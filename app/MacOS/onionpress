            # Usage: onionpress setup [--user USER] [--pass PASS] [--email EMAIL] [--title TITLE]
            #        onionpress setup --from-backup <password> <backup.zip>
            setup_db_passwords
            cd "$DOCKER_DIR"
            if wp_is_installed; then
                echo "WordPress is already installed."
                exit 0
            fi
            # Make sure WordPress container is running
            if ! wp_cli --info >/dev/null 2>&1; then
                echo "WordPress container is not running. Start OnionPress first."
                exit 1
            fi
