                # into the key volume so Tor uses the restored address.
                # Use .import-key-pending flag so start_containers removes the old
                # key volume and installs the restored key.
                # The backup's key replaces the one Tor serves now: hubs
                # that may hold a copy of that one are asked to delete it
                # first (not the backup's own address, which stays).
                # A backup without a key restored none: the install keeps
                # its key, and nothing is released or reimported.
                if [ "${SETUP_BACKUP_KEY_RESTORED:-}" = "yes" ]; then
                    local restored_key_dir=""
                    restored_key_dir=$(vanity_key_dir) || restored_key_dir=""
                    ONIONPRESS_YES=true onionheaven_release restore \
                        "${restored_key_dir:+$(basename "$restored_key_dir")}"
                    log "Setup --from-backup: flagging key reimport..."
                    touch "$DATA_DIR/.import-key-pending"
                fi
                stop_containers
                start_containers
                wait_for_services
            else
                # Start Tor if not running, its key volume in place first
                # (see start-tor).
                if ! docker compose ps tor --format json 2>/dev/null | grep -q running; then
                    echo "  Starting Tor..."
                    if ! migrate_key_volume; then
                        echo "  Tor not started: the onion service key volume is not in place (see $LOG_FILE)." >&2
                        exit 1
                    fi
                    docker compose up -d tor >> "$LOG_FILE" 2>&1
                fi
            fi
            echo ""
            echo "  Setup complete! Your site is now running."
            echo "  Admin panel: http://localhost:${ONIONPRESS_WP_PORT}/wp-admin"
            ;;

        backup)
            # backup [-o|--output <path>] [--user <login>]. The Python CLI
            # reads the password (must match a WordPress administrator) from
            # ONIONPRESS_BACKUP_PASSWORD, stdin or a no-echo prompt; the old
            # `backup <password> [output_path]` still works, with a warning.
            shift  # drop "backup"
            bundled_python -m onionpress.cli backup "$@"
            ;;

        restore)
