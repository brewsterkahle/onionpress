# OnionPress launcher script
# This script manages the WordPress + Tor onion service containers

set -e

# An OnionHeaven hub's backup recovery key, when the app's Restore... (or the
# operator) passes one in the environment: taken out of it at once and handed
# only to the commands that use it (restore, hub-recovery-key), so that no
# other child of this script inherits it.
_HUB_RECOVERY_KEY="${ONIONPRESS_HUB_RECOVERY_KEY:-}"
unset ONIONPRESS_HUB_RECOVERY_KEY

# Clear py2app PYTHONPATH so subprocess python calls are not confused.
unset PYTHONPATH

# Ensure we run natively on Apple Silicon (not under Rosetta).
# Universal binaries inherit the parent's architecture, so if this script
# was started under Rosetta we must re-exec to get native arm64 execution.
if sysctl hw.optional.arm64 2>/dev/null | grep -q ": 1" && [ "$(uname -m)" = "x86_64" ]; then
    exec arch -arm64 "$0" "$@"
fi

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_DIR="$(dirname "$SCRIPT_DIR")"
RESOURCES_DIR="$APP_DIR/Resources"
DOCKER_DIR="$RESOURCES_DIR/docker"
SCRIPTS_DIR="$RESOURCES_DIR/scripts"
DATA_DIR="$HOME/.onionpress"

# The value of KEY in ~/.onionpress/config (config_value KEY [default]),
# by config.read_value's rule (issue #404): a line is KEY's when, stripped,
# it starts with `KEY=`; the first such line wins; the value is everything
# after its first `=`, blanks around it trimmed. $2 (default empty) when
# no line names KEY. Always succeeds, so `x=$(config_value K)` is safe
# under `set -e`. Identical in the three launcher scripts
# (tests/test_config_one_reader.py).
config_value() {
    local line value
    line=$(grep -E "^[[:space:]]*$1=" "$DATA_DIR/config" 2>/dev/null | head -1)
    if [ -z "$line" ]; then
        printf '%s\n' "${2-}"
        return 0
    fi
    value=${line#*=}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    printf '%s\n' "$value"
}
DOCUMENTS_DIR="$HOME/OnionPress"

# DOCUMENTS_DIR lives at the top of $HOME (not under ~/Documents/) so the
# Apple Virtualization framework can mount it into the Colima VM without
# triggering the TCC "Documents Folder" grant. The grant is tied to bundle
# identity; every rebuild-menubar.sh modifies the adhoc-signed bundle and
# silently revokes the grant, causing the next VM start to fail. Top-of-home
# is not TCC-protected. See issue #239.
BIN_DIR="$RESOURCES_DIR/bin"
COLIMA_HOME="$DATA_DIR/colima"

# Use the Python bundled inside the py2app MenubarApp so we never depend on
# system Python (which may not exist — macOS does not ship a usable python3).
# PYTHONHOME is set inline per-call (not exported) to avoid polluting the
# environment for docker, docker compose, and other child processes.
_BUNDLED_PYTHON_BIN="$RESOURCES_DIR/MenubarApp/Contents/MacOS/python"
_BUNDLED_PYTHONHOME="$RESOURCES_DIR/MenubarApp/Contents/Resources"
# PYTHONSAFEPATH: `-m` and `-c` would otherwise put the current directory
# first on sys.path, and WordPress can write one directory the owner may
# run `onionpress` from, My Creations (issue #470). Not -I: it would
# ignore PYTHONHOME too.
bundled_python() { PYTHONHOME="$_BUNDLED_PYTHONHOME" PYTHONSAFEPATH=1 "$_BUNDLED_PYTHON_BIN" "$@"; }

# True only for a well-formed v3 onion address: 56 lowercase base32
# characters, then ".onion", and nothing else (no newline, no "/"). The
# rule of key_manager.is_valid_onion_address; a test keeps the two
# together. The letters are spelled out because a range like a-z can take
# in other characters in some locales.
is_onion_address() {
    [[ "$1" =~ ^[abcdefghijklmnopqrstuvwxyz234567]{56}\.onion$ ]]
}

# The imported or generated key's directory under vanity-keys/: the first
# one whose name is a whole onion address (is_onion_address), not merely
# "*.onion". Its name is taken for the address and the directory is
# bind-mounted into a container. Prints nothing and fails if there is none.
vanity_key_dir() {
    local d
    for d in "$DATA_DIR/shared/vanity-keys"/*.onion; do
        if [ -d "$d" ] && [ ! -L "$d" ] && is_onion_address "$(basename "$d")"; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Hand a file to the WordPress container, written as www-data: stdin goes to
# $1, mode ${2:-600} once in place (a temporary file beside it, renamed
# over it). Never as root: www-data owns /var/lib/onionpress and the web
# root, and root's `cat >` or docker cp followed a link planted at the name
# to any file in the container. The script is
# onionpress.wp_files.PUT_FILE_SCRIPT; a test keeps the copies equal.
wp_put() {
    docker exec -i -u www-data onionpress-wordpress \
        sh -c 't=$(mktemp "$1.XXXXXX") || exit 1; if cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"; then exit 0; fi; rm -f "$t"; exit 1' \
        sh "$1" "${2:-600}"
}

# Before this install forgets its onion service key (reset, key import, a
# restore to another address): ask every OnionHeaven hub that may hold a
# copy to delete it, while the key is still here to sign the request.
# onionpress.cli onionheaven-unregister sends the signed /unregister for
# the whole address to the hub the registration record names, through the
# tor container (which must be running), and says what it did; with nothing
# registered it does and prints nothing. The menubar's heartbeats are held
# off meanwhile (a lock and a hold in the record), so none puts the key back.
# Usage: onionheaven_release <reason> [<address whose key stays>]. Sets
# ONIONHEAVEN_RELEASE_RC (0 nothing left on a hub, 1 something the user
# could still take back, 3 something nothing here can take back, other:
# the command failed) and returns 1 only when the user chose to stop at
# the question.
onionheaven_release() {
    local answer=""
    ONIONHEAVEN_RELEASE_RC=0
    bundled_python -m onionpress.cli onionheaven-unregister --reason "$1" \
        ${2:+--keep-address "$2"} || ONIONHEAVEN_RELEASE_RC=$?
    # 0 and 3: nothing the user could still do. Anything else (1, or a
    # failure of the command itself) may leave a key on a hub: ask.
    case "$ONIONHEAVEN_RELEASE_RC" in 0|3) return 0 ;; esac
    [ "$ONIONPRESS_YES" = "true" ] && return 0
    printf "Continue anyway? The hub keeps the key listed above. [y/N] "
    read -r answer || true
    [ "$answer" = "y" ] || [ "$answer" = "Y" ]
}

# Run wp-cli in the WordPress container as www-data: wp_cli <args...>, and
# wp_cli_in for what wp-cli reads from stdin (docker exec -i). wp-cli loads
# WordPress (wp-config.php, mu-plugins, plugins, themes), every file of it
# www-data's to write, so run as root a plugin bug became root in the
# container. No --allow-root: wp-cli refuses to run as root. The command is
# onionpress.wp_files.wp_cli_args; a test keeps the copies equal.
wp_cli() {
    docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}


# The data dir is this user's alone (issue #397): config holds the
# Cloudflare token, shared/ the onion key. 0700 on every start, not only
# at creation, so an install made under a looser umask is fixed too.
mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"

# Idempotent subtree setup. No TCC concerns now that DOCUMENTS_DIR is at
# the top of $HOME — call eagerly at startup.
ensure_documents_dir() {
    mkdir -p "$DOCUMENTS_DIR/backups"
    mkdir -p "$DOCUMENTS_DIR/Creations/My Creations"
    # Social Archives holds source ZIPs from the Twitter/Mastodon/etc.
    # importers. Kept outside Creations so users don't see imported-
    # source clutter alongside their own original creations. Sentinel file
    # lets the WP-side importer plugin distinguish the real mount from
    # compose's /tmp fallback.
    mkdir -p "$DOCUMENTS_DIR/Social Archives"
    touch "$DOCUMENTS_DIR/Social Archives/.onionpress-activated"
}
ensure_documents_dir

# Emit `--mount $DOCUMENTS_DIR:w`. Always present now (the dir is
# created at startup) — but we still gate on existence as defensive
# protection against a hand-deleted directory mid-session.
docs_mount_args() {
    if [ -d "$DOCUMENTS_DIR" ]; then
        printf -- '--mount %s:w' "$DOCUMENTS_DIR"
    fi
}

# Log file + log() must be defined before any caller, otherwise bash falls
# through to macOS /usr/bin/log and prints help.
LOG_FILE="$DATA_DIR/onionpress.log"
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# One line naming the components that failed during this start, so "did
# everything come up?" is a single grep rather than a read of the whole
# log. Each guarded step appends its name to START_ERRORS.
START_ERRORS=""

# A Python start step names what it could not do in a file (the START
# SUMMARY contract, src/onionpress/start.py): `--errors-file "$f"` on the
# call, then `note_start_errors "$f"` reads the names, one per line, into
# START_ERRORS and removes the file. Only names of the bash's shape count.
start_errors_file() {
    mktemp "${TMPDIR:-/tmp}/onionpress-start-errors.XXXXXX" 2>/dev/null || true
}
note_start_errors() {
    local name
    [ -n "$1" ] && [ -f "$1" ] || return 0
    while IFS= read -r name || [ -n "$name" ]; do
        if [[ "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
            START_ERRORS="$START_ERRORS $name"
        fi
    done < "$1"
    rm -f "$1"
}

log_start_summary() {
    if [ -n "${START_ERRORS:-}" ]; then
        log "START SUMMARY: failed components:${START_ERRORS} — see the ERROR/WARNING lines above in $LOG_FILE"
    else
        log "START SUMMARY: all components started"
    fi
}

# Per-user lock file to prevent the same user from double-starting.
# Only checked for 'start' — other commands (status, get, launch, etc.) are safe.
PIDFILE="$DATA_DIR/onionpress.pid"

# Detect architecture (use sysctl to get actual hardware, not process architecture)
if sysctl hw.optional.arm64 2>/dev/null | grep -q ": 1"; then
    VM_ARCH="aarch64"
elif [ "$(uname -m)" = "x86_64" ]; then
    VM_ARCH="x86_64"
fi

# Create Docker config without credential store (avoids docker-credential-osxkeychain errors)
mkdir -p "$DATA_DIR/docker-config"
if [ ! -f "$DATA_DIR/docker-config/config.json" ]; then
    cat > "$DATA_DIR/docker-config/config.json" <<'EOFCONFIG'
{
	"auths": {},
	"currentContext": "colima"
}
EOFCONFIG
fi

# Install docker-compose plugin: prefer bundled, fall back to system
mkdir -p "$DATA_DIR/docker-config/cli-plugins"
if [ -f "$BIN_DIR/docker-compose" ]; then
    ln -sf "$BIN_DIR/docker-compose" "$DATA_DIR/docker-config/cli-plugins/docker-compose"
elif [ -L "$HOME/.docker/cli-plugins/docker-compose" ] && [ ! -e "$DATA_DIR/docker-config/cli-plugins/docker-compose" ]; then
    ln -sf "$HOME/.docker/cli-plugins/docker-compose" "$DATA_DIR/docker-config/cli-plugins/docker-compose"
fi

# Create default config if it doesn't exist. 0600: the template is a
# 0644 bundle resource and the file may hold CLOUDFLARE_TUNNEL_TOKEN
# (issue #397).
if [ ! -f "$DATA_DIR/config" ]; then
    if [ -f "$RESOURCES_DIR/config-template.txt" ]; then
        cp "$RESOURCES_DIR/config-template.txt" "$DATA_DIR/config"
    else
        cat > "$DATA_DIR/config" <<EOF
ADDRESS_PREFIX=op2
INSTALL_IA_PLUGIN=yes
LAUNCH_ON_LOGIN=no
EOF
    fi
    chmod 600 "$DATA_DIR/config"
fi

# Prefer bundled binaries
export PATH="$BIN_DIR:$PATH"
export PYTHONDONTWRITEBYTECODE=1
export COLIMA_HOME="$COLIMA_HOME"
export LIMA_HOME="$COLIMA_HOME/_lima"
# Colima (v0.8.1, config/files.go configBaseDir) honours $COLIMA_HOME only
# when the directory already exists; otherwise it silently uses ~/.colima
# for its config and for the Docker socket it has Lima forward
# (`hostSocket:` in the instance's lima.yaml). Launchers through 2.5.6
# left the directory for Colima to create, so a fresh install's first
# `colima start` put the socket at ~/.colima/default/docker.sock while
# ensure_docker_socket waited at ours, and the start failed with Docker
# healthy. Both directories exist before anything below runs Colima.
mkdir -p "$LIMA_HOME"
export LIMA_INSTANCE="onionpress"
export DOCKER_HOST="unix://$COLIMA_HOME/default/docker.sock"
# Also where Colima's own `docker context` create/use/rm calls land: never
# the user's ~/.docker (see launcher.sh).
export DOCKER_CONFIG="$DATA_DIR/docker-config"
export TZ="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || echo UTC)"

# The environment every verb runs with (issue #405): the ports and the
# paths, resolved once by the Python at the top of main() and exported
# here and nowhere else. `onionpress launcher-env` answers KEY=VALUE per
# line: ONIONPRESS_PORT_OFFSET and the three port variables compose and
# every start step read (onionpress.ports.resolve_at_start: a preset
# ONIONPRESS_PORT_OFFSET, the daemon's or the menubar's, as it is; else
# the previous instance's port waited for, the running stack's published
# port, else the bind probe), and DOCKER_DIR (platform.resolve_paths).
# The Colima environment above (COLIMA_HOME, DOCKER_HOST, DOCKER_CONFIG)
# is this launcher's own. Its log lines go to the log file only: stdout
# is what the menubar reads. When the Python does not answer (a broken
# bundle) the launcher keeps going on the preset offset or 0, so `stop`
# still brings the containers down.
launcher_environment() {
    local answer key value
    answer=$(bundled_python -m onionpress.cli --data-dir "$DATA_DIR" launcher-env 2>>"$LOG_FILE") || answer=""
    while IFS='=' read -r key value; do
        case "$key" in
            ONIONPRESS_PORT_OFFSET|ONIONPRESS_WP_PORT|ONIONPRESS_SOCKS_PORT|ONIONPRESS_PROXY_PORT)
                [[ "$value" =~ ^[0123456789]{1,5}$ ]] && export "$key=$value" ;;
            DOCKER_DIR)
                [ -n "$value" ] && [ -d "$value" ] && DOCKER_DIR="$value" ;;
        esac
    done <<< "$answer"
    if ! [[ "${ONIONPRESS_WP_PORT:-}" =~ ^[0123456789]{1,5}$ ]]; then
        [[ "${ONIONPRESS_PORT_OFFSET:-}" =~ ^[0123456789]{1,5}$ ]] || ONIONPRESS_PORT_OFFSET=0
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: the ports could not be resolved (onionpress launcher-env gave no answer): using offset $ONIONPRESS_PORT_OFFSET" >> "$LOG_FILE"
        export ONIONPRESS_PORT_OFFSET
        export ONIONPRESS_WP_PORT=$((8080 + ONIONPRESS_PORT_OFFSET))
        export ONIONPRESS_SOCKS_PORT=$((9050 + ONIONPRESS_PORT_OFFSET))
        export ONIONPRESS_PROXY_PORT=$((9077 + ONIONPRESS_PORT_OFFSET))
    fi
}

# Read version from Info.plist
ONIONPRESS_VERSION=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$APP_DIR/Info.plist" 2>/dev/null || echo "unknown")
export ONIONPRESS_VERSION

# Read Cloudflare Tunnel token from config (empty = disabled)
CLOUDFLARE_TUNNEL_TOKEN=""
if [ -f "$DATA_DIR/config" ]; then
    _cf_token=$(config_value CLOUDFLARE_TUNNEL_TOKEN)
    if [ ! -z "$_cf_token" ]; then
        CLOUDFLARE_TUNNEL_TOKEN="$_cf_token"
    fi
fi
export CLOUDFLARE_TUNNEL_TOKEN

# Run as an OnionHeaven hub (config-file-only). The containers accept
# registrations and run takeovers only on the canonical hub address or with
# an exact "yes" here; compose hands the value to the tor and onionheaven
# containers. Kept in step with linux/onionpress and onionpress.containers.
ONIONHEAVEN_ACCEPT_REGISTRATIONS=""
if [ -f "$DATA_DIR/config" ]; then
    ONIONHEAVEN_ACCEPT_REGISTRATIONS=$(config_value ONIONHEAVEN_ACCEPT_REGISTRATIONS)
fi
export ONIONHEAVEN_ACCEPT_REGISTRATIONS

# The hub's takeover tunables (the Settings page writes them; compose hands
# ONIONHEAVEN_PROPAGATION_DELAY to tor and onionheaven as
# TOR_PROPAGATION_DELAY, ONIONHEAVEN_MAX_SERVICES to onionheaven and
# onionheaven-farm). Kept in step with linux/onionpress and
# onionpress.containers (issue #353); until then only the Linux launcher
# read them. A value that is not a whole number is left to the default.
ONIONHEAVEN_MAX_SERVICES="${ONIONHEAVEN_MAX_SERVICES:-50}"
ONIONHEAVEN_PROPAGATION_DELAY="${ONIONHEAVEN_PROPAGATION_DELAY:-180}"
if [ -f "$DATA_DIR/config" ]; then
    _val=$(config_value ONIONHEAVEN_MAX_SERVICES)
    [[ "$_val" =~ ^[0-9]+$ ]] && ONIONHEAVEN_MAX_SERVICES="$_val"
    _val=$(config_value ONIONHEAVEN_PROPAGATION_DELAY)
    [[ "$_val" =~ ^[0-9]+$ ]] && ONIONHEAVEN_PROPAGATION_DELAY="$_val"
fi
export ONIONHEAVEN_MAX_SERVICES ONIONHEAVEN_PROPAGATION_DELAY

# Locally built container images (development).
#
# build/build-images.sh builds the tor and wordpress images from this repo and
# prints these two exports. Setting either here, or in ~/.onionpress/config,
# repoints the whole stack: compose's tor/wordpress/onionheaven services, the
# image pulls below, the OnionHeaven takeover workers and vanity-key
# generation. See docs/BUILDING.md.
for _img_var in ONIONPRESS_TOR_IMAGE ONIONPRESS_WORDPRESS_IMAGE; do
    if [ -z "$(eval echo \"\$$_img_var\")" ] && [ -f "$DATA_DIR/config" ]; then
        _img_val=$(config_value "$_img_var")
        if [ -n "$_img_val" ]; then
            eval "export ${_img_var}=\"\$_img_val\""
        fi
    fi
done
unset _img_var _img_val

# True when the stack points at images built on this machine rather than
# published ones. Every `docker pull` / `docker compose pull` below is gated
# on this: without the gate they overwrite a local tag with the registry's
# copy, so a developer would build an image, start the app, and silently test
# someone else's build. The rule itself (a reference not on ghcr.io, from the
# environment or ~/.onionpress/config) is onionpress.containers.using_local_images,
# asked through the CLI (Phase 4, #120).
using_local_images() {
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" using-local-images
}

# The image every one-shot helper that handles the onion service key runs
# from (the key volume migration, the key seeds, the backup's key reads):
# the stack's own tor image, pinned by digest like the rest, or the locally
# built one. Never a floating tag such as `alpine`, which a registry or a
# mirror could swap for an image that reads the key. Each run overrides the
# entrypoint and joins no network (tests/test_container_capabilities.py).
KEY_HELPER_IMAGE="${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:c309c64ac057c83b74a77921f5fc39f0f41bd63e386825a584eb43aef7ed1fe3}"

# Analytics directory — bind-mounted into the tor container so analytics
# data survives VM deletion.  Lives under shared/ which is already
# mounted into the Colima VM.
ONIONPRESS_SHARED_DIR="$DATA_DIR/shared"
mkdir -p "$ONIONPRESS_SHARED_DIR/analytics"
export ONIONPRESS_SHARED_DIR

# Documents directory for Creations mount into WordPress container.
# ensure_documents_dir() creates this at startup; the existence check is
# defensive against hand-deletion.
if [ -d "$DOCUMENTS_DIR" ]; then
    export ONIONPRESS_DOCUMENTS_DIR="$DOCUMENTS_DIR"
fi


# Cloudflare Tunnel (#352), one rule on both platforms (this function is
# test-held identical in the two launchers): cloudflared runs only while the
# config holds a token AND WordPress is installed. Before that its install
# page, then an unprovisioned site, would be on the open internet. Called at
# the end of a start, after provisioning and the bundled plugins (the
# clearnet's first page comes from a site with its cache policy in place),
# and at the end of every setup path, so a new site needs no restart.
# Otherwise the container is removed, not just stopped, so a removed token
# does not linger in its configuration. --no-deps: wordpress is up already,
# and a setup path's call must not recreate it. Its ingress must point at
# http://wordpress:80; the ONIONPRESS-TOR chain refuses the LAN and the host.
start_cloudflare_tunnel() {
    local wp_installed=$1
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ] && [ "$wp_installed" = true ]; then
        log "Cloudflare Tunnel enabled, starting cloudflared..."
        (cd "$DOCKER_DIR" && docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml \
            up -d --no-deps cloudflared) >> "$LOG_FILE" 2>&1 \
            || log "ERROR: Failed to start cloudflared container"
        return 0
    fi
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        log "Cloudflare Tunnel: waiting until WordPress is set up (it starts when setup finishes)"
    fi
    if docker container inspect onionpress-cloudflared >/dev/null 2>&1; then
        log "Cloudflare Tunnel off (no token, or WordPress not set up): removing cloudflared"
        docker rm -f onionpress-cloudflared >> "$LOG_FILE" 2>&1 || true
    fi
}

# OnionHeaven farm — takeover worker containers. The onionheaven container
# spawns and scales them itself (onionheaven_common._spawn_worker, from the
# registry's farm_scale_requests); the launcher only stops them on the way out.
stop_onionheaven_farm() {
    # Stop all farm containers (catches any scaled-up containers too), all at
    # once, with a second's grace each: their onion services are ephemeral
    # (ADD_ONION), and one after another at Docker's default 10 s a farm of
    # any size outlasted a quit, leaving workers to run on into the next
    # start.
    local container pids=""
    for container in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^onionheaven-(poll|takeover)-[0-9]+$'); do
        {
            docker stop -t 1 "$container" >> "$LOG_FILE" 2>&1 || true
            docker rm "$container" >> "$LOG_FILE" 2>&1 || true
            log "OnionHeaven farm: stopped $container"
        } &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# OnionPress installed the WordPress now in the container (issue #464):
# the marker setup_logic.wordpress_installed_by_onionpress reads, user 1's
# registration time as WordPress records it (setup_logic writes the same
# file from install_fresh_wordpress; a test keeps the two equal).
WP_INSTALLED_BY_ONIONPRESS_MARKER=".wordpress-installed-by-onionpress"

# Check if WordPress core is installed (setup wizard completed)
wp_is_installed() {
    local rc=0
    wp_cli core is-installed >/dev/null 2>&1 || rc=$?
    # rc 1 is WordPress answering "not installed"; anything else is docker
    # or wp-cli itself failing, which must not be mistaken for a fresh site.
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
        log "wp core is-installed: docker exec failed (rc=$rc) — treating as not installed" >&2
    fi
    return $rc
}

# Backup passwords are handed over in ONIONPRESS_BACKUP_PASSWORD, never on a
# command line: other local users can read any process's argv (ps,
# /proc/<pid>/cmdline) but not its environment. Sets BACKUP_PASS from the
# first of: the variable, a line on stdin, a no-echo prompt. A password
# given as an argument ($1: the old positional form of backup, restore,
# scrub and `setup --from-backup`) is refused, exit 2 (issue #504: a leaked
# child kept one in ps until reboot). Unsets the variable so the commands
# this script runs don't inherit it; pass it on as
# ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" cmd.
# Identical in app/MacOS/onionpress and linux/onionpress (test-enforced).
read_backup_password() {
    BACKUP_PASS="${ONIONPRESS_BACKUP_PASSWORD:-}"
    unset ONIONPRESS_BACKUP_PASSWORD
    if [ -n "${1:-}" ]; then
        echo "ERROR: a password on the command line is visible to other users of this computer, so it is refused. Leave it out to be prompted, or set ONIONPRESS_BACKUP_PASSWORD." >&2
        exit 2
    fi
    if [ -z "$BACKUP_PASS" ]; then
        if [ -t 0 ]; then
            read -r -s -p "Backup password: " BACKUP_PASS || true
            echo "" >&2
        else
            IFS= read -r BACKUP_PASS || true
        fi
    fi
}

# `onionpress setup` (setup_logic.setup_from_terminal, #442.11) with this
# launcher's arguments, the passwords moved off the command line into the
# environment the CLI reads (and drops) them from: `--pass`,
# `--ia-password` and `--from-backup`'s password. Its status says what is
# left for the launcher: 0 done, 2 already installed, 10 restart the stack
# (a backup's setup), anything else failed.
run_setup() {
    local args=() setup_pass="" ia_pass="" backup_pass=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --pass) setup_pass="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
            --ia-password) ia_pass="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
            --from-backup)
                # `--from-backup <zip>`: the password as backup and restore
                # take it (ONIONPRESS_BACKUP_PASSWORD, stdin, a prompt). The
                # old `--from-backup <password> <zip>` is refused by
                # read_backup_password (never taken for a zip path).
                # The setup is then the restore (issue #509), so a hub's
                # recovery key goes along as the restore case passes it.
                if [ $# -ge 3 ] && [ "${3#-}" = "$3" ]; then
                    read_backup_password "${2:-}"
                    args+=(--from-backup "$3")
                    shift 3
                else
                    read_backup_password ""
                    args+=(--from-backup "${2:-}")
                    shift; [ $# -eq 0 ] || shift
                fi
                backup_pass="$BACKUP_PASS" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    ONIONPRESS_SETUP_PASSWORD="$setup_pass" ONIONPRESS_IA_PASSWORD="$ia_pass" \
        ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" ONIONPRESS_BACKUP_PASSWORD="$backup_pass" \
        bundled_python -m onionpress.cli --data-dir "$DATA_DIR" setup --launcher "$SCRIPT_DIR/onionpress" "${args[@]}"
}

# The database passwords (issue #529): `onionpress ensure-secrets`
# (secrets_file.ensure_secrets: made once, random per install, 0600;
# refused when the file is incomplete) and then, here, the `source` and
# the export compose reads. Nothing else in bash touches the file.
setup_db_passwords() {
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" ensure-secrets 2>&1 | tee -a "$LOG_FILE"
    [ "${PIPESTATUS[0]}" -eq 0 ] || exit 1
    source "$DATA_DIR/secrets"
    export WORDPRESS_DB_PASSWORD MYSQL_PASSWORD MYSQL_ROOT_PASSWORD
}


# Function to detect container runtime
detect_container_runtime() {
    # Called as RUNTIME=$(detect_container_runtime): stdout IS the return
    # value, so every log line in here goes to stderr (tee still writes
    # the file copy) or it ends up inside $RUNTIME.
    # Use bundled Colima
    if command_exists colima; then
        if [ -f "$COLIMA_HOME/.initialized" ]; then
            if "$BIN_DIR/colima" status >/dev/null 2>&1; then
                # Check if configured VM memory differs from running VM
                _cfg_mem=2
                if [ -f "$DATA_DIR/config" ]; then
                    _tmp_mem=$(config_value VM_MEMORY)
                    [ -n "$_tmp_mem" ] && _cfg_mem="$_tmp_mem"
                fi
                # Get actual VM memory in GB (MemTotal is in kB). The value
                # is the tor container's to choose (root there faces the
                # network), and bash evaluates a variable inside $(( ))
                # or [[ -gt ]] as an expression, where `a[$(cmd)]` runs
                # cmd on the Mac (issue #466): only a plain number is
                # taken, anything else counts as unknown.
                _vm_mem_kb=$(docker exec onionpress-tor awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null | tr -d ' \n\r')
                [[ "$_vm_mem_kb" =~ ^[0123456789]{1,12}$ ]] || _vm_mem_kb=0
                _vm_mem_gb=$(( (_vm_mem_kb + 524288) / 1048576 ))  # round to nearest GB
                # Read configured CPU count
                _cfg_cpu=2
                if [ -f "$DATA_DIR/config" ]; then
                    _tmp_cpu=$(config_value VM_CPU)
                    [ -n "$_tmp_cpu" ] && _cfg_cpu="$_tmp_cpu"
                fi
                # Get actual VM CPU count
                _vm_cpus=$(docker exec onionpress-tor nproc 2>/dev/null | tr -d ' \n\r')
                [[ "$_vm_cpus" =~ ^[0123456789]{1,6}$ ]] || _vm_cpus=0

                _need_restart=false
                if [ "$_cfg_mem" -gt 0 ] 2>/dev/null && [ "$_vm_mem_gb" -gt 0 ] 2>/dev/null && [ "$_cfg_mem" -ne "$_vm_mem_gb" ]; then
                    log "VM memory mismatch: config=${_cfg_mem}GB, running=${_vm_mem_gb}GB" >&2
                    _need_restart=true
                fi
                if [ "$_cfg_cpu" -gt 0 ] 2>/dev/null && [ "$_vm_cpus" -gt 0 ] 2>/dev/null && [ "$_cfg_cpu" -ne "$_vm_cpus" ]; then
                    log "VM CPU mismatch: config=${_cfg_cpu}, running=${_vm_cpus}" >&2
                    _need_restart=true
                fi
                if [ "$_need_restart" = true ]; then
                    log "Restarting VM with ${_cfg_cpu} CPUs, ${_cfg_mem}GB RAM..." >&2
                    cd "$DOCKER_DIR"
                    docker compose down >> "$LOG_FILE" 2>&1 || true
                    "$BIN_DIR/colima" stop >> "$LOG_FILE" 2>&1
                    "$BIN_DIR/colima" start \
                        --activate=false \
                        --ssh-config=false \
                        --mount "$DATA_DIR/shared:w" \
                        $(docs_mount_args) \
                        --cpu "$_cfg_cpu" \
                        --memory "$_cfg_mem" \
                        >> "$LOG_FILE" 2>&1
                    if [ $? -eq 0 ]; then
                        log "VM restarted with ${_cfg_cpu} CPUs, ${_cfg_mem}GB" >&2
                    else
                        log "WARNING: VM restart failed" >&2
                    fi
                fi
                echo "colima-bundled"
                return 0
            else
                # Start Colima if stopped
                log "Starting bundled Colima..." >&2

                # Read VM memory/CPU from config so restarts honour changes
                _restart_mem=2
                _restart_cpu=2
                if [ -f "$DATA_DIR/config" ]; then
                    _cfg_mem=$(config_value VM_MEMORY)
                    [ -n "$_cfg_mem" ] && _restart_mem="$_cfg_mem"
                    _cfg_cpu=$(config_value VM_CPU)
                    [ -n "$_cfg_cpu" ] && _restart_cpu="$_cfg_cpu"
                fi

                "$BIN_DIR/colima" start \
                    --activate=false \
                    --ssh-config=false \
                    --mount "$DATA_DIR/shared:w" \
                    $(docs_mount_args) \
                    --cpu "$_restart_cpu" \
                    --memory "$_restart_mem" \
                    >> "$LOG_FILE" 2>&1
                if [ $? -eq 0 ]; then
                    echo "colima-bundled"
                    return 0
                fi
            fi
        fi
    fi

    # Fallback to system Docker (for development)
    if command_exists docker && docker info >/dev/null 2>&1; then
        echo "docker-system"
        return 0
    fi

    return 1
}

# Make sure DOCKER_HOST resolves to *our own* VM's socket — never another Colima.
#
# Colima honours COLIMA_HOME, so Lima forwards the guest's /var/run/docker.sock
# to $COLIMA_HOME/default/docker.sock (the `hostSocket:` entry in the instance's
# lima.yaml). Launchers up to v2.4.110 assumed the socket always landed in
# ~/.colima/ and symlinked that path into COLIMA_HOME to "bridge the gap". The
# bridge could only ever fire when our own forward was missing — so in practice
# it pointed DOCKER_HOST at whatever *other* Colima the user happened to be
# running, and OnionPress then deployed wordpress/db/tor into that VM. Repair
# any link left over from those versions, then wait for our own forward.
ensure_docker_socket() {
    local socket_path="$COLIMA_HOME/default/docker.sock"
    local wait_secs="${1:-45}"
    local waited=0
    local target

    if [ -L "$socket_path" ]; then
        target=$(readlink "$socket_path")
        case "$target" in
            "$COLIMA_HOME"/*)
                : ;;  # inside our own VM state — leave it alone
            *)
                log "WARNING: removing foreign Docker socket link ($socket_path -> $target)"
                rm -f "$socket_path"
                ;;
        esac
    fi

    while [ "$waited" -lt "$wait_secs" ]; do
        if [ -S "$socket_path" ]; then
            [ "$waited" -gt 0 ] && log "Docker socket ready after ${waited}s"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log "ERROR: Docker socket never appeared at $socket_path after ${wait_secs}s"
    if docker_socket_forward_is_foreign; then
        log "  Lima forwards the VM's /var/run/docker.sock to $(docker_socket_forwards | tr '\n' ' ')instead (the VM was created before \$COLIMA_HOME existed); the Docker wait restarts the VM through Colima to re-point it."
    else
        log "  Lima's forward for the VM's /var/run/docker.sock is down."
    fi
    log "  Diagnose: $COLIMA_HOME/_lima/colima/ha.stderr.log"
    log "  Recover:  quit OnionPress, \"$BIN_DIR/colima\" stop, start OnionPress again (never a bare colima \"start\": without OnionPress's flags it mounts the whole home folder into the VM)"
    return 1
}

# The host paths Lima forwards the VM's Docker socket to: every hostSocket
# of the instance's lima.yaml, which Colima writes from its config
# directory at each start. Nothing is printed without a VM.
docker_socket_forwards() {
    sed -n 's/^[[:space:]]*hostSocket:[[:space:]]*//p' "$LIMA_HOME/colima/lima.yaml" 2>/dev/null \
        | sed 's/^"\(.*\)"$/\1/'
}

# True when Lima forwards the VM's Docker socket somewhere outside
# $COLIMA_HOME: a VM created by a launcher through 2.5.6 on a fresh
# install, where Colima resolved its directory to ~/.colima (see the mkdir
# at the top). DOCKER_HOST can never answer through that forward.
docker_socket_forward_is_foreign() {
    local path
    while IFS= read -r path; do
        [ -n "$path" ] || continue  # no VM yet: nothing is foreign
        case "$path" in
            "$COLIMA_HOME"/*) ;;
            *) return 0 ;;
        esac
    done <<EOF
$(docker_socket_forwards)
EOF
    return 1
}

# Re-point a foreign Docker socket forward: stop the VM through Colima and
# start it again with OnionPress's VM settings. Now that $COLIMA_HOME
# exists, Colima regenerates lima.yaml with hostSocket under it (the
# `colima stop && colima start` the socket wait's error line used to
# recommend, with the flags). A Lima-level restart, the recovery for the
# sshd wedge, cannot change the forward: it boots the same lima.yaml. $1
# labels the log lines with the caller.
recover_docker_socket_forward() {
    local who="$1" cpu=2 memory=2 disk=20 value
    log "$who: Lima forwards the VM's Docker socket to $(docker_socket_forwards | tr '\n' ' ')— not $COLIMA_HOME/default/docker.sock, where OnionPress waits for it. Restarting the VM through Colima to re-point it"
    if [ -f "$DATA_DIR/config" ]; then
        value=$(config_value VM_CPU); [ -n "$value" ] && cpu="$value"
        value=$(config_value VM_MEMORY); [ -n "$value" ] && memory="$value"
        value=$(config_value VM_DISK); [ -n "$value" ] && disk="$value"
    fi
    if ! "$BIN_DIR/colima" stop >> "$LOG_FILE" 2>&1; then
        log "$who: colima stop failed — forcing"
        "$BIN_DIR/colima" stop -f >> "$LOG_FILE" 2>&1 || true
    fi
    if ! colima_start_with_vm_settings "$cpu" "$memory" "$disk"; then
        log "$who: Colima could not start the VM — giving up; see $LOG_FILE"
        return 1
    fi
    if docker_socket_forward_is_foreign; then
        log "$who: the VM restarted but Lima still forwards the Docker socket to $(docker_socket_forwards | tr '\n' ' ')— giving up"
        return 1
    fi
    log "$who: VM restarted; Lima now forwards the Docker socket to $COLIMA_HOME/default/docker.sock"
    return 0
}

# Replace the site's onion service key (onionpress.key_import, issue #524):
# the check, the confirm protocol (--check --json, --confirmed
# address-change), the copy of the current key, the hubs, the swap.
import_key() {
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" import-key "$@"
}

# Configure, then activate, Cache Enabler (network-wide, with its cache
# policy) and the Internet Archive Link Fixer (site by site), once
# WordPress is installed (onionpress.bundled_plugins, #442.3; a start does
# it inside start-post-up). The setup-bundled-plugins case, which
# setup_logic.install_fresh_wordpress starts once setup has made the
# user's site, runs it. Best effort: logged in this script's format, tee'd
# into the log, never a stopped command.
setup_bundled_plugins() {
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" setup-bundled-plugins \
        --scripts-dir "$SCRIPTS_DIR" 2>&1 | tee -a "$LOG_FILE"
    return 0
}

# WP-Statistics plugin removed — it phoned home to connect.wp-statistics.com
# despite telemetry settings being disabled.  OnionPress's built-in hit counter
# (onionpress-hit-counter plugin) provides the same functionality without
# any clearnet leaks.  On existing installs the plugin is deactivated on the
# next launch (see deactivate_wp_statistics below).

# `colima start` with every setting the VM is created with: the two
# mounts, CPUs, memory, the diffdisk cap and the backend for this
# architecture. install_docker creates the VM with it; the Docker socket
# recovery below restarts an existing VM with it, because that VM's
# Colima config was saved under ~/.colima (see the mkdir at the top) and
# a start without these flags would give it Colima's defaults: the whole
# home folder mounted, 100 GiB of disk. On an existing VM Colima keeps
# the backend, mount type and architecture it was created with.
colima_start_with_vm_settings() {
    local cpu="$1" memory="$2" disk="$3"
    if [ "$VM_ARCH" = "aarch64" ]; then
        # Apple Silicon: use VZ backend (Virtualization.framework)
        "$BIN_DIR/colima" start \
            --activate=false \
            --ssh-config=false \
            --vm-type vz \
            --mount-type virtiofs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$cpu" \
            --memory "$memory" \
            --disk "$disk" \
            --arch "$VM_ARCH" \
            --vz-rosetta=false \
            >> "$LOG_FILE" 2>&1
    else
        # Intel: use QEMU backend
        "$BIN_DIR/colima" start \
            --activate=false \
            --ssh-config=false \
            --vm-type qemu \
            --mount-type sshfs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$cpu" \
            --memory "$memory" \
            --disk "$disk" \
            --arch "$VM_ARCH" \
            >> "$LOG_FILE" 2>&1
    fi
}

# Function to initialize container runtime
install_docker() {
    log "Container runtime initialization required"

    # Read VM memory from config (default: 2 GB — the stack idles at ~840 MB)
    VM_MEMORY=2
    VM_CPU=2
    if [ -f "$DATA_DIR/config" ]; then
        config_mem=$(config_value VM_MEMORY)
        if [ ! -z "$config_mem" ]; then
            VM_MEMORY="$config_mem"
        fi
        config_cpu=$(config_value VM_CPU)
        if [ ! -z "$config_cpu" ]; then
            VM_CPU="$config_cpu"
        fi
    fi

    # Diffdisk cap (issue #230), same rule as launcher.sh: 20 GiB unless
    # VM_DISK is set in ~/.onionpress/config before first launch. The cap is
    # baked in at VM creation, so this fallback path has to pass it too or
    # a VM created here gets Lima's 100 GiB default.
    local VM_DISK=20 _cfg_disk
    if [ -f "$DATA_DIR/config" ]; then
        _cfg_disk=$(config_value VM_DISK)
        [ -n "$_cfg_disk" ] && VM_DISK="$_cfg_disk"
    fi
    log "Creating the Colima VM with a ${VM_DISK}GB diffdisk cap"

    # Should not happen if launcher worked, but handle it
    if colima_start_with_vm_settings "$VM_CPU" "$VM_MEMORY" "$VM_DISK"; then
        touch "$COLIMA_HOME/.initialized"
        log "Container runtime initialized successfully"
        return 0
    else
        log "ERROR: Failed to initialize container runtime"
        echo "ERROR: Failed to initialize container runtime." >&2
        echo "Check the logs for details: $LOG_FILE" >&2
        echo "Or file an issue at: https://github.com/brewsterkahle/onionpress/issues" >&2
        exit 1
    fi
}


# Function to set up OnionHeaven (onionheaven mode only)
# Registration API now runs in the onionheaven container (web-server.py),
# which creates its own data directories on the shared volume at startup.

# Whether Docker has volume $1: 0 yes, 1 no, 2 Docker could not say (the
# daemon is not up yet, e.g. the Colima VM is still booting). Callers must
# treat 2 as "stop", never as "no": a missing key volume is the first-run
# signal, so reading a Docker error as absence turns an upgrade into a first
# run. Kept identical in the macOS and Linux launchers; a test enforces that.
docker_volume_state() {
    local names
    names=$(docker volume ls --format '{{.Name}}' 2>>"$LOG_FILE") || return 2
    printf '%s\n' "$names" | grep -qx -- "$1"
}

# Wait up to $1 seconds for the Docker daemon to answer; returns 1 if it
# never does. Kept identical in the macOS and Linux launchers.
wait_for_docker() {
    local limit="$1" waited=0
    while ! docker info >/dev/null 2>&1; do
        if [ "$waited" -ge "$limit" ]; then
            return 1
        fi
        if [ "$waited" -eq 0 ]; then
            log "Waiting for Docker daemon to be ready..."
        fi
        sleep 2
        waited=$((waited + 2))
    done
    if [ "$waited" -gt 0 ]; then
        log "Docker daemon ready after ${waited}s"
    fi
    return 0
}

# Whether Lima thinks the colima instance is up. "Running" with no Docker
# answer is the wedge recover_lima_vm exists for.
lima_vm_running() {
    export COLIMA_HOME LIMA_HOME
    "$BIN_DIR/limactl" list --format '{{.Status}}' colima 2>/dev/null | grep -qx Running
}

# Force-stop and restart the Lima VM. This is the one known recovery for the
# wedged "Running but SSH refused" state the VM lands in occasionally after
# long uptime / sleep, and (2026-10-02) after a macOS update killed the app
# mid-stop: lima reports the instance Running, the guest even gets a DHCP
# lease, but sshd never comes up, so `colima start` waits ten minutes for a
# "running" event that never arrives and Docker stays unreachable. $1 labels
# the log lines with the caller (start / restart). Returns 1 when the VM
# would not come back; the caller decides what that means.
recover_lima_vm() {
    local who="$1"
    log "$who: Docker daemon not reachable — restarting Lima VM first"
    export COLIMA_HOME LIMA_HOME
    "$BIN_DIR/limactl" stop -f colima >> "$LOG_FILE" 2>&1 || true
    # Wait briefly for hostagent processes to fully die before starting
    # again — lima can trip over itself otherwise.
    sleep 3
    if ! "$BIN_DIR/limactl" start colima >> "$LOG_FILE" 2>&1; then
        log "$who: limactl start failed — giving up, user may need to reboot"
        return 1
    fi
    log "$who: Lima VM restarted"
    save_previous_boot_journal "$who"
    return 0
}

# wait_for_docker, plus one shot at the Lima wedge: when Docker has not
# answered within $1 seconds but Lima still reports the VM Running, recover
# the VM once and wait again with a fresh budget. Gives up (returns 1) only
# after that second wait, or straight away when the VM is not Running at
# all (a stopped VM is not the wedge; restarting it here would fight the
# launcher's own `colima start`). $2 labels the log lines with the caller.
wait_for_docker_or_recover_vm() {
    local limit="$1" who="$2"
    # Docker cannot answer through a forward aimed outside $COLIMA_HOME,
    # so there is nothing to wait for first: re-point it (a Running VM
    # only; a stopped one gets its lima.yaml rewritten by the launcher's
    # own `colima start`), then wait.
    if docker_socket_forward_is_foreign && lima_vm_running; then
        recover_docker_socket_forward "$who" || return 1
        wait_for_docker "$limit"
        return $?
    fi
    if wait_for_docker "$limit"; then
        return 0
    fi
    if ! lima_vm_running; then
        log "$who: Docker daemon not ready after ${limit}s and Lima does not report the VM Running — not recovering"
        return 1
    fi
    log "$who: Docker daemon not ready after ${limit}s while Lima reports the VM Running — recovering the wedged VM"
    recover_lima_vm "$who" || return 1
    wait_for_docker "$limit"
}


# Run a command inside the VM through `limactl shell`, bounded to $1
# seconds. limactl shell hangs for good when the guest's sshd is wedged
# (the state recover_lima_vm exists for) and macOS has no timeout(1).
# Prints the command's stdout; its stderr goes to the log. Returns the
# command's status, 124 on timeout, 127 when there is no bundled limactl
# (Linux, or a test harness without one).
vm_shell_bounded() {
    local limit="$1"; shift
    [ -x "$BIN_DIR/limactl" ] || return 127
    local out pid rc=0 waited=0
    out=$(mktemp "${TMPDIR:-/tmp}/onionpress-vm-shell.XXXXXX") || return 1
    "$BIN_DIR/limactl" shell colima -- "$@" > "$out" 2>> "$LOG_FILE" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge "$limit" ]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            rm -f "$out"
            return 124
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "$pid" || rc=$?
    cat "$out"
    rm -f "$out"
    return "$rc"
}


# The guest's root filesystem must be able to repair itself at boot.
#
# Root cause of the "Lima reports the VM Running, sshd and Docker never
# come up" wedge on the live install (found 2026-10-11 by reading the
# guest's journal): its root ext4 had carried an inconsistency since
# 2026-09-12 that the boot-time check (preen mode, `fsck -a`) refuses to
# fix — "UNEXPECTED INCONSISTENCY; RUN fsck MANUALLY", exit 4. That fails
# systemd-fsck-root.service, whose OnFailure= starts emergency.target, and
# whether sysinit/ssh/docker still come up is then a race: 3 of the 6
# boots in that journal lost it. Nobody can answer that prompt in an
# appliance VM, so give the kernel `fsck.repair=yes` — systemd-fsck then
# runs `fsck -y`, which clears such damage at the next boot and keeps
# emergency mode out of the picture. The guest boots without an initramfs
# (GRUB_FORCE_PARTUUID), so systemd-fsck is the only checker and a grub
# drop-in is the whole change. Idempotent: the drop-in is written once,
# update-grub runs only then, and the flag takes effect at the next VM
# boot. Also reports when this boot's root check failed, so the condition
# shows in onionpress.log instead of only in the guest's journal. Best
# effort: never fails the start.
ensure_vm_fsck_repair() {
    local script out rc=0 summary detail
    script=$(cat <<'EOF'
f=/etc/default/grub.d/60-onionpress-fsck.cfg
flag=present
if ! grep -qs "fsck.repair=yes" "$f"; then
    {
        echo "# OnionPress: repair the root filesystem automatically at boot. Without"
        echo "# this, an inconsistency the preen-mode check cannot fix sends systemd into"
        echo "# emergency mode, where sshd and Docker may never start, and no one can"
        echo "# answer \"RUN fsck MANUALLY\" in an appliance VM. systemd-fsck reads it as -y."
        echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT fsck.repair=yes\""
    } > "$f" && update-grub >/dev/null 2>&1 && flag=installed || flag=install-failed
fi
state=$(systemctl is-failed systemd-fsck-root.service 2>/dev/null || true)
if grep -qw "fsck.repair=yes" /proc/cmdline; then cmdline=yes; else cmdline=no; fi
echo "fsck-root=${state:-unknown} repair-flag=$flag cmdline=$cmdline"
if [ "$state" = failed ]; then
    journalctl -b 0 -u systemd-fsck-root.service --no-pager -o cat 2>/dev/null | grep -i "fsck\|inconsisten" | head -n 4
fi
EOF
)
    out=$(vm_shell_bounded 60 sudo sh -c "$script") || rc=$?
    case "$rc" in
        0) ;;
        127) return 0 ;;  # no bundled limactl: no VM to look after
        124) log "WARNING: VM root filesystem check skipped — limactl shell did not return within 60s (VM ssh wedged?)"; return 0 ;;
        *) log "WARNING: VM root filesystem check failed (rc=$rc) — see $LOG_FILE"; return 0 ;;
    esac
    summary=$(printf '%s\n' "$out" | head -n 1)
    detail=$(printf '%s\n' "$out" | tail -n +2)
    case "$summary" in
        *"repair-flag=installed"*)
            log "VM: added fsck.repair=yes to the guest kernel command line (takes effect at the next VM boot)" ;;
        *"repair-flag=install-failed"*)
            log "WARNING: VM: could not install the fsck.repair=yes grub drop-in — see $LOG_FILE" ;;
    esac
    case "$summary" in
        *"fsck-root=failed"*)
            log "WARNING: VM: the root filesystem check failed on this boot — sshd and Docker only came up by luck until it is repaired ($summary)"
            [ -n "$detail" ] && printf '%s\n' "$detail" >> "$LOG_FILE"
            case "$summary" in
                *"cmdline=yes"*)
                    log "WARNING: VM: fsck.repair=yes was active and still could not repair it — the VM disk needs manual attention" ;;
                *)
                    log "VM: the next VM boot will repair it (fsck.repair=yes)" ;;
            esac ;;
    esac
    return 0
}


# After recover_lima_vm has rebooted a wedged VM, keep the journal of the
# boot that wedged. The guest's journal is persistent, so `journalctl -b -1`
# is the only record of why sshd/Docker never came up — the 2026-10-11
# root cause (see ensure_vm_fsck_repair) sat in it for a month, found only
# by reading it by hand. One log line says what that boot did; the full
# journal lands next to the other logs, named so log rotation treats it
# like any other log type.
save_previous_boot_journal() {
    local who="$1" dir="$DATA_DIR/logs" day path n=1 rc=0
    local fsck=ok emergency=no sysinit=no ssh=no
    [ -n "$DATA_DIR" ] && mkdir -p "$dir" 2>/dev/null || return 0
    day=$(date +%Y-%m-%d)
    while [ -e "$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log" ] \
          || [ -e "$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log.gz" ]; do
        n=$((n + 1))
    done
    path="$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log"
    vm_shell_bounded 60 sudo journalctl -b -1 --no-pager -o short-monotonic > "$path" || rc=$?
    if [ "$rc" -ne 0 ] || [ ! -s "$path" ]; then
        rm -f "$path"
        log "$who: could not read the previous boot's journal from the VM (rc=$rc)"
        return 0
    fi
    grep -q "fsck failed with exit status" "$path" && fsck=failed
    grep -q "Started emergency.service" "$path" && emergency=yes
    grep -q "Reached target sysinit.target" "$path" && sysinit=yes
    grep -qE "Listening on ssh.socket|Started ssh.service" "$path" && ssh=yes
    log "$who: previous boot: fsck-root=$fsck emergency=$emergency sysinit=$sysinit ssh=$ssh — journal saved to $path"
    return 0
}


# One-time migration of the onion service key volume from its historical
# name, onionpress-arti-state (until 2026-09-25), to onionpress-onion-keys:
# ContainerManager.migrate_key_volume (Phase 4, #120; CLAUDE.md, "The key
# volume migration fails loudly"), run through the shared CLI. It runs
# before the first-run check, which keys off the NEW volume's existence, so
# its exit status is this function's and a 1 stops the start (the callers'
# `if ! migrate_key_volume`): an empty onionpress-onion-keys that starting
# tor would create passes for the migrated key on the next start. The log
# lines reach the log and the terminal as log's do; PIPESTATUS keeps the
# Python's status past tee.
migrate_key_volume() {
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" migrate-key-volume 2>&1 | tee -a "$LOG_FILE"
    return "${PIPESTATUS[0]}"
}

# Function to start containers
start_containers() {
    log "Starting OnionPress containers..."

    cd "$DOCKER_DIR"

    # Docker has to answer before anything asks whether a volume exists.
    # Those checks used to read "Docker is not up yet" as "no such volume",
    # and a missing key volume is the first-run signal: upgrading to 2.5.0
    # on 2026-09-30 while the Colima VM was still booting took the
    # first-run path instead of migrating the key volume.
    #
    # If Docker never answers but Lima still reports the VM Running, the VM
    # is in the wedge recover_lima_vm describes; the login-time start used
    # to give up here (2026-10-02) while the menubar Restart path already
    # knew how to recover. Both now share that recovery, tried once.
    if ! wait_for_docker_or_recover_vm 180 start; then
        log "ERROR: Docker daemon not ready after 180s (one Lima VM recovery attempted if it was Running); not starting"
        return 1
    fi

    # Docker answers, so the VM is up: make sure its next boot can repair
    # its own root filesystem instead of parking in emergency mode, and
    # say so when this boot's check failed (the wedge recover_lima_vm
    # exists for; see ensure_vm_fsck_repair). Best effort, never blocks.
    ensure_vm_fsck_repair

    # The rest of the start is onionpress.start's (#442.8): a pending key
    # import, the key volume's migration and the first run's key (each
    # before anything that could start Tor, each stopping the start when it
    # cannot be done), the core services (egress rules first), then Tor,
    # the plugins, provisioning, a backup's import, the image rebuild and
    # the site timezones. What fails without stopping the start is named in
    # the START SUMMARY through the errors file. The Cloudflare tunnel
    # comes after, in bash: one function, one rule on both platforms.
    local errors rc
    errors=$(start_errors_file)
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" start-containers \
        --docker-dir "$DOCKER_DIR" --bin-dir "$BIN_DIR" --scripts-dir "$SCRIPTS_DIR" \
        --themes-dir "$RESOURCES_DIR/themes" --plugins-dir "$RESOURCES_DIR/plugins" \
        --wp-port "$ONIONPRESS_WP_PORT" \
        ${errors:+--errors-file "$errors"} 2>&1 | tee -a "$LOG_FILE"
    rc=${PIPESTATUS[0]}
    note_start_errors "$errors"
    # 0: WordPress installed, 3: not yet (the setup window does it).
    local wp_installed=false
    case "$rc" in
        0) wp_installed=true ;;
        3) ;;
        *) return 1 ;;
    esac
    # Last: the clearnet sees the site once it is provisioned.
    start_cloudflare_tunnel "$wp_installed"
}

# Function to stop containers
stop_containers() {
    log "Stopping OnionPress containers..."
    # Stop farm containers first (they depend on the onionheaven container's DB)
    stop_onionheaven_farm
    cd "$DOCKER_DIR"
    # Stop all containers (including onionheaven), cloudflared too: always
    # with the override file, so a tunnel whose token was just removed still
    # goes down with the rest.
    # The status is compose's, not tee's or log's: `stop` and `quit` report
    # a failed stop (tests/test_launcher_dispatch_mac.py).
    local down_out down_rc=0
    down_out=$(docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml down 2>&1) || down_rc=$?
    [ -z "$down_out" ] || printf '%s\n' "$down_out" | tee -a "$LOG_FILE"
    if [ "$down_rc" -ne 0 ]; then
        log "ERROR: stopping the containers failed (compose down exited $down_rc)"
        return "$down_rc"
    fi
    log "Containers stopped"
}

# Reap lima's shared usernet daemon. It survives `colima stop` and leaks
# across restarts, holding the user-v2 network sockets — the likely cause of
# the next *cold* boot wedging (fresh VM's guest agent can't bring up
# networking -> gray icon; the same "5x in 30 days" wedge the restart path
# recovers via limactl stop -f). lima respawns it on the next start, so
# reaping at quit is safe
# and leaves a clean slate. Scoped by LIMA_HOME so multi-user installs don't
# touch each other; kill is per-user anyway. Mirrors _reap_lima_usernet in
# src/menubar.py for the path where the MenubarApp was SIGKILLed and never
# ran its own cleanup.
reap_lima_usernet() {
    local pidfile pid cmd
    for pidfile in "$LIMA_HOME"/_networks/*/usernet_*.pid; do
        [ -f "$pidfile" ] || continue
        pid=$(tr -d '[:space:]' < "$pidfile" 2>/dev/null)
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        cmd=$(ps -o command= -p "$pid" 2>/dev/null)
        case "$cmd" in
            *limactl*usernet*"$LIMA_HOME"*)
                log "quit: reaping leaked lima usernet daemon (pid $pid)"
                kill -TERM "$pid" 2>/dev/null || true
                ;;
        esac
    done
}



# Function to wait for services to be ready using active probing
# The wait after a start (issue #529): onionpress.start.wait_for_services
# over a start step's manager, every log line as this bash body's, the
# address into the shared volume and the healthcheck address into the data
# dir once both are ready. A timeout is a WARNING and names the step in
# the START SUMMARY (--errors-file); never a failed start. The site's
# address is read back afterwards by onion_address_line.
wait_for_services() {
    local errors
    errors=$(start_errors_file)
    bundled_python -m onionpress.cli --data-dir "$DATA_DIR" wait-for-services \
        --docker-dir "$DOCKER_DIR" --bin-dir "$BIN_DIR" --wp-port "$ONIONPRESS_WP_PORT" \
        ${errors:+--errors-file "$errors"} 2>&1 | tee -a "$LOG_FILE"
    note_start_errors "$errors"
    return 0
}

# The address line of a start: the address the tor container serves
# (`onionpress address`), or what to do for one.
onion_address_line() {
    local addr
    addr=$(bundled_python -m onionpress.cli --data-dir "$DATA_DIR" address 2>/dev/null) || addr=""
    echo "Onion address: ${addr:-none yet (set up the site from the menu bar)}"
}


# ===========================================================================
# CLI subcommands: setup, backup, restore, reset
# ===========================================================================

main() {
    launcher_environment
    case "${1:-start}" in
        start)
            # PID lock — prevent double-starting
            if [ -f "$PIDFILE" ]; then
                # If PID file is older than system boot, it's from a previous
                # boot session — definitely stale (PID may have been recycled)
                # "{ sec = 1790986968, usec = 370567 } ...": the first field (a
                # greedy `.*sec = ` matched usec, so this never fired).
                boot_sec=$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\),.*/\1/p')
                pid_mtime=$(stat -f %m "$PIDFILE" 2>/dev/null || echo 0)
                if [ -n "$boot_sec" ] && [ "$pid_mtime" -lt "$boot_sec" ] 2>/dev/null; then
                    log "Removing stale PID file from previous boot"
                    rm -f "$PIDFILE"
                else
                    old_pid=$(cat "$PIDFILE" 2>/dev/null)
                    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                        echo "OnionPress is already running (PID $old_pid)." >&2
                        osascript -e 'display dialog "OnionPress is already running." buttons {"OK"} default button "OK" with icon caution with title "OnionPress"' 2>/dev/null || true
                        exit 1
                    fi
                    # Stale pid file — process no longer running
                    rm -f "$PIDFILE"
                fi
            fi
            echo $$ > "$PIDFILE"
            # On exit: clean PID file and kill our background children.
            # The `|| true` is load-bearing: under `set -e`, a failing command
            # inside the EXIT trap becomes the SCRIPT's exit status. `kill`
            # fails when the jobs table is empty or only holds already-finished
            # jobs — so a fully successful `start` exited 1 whenever its
            # background children happened to finish first (race), which any
            # caller that checks the exit code (a managing app's stack installer) read
            # as a start failure.
            trap 'rm -f "$PIDFILE"; kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM HUP

            # Note: orphaned background processes from previous launches may exist
            # but are harmless (sleeping poll loops). The exit trap kills our own
            # children, and the PID lock prevents double-starting.

            # The OnionPress daemon (onionpress.daemon, issue #367): the
            # status loop, the dual probe, the heartbeat, the Settings
            # page's requests, the log captures, caffeinate, the extension
            # proxy, as a per-user launchd agent kept alive across crashes.
            # Started here so a headless start has it too; the menubar
            # starts it as well when it finds none.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" daemon start \
                --launcher "$SCRIPT_DIR/onionpress" >> "$LOG_FILE" 2>&1 \
                || log "WARNING: the OnionPress daemon could not be started (see $LOG_FILE)"

            # Detect container runtime (install if needed on first run)
            if ! RUNTIME=$(detect_container_runtime); then
                install_docker || exit $?
                # Re-detect after install
                RUNTIME=$(detect_container_runtime) || { log "ERROR: Container runtime still not available after install"; exit 1; }
            fi

            log "Detected container runtime: $RUNTIME"

            # Point DOCKER_HOST at our own VM's socket (never a foreign Colima)
            ensure_docker_socket || true

            # Setup database passwords (generates random passwords on first run)
            setup_db_passwords

            # Start containers
            start_containers

            # Actively poll until services are ready (replaces fixed sleep)
            wait_for_services

            log_start_summary

            log "OnionPress is running!"
            log "$(onion_address_line)"
            log "Local access: http://localhost:${ONIONPRESS_WP_PORT:-8080}"
            log "OnionPress is now running! Check the menu bar for status."
            ;;

        stop)
            # The daemon tells the hub /offline while the tor container is
            # still up (what the menubar's Stop did before stopping), then
            # the containers stop. The daemon itself keeps running.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" daemon offline >/dev/null 2>&1 || true
            setup_db_passwords
            stop_containers
            ;;

        quit)
            # CLI-equivalent of the menubar Quit button: take the app
            # fully off — daemon, MenubarApp, containers, Colima VM, PID
            # lock. The menubar's own Quit runs `quit --leave-menubar`
            # (it is the caller, and exits itself afterwards).
            # If the MenubarApp is alive, SIGTERM it: that fires
            # NSApplicationWillTerminateNotification → _handle_terminate
            # which runs the full cleanup synchronously. Then we run
            # the process-independent steps as belt-and-suspenders so
            # this command is always a reliable teardown for scripting,
            # CI, pre-update, and pre-scrub — even if the MenubarApp
            # was already gone or got SIGKILLed.

            FAILED_STEPS=""

            # The daemon first: it sends the hub /offline while the tor
            # container is still up (`daemon stop` marks the stop as a
            # quit), stops the extension proxy, caffeinate and the log
            # captures, and exits 0 so launchd leaves it down.
            # (`--no-offline`, from the menubar's update relaunch: the site
            # is coming right back, so the hub is not told /offline.)
            # Both flags are read wherever they stand; anything else is
            # ignored with a warning (a teardown never stops on a flag).
            QUIT_DAEMON_ARGS=""
            QUIT_LEAVE_MENUBAR=no
            for _arg in "${@:2}"; do
                case "$_arg" in
                    --no-offline) QUIT_DAEMON_ARGS="--no-offline" ;;
                    --leave-menubar) QUIT_LEAVE_MENUBAR=yes ;;
                    *) echo "onionpress quit: ignoring unknown option $_arg" >&2 ;;
                esac
            done
            log "quit: stopping the OnionPress daemon"
            if ! bundled_python -m onionpress.cli --data-dir "$DATA_DIR" daemon stop $QUIT_DAEMON_ARGS >> "$LOG_FILE" 2>&1; then
                FAILED_STEPS="$FAILED_STEPS daemon"
            fi

            # Capture MenubarApp PID. Prefer the PID file
            # (authoritative), but fall back to pgrep — the PID file
            # can be missing after a prior unclean shutdown, manual rm,
            # or a MenubarApp code path that never wrote it, and we
            # still need to find and stop the running MenubarApp in
            # that case. `-u $(whoami)` restricts to this user's
            # processes per the multi-user rule in CLAUDE.md.
            MENUBAR_PID=""
            if [ "$QUIT_LEAVE_MENUBAR" = yes ]; then
                log "quit: run from the menubar (it quits itself)"
            elif [ -f "$DATA_DIR/menubar.pid" ]; then
                # The MenubarApp's own pid file (src/menubar.py writes it;
                # $PIDFILE is the start lock, never the app's pid).
                MENUBAR_PID=$(cat "$DATA_DIR/menubar.pid" 2>/dev/null | tr -d '[:space:]')
            fi
            if [ "$QUIT_LEAVE_MENUBAR" != yes ] && { [ -z "$MENUBAR_PID" ] || ! kill -0 "$MENUBAR_PID" 2>/dev/null; }; then
                # Match THIS bundle's py2app-frozen MenubarApp binary path,
                # anchored so only a command line that IS that executable
                # matches — not a shell, grep or tail that merely names the
                # path in its arguments, and not another bundle's app (a
                # test copy beside the installed one).
                MENUBAR_PID=$(pgrep -u "$(whoami)" -f "^$RESOURCES_DIR/MenubarApp/Contents/MacOS/OnionPress( |$)" 2>/dev/null | head -1)
            fi

            if [ -n "$MENUBAR_PID" ] && kill -0 "$MENUBAR_PID" 2>/dev/null; then
                log "quit: SIGTERM to MenubarApp (pid $MENUBAR_PID)"
                kill -TERM "$MENUBAR_PID" 2>/dev/null || true
                # Wait up to 60s for graceful exit. _handle_terminate
                # runs ~90s in the worst case (30s launcher stop + 60s
                # colima stop) but in practice exits well before that.
                # We need to stay under ~90s total or we SIGKILL mid-
                # cleanup and leave things wedged.
                WAITED=0
                while kill -0 "$MENUBAR_PID" 2>/dev/null && [ "$WAITED" -lt 120 ]; do
                    sleep 0.5
                    WAITED=$((WAITED + 1))
                done
                if kill -0 "$MENUBAR_PID" 2>/dev/null; then
                    log "quit: MenubarApp still alive after 60s, sending SIGKILL"
                    kill -9 "$MENUBAR_PID" 2>/dev/null || true
                    FAILED_STEPS="$FAILED_STEPS menubar-app"
                fi
            else
                log "quit: MenubarApp not running"
            fi

            # Now do the process-independent cleanup. These steps run
            # whether the MenubarApp quit cleanly or not — belt and
            # suspenders.
            log "quit: stopping containers"
            setup_db_passwords
            if ! stop_containers; then
                FAILED_STEPS="$FAILED_STEPS containers"
            fi

            log "quit: stopping Colima VM"
            COLIMA_BIN="$BIN_DIR/colima"
            if [ -x "$COLIMA_BIN" ]; then
                # The three env vars are already exported at script-top
                # (lines 144-146) so this invocation uses the OnionPress-
                # specific Colima profile.
                if ! "$COLIMA_BIN" stop >> "$LOG_FILE" 2>&1; then
                    FAILED_STEPS="$FAILED_STEPS colima"
                fi
            else
                log "quit: colima binary not found at $COLIMA_BIN — skipping"
                FAILED_STEPS="$FAILED_STEPS colima-missing"
            fi

            # Leave a clean slate: lima's usernet daemon outlives `colima
            # stop` and leaking it tends to wedge the next cold boot.
            reap_lima_usernet

            # Remove the PID file, but only if it still matches the PID
            # we saw at the top (mirrors _remove_pid_file safety in
            # src/menubar.py:1349-1357 — avoids nuking a freshly-started
            # OnionPress instance that raced in between).
            if [ -f "$PIDFILE" ]; then
                STORED_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
                if [ -z "$MENUBAR_PID" ] || [ "$STORED_PID" = "$MENUBAR_PID" ]; then
                    rm -f "$PIDFILE"
                fi
            fi

            if [ -n "$FAILED_STEPS" ]; then
                log "quit: completed with issues in:$FAILED_STEPS"
                echo "onionpress quit: some steps failed:$FAILED_STEPS" >&2
                exit 1
            fi
            log "quit: clean"
            ;;

        restart)
            # Adaptive restart: if Docker is reachable, just bounce the
            # containers (fast, ~30s). If it isn't, the Lima VM is most
            # likely in the wedged "Running but SSH refused" state that
            # occasionally happens after long uptime / sleep — force-
            # stop and restart the VM first, then proceed. This turns
            # the menubar "Restart" item into a reliable recovery for
            # the wedge we've seen 5× in 30 days on a single machine.
            # The same recovery runs from the start path when its Docker
            # wait times out (see wait_for_docker_or_recover_vm).
            if ! docker info >/dev/null 2>&1; then
                if docker_socket_forward_is_foreign && lima_vm_running; then
                    recover_docker_socket_forward restart || exit 1
                else
                    recover_lima_vm restart || exit 1
                fi
                log "restart: resuming normal restart"
            fi
            setup_db_passwords
            stop_containers || log "WARNING: restart: the stop failed; starting the containers anyway"
            start_containers
            wait_for_services
            # The same summary a start ends with (issue #507).
            log_start_summary
            ;;

        status)
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" status
            ;;

        address)
            # The address, its shareable URL (--url) or that URL on the
            # clipboard (--copy): onionpress.app_commands (issue #382).
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" address "${@:2}"
            ;;

        version|check-reachability|check-docker|open|onionname)
            # The app's remaining functions as subcommands (issue #382):
            # the About box's version, the Settings page's reachability
            # test through the onionheaven Tor client, whether Docker and
            # Compose are new enough, the menu's Open Local Site / Open in
            # Tor Browser / Settings (logged in), and the onionname (show
            # | set NAME).
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" "$1" "${@:2}"
            ;;

        start-tor)
            # The daemon's, once setup has installed WordPress (Tor is not
            # started before the first run's setup on a Mac): the key
            # volume migration, then tor alone (onionpress start-tor,
            # ContainerManager.start_tor, never before its key volume is
            # in place). Its exit is this one's.
            setup_db_passwords
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" start-tor \
                --docker-dir "$DOCKER_DIR" --bin-dir "$BIN_DIR" 2>&1 | tee -a "$LOG_FILE"
            exit "${PIPESTATUS[0]}"
            ;;

        import-key)
            # The stop inside runs compose: with the DB passwords, or it
            # warns about every missing one (issue #507).
            setup_db_passwords
            import_key "${@:2}"
            ;;

        logs)
            # Bare: the container logs. --app, --launcher or --web (-n N,
            # -f): the end of that OnionPress log (issue #382).
            if [ $# -gt 1 ]; then
                bundled_python -m onionpress.cli --data-dir "$DATA_DIR" logs "${@:2}"
            else
                cd "$DOCKER_DIR"
                docker compose logs -f
            fi
            ;;

        launch)
            # Full app launch — opens the OnionPress.app bundle, which runs the
            # launcher script (boots Colima VM, starts MenubarApp, starts containers).
            # Safe to call when already running (launcher detects and exits).
            APP_BUNDLE="$(dirname "$APP_DIR")"
            open "$APP_BUNDLE"
            ;;

        upload-analytics)
            # Upload the diagnostic logs to OnionHome now (Share Now from
            # the command line): one implementation for both platforms,
            # onionpress.analytics_sharing.request_upload (issue #351). It
            # refuses while sharing is off or the daemon is not running,
            # else leaves the marker the daemon's status loop takes.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" upload-analytics
            ;;

        validate-oh-address)
            # The Settings dialog's hub check (onionheaven.validate_hub_address,
            # issue #529): JSON on stdout, exit 1 for a malformed or own address.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" validate-oh-address "${2:-}"
            ;;

        config)
            # Read and change settings: config get KEY | set KEY VALUE |
            # unset KEY | list [--json]. One implementation for both
            # platforms (src/onionpress/config.py, issue #365); the
            # menubar's Settings dialog writes through it too.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" config "${@:2}"
            ;;

        onionheaven)
            # Opt in to / out of OnionHeaven: enable | disable | status
            # [--json]. Delegated to src/onionpress/onionheaven.py.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" onionheaven "${@:2}"
            ;;

        get)
            # Fetch a URL over Tor and print the body — for checking whether
            # a .onion is reachable. Delegated to src/onionpress/cli.py
            # cmd_get, which runs curl inside the tor container (a SOCKS
            # connection from the host does not work through Colima's port
            # forwarding). "${@:2}" forwards the URL and flags verbatim.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" get "${@:2}"
            ;;

        provision-post-install)
            # Delegated to src/onionpress/multisite.py:provision_post_install
            # so Mac and Linux share one implementation. The bash sub-
            # functions (ensure_multisite, install_multisite_domain_map,
            # etc.) still exist below and are still called by start_
            # containers — only this subcommand entry point goes through
            # Python for now.
            # Every setup window's install ends here
            # (setup_logic.install_fresh_wordpress): the tunnel starts now,
            # when there is a token (start_cloudflare_tunnel), not at the
            # next start. The status stays provisioning's.
            local ppi_rc=0
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" provision-post-install \
                --themes-dir "$RESOURCES_DIR/themes" \
                --plugins-dir "$RESOURCES_DIR/plugins" || ppi_rc=$?
            if wp_is_installed; then
                start_cloudflare_tunnel true
            fi
            exit "$ppi_rc"
            ;;

        setup-bundled-plugins)
            # Configure and activate Cache Enabler and the Link Fixer
            # (setup_bundled_plugins). setup_logic.install_fresh_wordpress
            # starts this in the background once setup has made the user's
            # site, so a new install has them without waiting for a restart.
            setup_bundled_plugins
            ;;

        setup)
            # Usage: onionpress setup [--user USER] [--pass PASS] [--title TITLE]
            #        onionpress setup --from-backup <backup.zip>   (password: ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt)
            # The install the setup window makes (run_setup); a backup's
            # setup is the restore (issue #509: the backup's site, never a
            # fresh one under temporary credentials), then a restart so
            # the start provisions the restored site.
            setup_db_passwords
            cd "$DOCKER_DIR"
            shift  # remove "setup" from args
            local setup_rc=0
            run_setup "$@" || setup_rc=$?
            case "$setup_rc" in
                0)
                    # The site is set up: the tunnel, if there is a token.
                    start_cloudflare_tunnel true
                    ;;
                2) exit 0 ;;
                10)
                    stop_containers || log "WARNING: setup: the stop failed; starting the containers anyway"
                    start_containers
                    wait_for_services
                    ;;
                *) exit 1 ;;
            esac
            echo ""
            echo "  Setup complete! Your site is now running."
            echo "  Admin panel: http://localhost:${ONIONPRESS_WP_PORT}/wp-admin"
            ;;

        backup)
            # backup [-o|--output <path>] [--user <login>]. The Python CLI
            # reads the password (must match a WordPress administrator) from
            # ONIONPRESS_BACKUP_PASSWORD, stdin or a no-echo prompt; the old
            # `backup <password> [output_path]` is refused (issue #504).
            shift  # drop "backup"
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" backup "$@"
            ;;

        restore)
            # restore <backup_file.zip> [--check] [--json] [--confirmed WHAT];
            # the password comes from read_backup_password and goes on to
            # Python in the environment. The old `restore <password>
            # <backup_file.zip>` is refused. The flags are the check/confirm
            # protocol's (onionpress.confirm): --check answers what the
            # backup is, or {"ask": "password"} without one.
            setup_db_passwords
            local restore_legacy_pass="" restore_path="" restore_check=no restore_what=no
            restore_flags=()
            restore_pos=()
            for restore_arg in "${@:2}"; do
                if [ "$restore_what" = yes ]; then
                    restore_flags+=("$restore_arg")
                    restore_what=no
                    continue
                fi
                case "$restore_arg" in
                    --check) restore_check=yes; restore_flags+=("$restore_arg") ;;
                    --json) restore_flags+=("$restore_arg") ;;
                    --confirmed) restore_what=yes; restore_flags+=("$restore_arg") ;;
                    --confirmed=?*) restore_flags+=("$restore_arg") ;;
                    # An unknown flag must not become the legacy password.
                    -?*) echo "ERROR: restore: unknown option $restore_arg" >&2; exit 2 ;;
                    *) restore_pos+=("$restore_arg") ;;
                esac
            done
            if [ "$restore_what" = yes ]; then
                echo "ERROR: restore: --confirmed needs a value" >&2
                exit 2
            fi
            if [ "${#restore_pos[@]}" -gt 2 ]; then
                echo "ERROR: restore: too many arguments" >&2
                exit 2
            fi
            restore_path="${restore_pos[0]:-}"
            if [ -n "${restore_pos[1]:-}" ]; then
                restore_legacy_pass="${restore_pos[0]}"
                restore_path="${restore_pos[1]}"
            fi
            if [ -z "$restore_path" ]; then
                echo "Usage: $0 restore <backup_file.zip> [--check] [--json] [--confirmed WHAT]"
                echo "Restores from an OnionPress backup. Containers must be running."
                echo "The password is read from ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt."
                echo "An OnionHeaven hub's sealed registry and keys need its recovery key:"
                echo "ONIONPRESS_HUB_RECOVERY_KEY, or a prompt (see: $0 hub-recovery-key)."
                exit 1
            fi
            read_backup_password "$restore_legacy_pass"
            if [ -z "$BACKUP_PASS" ] && [ "$restore_check" != yes ]; then
                echo "ERROR: Password is required." >&2
                exit 1
            fi
            if [ "$restore_check" = yes ]; then
                # Changes nothing: the CLI's answer is the whole result.
                ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" bundled_python -m onionpress.cli --data-dir "$DATA_DIR" restore "$restore_path" "${restore_flags[@]}"
                exit $?
            fi
            # install-from-backup: the Python CLI tears the install down and
            # rebuilds it from the backup (seeded key + imported DB/content),
            # replacing the old in-place overwrite + key-volume swap churn
            # (no .import-key-pending, no manual multisite/Tor dance).
            # The exit status is the caller's only sign of a refused or
            # failed restore (the tray and the menubar check it).
            if ! ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" bundled_python -m onionpress.cli --data-dir "$DATA_DIR" restore "$restore_path" "${restore_flags[@]}"; then
                echo "ERROR: Restore failed — see $LOG_FILE" >&2
                exit 1
            fi
            echo "Done! OnionPress rebuilt from backup."
            ;;

        hub-recovery-key)
            # An OnionHeaven hub's backup recovery key: create, show, check,
            # restore (src/onionpress/cli.py, hub_backup.py). The hub's
            # registry and registrants' keys in its backups are sealed to
            # it. The private half is printed once by create and otherwise
            # read from ONIONPRESS_HUB_RECOVERY_KEY, stdin or a prompt,
            # never from argv. The public half goes to
            # $DATA_DIR/hub-backup-recovery.pub, outside the VM's mounts.
            ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" \
                bundled_python -m onionpress.cli --data-dir "$DATA_DIR" hub-recovery-key "${@:2}"
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config,
            # secrets (onionpress.cli reset, issue #366: it asks first, with
            # --check --json / --confirmed for a UI and --yes for scripts,
            # and asks the OnionHeaven hubs that may hold the key to delete
            # it while the key can still sign). Start OnionPress again for
            # fresh containers. ONIONPRESS_YES=true still means --yes.
            setup_db_passwords 2>/dev/null || true
            reset_args=("${@:2}")
            [ "${ONIONPRESS_YES:-}" != "true" ] || reset_args+=(--yes)
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" reset "${reset_args[@]}"
            ;;

        scrub)
            # Full lifecycle test — backup, reset in place, restore, verify
            # (onionpress.scrub's Mac cycle, issue #529). The WordPress
            # admin password comes from ONIONPRESS_BACKUP_PASSWORD or a
            # prompt; one on argv is refused (#504). -y skips the question.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" scrub "${@:2}"
            ;;

        update)
            # A new release from GitHub, installed by the staged bundle swap
            # (onionpress.cli update -> updater.download_and_install: the new
            # bundle is copied beside the old one and renamed into place
            # last, since this very process runs out of the one being
            # replaced; the menubar relaunches after). --check only reports
            # (--json for the menubar), --yes skips the prompt.
            ONIONPRESS_APP_PATH="$(dirname "$APP_DIR")" \
                bundled_python -m onionpress.cli --data-dir "$DATA_DIR" update "${@:2}"
            ;;

        uninstall)
            # Remove OnionPress (onionpress.uninstall, issue #366): asks
            # first (--check --json and --confirmed for the menubar, or at
            # this terminal), takes the key back off the OnionHeaven hubs
            # that may hold it, stops OnionPress, deletes the Colima VM, the
            # login item and ~/.onionpress. The app bundle is yours to move
            # to the Trash.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" uninstall "${@:2}"
            ;;

        handle-action)
            # The WordPress Settings page's requests, handled once for both
            # platforms (onionpress.handle_action, issue #366): the daemon
            # runs this on its status loop (on Linux too, issue #407).
            # The actions run through this launcher: start, restart, stop,
            # apply-config, import-key, settings-page-backup,
            # settings-page-restore, update. A key import or a restore of
            # another address stops at {"confirm": "address-change"} until
            # the menubar asks the person at this Mac and runs it again with
            # --confirmed address-change (or --cancel).
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" handle-action --launcher "$SCRIPT_DIR/onionpress" "${@:2}"
            ;;

        daemon)
            # The Mac's long-running loops as a per-user launchd agent
            # (onionpress.daemon, issue #367): `daemon start|stop|status|
            # offline [--json]`, or `daemon` (run in the foreground: what
            # the agent's plist runs, with this script's environment).
            # exec, not a child: launchd's pid is then the daemon itself, so
            # its TERM (bootout, `daemon stop`) reaches the Python process
            # (AbandonProcessGroup leaves children alone on purpose).
            PYTHONHOME="$_BUNDLED_PYTHONHOME" exec "$_BUNDLED_PYTHON_BIN" -m onionpress.cli --data-dir "$DATA_DIR" daemon --launcher "$SCRIPT_DIR/onionpress" "${@:2}"
            ;;

        apply-config)
            # The Settings page's config-updates.json, through the allowlist
            # (config.SETTINGS_PAGE_KEYS); what the running menubar owes is
            # left in .config-changed for it.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" apply-config
            ;;

        settings-page-backup|settings-page-restore)
            # The Settings page's own backup and restore, run by
            # handle-action (the password in ONIONPRESS_BACKUP_PASSWORD):
            # for WordPress, so without the hub data, the host's secrets or
            # the onion service key; the restore in place
            # (backup.restore_from_backup with through_wordpress=True), never
            # the install-from-backup `restore` (issue #341).
            setup_db_passwords
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" "$1" "${@:2}"
            ;;

        prepare-restore)
            # The welcome screen's Restore from backup: stage the backup for
            # the first start, which imports it (the password in
            # ONIONPRESS_BACKUP_PASSWORD).
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" prepare-restore "${@:2}"
            ;;

        help|-h|--help)
            cat <<EOF
OnionPress - WordPress + Tor Onion Service

Usage: $0 <command> [args]

User commands:
  start         Start WordPress and Tor containers
  stop          Stop all containers (leaves the daemon, MenubarApp + VM running)
  quit          Fully shut down: daemon + containers + Colima VM + MenubarApp
                (equivalent of clicking Quit in the menubar)
  daemon        The OnionPress daemon (status loop, probe, heartbeat, the
                Settings page's requests, log captures, the extension
                proxy), a launchd agent: daemon start | stop | status [--json]
  restart       Restart all containers
  status        Show container status
  version       Show the OnionPress version (--json)
  address       Show your .onion address (--url: the site's shareable URL
                with its /<onionname>/ path; --copy: put it on the clipboard)
  open          Open the site in a browser, logged in: open site | admin |
                settings | onion (the .onion address, in Tor Browser)
  logs          Tail container logs; logs --app | --launcher | --web prints
                the end of that OnionPress log (-n N lines, -f to follow)
  check-reachability
                Test the site through the independent onionheaven Tor
                client, as the Settings page does (--json)
  check-docker  Say whether Docker Engine and Compose are new enough for
                OnionPress (--json)
  get           Fetch a URL over Tor and print the body (is this .onion up?)
                (-i to include response headers, --max-time SECONDS)
  update        Check GitHub for a new release and install it
                (--check to only check, -y to skip prompt, --json)
  backup        Create an encrypted backup zip
  restore       Restore from an encrypted backup zip
  setup         Run the first-time WordPress setup
  import-key    Import an existing onion service key (base32, - for stdin,
                or --file <hs_ed25519_secret_key>)
  onionname     The site's onionname: onionname show | set NAME [--json]
  config        Read and change settings: config get KEY | set KEY VALUE |
                unset KEY | list [--json]  (a secret: set KEY - with the
                value on stdin; run 'config list --help' for the keys)
  onionheaven   Keep the site reachable through OnionHeaven:
                onionheaven enable | disable | status [--json] |
                overview [--json]
  hub-recovery-key
                An OnionHeaven hub's backup recovery key
                (create, show, check, restore)
  uninstall     Remove OnionPress: the onion address and key, the site,
                the container VM and ~/.onionpress (asks first; then move
                OnionPress.app to the Trash)
  reset         Wipe everything and start over (asks first)

Destructive commands ask before acting. A program runs them as
  <command> --check --json   (answers {"ok": true}, {"confirm": "<what>", ...}
                              or {"error": ...}, changing nothing)
  <command> --confirmed <what>
(or sets ONIONPRESS_CONFIRMED); without the confirmation they refuse.

Advanced / internal (used by the menubar app or scripts):
  start-tor, launch, upload-analytics, validate-oh-address, scrub,
  daemon offline (the daemon tells the hub /offline before a stop),
  handle-action (the WordPress Settings page's requests),
  apply-config (its saved settings),
  settings-page-backup, settings-page-restore (its backup and restore),
  prepare-restore (the welcome screen's restore from a backup)

Examples:
  $0 status
  $0 address --url
  $0 open site
  $0 logs --web -n 50
  $0 check-reachability
  $0 get http://<some-address>.onion/
  $0 update --check
  $0 update -y
  $0 uninstall --check --json
  $0 config set PREVENT_SLEEP never
  $0 onionheaven status
  $0 backup [-o <output_path>]
  $0 restore <backup.zip>

Your WordPress site will be available at:
  - Via Tor: http://[your-onion-address].onion
  - Locally (testing): http://localhost:8080

EOF
            exit 0
            ;;

        *)
            # Every other verb is onionpress.cli's: a subcommand with no
            # case of its own reaches it here (ensure-archive-s3-keys,
            # check-for-update, ...), and one the CLI does not have either
            # gets the CLI's usage and exit status.
            bundled_python -m onionpress.cli --data-dir "$DATA_DIR" "$@"
            ;;
    esac
}

main "$@"
