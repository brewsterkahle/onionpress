#!/bin/bash

# OnionPress launcher script
# This script manages the WordPress + Tor onion service containers

set -e

# An OnionHeaven hub's backup recovery key, when the app's Restore... (or the
# operator) passes one in the environment: taken out of it at once and handed
# only to the commands that use it (restore, hub-recovery-key), so that no
# other child of this script inherits it.
_HUB_RECOVERY_KEY="${ONIONPRESS_HUB_RECOVERY_KEY:-}"
unset ONIONPRESS_HUB_RECOVERY_KEY

# Clear py2app PYTHONPATH so subprocess python calls are not confused.
unset PYTHONPATH

# Ensure we run natively on Apple Silicon (not under Rosetta).
# Universal binaries inherit the parent's architecture, so if this script
# was started under Rosetta we must re-exec to get native arm64 execution.
if sysctl hw.optional.arm64 2>/dev/null | grep -q ": 1" && [ "$(uname -m)" = "x86_64" ]; then
    exec arch -arm64 "$0" "$@"
fi

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_DIR="$(dirname "$SCRIPT_DIR")"
RESOURCES_DIR="$APP_DIR/Resources"
DOCKER_DIR="$RESOURCES_DIR/docker"
SCRIPTS_DIR="$RESOURCES_DIR/scripts"
DATA_DIR="$HOME/.onionpress"
DOCUMENTS_DIR="$HOME/OnionPress"
OLD_DOCUMENTS_DIR="$HOME/Documents/OnionPress"

# DOCUMENTS_DIR lives at the top of $HOME (not under ~/Documents/) so the
# Apple Virtualization framework can mount it into the Colima VM without
# triggering the TCC "Documents Folder" grant. The grant is tied to bundle
# identity; every rebuild-menubar.sh modifies the adhoc-signed bundle and
# silently revokes the grant, causing the next VM start to fail. Top-of-home
# is not TCC-protected. See issue #239.
BIN_DIR="$RESOURCES_DIR/bin"
COLIMA_HOME="$DATA_DIR/colima"

# Use the Python bundled inside the py2app MenubarApp so we never depend on
# system Python (which may not exist — macOS does not ship a usable python3).
# PYTHONHOME is set inline per-call (not exported) to avoid polluting the
# environment for docker, docker compose, and other child processes.
_BUNDLED_PYTHON_BIN="$RESOURCES_DIR/MenubarApp/Contents/MacOS/python"
_BUNDLED_PYTHONHOME="$RESOURCES_DIR/MenubarApp/Contents/Resources"
bundled_python() { PYTHONHOME="$_BUNDLED_PYTHONHOME" "$_BUNDLED_PYTHON_BIN" "$@"; }

# True only for a well-formed v3 onion address: 56 lowercase base32
# characters, then ".onion", and nothing else (no newline, no "/"). The
# rule of key_manager.is_valid_onion_address; a test keeps the two
# together. The letters are spelled out because a range like a-z can take
# in other characters in some locales.
is_onion_address() {
    [[ "$1" =~ ^[abcdefghijklmnopqrstuvwxyz234567]{56}\.onion$ ]]
}

# The imported or generated key's directory under vanity-keys/: the first
# one whose name is a whole onion address (is_onion_address), not merely
# "*.onion". Its name is taken for the address and the directory is
# bind-mounted into a container. Prints nothing and fails if there is none.
vanity_key_dir() {
    local d
    for d in "$DATA_DIR/shared/vanity-keys"/*.onion; do
        if [ -d "$d" ] && [ ! -L "$d" ] && is_onion_address "$(basename "$d")"; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Hand a file to the WordPress container, written as www-data: stdin goes to
# $1, mode ${2:-600} once in place (a temporary file beside it, renamed
# over it). Never as root: www-data owns /var/lib/onionpress and the web
# root, and root's `cat >` or docker cp followed a link planted at the name
# to any file in the container. The script is
# onionpress.wp_files.PUT_FILE_SCRIPT; a test keeps the copies equal.
wp_put() {
    docker exec -i -u www-data onionpress-wordpress \
        sh -c 't=$(mktemp "$1.XXXXXX") || exit 1; if cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"; then exit 0; fi; rm -f "$t"; exit 1' \
        sh "$1" "${2:-600}"
}

# Before this install forgets its onion service key (reset, key import, a
# restore to another address): ask every OnionHeaven hub that may hold a
# copy to delete it, while the key is still here to sign the request.
# onionpress.cli onionheaven-unregister sends the signed /unregister for
# the whole address to the hub the registration record names, through the
# tor container (which must be running), and says what it did; with nothing
# registered it does and prints nothing. The menubar's heartbeats are held
# off meanwhile (a lock and a hold in the record), so none puts the key back.
# Usage: onionheaven_release <reason> [<address whose key stays>]. Sets
# ONIONHEAVEN_RELEASE_RC (0 nothing left on a hub, 1 something the user
# could still take back, 3 something nothing here can take back, other:
# the command failed) and returns 1 only when the user chose to stop at
# the question.
onionheaven_release() {
    local answer=""
    ONIONHEAVEN_RELEASE_RC=0
    bundled_python -m onionpress.cli onionheaven-unregister --reason "$1" \
        ${2:+--keep-address "$2"} || ONIONHEAVEN_RELEASE_RC=$?
    # 0 and 3: nothing the user could still do. Anything else (1, or a
    # failure of the command itself) may leave a key on a hub: ask.
    case "$ONIONHEAVEN_RELEASE_RC" in 0|3) return 0 ;; esac
    [ "$ONIONPRESS_YES" = "true" ] && return 0
    printf "Continue anyway? The hub keeps the key listed above. [y/N] "
    read -r answer || true
    [ "$answer" = "y" ] || [ "$answer" = "Y" ]
}

# Run wp-cli in the WordPress container as www-data: wp_cli <args...>, and
# wp_cli_in for what wp-cli reads from stdin (docker exec -i). wp-cli loads
# WordPress (wp-config.php, mu-plugins, plugins, themes), every file of it
# www-data's to write, so run as root a plugin bug became root in the
# container. No --allow-root: wp-cli refuses to run as root. The command is
# onionpress.wp_files.wp_cli_args; a test keeps the copies equal.
wp_cli() {
    docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}
wp_cli_in() {
    docker exec -i -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}

# Copy the tor hostname into the shared volume so WP code (theme,
# mu-plugins, REST endpoints) can answer "what's my .onion?" without
# parsing Host headers. Read from the tor container, written by www-data:
# root's cp in the tor container followed a link www-data can plant at
# onion_address to any file there (its key).
write_shared_onion_address() {
    local addr
    addr=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
    is_onion_address "$addr" || return 1
    printf '%s\n' "$addr" | wp_put /var/lib/onionpress/onion_address 644
}

mkdir -p "$DATA_DIR"

# One-time host-side migration: ~/Documents/OnionPress → ~/OnionPress.
# Walks the source tree recursively so an empty pre-existing subdir in
# the destination (e.g. left over from a previous launcher pass) doesn't
# block the mv. Marker is set only when the old dir is actually gone,
# so a TCC-denied attempt retries on next launch. See issue #239.
#
# REMOVE-AFTER 2026-08-01: by then every active install will have
# migrated. Delete this block, _op_migrate_tree, and OLD_DOCUMENTS_DIR.
_op_migrate_tree() {
    local src="$1" dst="$2"
    [ -d "$src" ] || return 0
    mkdir -p "$dst"
    shopt -s dotglob nullglob 2>/dev/null || true
    local entry base target
    for entry in "$src"/*; do
        [ -e "$entry" ] || continue
        base=$(basename "$entry")
        target="$dst/$base"
        if [ -d "$entry" ] && [ -d "$target" ]; then
            _op_migrate_tree "$entry" "$target"
            rmdir "$entry" 2>/dev/null || true
        else
            mv -n "$entry" "$target" 2>/dev/null || true
        fi
    done
}

if ! grep -qE '^PATH_MIGRATION_2026_05=done$' "$DATA_DIR/config" 2>/dev/null; then
    if [ -d "$OLD_DOCUMENTS_DIR" ]; then
        # Skip leftover breadcrumb from earlier attempts so it doesn't
        # follow the user into the new dir.
        rm -f "$OLD_DOCUMENTS_DIR/MOVED.txt" 2>/dev/null || true
        _op_migrate_tree "$OLD_DOCUMENTS_DIR" "$DOCUMENTS_DIR"
        rmdir "$OLD_DOCUMENTS_DIR" 2>/dev/null || true
        if [ -d "$OLD_DOCUMENTS_DIR" ]; then
            echo "OnionPress content moved to $DOCUMENTS_DIR" \
                > "$OLD_DOCUMENTS_DIR/MOVED.txt" 2>/dev/null || true
        else
            printf 'PATH_MIGRATION_2026_05=done\n' >> "$DATA_DIR/config" 2>/dev/null || true
        fi
    else
        mkdir -p "$DOCUMENTS_DIR"
        printf 'PATH_MIGRATION_2026_05=done\n' >> "$DATA_DIR/config" 2>/dev/null || true
    fi
fi

# Idempotent subtree setup. No TCC concerns now that DOCUMENTS_DIR is at
# the top of $HOME — call eagerly at startup.
ensure_documents_dir() {
    mkdir -p "$DOCUMENTS_DIR/backups"
    mkdir -p "$DOCUMENTS_DIR/Creations/My Creations"
    # Social Archives holds source ZIPs from the Twitter/Mastodon/etc.
    # importers. Kept outside Creations so users don't see imported-
    # source clutter alongside their own original creations. Sentinel file
    # lets the WP-side importer plugin distinguish the real mount from
    # compose's /tmp fallback.
    mkdir -p "$DOCUMENTS_DIR/Social Archives"
    touch "$DOCUMENTS_DIR/Social Archives/.onionpress-activated"
}
ensure_documents_dir

# Emit `--mount $DOCUMENTS_DIR:w`. Always present now (the dir is
# created at startup) — but we still gate on existence as defensive
# protection against a hand-deleted directory mid-session.
docs_mount_args() {
    if [ -d "$DOCUMENTS_DIR" ]; then
        printf -- '--mount %s:w' "$DOCUMENTS_DIR"
    fi
}

# Log file + log() must be defined before any caller (e.g. detect_port_offset),
# otherwise bash falls through to macOS /usr/bin/log and prints help.
LOG_FILE="$DATA_DIR/onionpress.log"
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# One line naming the components that failed during this start, so "did
# everything come up?" is a single grep rather than a read of the whole
# log. Each guarded step appends its name to START_ERRORS.
START_ERRORS=""
log_start_summary() {
    if [ -n "${START_ERRORS:-}" ]; then
        log "START SUMMARY: failed components:${START_ERRORS} — see the ERROR/WARNING lines above in $LOG_FILE"
    else
        log "START SUMMARY: all components started"
    fi
}

# Per-user lock file to prevent the same user from double-starting.
# Only checked for 'start' — other commands (status, get, launch, etc.) are safe.
PIDFILE="$DATA_DIR/onionpress.pid"

# Detect architecture (use sysctl to get actual hardware, not process architecture)
if sysctl hw.optional.arm64 2>/dev/null | grep -q ": 1"; then
    VM_ARCH="aarch64"
elif [ "$(uname -m)" = "x86_64" ]; then
    VM_ARCH="x86_64"
fi

# Create Docker config without credential store (avoids docker-credential-osxkeychain errors)
mkdir -p "$DATA_DIR/docker-config"
if [ ! -f "$DATA_DIR/docker-config/config.json" ]; then
    cat > "$DATA_DIR/docker-config/config.json" <<'EOFCONFIG'
{
	"auths": {},
	"currentContext": "colima"
}
EOFCONFIG
fi

# Install docker-compose plugin: prefer bundled, fall back to system
mkdir -p "$DATA_DIR/docker-config/cli-plugins"
if [ -f "$BIN_DIR/docker-compose" ]; then
    ln -sf "$BIN_DIR/docker-compose" "$DATA_DIR/docker-config/cli-plugins/docker-compose"
elif [ -L "$HOME/.docker/cli-plugins/docker-compose" ] && [ ! -e "$DATA_DIR/docker-config/cli-plugins/docker-compose" ]; then
    ln -sf "$HOME/.docker/cli-plugins/docker-compose" "$DATA_DIR/docker-config/cli-plugins/docker-compose"
fi

# Create default config if it doesn't exist
if [ ! -f "$DATA_DIR/config" ]; then
    if [ -f "$RESOURCES_DIR/config-template.txt" ]; then
        cp "$RESOURCES_DIR/config-template.txt" "$DATA_DIR/config"
    else
        cat > "$DATA_DIR/config" <<EOF
ADDRESS_PREFIX=op2
INSTALL_IA_PLUGIN=yes
UPDATE_ON_LAUNCH=no
LAUNCH_ON_LOGIN=no
EOF
    fi
fi

# Prefer bundled binaries
export PATH="$BIN_DIR:$PATH"
export PYTHONDONTWRITEBYTECODE=1
export COLIMA_HOME="$COLIMA_HOME"
export LIMA_HOME="$COLIMA_HOME/_lima"
export LIMA_INSTANCE="onionpress"
export DOCKER_HOST="unix://$COLIMA_HOME/default/docker.sock"
# Also where Colima's own `docker context` create/use/rm calls land: never
# the user's ~/.docker (see launcher.sh).
export DOCKER_CONFIG="$DATA_DIR/docker-config"
export TZ="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || echo UTC)"

# Detect per-user port offset for multi-user support
# When multiple macOS users run OnionPress, each needs unique host ports.
# Try binding the WordPress port; if in use, bump offset by 10000.
# NOTE: Must use actual socket bind (not lsof) because lsof only shows
# the current user's processes and cannot detect ports bound by other users.
detect_port_offset() {
    local offset=0
    # Log to file only — stdout is captured by $(detect_port_offset),
    # and stderr would spam every CLI invocation (status, address, ...).
    local _stamp
    while true; do
        local test_port=$((8080 + offset))
        if [ $test_port -gt 65535 ]; then
            _stamp=$(date '+%Y-%m-%d %H:%M:%S')
            echo "[$_stamp] ERROR: No available ports (tried offsets 0-$((offset - 10000)))" >> "$LOG_FILE"
            offset=0  # fall back to default
            break
        fi
        # Try to bind the port — fails with EADDRINUSE regardless of which user owns it
        if bundled_python -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(('127.0.0.1', int(sys.argv[1])))
    s.close()
except OSError:
    sys.exit(1)
" "$test_port" 2>/dev/null; then
            break
        fi
        _stamp=$(date '+%Y-%m-%d %H:%M:%S')
        echo "[$_stamp] Port $test_port in use, trying offset $((offset + 10000))" >> "$LOG_FILE"
        offset=$((offset + 10000))
    done
    echo "$offset"
}

# Use pre-set offset from menubar app if available, otherwise detect
if [ -z "$ONIONPRESS_PORT_OFFSET" ]; then
    ONIONPRESS_PORT_OFFSET=$(detect_port_offset)
fi
export ONIONPRESS_PORT_OFFSET
export ONIONPRESS_WP_PORT=$((8080 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_SOCKS_PORT=$((9050 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_PROXY_PORT=$((9077 + ONIONPRESS_PORT_OFFSET))

# Read version from Info.plist
ONIONPRESS_VERSION=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$APP_DIR/Info.plist" 2>/dev/null || echo "unknown")
export ONIONPRESS_VERSION

# Read Cloudflare Tunnel token from config (empty = disabled)
CLOUDFLARE_TUNNEL_TOKEN=""
if [ -f "$DATA_DIR/config" ]; then
    _cf_token=$(grep "^CLOUDFLARE_TUNNEL_TOKEN=" "$DATA_DIR/config" | head -1 | cut -d= -f2-)
    if [ ! -z "$_cf_token" ]; then
        CLOUDFLARE_TUNNEL_TOKEN="$_cf_token"
    fi
fi
export CLOUDFLARE_TUNNEL_TOKEN

# Run as an OnionHeaven hub (config-file-only). The containers accept
# registrations and run takeovers only on the canonical hub address or with
# an exact "yes" here; compose hands the value to the tor and onionheaven
# containers. Kept in step with linux/onionpress and onionpress.containers.
ONIONHEAVEN_ACCEPT_REGISTRATIONS=""
if [ -f "$DATA_DIR/config" ]; then
    ONIONHEAVEN_ACCEPT_REGISTRATIONS=$(grep "^ONIONHEAVEN_ACCEPT_REGISTRATIONS=" "$DATA_DIR/config" | head -1 | cut -d= -f2-)
fi
export ONIONHEAVEN_ACCEPT_REGISTRATIONS

# Locally built container images (development).
#
# build/build-images.sh builds the tor and wordpress images from this repo and
# prints these two exports. Setting either here, or in ~/.onionpress/config,
# repoints the whole stack: compose's tor/wordpress/onionheaven services, the
# image pulls below, the OnionHeaven takeover workers and vanity-key
# generation. See docs/BUILDING.md.
#
# The `| cut` is not cosmetic — a bare `var=$(grep ...)` takes grep's exit
# status, so a missing key would return 1 and kill the script under `set -e`.
# -f2- rather than -f2 so a value containing '=' is not truncated.
for _img_var in ONIONPRESS_TOR_IMAGE ONIONPRESS_WORDPRESS_IMAGE; do
    if [ -z "$(eval echo \"\$$_img_var\")" ] && [ -f "$DATA_DIR/config" ]; then
        _img_val=$(grep "^${_img_var}=" "$DATA_DIR/config" | head -1 | cut -d= -f2-)
        if [ -n "$_img_val" ]; then
            eval "export ${_img_var}=\"\$_img_val\""
        fi
    fi
done
unset _img_var _img_val

# True when the stack points at images built on this machine rather than
# published ones. Every `docker pull` / `docker compose pull` below is gated
# on this: without the gate they overwrite a local tag with the registry's
# copy, so a developer would build an image, start the app, and silently test
# someone else's build.
using_local_images() {
    local _ref
    for _ref in "${ONIONPRESS_TOR_IMAGE:-}" "${ONIONPRESS_WORDPRESS_IMAGE:-}"; do
        [ -n "$_ref" ] || continue
        case "$_ref" in
            ghcr.io/*) ;;   # explicitly pointed at a published image
            *) return 0 ;;
        esac
    done
    return 1
}

# The image every one-shot helper that handles the onion service key runs
# from (the key volume migration, the key seeds, the backup's key reads):
# the stack's own tor image, pinned by digest like the rest, or the locally
# built one. Never a floating tag such as `alpine`, which a registry or a
# mirror could swap for an image that reads the key. Each run overrides the
# entrypoint and joins no network (tests/test_container_capabilities.py).
KEY_HELPER_IMAGE="${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:79b18a6190e3ba8d3c261fd2782ee0a5871cbfebc663cbe12e6ade918e10aa4f}"

# Make sure KEY_HELPER_IMAGE is here before a helper runs from it: the key
# volume migration and the first-run seed come before any pull. A missing
# image is pulled by its pinned reference, never when the stack runs locally
# built images. Returns 1 when it is not here and cannot be. Kept identical
# in the macOS and Linux launchers; a test enforces that.
ensure_key_helper_image() {
    if docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1; then
        return 0
    fi
    if using_local_images; then
        log "ERROR: the locally built tor image $KEY_HELPER_IMAGE is not here (build it with build/build-images.sh)"
        return 1
    fi
    log "Pulling $KEY_HELPER_IMAGE for the onion service key helpers..."
    if ! docker pull "$KEY_HELPER_IMAGE" >> "$LOG_FILE" 2>&1; then
        log "ERROR: could not pull $KEY_HELPER_IMAGE"
        return 1
    fi
    docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1
}

# Analytics directory — bind-mounted into the tor container so analytics
# data survives VM deletion.  Lives under shared/ which is already
# mounted into the Colima VM.
ONIONPRESS_SHARED_DIR="$DATA_DIR/shared"
mkdir -p "$ONIONPRESS_SHARED_DIR/analytics"
export ONIONPRESS_SHARED_DIR

# Documents directory for Creations mount into WordPress container.
# ensure_documents_dir() creates this at startup; the existence check is
# defensive against hand-deletion.
if [ -d "$DOCUMENTS_DIR" ]; then
    export ONIONPRESS_DOCUMENTS_DIR="$DOCUMENTS_DIR"
fi


# Build compose flags — include cloudflare override file only when token is set
if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
    CF_COMPOSE="-f docker-compose.yml -f docker-compose.cloudflare.yml"
else
    CF_COMPOSE=""
fi

# OnionHeaven farm — takeover worker containers. The onionheaven container
# spawns and scales them itself (onionheaven_common._spawn_worker, from the
# registry's farm_scale_requests); the launcher only stops them on the way out.
stop_onionheaven_farm() {
    # Stop all farm containers (catches any scaled-up containers too), all at
    # once, with a second's grace each: their onion services are ephemeral
    # (ADD_ONION), and one after another at Docker's default 10 s a farm of
    # any size outlasted a quit, leaving workers to run on into the next
    # start.
    local container pids=""
    for container in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^onionheaven-(poll|takeover)-[0-9]+$'); do
        {
            docker stop -t 1 "$container" >> "$LOG_FILE" 2>&1 || true
            docker rm "$container" >> "$LOG_FILE" 2>&1 || true
            log "OnionHeaven farm: stopped $container"
        } &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# Containers an OnionPress from before the OnionHeaven data had a volume of
# its own started still read and write the hub's registry and keys where
# they used to be, onionheaven/ on onionpress-persistent-data. The move
# (onionheaven-data-migrate.py, in the onionheaven and onionpress-tor
# entrypoints) must not race them, and nothing may go on using that copy
# after it. So before compose starts anything, every OnionHeaven worker and
# Tor-side container that does not mount onionpress-onionheaven-data is
# removed, all at once: compose recreates onionpress-tor and onionheaven,
# and the heartbeat starts new workers. Identical in both launchers
# (tests/test_onionheaven_data_move_hardening.py).
retire_old_onionheaven_containers() {
    local name mounts pids=""
    for name in $(docker ps -a --format '{{.Names}}' 2>/dev/null \
            | grep -E '^(onionpress-tor|onionheaven|onionheaven-(poll|takeover)-[0-9]+)$'); do
        mounts=$(docker inspect --format '{{range .Mounts}}{{.Name}}:{{.Destination}} {{end}}' "$name" 2>/dev/null) || continue
        case " $mounts" in
            *" onionpress-onionheaven-data:/var/lib/onionheaven "*) continue ;;
        esac
        log "Removing $name: it does not mount onionpress-onionheaven-data (started by an older OnionPress)"
        docker rm -f "$name" >> "$LOG_FILE" 2>&1 &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# onionpress-network's bridge has a fixed name, onionpress-tor0
# (docker-compose.yml), so the Tor side's rules (onionpress/
# wordpress_egress.py) can name it before it exists. Docker cannot rename a
# bridge: an onionpress-network made before has Docker's br-<id>, which the
# rules miss, so it is removed here and `compose up` makes it anew. Compose
# 2.40 would try that itself and fail the whole start while a takeover
# worker (no compose service) is still on it. Every container on it is
# OnionPress's and is removed (compose recreates its services, the
# heartbeat its workers), onionheaven first since it starts workers;
# anything else is only disconnected. Once per install; kept identical in
# both launchers (ContainerManager.migrate_tor_network does the same), a
# test enforces it.
migrate_tor_network() {
    local options names name ours pids=""
    options=$(docker network inspect --format '{{json .Options}}' onionpress-network 2>/dev/null) || return 0
    case "$options" in
        *'"com.docker.network.bridge.name":"onionpress-tor0"'*) return 0 ;;
        "{"*) ;;
        *) return 0 ;;
    esac
    log "Recreating onionpress-network on its own bridge (onionpress-tor0), so the Tor side's rules apply to it"
    names=$(docker network inspect --format '{{range .Containers}}{{.Name}} {{end}}' onionpress-network 2>/dev/null) || names=""
    case " $names " in
        *" onionheaven "*)
            docker rm -f onionheaven >> "$LOG_FILE" 2>&1 || true
            names=$(docker network inspect --format '{{range .Containers}}{{.Name}} {{end}}' onionpress-network 2>/dev/null) || names="" ;;
    esac
    for name in $names; do
        # OnionPress's own names only: its compose services and the
        # workers, onionheaven-poll-<n> and onionheaven-takeover-<n>.
        ours=no
        case "$name" in
            onionpress-tor|onionpress-wordpress|onionpress-db|onionpress-cloudflared|onionheaven) ours=yes ;;
            onionheaven-poll-[0-9]*|onionheaven-takeover-[0-9]*)
                case "${name##*-}" in
                    *[!0-9]*) ;;
                    *) ours=yes ;;
                esac ;;
        esac
        if [ "$ours" = yes ]; then
            docker rm -f "$name" >> "$LOG_FILE" 2>&1 &
            pids="$pids $!"
        else
            log "WARNING: $name is on onionpress-network but is not OnionPress's: disconnecting it"
            docker network disconnect -f onionpress-network "$name" >> "$LOG_FILE" 2>&1 || true
        fi
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
    if ! docker network rm onionpress-network >> "$LOG_FILE" 2>&1; then
        log "WARNING: could not recreate onionpress-network on onionpress-tor0: until it is, the Tor-side containers can reach this machine and its network (see $LOG_FILE)"
    fi
    return 0
}

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if WordPress core is installed (setup wizard completed)
wp_is_installed() {
    local rc=0
    wp_cli core is-installed >/dev/null 2>&1 || rc=$?
    # rc 1 is WordPress answering "not installed"; anything else is docker
    # or wp-cli itself failing, which must not be mistaken for a fresh site.
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
        log "wp core is-installed: docker exec failed (rc=$rc) — treating as not installed" >&2
    fi
    return $rc
}

# Backup passwords are handed over in ONIONPRESS_BACKUP_PASSWORD, never on a
# command line: other local users can read any process's argv (ps,
# /proc/<pid>/cmdline) but not its environment. Sets BACKUP_PASS from the
# first of: $1 (the old positional form; warns), the variable, a line on
# stdin, a no-echo prompt. Unsets the variable so the commands this script
# runs don't inherit it; pass it on as ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" cmd.
# Identical in app/MacOS/onionpress and linux/onionpress (test-enforced).
read_backup_password() {
    BACKUP_PASS="${ONIONPRESS_BACKUP_PASSWORD:-}"
    unset ONIONPRESS_BACKUP_PASSWORD
    if [ -n "${1:-}" ]; then
        echo "WARNING: a password on the command line is visible to other users of this computer. Leave it out to be prompted, or set ONIONPRESS_BACKUP_PASSWORD." >&2
        BACKUP_PASS="$1"
    elif [ -z "$BACKUP_PASS" ]; then
        if [ -t 0 ]; then
            read -r -s -p "Backup password: " BACKUP_PASS || true
            echo "" >&2
        else
            IFS= read -r BACKUP_PASS || true
        fi
    fi
}

# Function to generate and load database passwords
setup_db_passwords() {
    local secrets_file="$DATA_DIR/secrets"

    # Create secrets file if it doesn't exist
    if [ ! -f "$secrets_file" ]; then
        log "Generating random database passwords..."

        # Generate random 32-character passwords using /dev/urandom
        # Use only alphanumeric chars to avoid shell quoting issues when sourcing
        local wordpress_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)
        local root_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)

        # Write passwords to secrets file with restricted permissions
        # Values are single-quoted to prevent shell interpretation on source
        touch "$secrets_file"
        chmod 600 "$secrets_file"

        cat > "$secrets_file" <<EOF
# Database passwords - generated on $(date)
# DO NOT SHARE THESE PASSWORDS
WORDPRESS_DB_PASSWORD='$wordpress_pass'
MYSQL_PASSWORD='$wordpress_pass'
MYSQL_ROOT_PASSWORD='$root_pass'
EOF

        log "Database passwords generated and saved to $secrets_file"
    fi

    # Load passwords from secrets file
    if [ -f "$secrets_file" ]; then
        source "$secrets_file"
        export WORDPRESS_DB_PASSWORD
        export MYSQL_PASSWORD
        export MYSQL_ROOT_PASSWORD
        # A truncated file (disk full on first run) sources fine and yields
        # empty passwords; mariadb then refuses to initialise and the only
        # symptom is a db restart loop. Say so here instead.
        if [ -z "$WORDPRESS_DB_PASSWORD" ] || [ -z "$MYSQL_ROOT_PASSWORD" ]; then
            log "ERROR: $secrets_file is incomplete (empty database password) — not starting. The database was initialised with these passwords, so restore the file rather than regenerating it."
            exit 1
        fi
    else
        log "ERROR: Secrets file not found at $secrets_file"
        exit 1
    fi
}

# Set a WordPress user's password: wp_set_user_password <login> <password>
# Both reach a fixed `wp eval` PHP on stdin. As --admin_password or
# --user_pass the password would sit in the process list, where ps shows
# every user's command lines. Identical in app/MacOS/onionpress and
# linux/onionpress, and the PHP is setup_logic.WP_SET_PASSWORD_PHP
# (test-enforced).
wp_set_user_password() {
    printf '%s\n%s' "$1" "$2" | wp_cli_in eval '
$in = explode("\n", file_get_contents("php://stdin"), 2);
$u = get_user_by("login", trim($in[0]));
$pw = isset($in[1]) ? trim($in[1]) : "";
if (!$u || $pw === "") { fwrite(STDERR, "Error: no such user, or an empty password\n"); exit(1); }
wp_set_password($pw, $u->ID);
delete_user_meta($u->ID, "default_password_nag");
echo "Success: password set for ", $u->user_login, "\n";
'
}

# Function to detect container runtime
detect_container_runtime() {
    # Called as RUNTIME=$(detect_container_runtime): stdout IS the return
    # value, so every log line in here goes to stderr (tee still writes
    # the file copy) or it ends up inside $RUNTIME.
    # Use bundled Colima
    if command_exists colima; then
        if [ -f "$COLIMA_HOME/.initialized" ]; then
            if "$BIN_DIR/colima" status >/dev/null 2>&1; then
                # Check if configured VM memory differs from running VM
                _cfg_mem=2
                if [ -f "$DATA_DIR/config" ]; then
                    _tmp_mem=$(grep "^VM_MEMORY=" "$DATA_DIR/config" | cut -d= -f2)
                    [ -n "$_tmp_mem" ] && _cfg_mem="$_tmp_mem"
                fi
                # Get actual VM memory in GB (MemTotal is in kB)
                _vm_mem_kb=$(docker exec onionpress-tor awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null | tr -d ' \n\r')
                _vm_mem_kb="${_vm_mem_kb:-0}"
                _vm_mem_gb=$(( (_vm_mem_kb + 524288) / 1048576 ))  # round to nearest GB
                # Read configured CPU count
                _cfg_cpu=2
                if [ -f "$DATA_DIR/config" ]; then
                    _tmp_cpu=$(grep "^VM_CPU=" "$DATA_DIR/config" | cut -d= -f2)
                    [ -n "$_tmp_cpu" ] && _cfg_cpu="$_tmp_cpu"
                fi
                # Get actual VM CPU count
                _vm_cpus=$(docker exec onionpress-tor nproc 2>/dev/null | tr -d ' \n\r')
                _vm_cpus="${_vm_cpus:-0}"

                _need_restart=false
                if [ "$_cfg_mem" -gt 0 ] 2>/dev/null && [ "$_vm_mem_gb" -gt 0 ] 2>/dev/null && [ "$_cfg_mem" -ne "$_vm_mem_gb" ]; then
                    log "VM memory mismatch: config=${_cfg_mem}GB, running=${_vm_mem_gb}GB" >&2
                    _need_restart=true
                fi
                if [ "$_cfg_cpu" -gt 0 ] 2>/dev/null && [ "$_vm_cpus" -gt 0 ] 2>/dev/null && [ "$_cfg_cpu" -ne "$_vm_cpus" ]; then
                    log "VM CPU mismatch: config=${_cfg_cpu}, running=${_vm_cpus}" >&2
                    _need_restart=true
                fi
                if [ "$_need_restart" = true ]; then
                    log "Restarting VM with ${_cfg_cpu} CPUs, ${_cfg_mem}GB RAM..." >&2
                    cd "$DOCKER_DIR"
                    docker compose down >> "$LOG_FILE" 2>&1 || true
                    "$BIN_DIR/colima" stop >> "$LOG_FILE" 2>&1
                    "$BIN_DIR/colima" start \
                        --activate=false \
                        --ssh-config=false \
                        --mount "$DATA_DIR/shared:w" \
                        $(docs_mount_args) \
                        --cpu "$_cfg_cpu" \
                        --memory "$_cfg_mem" \
                        >> "$LOG_FILE" 2>&1
                    if [ $? -eq 0 ]; then
                        log "VM restarted with ${_cfg_cpu} CPUs, ${_cfg_mem}GB" >&2
                    else
                        log "WARNING: VM restart failed" >&2
                    fi
                fi
                echo "colima-bundled"
                return 0
            else
                # Start Colima if stopped
                log "Starting bundled Colima..." >&2

                # Read VM memory/CPU from config so restarts honour changes
                _restart_mem=2
                _restart_cpu=2
                if [ -f "$DATA_DIR/config" ]; then
                    _cfg_mem=$(grep "^VM_MEMORY=" "$DATA_DIR/config" | cut -d= -f2)
                    [ -n "$_cfg_mem" ] && _restart_mem="$_cfg_mem"
                    _cfg_cpu=$(grep "^VM_CPU=" "$DATA_DIR/config" | cut -d= -f2)
                    [ -n "$_cfg_cpu" ] && _restart_cpu="$_cfg_cpu"
                fi

                "$BIN_DIR/colima" start \
                    --activate=false \
                    --ssh-config=false \
                    --mount "$DATA_DIR/shared:w" \
                    $(docs_mount_args) \
                    --cpu "$_restart_cpu" \
                    --memory "$_restart_mem" \
                    >> "$LOG_FILE" 2>&1
                if [ $? -eq 0 ]; then
                    echo "colima-bundled"
                    return 0
                fi
            fi
        fi
    fi

    # Fallback to system Docker (for development)
    if command_exists docker && docker info >/dev/null 2>&1; then
        echo "docker-system"
        return 0
    fi

    return 1
}

# Make sure DOCKER_HOST resolves to *our own* VM's socket — never another Colima.
#
# Colima honours COLIMA_HOME, so Lima forwards the guest's /var/run/docker.sock
# to $COLIMA_HOME/default/docker.sock (the `hostSocket:` entry in the instance's
# lima.yaml). Launchers up to v2.4.110 assumed the socket always landed in
# ~/.colima/ and symlinked that path into COLIMA_HOME to "bridge the gap". The
# bridge could only ever fire when our own forward was missing — so in practice
# it pointed DOCKER_HOST at whatever *other* Colima the user happened to be
# running, and OnionPress then deployed wordpress/db/tor into that VM. Repair
# any link left over from those versions, then wait for our own forward.
ensure_docker_socket() {
    local socket_path="$COLIMA_HOME/default/docker.sock"
    local wait_secs="${1:-45}"
    local waited=0
    local target

    if [ -L "$socket_path" ]; then
        target=$(readlink "$socket_path")
        case "$target" in
            "$COLIMA_HOME"/*)
                : ;;  # inside our own VM state — leave it alone
            *)
                log "WARNING: removing foreign Docker socket link ($socket_path -> $target)"
                rm -f "$socket_path"
                ;;
        esac
    fi

    while [ "$waited" -lt "$wait_secs" ]; do
        if [ -S "$socket_path" ]; then
            [ "$waited" -gt 0 ] && log "Docker socket ready after ${waited}s"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log "ERROR: Docker socket never appeared at $socket_path after ${wait_secs}s"
    log "  Lima's forward for the VM's /var/run/docker.sock is down."
    log "  Diagnose: $COLIMA_HOME/_lima/colima/ha.stderr.log"
    log "  Recover:  \"$BIN_DIR/colima\" stop && \"$BIN_DIR/colima\" start"
    return 1
}

# Ensure both key formats exist in a directory: C Tor's key files and the
# OpenSSH PEM (ks_hs_id.ed25519_expanded_private) that the container and
# OnionHeaven take. Derives whichever is missing from whichever is present.
ensure_key_formats() {
    local dir="$1"
    bundled_python "$SCRIPTS_DIR/key_manager.py" ensure-formats "$dir" >> "$LOG_FILE" 2>&1
}

# Function to generate custom onion address with prefix
generate_vanity_address() {
    local prefix="${1:-op2}"
    # Use shared directory so Docker/Colima can access it
    local output_dir="$DATA_DIR/shared/vanity-keys"

    log "Generating custom onion address with prefix '$prefix'..." >&2

    # Create output directory, abort loudly if we can't
    if ! mkdir -p "$output_dir" 2>>"$LOG_FILE"; then
        log "ERROR: Cannot create $output_dir (permissions?). Not falling back to random." >&2
        return 1
    fi

    # Check if mkp224o is available
    if [ ! -f "$BIN_DIR/mkp224o" ]; then
        log "ERROR: mkp224o not found at $BIN_DIR/mkp224o. Not falling back to random." >&2
        return 1
    fi
    if [ ! -x "$BIN_DIR/mkp224o" ]; then
        log "ERROR: $BIN_DIR/mkp224o exists but is not executable. Not falling back to random." >&2
        return 1
    fi
    # Quarantine attribute on a nested helper binary (common when the DMG
    # is downloaded from onionpress.org and Gatekeeper only approved the
    # main app) makes mkp224o silently killed on first exec. Strip it
    # defensively — harmless if the attr isn't there.
    xattr -d com.apple.quarantine "$BIN_DIR/mkp224o" 2>/dev/null || true

    # Clean stale output dirs from a prior crashed run so `find` below
    # can't pick up a partial.
    find "$output_dir" -maxdepth 1 -type d -name "*.onion" -empty -delete 2>/dev/null || true

    # Generate address with prefix (single threaded for consistency).
    # Capture exit status so we can complain loudly if mkp224o crashes.
    if ! cd "$output_dir"; then
        log "ERROR: Cannot cd to $output_dir" >&2
        return 1
    fi
    "$BIN_DIR/mkp224o" -d . -n 1 -t 4 "$prefix" >> "$LOG_FILE" 2>&1
    local mkp_rc=$?
    if [ $mkp_rc -ne 0 ]; then
        log "ERROR: mkp224o exited with status $mkp_rc (prefix='$prefix'). "\
"This is usually one of: quarantined nested binary (codesign/notarize issue), "\
"disk full, or platform mismatch. Not falling back to random." >&2
        return 1
    fi

    # Find generated directory — must contain the actual key files, not
    # just an empty stub from a prior crash.
    local candidate
    candidate=$(find "$output_dir" -maxdepth 1 -type d -name "${prefix}*" 2>/dev/null | head -1)
    if [ -z "$candidate" ]; then
        log "ERROR: mkp224o exited 0 but no ${prefix}*.onion directory was produced" >&2
        return 1
    fi
    if [ ! -f "$candidate/hs_ed25519_secret_key" ] || [ ! -f "$candidate/hostname" ]; then
        log "ERROR: $candidate exists but is missing hs_ed25519_secret_key or hostname" >&2
        return 1
    fi
    VANITY_DIR="$candidate"

    VANITY_ADDRESS=$(basename "$VANITY_DIR")
    log "Generated custom address: $VANITY_ADDRESS" >&2

    # Ensure both key formats exist (mkp224o generates C Tor format, derive the PEM)
    if ! ensure_key_formats "$VANITY_DIR"; then
        log "ERROR: ensure_key_formats failed for $VANITY_DIR" >&2
        return 1
    fi
    log "Ensured both key formats for vanity key" >&2

    # Return the directory path (only thing on stdout)
    echo "$VANITY_DIR"
    return 0
}

# Function to import a pre-generated onion service key
import_key() {
    local key_b32="$1"
    # "-" reads the key from stdin, so a caller (the menubar's settings-page
    # import) can keep it out of this process's argv, which ps shows to
    # every user. The key is passed on to key_manager.py on stdin too.
    if [ "$key_b32" = "-" ]; then
        IFS= read -r key_b32 || true
    fi

    # Ensure data directory exists (import-key may run before first launch)
    mkdir -p "$DATA_DIR"

    # Show help if no argument or --help
    if [ -z "$key_b32" ] || [ "$key_b32" = "--help" ] || [ "$key_b32" = "-h" ]; then
        cat <<HELPEOF
Usage: onionpress import-key <base32-secret-key>

Import a pre-generated ed25519 key for your onion service.

The base32 key should encode the 64-byte expanded ed25519 secret key.
OnionPress will derive the .onion address automatically.

HOW TO GET THE KEY FROM mkp224o OUTPUT:

  OnionPress stores vanity keys in ~/.onionpress/shared/vanity-keys/.
  Each address has its own directory containing hs_ed25519_secret_key.
  Encode that file to base32:

    PYTHONHOME=$_BUNDLED_PYTHONHOME $_BUNDLED_PYTHON_BIN -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())"

  If you ran mkp224o yourself, substitute the path to your output directory.

  OnionPress accepts both the full file (96 bytes with header) and the
  64-byte key alone (read()[32:]).

EXAMPLE:

  KEY=\$(PYTHONHOME=$_BUNDLED_PYTHONHOME $_BUNDLED_PYTHON_BIN -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())")
  ./onionpress import-key "\$KEY"

WHAT THIS COMMAND DOES:

  1. Decodes the base32 key and checks it is a usable 64-byte expanded
     ed25519 key; nothing is changed for a key that is refused
  2. Derives the .onion address from it
  3. Keeps a copy of the current key in ~/.onionpress/replaced-keys/
     <address>-<time>/ (import that key again to go back)
  4. Writes key files to ~/.onionpress/shared/vanity-keys/<address>/
     - ks_hs_id.ed25519_expanded_private  (OpenSSH PEM, the format the container takes)
     - hostname                           (the .onion address)
  5. On next start, OnionPress will use this key

NOTE: If an onion address already exists, you will be prompted to
confirm the replacement. OnionPress will handle stopping and
removing the old keys automatically.

HELPEOF
        return 0
    fi

    # Check the key and derive its .onion address before anything is
    # touched: a key that is refused changes nothing.
    local address
    if ! address=$(printf '%s\n' "$key_b32" | bundled_python "$SCRIPTS_DIR/key_manager.py" decode-key - 2>&1); then
        echo "$address" >&2
        return 1
    fi

    # Check if this is the same key already installed
    local current_addr
    current_addr=$(find "$DATA_DIR/shared/vanity-keys" -name hostname -exec cat {} \; 2>/dev/null | head -1)
    if [ "$current_addr" = "$address" ]; then
        echo "Key already installed for: $address"
        echo "Nothing to do."
        return 0
    fi

    # Check if a key volume already exists (need to replace old key). The old
    # name is checked too: an install that never started on this version has
    # not migrated yet. The question is skipped only for an explicit
    # ONIONPRESS_IMPORT_KEY_CONFIRMED=yes: the menubar sets it after the
    # person at this Mac clicked Replace in its own dialog (a Settings-page
    # import). Its key arrives on stdin, so this read would see the end of
    # the input and cancel.
    if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -qx 'onionpress-onion-keys\|onionpress-arti-state'; then
        echo "An onion address key already exists."
        echo ""
        if [ -n "$current_addr" ]; then
            echo "Current address: $current_addr"
            echo ""
        fi
        echo "Importing a new key will REPLACE your current onion address."
        echo "A copy of the current key is kept in $DATA_DIR/replaced-keys/."
        echo ""
        if [ "${ONIONPRESS_IMPORT_KEY_CONFIRMED:-}" = "yes" ]; then
            echo "Confirmed at this Mac."
        else
            printf "Continue? [y/N] "
            local confirm=""
            read -r confirm || true
            if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                echo "Cancelled."
                return 1
            fi
        fi
    fi

    # Keep a copy of the current key, ask the OnionHeaven hubs that may hold
    # it to delete theirs, stop OnionPress and put the new key in place.
    local rc=0
    replace_onion_key "$key_b32" || rc=$?
    if [ "$rc" -eq 2 ]; then
        echo "Key already installed for: $address"
        echo "Nothing to do."
        return 0
    elif [ "$rc" -ne 0 ]; then
        echo "ERROR: $REPLACE_KEY_ERROR" >&2
        if [ "$REPLACE_KEY_STOPPED" = "yes" ]; then
            echo "OnionPress was stopped; launch it again." >&2
        fi
        return 1
    fi

    echo "Imported key for: $address"
    echo "Key files written to: $DATA_DIR/shared/vanity-keys/$address"
    if [ -n "$REPLACE_KEY_KEPT" ]; then
        echo "The replaced key is kept in:"
        printf '%s\n' "$REPLACE_KEY_KEPT" | sed 's/^/  /'
    fi
    echo ""
    echo "Launch OnionPress to use this address."
    return 0
}

# Replace this site's onion service key, in an order that never loses the
# current one. The Linux launcher's replace_onion_key (see there), run
# with the bundled Python; a test keeps the two the same.
replace_onion_key() {
    local staging new_addr staged rc vdir vol state
    local vdirs=()
    REPLACE_KEY_ADDRESS=""
    REPLACE_KEY_KEPT=""
    REPLACE_KEY_STOPPED=""
    REPLACE_KEY_ERROR=""
    mkdir -p "$DATA_DIR/shared"
    if ! staging=$(mktemp -d "$DATA_DIR/.key-import-XXXXXX"); then
        REPLACE_KEY_ERROR="Could not make a staging folder in $DATA_DIR"
        return 1
    fi
    mkdir "$staging/vanity-keys"

    # 1. Check and stage.
    if ! new_addr=$(printf '%s\n' "$1" | bundled_python "$SCRIPTS_DIR/key_manager.py" import-key - "$staging/vanity-keys" 2>"$staging/error"); then
        REPLACE_KEY_ERROR=$(head -c 400 "$staging/error" | tr -d '\r' | head -1)
        REPLACE_KEY_ERROR="${REPLACE_KEY_ERROR#Error: }"
        REPLACE_KEY_ERROR="${REPLACE_KEY_ERROR:-The key could not be read}"
        rm -rf "$staging"
        log "Key import refused: $REPLACE_KEY_ERROR"
        return 1
    fi
    staged=$(bundled_python "$SCRIPTS_DIR/key_manager.py" staged-address "$staging/vanity-keys/$new_addr" 2>>"$LOG_FILE") || staged=""
    if ! is_onion_address "$new_addr" || [ "$staged" != "$new_addr" ]; then
        REPLACE_KEY_ERROR="The imported key did not read back as one onion address"
        rm -rf "$staging"
        log "Key import refused: $REPLACE_KEY_ERROR"
        return 1
    fi
    REPLACE_KEY_ADDRESS="$new_addr"

    # Already the address Tor serves (or, with Tor not answering, the one in
    # vanity-keys/): nothing to replace.
    vdir=$(vanity_key_dir || true)
    staged=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ') || staged=""
    if [ "$staged" = "$new_addr" ] \
            || { [ -z "$staged" ] && [ -n "$vdir" ] && [ "$(basename "$vdir")" = "$new_addr" ]; }; then
        rm -rf "$staging"
        log "Key import: $new_addr is already this site's address"
        return 2
    fi

    # 2. Keep a copy of the current key.
    [ -n "$vdir" ] && vdirs=("$vdir")
    rc=0
    REPLACE_KEY_KEPT=$(bundled_python "$SCRIPTS_DIR/key_manager.py" keep-current "$DATA_DIR/replaced-keys" "${vdirs[@]}" 2>>"$LOG_FILE") || rc=$?
    if [ "$rc" -eq 3 ]; then
        # Nothing could be read. Only Docker's confirmed "no such volume"
        # for every place a key lives means there is no key to keep.
        for vol in onionpress-onion-keys onionpress-arti-state onionpress-tor-state; do
            state=0; docker_volume_state "$vol" || state=$?
            if [ "$state" -ne 1 ]; then
                REPLACE_KEY_ERROR="The current onion service key could not be read, so no copy of it could be kept. Start OnionPress and try again; nothing was changed."
                rm -rf "$staging"
                log "Key import refused: no copy of the current key (volume $vol: state $state)"
                return 1
            fi
        done
        REPLACE_KEY_KEPT=""
        log "Key import: no current key to keep (no key volume)"
    elif [ "$rc" -ne 0 ]; then
        REPLACE_KEY_ERROR="A copy of the current onion service key could not be kept (see $LOG_FILE); nothing was changed."
        rm -rf "$staging"
        log "Key import refused: keeping the current key failed"
        return 1
    else
        log "Kept a copy of the current onion service key: $(printf '%s' "$REPLACE_KEY_KEPT" | tr '\n' ' ')"
    fi

    # 3. Only now: the hubs, then OnionPress.
    if ! onionheaven_release key-import; then
        REPLACE_KEY_ERROR="Cancelled: an OnionHeaven hub may still hold the current key"
        rm -rf "$staging"
        return 1
    fi
    REPLACE_KEY_STOPPED=yes
    stop_containers 2>/dev/null || true

    # 4. The staged key becomes vanity-keys/; the next start does the rest.
    if [ -e "$DATA_DIR/shared/vanity-keys" ] || [ -L "$DATA_DIR/shared/vanity-keys" ]; then
        if ! mv "$DATA_DIR/shared/vanity-keys" "$staging/replaced-vanity-keys"; then
            REPLACE_KEY_ERROR="Could not move the old vanity-keys folder aside; the key was not replaced"
            rm -rf "$staging/vanity-keys"
            log "ERROR: $REPLACE_KEY_ERROR (staging folder $staging)"
            return 1
        fi
    fi
    if ! mv "$staging/vanity-keys" "$DATA_DIR/shared/vanity-keys"; then
        mv "$staging/replaced-vanity-keys" "$DATA_DIR/shared/vanity-keys" 2>/dev/null || true
        REPLACE_KEY_ERROR="Could not put the new key in place; the key was not replaced"
        log "ERROR: $REPLACE_KEY_ERROR (staging folder $staging)"
        return 1
    fi
    touch "$DATA_DIR/.import-key-pending"
    # A replaced identity ends any unfinished move of the old key into
    # its new volume: the next start must not copy it back.
    rm -f "$DATA_DIR/.key-volume-migration-pending"
    rm -rf "$staging"

    # 5.
    set_address_prefix_for "$new_addr"
    log "Imported key for address: $new_addr"
    return 0
}

# ADDRESS_PREFIX follows an imported address.
set_address_prefix_for() {
    local address="$1"
    # Update ADDRESS_PREFIX in config to match the imported address
    # so the startup prefix check doesn't flag a mismatch. Keep the user's
    # configured prefix length instead of always truncating to 3 (#116);
    # same logic as the Linux launcher, bounded by the 2-5 character rule
    # the startup check enforces so the written value stays valid.
    local current_prefix=""
    if [ -f "$DATA_DIR/config" ]; then
        current_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
    fi
    local prefix_len=${#current_prefix}
    if [ "$prefix_len" -lt 2 ]; then
        prefix_len=3
    elif [ "$prefix_len" -gt 5 ]; then
        prefix_len=5
    fi
    local addr_prefix=$(echo "$address" | cut -c1-"$prefix_len")
    if [ -f "$DATA_DIR/config" ] && grep -q "^ADDRESS_PREFIX=" "$DATA_DIR/config"; then
        sed -i '' "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$addr_prefix/" "$DATA_DIR/config"
    else
        echo "ADDRESS_PREFIX=$addr_prefix" >> "$DATA_DIR/config"
    fi
    log "Updated ADDRESS_PREFIX to '$addr_prefix' to match imported key"
}

# Is a WordPress.org plugin wanted? plugin_wanted INSTALL_CACHE_ENABLER |
# INSTALL_IA_PLUGIN: yes unless ~/.onionpress/config sets it to something
# else; missing or empty means yes, as it always has.
plugin_wanted() {
    local value
    value=$(grep "^$1=" "$DATA_DIR/config" 2>/dev/null | tail -1 | cut -d= -f2)
    [ -z "$value" ] || [ "$value" = "yes" ]
}

# Is the plugin file $1 (<folder>/<main file>.php) in the WordPress
# container's plugins folder? Looked at as www-data, whose folder it is.
wp_plugin_present() {
    docker exec -u www-data onionpress-wordpress test -f "/var/www/html/wp-content/plugins/$1" 2>/dev/null
}

# The Version: header of the plugin file $1, as installed ('' if none).
# Compared with the pin only; kept to version characters for the log.
wp_plugin_version() {
    docker exec -u www-data onionpress-wordpress sed -n 's/^[[:space:]*]*Version:[[:space:]]*//p' \
        "/var/www/html/wp-content/plugins/$1" 2>/dev/null | head -1 | tr -cd '0-9A-Za-z.-'
}

# Put the pinned release of a WordPress.org plugin in the WordPress
# container: install_wp_org_plugin <slug> <name for the log>. Downloaded
# over Tor and checked against its pin (install_plugin.sh); a copy of any
# other version (installed before plugins were pinned) is replaced, so
# what gets activated is the release that was reviewed. Activation is
# setup_bundled_plugins's.
install_wp_org_plugin() {
    local slug="$1" name="$2"
    local pinned installed temp_dir

    if [ ! -d "$SCRIPTS_DIR" ] || [ ! -f "$SCRIPTS_DIR/install_plugin.sh" ]; then
        log "Plugin installation scripts not available, skipping $name"
        return 0
    fi
    if ! pinned=$("$SCRIPTS_DIR/install_plugin.sh" --pinned-version "$slug"); then
        log "No pinned release of $name — not installing it"
        return 0
    fi

    installed=$(wp_plugin_version "$slug/$slug.php")
    if [ "$installed" = "$pinned" ]; then
        log "$name $installed already installed"
        return 0
    fi
    if [ -n "$installed" ]; then
        log "Replacing $name $installed with the pinned release $pinned..."
    else
        log "Installing $name $pinned..."
    fi

    temp_dir=$(mktemp -d)
    if "$SCRIPTS_DIR/install_plugin.sh" "$slug" "$temp_dir" >>"$LOG_FILE" 2>&1; then
        # Written as www-data, not docker cp + chown -R as root (both
        # followed links www-data can plant in plugins/).
        if bundled_python -m onionpress.cli put-wp-tree --src "$temp_dir/$slug" \
                --dest "/var/www/html/wp-content/plugins/$slug" 2>>"$LOG_FILE"; then
            log "✓ $name $pinned installed with verified checksum"
        else
            log "Failed to copy $name to container"
        fi
    else
        log "Failed to download and verify $name - check log for details"
    fi
    rm -rf "$temp_dir"
    return 0
}

# Internet Archive Wayback Machine Link Fixer: points links archive.org
# finds broken at their Wayback copies. INSTALL_IA_PLUGIN=no leaves it out.
install_ia_plugin() {
    if ! plugin_wanted INSTALL_IA_PLUGIN; then
        log "Internet Archive plugin installation disabled in config"
        return 0
    fi
    install_wp_org_plugin internet-archive-wayback-machine-link-fixer \
        "Internet Archive Wayback Machine Link Fixer"
}

# Cache Enabler, a page cache for what Tor visitors see (what it may keep:
# onionpress-cache-policy.php). INSTALL_CACHE_ENABLER=no leaves it out.
install_cache_enabler() {
    if ! plugin_wanted INSTALL_CACHE_ENABLER; then
        log "Cache Enabler plugin installation disabled in config"
        return 0
    fi
    install_wp_org_plugin cache-enabler "Cache Enabler"
}

# Configure, then activate, the plugins install_cache_enabler and
# install_ia_plugin put in place (each while still wanted in the config),
# and for Cache Enabler then check its settings against OnionPress's cache
# policy. Configured first: Cache Enabler validates its settings (through
# onionpress-cache-policy.php) and writes its files when it is activated,
# and the Link Fixer shows its setup wizard unless it is completed by then.
# Cache Enabler is network-activated (one drop-in and page cache for the
# network; the mu-plugin gives every site, also one made later, its
# settings); the Link Fixer site by site, as it creates its link table only
# in the site it is activated on. The configure-* steps refuse, and nothing
# is activated, without the policy mu-plugins, so this runs after
# provision-post-install. Also run by the setup-bundled-plugins subcommand,
# which setup_logic.install_fresh_wordpress starts once setup has made the
# user's site. Idempotent; activation is repeated at every start
# (INSTALL_*=no stops that, and leaves an active plugin as it is).
setup_bundled_plugins() {
    if ! wp_is_installed; then
        log "WordPress not installed yet — Cache Enabler and the Link Fixer are set up after setup"
        return 0
    fi

    if plugin_wanted INSTALL_CACHE_ENABLER && wp_plugin_present cache-enabler/cache-enabler.php; then
        if bundled_python -m onionpress.cli configure-cache-enabler >>"$LOG_FILE" 2>&1 \
                && "$SCRIPTS_DIR/activate_plugin.sh" onionpress-wordpress \
                    cache-enabler/cache-enabler.php --network >>"$LOG_FILE" 2>&1 \
                && bundled_python -m onionpress.cli apply-cache-policy >>"$LOG_FILE" 2>&1; then
            log "✓ Cache Enabler active, cache policy applied"
        else
            log "WARNING: Cache Enabler not set up — see $LOG_FILE"
        fi
    fi

    if plugin_wanted INSTALL_IA_PLUGIN \
            && wp_plugin_present internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php; then
        if bundled_python -m onionpress.cli configure-ia-plugin >>"$LOG_FILE" 2>&1 \
                && "$SCRIPTS_DIR/activate_plugin.sh" onionpress-wordpress \
                    internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php \
                    --each-site >>"$LOG_FILE" 2>&1; then
            log "✓ Internet Archive Wayback Machine Link Fixer active on every site"
        else
            log "WARNING: Internet Archive Link Fixer not set up — see $LOG_FILE"
        fi
    fi
    return 0
}

# WP-Statistics plugin removed — it phoned home to connect.wp-statistics.com
# despite telemetry settings being disabled.  OnionPress's built-in hit counter
# (onionpress-hit-counter plugin) provides the same functionality without
# any clearnet leaks.  On existing installs the plugin is deactivated on the
# next launch (see deactivate_wp_statistics below).

# Function to initialize container runtime
install_docker() {
    log "Container runtime initialization required"

    # Read VM memory from config (default: 2 GB — the stack idles at ~840 MB)
    VM_MEMORY=2
    VM_CPU=2
    if [ -f "$DATA_DIR/config" ]; then
        config_mem=$(grep "^VM_MEMORY=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_mem" ]; then
            VM_MEMORY="$config_mem"
        fi
        config_cpu=$(grep "^VM_CPU=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_cpu" ]; then
            VM_CPU="$config_cpu"
        fi
    fi

    # Diffdisk cap (issue #230), same rule as launcher.sh: 20 GiB unless
    # VM_DISK is set in ~/.onionpress/config before first launch. The cap is
    # baked in at VM creation, so this fallback path has to pass it too or
    # a VM created here gets Lima's 100 GiB default.
    local VM_DISK=20 _cfg_disk
    if [ -f "$DATA_DIR/config" ]; then
        _cfg_disk=$(grep "^VM_DISK=" "$DATA_DIR/config" | cut -d= -f2)
        [ -n "$_cfg_disk" ] && VM_DISK="$_cfg_disk"
    fi
    log "Creating the Colima VM with a ${VM_DISK}GB diffdisk cap"

    # Should not happen if launcher worked, but handle it
    if [ "$VM_ARCH" = "aarch64" ]; then
        # Apple Silicon: use VZ backend (Virtualization.framework)
        "$BIN_DIR/colima" start \
            --activate=false \
            --ssh-config=false \
            --vm-type vz \
            --mount-type virtiofs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$VM_CPU" \
            --memory "$VM_MEMORY" \
            --disk "$VM_DISK" \
            --arch "$VM_ARCH" \
            --vz-rosetta=false \
            >> "$LOG_FILE" 2>&1
    else
        # Intel: use QEMU backend
        "$BIN_DIR/colima" start \
            --activate=false \
            --ssh-config=false \
            --vm-type qemu \
            --mount-type sshfs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$VM_CPU" \
            --memory "$VM_MEMORY" \
            --disk "$VM_DISK" \
            --arch "$VM_ARCH" \
            >> "$LOG_FILE" 2>&1
    fi

    if [ $? -eq 0 ]; then
        touch "$COLIMA_HOME/.initialized"
        log "Container runtime initialized successfully"
        return 0
    else
        log "ERROR: Failed to initialize container runtime"
        echo "ERROR: Failed to initialize container runtime." >&2
        echo "Check the logs for details: $LOG_FILE" >&2
        echo "Or file an issue at: https://github.com/brewsterkahle/onionpress/issues" >&2
        exit 1
    fi
}

# Function to update Docker images if enabled
update_images() {
    # Check if auto-update is enabled in config
    local update_enabled="no"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^UPDATE_ON_LAUNCH=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            update_enabled="$config_value"
        fi
    fi

    if [ "$update_enabled" != "yes" ]; then
        return 0
    fi

    if using_local_images; then
        log "Skipping image update: running locally built images"
        return 0
    fi

    log "Checking for Docker image updates..."

    cd "$DOCKER_DIR"

    # Pull the images the stack actually runs. These were bare `:latest` tags
    # while docker-compose.yml pinned by digest, so this loop warmed a layer
    # the stack never started and then logged it as "up to date" — the Linux
    # launcher has pinned here since v2.4.99. The pins come from
    # build/image-pins.env via build/refresh-image-digests.sh, and
    # tests/test_image_pins.py fails if they drift. Exporting
    # ONIONPRESS_TOR_IMAGE / ONIONPRESS_WORDPRESS_IMAGE points this at a
    # locally built stack.
    #
    # Every image is pinned by digest (the third-party ones too, since the
    # start-time pull stopped refreshing them), so a pull here fetches
    # something only when a new OnionPress moved a pin; otherwise it is one
    # manifest check per image. cloudflared only when the tunnel is on:
    # compose never starts it otherwise, and it is ~60 MB.
    local images=(
        "${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:79b18a6190e3ba8d3c261fd2782ee0a5871cbfebc663cbe12e6ade918e10aa4f}"
        "${ONIONPRESS_WORDPRESS_IMAGE:-ghcr.io/brewsterkahle/onionpress-wordpress:latest@sha256:2e3fbc5cc60bf51bc453e32836e05a442c836006e86d06b96c37654a7806d291}"
        "mariadb:13.0.2@sha256:f1bba652ba57bea3099ca2fe1af692af537c27d96e0bcde39dce29e2ba1ec4f3"
        "willfarrell/autoheal:latest@sha256:fe88c69806c71ac82fd3a483596011742f5ef319f84744cc3128e5b92b10af77"
        "ghcr.io/wollomatic/socket-proxy:1.13.1@sha256:e78e68ba3ea4a6bf8ee47865ac1d1f98d525c3660df948554e766283c40d3f4b"
    )
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        images+=("cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07")
    fi
    local updated=false

    for image in "${images[@]}"; do
        log "Pulling $image..."
        if docker pull "$image" >> "$LOG_FILE" 2>&1; then
            log "✓ $image up to date"
            updated=true
        else
            log "WARNING: Failed to pull $image (continuing with cached version)"
        fi
    done

    if [ "$updated" = true ]; then
        log "✓ Image update check complete"
        # Issue #230: reclaim disk from old <none> image tags created by
        # the pull above. Dangling-only (no -a) so in-use and freshly
        # tagged images are untouched.
        local prune_out
        prune_out=$(docker image prune -f 2>&1 | tail -1)
        if [ -n "$prune_out" ]; then
            log "$prune_out"
        fi
    fi

    return 0
}

# Install OnionPress theme and plugins into the WordPress container
configure_site_timezones() {
    # Set each site's timezone_string to the host machine's IANA TZ
    # (e.g. America/Los_Angeles) the first time we see each site.
    # Without this, fresh WordPress installs default to empty string /
    # gmt_offset=0, and imported tweet timestamps (stored as UTC
    # post_date_gmt) end up displayed in UTC. Matching the host TZ
    # reflects the times the user saw when they posted originally.
    #
    # Only sets when timezone_string is empty — never clobbers a
    # user's intentional choice. Idempotent across launches.
    if ! wp_is_installed; then
        return 0
    fi

    local host_tz
    host_tz="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
    if [ -z "$host_tz" ]; then
        log "Skipping timezone config: host TZ undetectable"
        return 0
    fi

    # On multisite, iterate all sites; on single-site, fall back to the
    # main siteurl. Empty output from `wp site list` means single-site.
    local sites
    sites="$(wp_cli site list --field=url 2>/dev/null)"
    if [ -z "$sites" ]; then
        sites="$(wp_cli option get siteurl 2>/dev/null)"
    fi

    local site_url current
    for site_url in $sites; do
        current="$(wp_cli option get timezone_string --url="$site_url" 2>/dev/null || echo "")"
        if [ -z "$current" ]; then
            if wp_cli option update timezone_string "$host_tz" --url="$site_url" >> "$LOG_FILE" 2>&1; then
                log "✓ Set timezone_string=$host_tz for $site_url"
            else
                log "WARNING: Failed to set timezone for $site_url"
            fi
            # With timezone_string set, gmt_offset becomes redundant;
            # blank it so WP uses the IANA name rather than a fixed offset.
            wp_cli option update gmt_offset "" --url="$site_url" >> "$LOG_FILE" 2>&1 || true
        fi
    done
}

# Function to set up OnionHeaven (onionheaven mode only)
# Registration API now runs in the onionheaven container (web-server.py),
# which creates its own data directories on the shared volume at startup.

# Whether Docker has volume $1: 0 yes, 1 no, 2 Docker could not say (the
# daemon is not up yet, e.g. the Colima VM is still booting). Callers must
# treat 2 as "stop", never as "no": a missing key volume is the first-run
# signal, so reading a Docker error as absence turns an upgrade into a first
# run. Kept identical in the macOS and Linux launchers; a test enforces that.
docker_volume_state() {
    local names
    names=$(docker volume ls --format '{{.Name}}' 2>>"$LOG_FILE") || return 2
    printf '%s\n' "$names" | grep -qx -- "$1"
}

# Wait up to $1 seconds for the Docker daemon to answer; returns 1 if it
# never does. Kept identical in the macOS and Linux launchers.
wait_for_docker() {
    local limit="$1" waited=0
    while ! docker info >/dev/null 2>&1; do
        if [ "$waited" -ge "$limit" ]; then
            return 1
        fi
        if [ "$waited" -eq 0 ]; then
            log "Waiting for Docker daemon to be ready..."
        fi
        sleep 2
        waited=$((waited + 2))
    done
    if [ "$waited" -gt 0 ]; then
        log "Docker daemon ready after ${waited}s"
    fi
    return 0
}

# Whether Lima thinks the colima instance is up. "Running" with no Docker
# answer is the wedge recover_lima_vm exists for.
lima_vm_running() {
    export COLIMA_HOME LIMA_HOME
    "$BIN_DIR/limactl" list --format '{{.Status}}' colima 2>/dev/null | grep -qx Running
}

# Force-stop and restart the Lima VM. This is the one known recovery for the
# wedged "Running but SSH refused" state the VM lands in occasionally after
# long uptime / sleep, and (2026-10-02) after a macOS update killed the app
# mid-stop: lima reports the instance Running, the guest even gets a DHCP
# lease, but sshd never comes up, so `colima start` waits ten minutes for a
# "running" event that never arrives and Docker stays unreachable. $1 labels
# the log lines with the caller (start / restart). Returns 1 when the VM
# would not come back; the caller decides what that means.
recover_lima_vm() {
    local who="$1"
    log "$who: Docker daemon not reachable — restarting Lima VM first"
    export COLIMA_HOME LIMA_HOME
    "$BIN_DIR/limactl" stop -f colima >> "$LOG_FILE" 2>&1 || true
    # Wait briefly for hostagent processes to fully die before starting
    # again — lima can trip over itself otherwise.
    sleep 3
    if ! "$BIN_DIR/limactl" start colima >> "$LOG_FILE" 2>&1; then
        log "$who: limactl start failed — giving up, user may need to reboot"
        return 1
    fi
    log "$who: Lima VM restarted"
    save_previous_boot_journal "$who"
    return 0
}

# wait_for_docker, plus one shot at the Lima wedge: when Docker has not
# answered within $1 seconds but Lima still reports the VM Running, recover
# the VM once and wait again with a fresh budget. Gives up (returns 1) only
# after that second wait, or straight away when the VM is not Running at
# all (a stopped VM is not the wedge; restarting it here would fight the
# launcher's own `colima start`). $2 labels the log lines with the caller.
wait_for_docker_or_recover_vm() {
    local limit="$1" who="$2"
    if wait_for_docker "$limit"; then
        return 0
    fi
    if ! lima_vm_running; then
        log "$who: Docker daemon not ready after ${limit}s and Lima does not report the VM Running — not recovering"
        return 1
    fi
    log "$who: Docker daemon not ready after ${limit}s while Lima reports the VM Running — recovering the wedged VM"
    recover_lima_vm "$who" || return 1
    wait_for_docker "$limit"
}

# Run a command inside the VM through `limactl shell`, bounded to $1
# seconds. limactl shell hangs for good when the guest's sshd is wedged
# (the state recover_lima_vm exists for) and macOS has no timeout(1).
# Prints the command's stdout; its stderr goes to the log. Returns the
# command's status, 124 on timeout, 127 when there is no bundled limactl
# (Linux, or a test harness without one).
vm_shell_bounded() {
    local limit="$1"; shift
    [ -x "$BIN_DIR/limactl" ] || return 127
    local out pid rc=0 waited=0
    out=$(mktemp "${TMPDIR:-/tmp}/onionpress-vm-shell.XXXXXX") || return 1
    "$BIN_DIR/limactl" shell colima -- "$@" > "$out" 2>> "$LOG_FILE" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge "$limit" ]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            rm -f "$out"
            return 124
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "$pid" || rc=$?
    cat "$out"
    rm -f "$out"
    return "$rc"
}

# The guest's root filesystem must be able to repair itself at boot.
#
# Root cause of the "Lima reports the VM Running, sshd and Docker never
# come up" wedge on the live install (found 2026-10-11 by reading the
# guest's journal): its root ext4 had carried an inconsistency since
# 2026-09-12 that the boot-time check (preen mode, `fsck -a`) refuses to
# fix — "UNEXPECTED INCONSISTENCY; RUN fsck MANUALLY", exit 4. That fails
# systemd-fsck-root.service, whose OnFailure= starts emergency.target, and
# whether sysinit/ssh/docker still come up is then a race: 3 of the 6
# boots in that journal lost it. Nobody can answer that prompt in an
# appliance VM, so give the kernel `fsck.repair=yes` — systemd-fsck then
# runs `fsck -y`, which clears such damage at the next boot and keeps
# emergency mode out of the picture. The guest boots without an initramfs
# (GRUB_FORCE_PARTUUID), so systemd-fsck is the only checker and a grub
# drop-in is the whole change. Idempotent: the drop-in is written once,
# update-grub runs only then, and the flag takes effect at the next VM
# boot. Also reports when this boot's root check failed, so the condition
# shows in onionpress.log instead of only in the guest's journal. Best
# effort: never fails the start.
ensure_vm_fsck_repair() {
    local script out rc=0 summary detail
    script=$(cat <<'EOF'
f=/etc/default/grub.d/60-onionpress-fsck.cfg
flag=present
if ! grep -qs "fsck.repair=yes" "$f"; then
    {
        echo "# OnionPress: repair the root filesystem automatically at boot. Without"
        echo "# this, an inconsistency the preen-mode check cannot fix sends systemd into"
        echo "# emergency mode, where sshd and Docker may never start, and no one can"
        echo "# answer \"RUN fsck MANUALLY\" in an appliance VM. systemd-fsck reads it as -y."
        echo "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT fsck.repair=yes\""
    } > "$f" && update-grub >/dev/null 2>&1 && flag=installed || flag=install-failed
fi
state=$(systemctl is-failed systemd-fsck-root.service 2>/dev/null || true)
if grep -qw "fsck.repair=yes" /proc/cmdline; then cmdline=yes; else cmdline=no; fi
echo "fsck-root=${state:-unknown} repair-flag=$flag cmdline=$cmdline"
if [ "$state" = failed ]; then
    journalctl -b 0 -u systemd-fsck-root.service --no-pager -o cat 2>/dev/null | grep -i "fsck\|inconsisten" | head -n 4
fi
EOF
)
    out=$(vm_shell_bounded 60 sudo sh -c "$script") || rc=$?
    case "$rc" in
        0) ;;
        127) return 0 ;;  # no bundled limactl: no VM to look after
        124) log "WARNING: VM root filesystem check skipped — limactl shell did not return within 60s (VM ssh wedged?)"; return 0 ;;
        *) log "WARNING: VM root filesystem check failed (rc=$rc) — see $LOG_FILE"; return 0 ;;
    esac
    summary=$(printf '%s\n' "$out" | head -n 1)
    detail=$(printf '%s\n' "$out" | tail -n +2)
    case "$summary" in
        *"repair-flag=installed"*)
            log "VM: added fsck.repair=yes to the guest kernel command line (takes effect at the next VM boot)" ;;
        *"repair-flag=install-failed"*)
            log "WARNING: VM: could not install the fsck.repair=yes grub drop-in — see $LOG_FILE" ;;
    esac
    case "$summary" in
        *"fsck-root=failed"*)
            log "WARNING: VM: the root filesystem check failed on this boot — sshd and Docker only came up by luck until it is repaired ($summary)"
            [ -n "$detail" ] && printf '%s\n' "$detail" >> "$LOG_FILE"
            case "$summary" in
                *"cmdline=yes"*)
                    log "WARNING: VM: fsck.repair=yes was active and still could not repair it — the VM disk needs manual attention" ;;
                *)
                    log "VM: the next VM boot will repair it (fsck.repair=yes)" ;;
            esac ;;
    esac
    return 0
}

# After recover_lima_vm has rebooted a wedged VM, keep the journal of the
# boot that wedged. The guest's journal is persistent, so `journalctl -b -1`
# is the only record of why sshd/Docker never came up — the 2026-10-11
# root cause (see ensure_vm_fsck_repair) sat in it for a month, found only
# by reading it by hand. One log line says what that boot did; the full
# journal lands next to the other logs, named so log rotation treats it
# like any other log type.
save_previous_boot_journal() {
    local who="$1" dir="$DATA_DIR/logs" day path n=1 rc=0
    local fsck=ok emergency=no sysinit=no ssh=no
    [ -n "$DATA_DIR" ] && mkdir -p "$dir" 2>/dev/null || return 0
    day=$(date +%Y-%m-%d)
    while [ -e "$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log" ] \
          || [ -e "$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log.gz" ]; do
        n=$((n + 1))
    done
    path="$dir/vm-wedged-boot-$day-$(printf '%03d' "$n").log"
    vm_shell_bounded 60 sudo journalctl -b -1 --no-pager -o short-monotonic > "$path" || rc=$?
    if [ "$rc" -ne 0 ] || [ ! -s "$path" ]; then
        rm -f "$path"
        log "$who: could not read the previous boot's journal from the VM (rc=$rc)"
        return 0
    fi
    grep -q "fsck failed with exit status" "$path" && fsck=failed
    grep -q "Started emergency.service" "$path" && emergency=yes
    grep -q "Reached target sysinit.target" "$path" && sysinit=yes
    grep -qE "Listening on ssh.socket|Started ssh.service" "$path" && ssh=yes
    log "$who: previous boot: fsck-root=$fsck emergency=$emergency sysinit=$sysinit ssh=$ssh — journal saved to $path"
    return 0
}

# One-time migration of the onion service key volume from its historical
# name. Until 2026-09-25 the delivered PEM lived in onionpress-arti-state at
# state/keystore/hss/<name>/ (arti's keystore layout); it now lives in
# onionpress-onion-keys at <name>/. This runs before the first-run check,
# which keys off the NEW volume's existence — without it an upgraded install
# would look like a fresh one and mint a new address. For the same reason it
# refuses to let the start continue when the copy fails, when the old
# keystore cannot be read (only a keystore the old volume shows to be absent
# counts as nothing to copy), or when Docker cannot say which volumes exist:
# the old volume is left untouched and the next start retries. Until the
# copy is verified, $DATA_DIR/.key-volume-migration-pending says the new
# volume is not to be trusted: a start that finds it beside both volumes (an
# interrupted copy, or a failed one whose volume could not be removed)
# removes the new volume and copies again. Kept identical in the macOS and
# Linux launchers; a test enforces that.
migrate_key_volume() {
    local state=0 old_state=0
    local pending="$DATA_DIR/.key-volume-migration-pending"
    docker_volume_state onionpress-onion-keys || state=$?
    if [ "$state" -eq 2 ]; then
        log "ERROR: Docker did not say whether onionpress-onion-keys exists; not starting"
        return 1
    fi
    if [ "$state" -eq 0 ] && [ ! -e "$pending" ]; then
        return 0
    fi
    docker_volume_state onionpress-arti-state || old_state=$?
    case "$old_state" in
        1) # Nothing to copy from: a fresh install, one that never had the
           # old volume, or one whose volumes a key import or restore wiped.
           if [ "$state" -eq 0 ]; then
               log "WARNING: a key volume migration did not finish and onionpress-arti-state is gone; keeping onionpress-onion-keys as it is"
           fi
           rm -f "$pending"
           return 0 ;;
        2) log "ERROR: Docker did not say whether onionpress-arti-state exists; not starting"
           return 1 ;;
    esac
    if [ "$state" -eq 0 ]; then
        log "A key volume migration did not finish; removing the unverified onionpress-onion-keys to copy again"
        if ! docker volume rm onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
            log "ERROR: could not remove the unverified onionpress-onion-keys; not starting (the old key volume is untouched)"
            return 1
        fi
    fi
    if ! ensure_key_helper_image; then
        log "ERROR: no tor image to migrate the key volume with; not starting (the old key volume is untouched)"
        return 1
    fi
    log "Migrating the onion service key volume: onionpress-arti-state -> onionpress-onion-keys"
    if ! : > "$pending"; then
        log "ERROR: could not write $pending; not starting (the old key volume is untouched)"
        return 1
    fi
    if ! docker volume create onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
        log "ERROR: could not create onionpress-onion-keys; not starting (the old key volume is untouched)"
        return 1
    fi
    # Arti's files are its own user's, in 0700 folders: reading them takes
    # DAC_OVERRIDE. The copy is root's, 0700/0600, as the key seeds make
    # it, so nothing else is needed. The script walks down to the keystore
    # one listed folder at a time, so a folder it cannot list (without
    # DAC_OVERRIDE, say) stops it instead of passing for a missing keystore,
    # as it used to: an empty copy that the next start took for the
    # migrated key. The keystore may hold folders and files only; every
    # name in it has to be in the copy and every file the same bytes.
    if ! docker run --rm \
        --network none \
        --cap-drop ALL \
        --cap-add DAC_OVERRIDE \
        --security-opt no-new-privileges:true \
        -v onionpress-arti-state:/old:ro \
        -v onionpress-onion-keys:/new \
        --entrypoint sh \
        "$KEY_HELPER_IMAGE" -c '
            set -eu
            dir="$1" dest="$2"
            for name in state keystore hss; do
                listing=$(ls -A "$dir")
                if ! printf "%s\n" "$listing" | grep -qxF "$name"; then
                    echo "the old key volume holds no keystore ($dir has no $name): nothing to copy"
                    chmod 700 "$dest"
                    exit 0
                fi
                dir="$dir/$name"
                if [ -L "$dir" ] || [ ! -d "$dir" ]; then
                    echo "$dir is not a folder" >&2
                    exit 1
                fi
            done
            wanted=$(cd "$dir" && find .)
            odd=$(cd "$dir" && find . ! -type d ! -type f)
            if [ -n "$odd" ]; then
                echo "the old keystore holds more than folders and files: $odd" >&2
                exit 1
            fi
            cp -R "$dir/." "$dest/"
            chmod 700 "$dest"
            find "$dest" -mindepth 1 -type d -exec chmod 700 {} +
            find "$dest" -type f -exec chmod 600 {} +
            got=$(cd "$dest" && find .)
            if [ "$(printf "%s\n" "$got" | sort)" != "$(printf "%s\n" "$wanted" | sort)" ]; then
                echo "the copy does not hold what the old keystore holds" >&2
                exit 1
            fi
            differ=$(cd "$dir" && find . -type f ! -exec cmp -s {} "$dest/{}" \; -print)
            if [ -n "$differ" ]; then
                echo "did not copy intact: $differ" >&2
                exit 1
            fi
            echo "copied the old keystore: $(find "$dest" -type f | wc -l) files, each compared with its original"
        ' migrate-key-volume /old /new >> "$LOG_FILE" 2>&1; then
        if docker volume rm onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
            rm -f "$pending"
        fi
        log "ERROR: key volume migration failed; not starting so the old key volume stays intact (see $LOG_FILE)"
        return 1
    fi
    rm -f "$pending"
    log "Key volume migrated; onionpress-arti-state is kept as a fallback until uninstall sweeps it"
    return 0
}

# Image derivatives (issue #257): backups carry original images only, so a
# restore leaves the resized copies (-WxH sizes, -scaled) to be rebuilt. True
# when that rebuild is still owed: the host marker the restore paths write,
# or the marker a backup archive carries inside wp-content/uploads/ (which a
# restore by an OnionPress version that predates the host marker still copies
# into the container). start_containers then runs
# `onionpress.cli regenerate-derivatives` detached in the background; it uses
# `wp media regenerate --only-missing`, so an interrupted sweep resumes on the
# next start, and it clears both markers only when it completes. Kept
# identical in the macOS and Linux launchers; a test enforces that.
regenerate_derivatives_pending() {
    [ -f "$DATA_DIR/.regenerate-derivatives-pending" ] && return 0
    docker exec onionpress-wordpress test -f \
        /var/www/html/wp-content/uploads/.onionpress-regenerate-derivatives >/dev/null 2>&1
}

# Function to start containers
start_containers() {
    log "Starting OnionPress containers..."

    cd "$DOCKER_DIR"

    # Docker has to answer before anything below asks whether a volume
    # exists. Those checks used to read "Docker is not up yet" as "no such
    # volume", and a missing key volume is the first-run signal: upgrading
    # to 2.5.0 on 2026-09-30 while the Colima VM was still booting took the
    # first-run path instead of migrating the key volume.
    #
    # If Docker never answers but Lima still reports the VM Running, the VM
    # is in the wedge recover_lima_vm describes; the login-time start used
    # to give up here (2026-10-02) while the menubar Restart path already
    # knew how to recover. Both now share that recovery, tried once.
    local vol_state key_state
    if ! wait_for_docker_or_recover_vm 180 start; then
        log "ERROR: Docker daemon not ready after 180s (one Lima VM recovery attempted if it was Running); not starting"
        return 1
    fi

    # Docker answers, so the VM is up: make sure its next boot can repair
    # its own root filesystem instead of parking in emergency mode, and
    # say so when this boot's check failed (the wedge recover_lima_vm
    # exists for; see ensure_vm_fsck_repair). Best effort, never blocks.
    ensure_vm_fsck_repair

    # Handle pending key import (volume couldn't be removed when Docker wasn't running)
    if [ -f "$DATA_DIR/.import-key-pending" ]; then
        log "Pending key import detected — removing old key and tor-state volumes..."
        # Both keystores must be wiped: onion-keys holds the delivered PEM key,
        # tor-state holds C Tor's /var/lib/tor/hidden_service/<name>/ pair. The
        # entrypoint only converts PEM→C Tor when CTOR_SECRET is missing, so a
        # stale tor-state would silently override the imported identity. The
        # pre-2026-09-25 volume name goes too, or the migration below would
        # bring the replaced identity back.
        for vol in onionpress-onion-keys onionpress-arti-state onionpress-tor-state; do
            docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
            vol_state=0; docker_volume_state "$vol" || vol_state=$?
            if [ "$vol_state" -eq 0 ]; then
                log "Volume $vol still in use — force-removing containers using it..."
                docker rm -f $(docker ps -aq --filter "volume=$vol") >> "$LOG_FILE" 2>&1 || true
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
                vol_state=0; docker_volume_state "$vol" || vol_state=$?
            fi
            # Only a confirmed absence counts. Dropping the marker while an
            # old keystore survives (or could not be checked) would silently
            # keep the replaced identity, so leave it for the next start.
            if [ "$vol_state" -ne 1 ]; then
                log "ERROR: could not remove the old $vol volume; keeping the pending key import and not starting"
                return 1
            fi
        done
        # Also remove old tor-keys volume if it exists (migration leftover)
        docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
        # No unfinished key volume migration survives a replaced identity.
        rm -f "$DATA_DIR/.key-volume-migration-pending"
        rm -f "$DATA_DIR/.import-key-pending"
    fi

    # Upgraded installs: bring the key volume over from its old name before
    # the first-run check below looks for the new one.
    if ! migrate_key_volume; then
        log "ERROR: cannot start without the onion service key volume"
        return 1
    fi

    # Check if this is first run (no key volume exists). Only Docker's
    # confirmed "no" counts: an unanswered question is not a fresh install.
    key_state=0; docker_volume_state onionpress-onion-keys || key_state=$?
    if [ "$key_state" -eq 2 ]; then
        log "ERROR: Docker did not say whether onionpress-onion-keys exists; not starting"
        return 1
    fi
    if [ "$key_state" -eq 1 ]; then
        log "First run detected - generating custom onion address..."

        # Read address prefix from config, default to "op2"
        # Fall back to old VANITY_PREFIX for migration from older configs
        ADDRESS_PREFIX="op2"
        if [ -f "$DATA_DIR/config" ]; then
            CUSTOM_PREFIX=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
            if [ -z "$CUSTOM_PREFIX" ]; then
                CUSTOM_PREFIX=$(grep "^VANITY_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
            fi
            if [ ! -z "$CUSTOM_PREFIX" ]; then
                ADDRESS_PREFIX="$CUSTOM_PREFIX"
            fi
        fi

        # Validate before announcing it — the old order logged
        # "Using address prefix: 'elphin'" and only then the rejection, so the
        # log's first statement about the prefix was the one that did not
        # happen.
        #
        # These rules mirror config.validate_address_prefix(): base32 (a-z,
        # 2-7), 2 to 5 characters. Keep them in step; the Python side is the
        # source of truth and tests/test_address_prefix.py checks they agree.
        #
        # The fallback is deliberately silent-but-logged rather than fatal: a
        # bad prefix must not stop the app starting. The real guard is
        # validation at the point of entry (setup_window.py), because nobody
        # reads this log — a user who typed "elphin" got an op2… address and
        # the only evidence was here.
        #
        # The character check is [[ =~ ]], which tests the whole value. It
        # was `echo | grep -qE`, which tests each line on its own: a config
        # with two ADDRESS_PREFIX= lines reads as "ab<newline>cd" and passed.
        _prefix_problem=""
        _prefix_re='^[a-z2-7]+$'
        if [ ${#ADDRESS_PREFIX} -gt 5 ]; then
            _prefix_problem="too long (${#ADDRESS_PREFIX} chars, max 5)"
        elif [ ${#ADDRESS_PREFIX} -lt 2 ]; then
            _prefix_problem="too short (${#ADDRESS_PREFIX} chars, min 2)"
        elif ! [[ $ADDRESS_PREFIX =~ $_prefix_re ]]; then
            _prefix_problem="contains characters that are not base32 (only a-z and 2-7; 0, 1, 8 and 9 are not valid)"
        fi

        if [ -n "$_prefix_problem" ]; then
            # Closest valid prefix, by the same rule the Python validator uses:
            # lowercase, drop non-base32, truncate to 5.
            _prefix_suggestion=$(echo "$ADDRESS_PREFIX" | tr '[:upper:]' '[:lower:]' \
                | tr -cd 'a-z2-7' | cut -c1-5)
            log "ERROR: ADDRESS_PREFIX '$ADDRESS_PREFIX' is $_prefix_problem."
            if [ ${#_prefix_suggestion} -ge 2 ]; then
                log "       Falling back to 'op2'. To use the closest valid prefix, set"
                log "       ADDRESS_PREFIX=$_prefix_suggestion in $DATA_DIR/config before first launch."
            else
                log "       Falling back to 'op2'. Edit ADDRESS_PREFIX in $DATA_DIR/config."
            fi
            ADDRESS_PREFIX="op2"
            unset _prefix_suggestion
        fi
        unset _prefix_problem _prefix_re

        log "Using address prefix: '$ADDRESS_PREFIX'"

        # Check for pre-existing imported key before generating a new one
        VANITY_DIR=""
        if [ -d "$DATA_DIR/shared/vanity-keys" ]; then
            VANITY_DIR=$(vanity_key_dir || true)
            if [ -n "$VANITY_DIR" ]; then
                log "Using pre-imported key: $(basename "$VANITY_DIR")"
            fi
        fi

        # Generate custom onion address if no imported key found
        if [ -z "$VANITY_DIR" ]; then
            if VANITY_DIR=$(generate_vanity_address "$ADDRESS_PREFIX"); then
                log "Custom onion address generated successfully"
            fi
        fi

        if [ -n "$VANITY_DIR" ]; then
            # The seed runs from the stack's tor image, which a first run
            # has not pulled yet.
            if ! ensure_key_helper_image; then
                log "ERROR: no tor image to install the address key with; not starting (the key stays in $VANITY_DIR for the next start)"
                return 1
            fi
            # Create the key volume and install the PEM where the entrypoint
            # looks for it (<name>/ks_hs_id.ed25519_expanded_private, read as root)
            if ! docker volume create onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
                log "ERROR: Failed to create the onionpress-onion-keys volume"
                return 1
            fi
            # Root reads the key out of the user's 0700 folder. virtiofs
            # leaves that check to macOS, which allows it; DAC_OVERRIDE is
            # for a mount that enforces it in the VM (the untested qemu/sshfs
            # fallback), as cli.py's same seed needs on Linux. The key needs
            # no network, and gets none.
            if ! docker run --rm \
                --network none \
                --cap-drop ALL \
                --cap-add DAC_OVERRIDE \
                --security-opt no-new-privileges:true \
                -v onionpress-onion-keys:/dest \
                --mount type=bind,source="$VANITY_DIR",target=/src,readonly \
                --entrypoint sh \
                "$KEY_HELPER_IMAGE" -c 'mkdir -p /dest/wordpress && cp /src/ks_hs_id.ed25519_expanded_private /dest/wordpress/ && chown -R 0:0 /dest && chmod 700 /dest /dest/wordpress && chmod 600 /dest/wordpress/*' >> "$LOG_FILE" 2>&1; then
                # Left behind, the volume would end the first run: the next
                # start would never install this key, and Tor would mint a
                # random address. Without it, the next start tries again.
                if ! docker volume rm onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
                    log "ERROR: could not remove the onionpress-onion-keys volume the key did not reach; remove it (docker volume rm onionpress-onion-keys) before the next start, or Tor will start without the key"
                fi
                log "ERROR: Failed to copy address key to the onionpress-onion-keys volume; not starting"
                return 1
            fi

            log "Address key installed to the onionpress-onion-keys volume"
            log "Onion address: $(cat "$VANITY_DIR/hostname" 2>/dev/null || basename "$VANITY_DIR")"
        else
            # Vanity generation failed. Continue with a random address so
            # the user gets a working install, but leave detailed
            # diagnostic lines in the log (written by generate_vanity_address)
            # so we can find out after the fact why the op2… generation
            # didn't work. Common cause: quarantined nested mkp224o helper
            # on a fresh Apple Silicon install from onionpress.org.
            log "WARNING: vanity generation failed — continuing with random onion address (see ERROR lines above)"
        fi
    else
        # Not first run. The vanity prefix is fixed at install (#256 phase 4b)
        # — the old "config ADDRESS_PREFIX changed -> regenerate the onion
        # identity on startup" path was removed: it shared the churny
        # compose-down + delete-key-volume + regenerate flow and risked
        # clobbering the address. Nothing to do here.
        :
    fi

    # Update images if enabled in config
    update_images

    # Pull the images compose is about to start, but only the ones not
    # already here. This runs on every start, regardless of UPDATE_ON_LAUNCH —
    # update_images() above is the separate, opt-in refresh. Until 2.5.3 this
    # was an unconditional `docker compose pull`, so every launch did
    # clearnet DNS and registry traffic for images it already had, and the
    # then-floating mariadb and autoheal tags could change under the user
    # (issue #36). With every image pinned by digest, `--policy missing`
    # (the Linux launcher's policy since v2.4.99) pulls exactly what a new
    # OnionPress release moved a pin to, and nothing on an ordinary launch.
    if using_local_images; then
        log "Skipping image pull: running locally built images"
    else
        log "Pulling pre-built images (missing only)..."
        docker compose pull --policy missing >> "$LOG_FILE" 2>&1 || log "WARNING: Failed to pull images (using cached)"
    fi

    # WordPress's network is shut before anything starts on it.
    block_wordpress_egress

    # Nothing from before the OnionHeaven data volume may run beside the
    # containers about to start (the data move must not race them).
    retire_old_onionheaven_containers

    # The Tor side's network on its fixed bridge, for its rules (once).
    migrate_tor_network

    # Always start WordPress and DB first
    local max_attempts=3
    local attempt=1
    while [ $attempt -le $max_attempts ]; do
        if docker compose up -d wordpress db onionheaven autoheal >> "$LOG_FILE" 2>&1; then
            break
        fi
        log "WARNING: 'docker compose up -d wordpress db onionheaven autoheal' failed (attempt $attempt/$max_attempts). Check $LOG_FILE for details."
        if [ $attempt -eq $max_attempts ]; then
            log "ERROR: 'docker compose up -d wordpress db onionheaven autoheal' failed after $max_attempts attempts."
            return 1
        fi
        attempt=$((attempt + 1))
        sleep 5
    done
    log "WordPress, DB, and Tor client containers starting"

    # Wait for WordPress container to be ready before checking install status
    local wp_wait=0
    while [ $wp_wait -lt 60 ]; do
        if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT:-8080}" >/dev/null 2>&1; then
            break
        fi
        sleep 2
        wp_wait=$((wp_wait + 2))
    done
    if [ $wp_wait -ge 60 ]; then
        log "WARNING: WordPress did not answer on :${ONIONPRESS_WP_PORT:-8080} within 60s — continuing; the install check below may misreport a slow database as a fresh site"
    fi

    # Check if WordPress is already set up (admin account created)
    # Retry a few times — the DB may still be warming up even though
    # WordPress HTTP is responding (wp core is-installed needs a live DB)
    # 15 tries x 2s, matching the Linux launcher: 5 was short enough that a
    # cold MariaDB (e.g. MARIADB_AUTO_UPGRADE after an image refresh) read as
    # "WordPress not yet installed" and skipped the per-start repairs.
    local wp_installed=false
    local wp_check=0
    while [ $wp_check -lt 15 ]; do
        if wp_is_installed; then
            wp_installed=true
            break
        fi
        sleep 2
        wp_check=$((wp_check + 1))
    done

    # Ensure .htaccess exists — WordPress REST API (block editor publishing)
    # requires rewrite rules. These can be lost if WordPress auto-updates or
    # the volume is recreated. Check on every launch, not just first setup.
    if $wp_installed; then
        log "WordPress is installed"
        if ! docker exec onionpress-wordpress test -s /var/www/html/.htaccess 2>/dev/null; then
            log "Restoring .htaccess rewrite rules (missing or empty)"
            # Written as www-data, whose folder the web root is (wp_put).
            if wp_put /var/www/html/.htaccess 644 2>>"$LOG_FILE" << "HTEOF"
# Privacy: prevent onion address leaking in Referer headers
<IfModule mod_headers.c>
Header set Referrer-Policy "no-referrer"
</IfModule>

# My Creations is a publishing folder: serve its files, never run them
RewriteEngine On
RewriteCond %{REQUEST_URI} /wp-content/creations/ [NC]
RewriteCond %{REQUEST_URI} \.(php[0-9]*|pht(ml)?|phar|phps|cgi|shtml)(/|$) [NC]
RewriteRule ^ - [F]
# ...and never its hidden files and folders (.git/, .DS_Store, .thumbs/)
RewriteCond %{REQUEST_URI} /wp-content/creations/(.*/)?\. [NC]
RewriteRule ^ - [F]

# Blog importer snapshots (drafts, private posts, author emails) went to
# blog-archives/ through 2.5.2. They live in the hidden .blog-archives/ now;
# until the importer has moved the old folder there, refuse it as well.
RewriteCond %{REQUEST_URI} /wp-content/creations/blog-archives(/|$) [NC]
RewriteRule ^ - [F]

# Uploads are media: serve them, never run them
RewriteCond %{REQUEST_URI} /wp-content/uploads/ [NC]
RewriteCond %{REQUEST_URI} \.(php[0-9]*|pht(ml)?|phar|phps|cgi|shtml)(/|$) [NC]
RewriteRule ^ - [F]

# BEGIN WordPress Multisite
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]

# add a trailing slash to /wp-admin
RewriteRule ^([_0-9a-zA-Z.-]+/)?wp-admin$ $1wp-admin/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([_0-9a-zA-Z.-]+/)?(wp-(content|admin|includes).*) $2 [L]
RewriteRule ^([_0-9a-zA-Z.-]+/)?(.*\.php)$ $2 [L]
RewriteRule . index.php [L]
# END WordPress Multisite
HTEOF
            then
                log "✓ .htaccess restored"
            else
                log "WARNING: Failed to restore .htaccess"
            fi
        fi
    else
        log "WordPress not yet installed — will be configured by setup window"
    fi

    # Always start Tor — generate the onion address in parallel with WordPress
    # setup so it's ready when the user finishes configuring.
    log "Starting Tor containers..."
    docker compose up -d tor onionheaven >> "$LOG_FILE" 2>&1 \
        || { log "ERROR: Failed to start tor/onionheaven containers (rc=$?) — see $LOG_FILE"; START_ERRORS="$START_ERRORS tor"; }

    # Put the pinned Internet Archive Link Fixer and Cache Enabler releases
    # in place (downloaded over Tor, checked against their pins).
    # setup_bundled_plugins configures and activates them below, once
    # provision-post-install has installed the mu-plugins that say what
    # they may do.
    install_ia_plugin
    install_cache_enabler

    # The WP-side post-start provisioning is shared with Linux now:
    # deactivate-wp-statistics, then provision-post-install (which
    # internally handles ensure_multisite, install_multisite_domain_map,
    # install_onionpress_theme, the perm fixes, and the shared-onion-address
    # write — in the right order), then setup_bundled_plugins.
    # See src/onionpress/multisite.py.
    # install-from-backup: if a backup was staged for this install, import its
    # DB + content into the now-running containers BEFORE the WP provisioning
    # below, so provision-post-install and the plugin setup operate on the
    # restored site.
    # provision-post-install then refreshes the OnionPress-managed theme/
    # mu-plugins/sunrise.php to the CURRENT version, fixing any backup version skew.
    _ifb_marker="$DATA_DIR/.install-from-backup"
    _ifb_staging=""
    if [ -f "$_ifb_marker" ]; then
        _ifb_staging=$(head -1 "$_ifb_marker" 2>/dev/null)
        if [ -n "$_ifb_staging" ] && [ -d "$_ifb_staging" ]; then
            log "Install-from-backup: importing artifacts from $_ifb_staging"
            if ! bundled_python -m onionpress.cli import-backup-artifacts --staging "$_ifb_staging"; then
                log "ERROR: install-from-backup import failed — leaving marker for retry"
                _ifb_staging=""
            fi
        else
            log "Install-from-backup: marker present but staging missing ($_ifb_staging); ignoring"
            _ifb_staging=""
        fi
    fi

    # Each of these exits 1 on failure; under set -e a bare call would end
    # `onionpress start` here with only a traceback on stderr, skipping the
    # timezone, clearnet-logging and readiness steps. Log and carry on.
    local _step
    for _step in deactivate-wp-statistics; do
        bundled_python -m onionpress.cli "$_step" >> "$LOG_FILE" 2>&1 \
            || { log "WARNING: $_step failed (rc=$?) — continuing; see $LOG_FILE"; START_ERRORS="$START_ERRORS $_step"; }
    done
    bundled_python -m onionpress.cli provision-post-install \
        --themes-dir "$RESOURCES_DIR/themes" \
        --plugins-dir "$RESOURCES_DIR/plugins" >> "$LOG_FILE" 2>&1 \
        || { log "WARNING: provision-post-install failed (rc=$?) — themes/plugins may be missing; see $LOG_FILE"; START_ERRORS="$START_ERRORS provision-post-install"; }
    setup_bundled_plugins

    # install-from-backup: clean up staging + marker only after a successful
    # import + provisioning, so an interrupted run re-imports on the next start.
    if [ -n "$_ifb_staging" ]; then
        rm -rf "$_ifb_staging"
        rm -f "$_ifb_marker"
        log "Install-from-backup: complete (staging cleaned up)"
    fi

    # Image derivatives (#257): if a restore left resized images to rebuild,
    # do it in the background — niced, detached from this script's job table
    # (see the subshell note below), resumable across restarts. After
    # provision-post-install so the image-fallback mu-plugin is in place.
    if $wp_installed && regenerate_derivatives_pending; then
        log "Image derivatives: rebuild pending — starting in the background"
        ( bundled_python -m onionpress.cli regenerate-derivatives >> "$LOG_FILE" 2>&1 & )
    fi

    # Tor-routed archive.org login can take 30s — background it so the
    # rest of start_containers returns promptly. No-op if keys are set.
    # Run it from a subshell so it is not in this script's job table: the
    # EXIT trap kills $(jobs -p), and `onionpress start` returns within a
    # second on a not-yet-installed site, which used to SIGTERM this 30s
    # login every time with nothing in the log.
    ( bundled_python -m onionpress.cli ensure-archive-s3-keys >> "$LOG_FILE" 2>&1 & )

    # Configure site timezones to match the host machine so imported
    # social-media timestamps display in local time. Idempotent.
    configure_site_timezones

    # Conditionally start Cloudflare Tunnel
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        log "Cloudflare Tunnel enabled, starting cloudflared..."
        docker compose $CF_COMPOSE up -d cloudflared >> "$LOG_FILE" 2>&1 || log "ERROR: Failed to start cloudflared container"
    else
        # Stop cloudflared if it was previously running but token was removed
        docker stop onionpress-cloudflared 2>/dev/null || true
    fi
}

# WordPress and MariaDB reach nothing outside Docker (issue #144). Their
# network's bridge (onionpress-wp0, docker-compose.yml) gets the
# ONIONPRESS-WP chain in the Colima VM before anything starts on it: only
# replies to connections made from outside (the published port,
# docker-proxy) leave the bridge or reach the VM itself. A docker.service
# drop-in in the VM puts the chain back before Docker restarts any container
# after a VM boot. The rules and how they get there: onionpress/
# wordpress_egress.py (shared with Linux and ContainerManager.start_core).
#
# The same call shuts the Tor side (onionpress-network, bridge
# onionpress-tor0: tor, onionheaven, cloudflared, takeover workers) off from
# the VM and private addresses, among them the VM's gateway, which Lima maps
# to this Mac's 127.0.0.1 (every service on the Mac's loopback was theirs,
# and through Lima's forward WordPress's port, arriving as the gateway
# auto-login trusts), and refuses WordPress's published port to every
# container (ONIONPRESS_WP_PORT, with this user's offset).
#
# This replaces the clearnet logging that used to run here after the
# containers were up: LOG rules keyed by WordPress's and MariaDB's
# addresses on onionpress-network, which only logged. The chain removes
# them, and logs what it refuses as "CLEARNET-blocked:", which the
# menubar's dmesg poller still collects.
#
# Best effort, like the other start steps: without the chain the site still
# starts (WordPress's own requests still go through Tor), and the log and
# the start summary say so. The Python side bounds `limactl shell`, which
# hangs for good when the VM's sshd is wedged.
block_wordpress_egress() {
    local out rc=0
    out=$(bundled_python -m onionpress.cli --data-dir "$DATA_DIR" wordpress-egress \
        --bin-dir "$BIN_DIR" --wp-port "$ONIONPRESS_WP_PORT" 2>>"$LOG_FILE") || rc=$?
    if [ "$rc" -eq 0 ]; then
        log "✓ WordPress network egress block in place: $out"
    else
        log "WARNING: WordPress network egress block not in place: ${out:-rc=$rc}. WordPress and MariaDB can reach the network directly, and the Tor-side containers this Mac's own services — see $LOG_FILE"
        START_ERRORS="$START_ERRORS wordpress-egress"
    fi
    return 0
}

# Function to stop containers
stop_containers() {
    log "Stopping OnionPress containers..."
    # Stop farm containers first (they depend on the onionheaven container's DB)
    stop_onionheaven_farm
    cd "$DOCKER_DIR"
    # Stop all containers (including onionheaven; cloudflared via override file if token set)
    docker compose $CF_COMPOSE down 2>&1 | tee -a "$LOG_FILE"
    log "Containers stopped"
}

# Reap lima's shared usernet daemon. It survives `colima stop` and leaks
# across restarts, holding the user-v2 network sockets — the likely cause of
# the next *cold* boot wedging (fresh VM's guest agent can't bring up
# networking -> gray icon; the same "5x in 30 days" wedge the restart path
# recovers via limactl stop -f). lima respawns it on the next start, so
# reaping at quit is safe
# and leaves a clean slate. Scoped by LIMA_HOME so multi-user installs don't
# touch each other; kill is per-user anyway. Mirrors _reap_lima_usernet in
# src/menubar.py for the path where the MenubarApp was SIGKILLed and never
# ran its own cleanup.
reap_lima_usernet() {
    local pidfile pid cmd
    for pidfile in "$LIMA_HOME"/_networks/*/usernet_*.pid; do
        [ -f "$pidfile" ] || continue
        pid=$(tr -d '[:space:]' < "$pidfile" 2>/dev/null)
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        cmd=$(ps -o command= -p "$pid" 2>/dev/null)
        case "$cmd" in
            *limactl*usernet*"$LIMA_HOME"*)
                log "quit: reaping leaked lima usernet daemon (pid $pid)"
                kill -TERM "$pid" 2>/dev/null || true
                ;;
        esac
    done
}

# Function to get container status
get_status() {
    cd "$DOCKER_DIR"
    # Convert newline-delimited JSON to JSON array
    docker compose ps --format json 2>/dev/null | jq -s '.' 2>/dev/null || echo "[]"
}

# Function to get onion address (non-blocking, single attempt)
get_onion_address() {
    cd "$DOCKER_DIR"
    ONION_ADDR=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
    # The whole value must be an onion address: callers cache it and put it
    # into URLs. Anything else reads as not generated yet.
    if is_onion_address "$ONION_ADDR"; then
        echo "$ONION_ADDR"
        return 0
    fi
    echo "Generating..."
    return 1
}

# Function to get healthcheck onion address (non-blocking, single attempt)
get_healthcheck_address() {
    cd "$DOCKER_DIR"
    local addr
    addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/healthcheck/hostname 2>/dev/null || echo "")
    if is_onion_address "$addr"; then
        echo "$addr"
        # Save to data dir for menubar app to read
        echo "$addr" > "$DATA_DIR/healthcheck-address"
        return 0
    fi
    return 1
}

# Function to wait for services to be ready using active probing
wait_for_services() {
    cd "$DOCKER_DIR"
    local max_wait=120
    local waited=0
    local wp_ready=false
    local onion_ready=false
    local onion_addr=""

    log "Waiting for services to be ready (polling with curl)..."

    while [ $waited -lt $max_wait ]; do
        # Step 1: Get onion address if we don't have it yet
        if [ -z "$onion_addr" ] || [ "$onion_addr" = "Generating..." ]; then
            onion_addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
        fi

        # Step 2: Check if WordPress is responding locally
        if [ "$wp_ready" = false ]; then
            if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT:-8080}" >/dev/null 2>&1; then
                log "✓ WordPress is responding on localhost:${ONIONPRESS_WP_PORT:-8080}"
                log "Waiting for Tor to bootstrap and onion service to be reachable (est. 30-90s)..."
                wp_ready=true

                # If WordPress is not yet installed, skip waiting for Tor
                if ! wp_is_installed; then
                    log "WordPress not installed — setup required, skipping Tor wait"
                    return 0
                fi
            fi
        fi

        # Step 3: Check Tor bootstrap and WordPress reachable from Tor container
        # (SOCKS proxy doesn't work through Colima VM port forwarding,
        # so we test the actual path: tor -> wordpress via Docker network)
        if [ "$onion_ready" = false ] && [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
            # Check Tor is bootstrapped
            if docker compose logs --tail 100 tor 2>/dev/null | grep -q -E "Bootstrapped 100% \(done\)|Sufficiently bootstrapped"; then
                # Check WordPress is reachable from Tor container
                if docker compose exec -T tor wget -q -O /dev/null --timeout=5 http://wordpress:80/ 2>/dev/null; then
                    log "✓ Onion service ready: ${onion_addr}"
                    onion_ready=true
                fi
            fi
        fi

        # Both ready — done
        if [ "$wp_ready" = true ] && [ "$onion_ready" = true ]; then
            log "All services are ready after ${waited}s"
            ONION_ADDR="$onion_addr"
            # Read and save healthcheck address
            if hc_addr=$(get_healthcheck_address); then
                log "Healthcheck address: ${hc_addr}"
            fi

            # Write onion address to shared volume for WordPress plugins
            write_shared_onion_address 2>>"$LOG_FILE" && \
                log "✓ Onion address written to shared volume" || \
                log "WARNING: Failed to write onion address to shared volume"

            return 0
        fi

        sleep 2
        waited=$((waited + 2))
    done

    # Timed out — report what we have
    log "WARNING: Services not fully ready after ${max_wait}s (wp=${wp_ready}, onion=${onion_ready})"
    if [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
        ONION_ADDR="$onion_addr"
    else
        ONION_ADDR="Generating..."
    fi
    # The WARNING above is the report. Returning 1 here ended `onionpress
    # start` under set -e before the start summary and the "running" lines,
    # and the Linux launcher already returns 0; a slow Tor bootstrap is not
    # a failed start.
    return 0
}

# Main execution
# ─── Validate OnionHeaven address ─────────────────────────────────────
# Returns JSON: {"valid":true/false, "status":"hub"|"site"|"unreachable"|"self"|"invalid_format", "message":"..."}
# Called by: menubar settings dialog, WordPress settings page
_validate_oh_address() {
    local addr="$1"

    # Format check: the whole value, as is_onion_address does. This was a
    # length of 62 and `echo | grep '\.onion$'`, which tests each line on
    # its own and passed any 62 characters ending in ".onion" (a clearnet
    # host and path included) on to curl.
    if ! is_onion_address "$addr"; then
        echo '{"valid":false,"status":"invalid_format","message":"Address must be a valid 56-character .onion address."}'
        return 1
    fi

    # Self check — compare against our own address
    local our_address="" our_key_dir=""
    our_key_dir=$(vanity_key_dir || true)
    if [ -n "$our_key_dir" ]; then
        our_address=$(basename "$our_key_dir")
    fi
    if [ -z "$our_address" ]; then
        our_address=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
    fi
    if [ -n "$our_address" ] && [ "$addr" = "$our_address" ]; then
        echo '{"valid":false,"status":"self","message":"You cannot use your own onion address as the OnionHeaven hub."}'
        return 1
    fi

    # Probe the OnionHeaven API endpoint (:8083/status)
    local api_result
    api_result=$(docker exec onionheaven curl -s --max-time 30 \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}:8083/status" 2>/dev/null) || true

    if [ -n "$api_result" ] && echo "$api_result" | grep -q '"version"'; then
        # Every node answers /status, but only a hub accepts registrations.
        # Images from before that gate omit the field; they took them all.
        if echo "$api_result" | grep -q '"accepting_registrations": *false'; then
            echo '{"valid":true,"status":"site","message":"This address runs OnionPress but is not an OnionHeaven hub, so it will refuse registrations."}'
            return 0
        fi
        echo '{"valid":true,"status":"hub","message":"Valid OnionHeaven hub."}'
        return 0
    fi

    # API didn't respond — try the base address (port 80)
    local http_code
    http_code=$(docker exec onionheaven curl -s --max-time 30 \
        -o /dev/null -w "%{http_code}" \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}/" 2>/dev/null) || true

    if [ "$http_code" = "200" ] || [ "$http_code" = "301" ] || [ "$http_code" = "302" ]; then
        echo '{"valid":true,"status":"site","message":"This address is reachable but is not running OnionHeaven yet."}'
        return 0
    fi

    echo '{"valid":true,"status":"unreachable","message":"Could not reach this address over Tor. It may be offline or invalid."}'
    return 0
}

# ===========================================================================
# CLI subcommands: setup, backup, restore, reset
# ===========================================================================

setup_wordpress_cli() {
    local wp_user="" wp_pass="" wp_email="" wp_title="OnionPress"
    local from_backup_pass="" from_backup_path=""

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --user)  wp_user="$2";  shift 2 ;;
            --pass)  wp_pass="$2";  shift 2 ;;
            --email) wp_email="$2"; shift 2 ;;
            --title) wp_title="$2"; shift 2 ;;
            --from-backup)
                from_backup_pass="$2"
                from_backup_path="$3"
                shift 3 ;;
            *) shift ;;
        esac
    done

    # Set when --from-backup copied the backup's key in (the setup command
    # then has the start install it); a backup without one leaves this
    # install's key alone.
    SETUP_BACKUP_KEY_RESTORED=""
    # --from-backup mode: extract config from backup, use dummy WP credentials
    # (restore will overwrite the database with real users afterward)
    if [ -n "$from_backup_pass" ]; then
        if [ -z "$from_backup_path" ] || [ ! -f "$from_backup_path" ]; then
            echo "Usage: $0 setup --from-backup <password> <backup.zip>"
            return 1
        fi
        echo "  Extracting config from backup..."
        local staging
        staging=$(mktemp -d -t onionpress-setup-XXXXXX)
        trap "rm -rf '$staging'" RETURN
        # Either backup format; format 2 needs the Python decoder (plain
        # unzip can't read it). The password goes over stdin, not argv.
        if ! printf '%s' "$from_backup_pass" | bundled_python -m onionpress.cli extract-backup --archive "$from_backup_path" --dest "$staging" >>"$LOG_FILE" 2>&1; then
            echo "ERROR: Failed to extract backup (wrong password, corrupt zip or not a valid OnionPress backup)" >&2
            return 1
        fi
        # metadata.json and the key files are whoever made the backup file's
        # (a password proves nothing about that). backup-address checks
        # them and prints the address the key belongs to, or nothing if the
        # backup has no key; that address names a directory below, so it is
        # never read from metadata.json. Refused before anything is copied.
        local onion_address
        if ! onion_address=$(bundled_python -m onionpress.cli backup-address --staging "$staging" 2>>"$LOG_FILE") \
            || { [ -n "$onion_address" ] && ! is_onion_address "$onion_address"; }; then
            echo "ERROR: Not a valid OnionPress backup (invalid metadata or onion service key)" >&2
            return 1
        fi
        # Restore the backup's user preferences. The backup's config is
        # its author's: every other key keeps this install's value
        # (backup.RESTORABLE_CONFIG), never a straight copy.
        if bundled_python -m onionpress.cli restore-config --staging "$staging" --config "$DATA_DIR/config" \
            --address "$onion_address" 2>>"$LOG_FILE"; then
            log "Setup: restored settings from backup"
            echo "  Settings restored from backup."
        fi
        # Restore vanity keys if present (accept either C Tor or Arti format)
        if { [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] || [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ]; } && [ -f "$staging/metadata.json" ]; then
            if [ -n "$onion_address" ]; then
                rm -rf "$DATA_DIR/shared/vanity-keys/"
                local addr_dir="$DATA_DIR/shared/vanity-keys/$onion_address"
                mkdir -p "$addr_dir"
                [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] && cp "$staging/tor-keys/hs_ed25519_secret_key" "$addr_dir/"
                [ -f "$staging/tor-keys/hs_ed25519_public_key" ] && cp "$staging/tor-keys/hs_ed25519_public_key" "$addr_dir/"
                [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ] && cp "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" "$addr_dir/"
                echo "$onion_address" > "$addr_dir/hostname"
                log "Setup: restored Tor keys for $onion_address from backup"
                echo "  Tor keys restored from backup ($onion_address)."
                SETUP_BACKUP_KEY_RESTORED=yes
            fi
        fi
        if [ "$SETUP_BACKUP_KEY_RESTORED" != "yes" ]; then
            # A backup without an onion service key (a Mac Settings page
            # backup): this install keeps the key and address it has.
            log "Setup: the backup holds no onion service key; this install keeps its own"
            echo "  This backup holds no onion service key: this install keeps its own address."
        fi
        # Use dummy credentials — restore will overwrite the database
        wp_user="admin"
        wp_pass="$from_backup_pass"
        wp_email="admin@onionpress.local"
        echo "  Installing WordPress with temporary credentials (restore will overwrite)..."
    fi

    # If credentials not provided, prompt interactively
    if [ -z "$wp_user" ] || [ -z "$wp_pass" ]; then
        echo ""
        echo "  ======================================="
        echo "  OnionPress First-Time Setup"
        echo "  ======================================="
        echo ""
        echo "  Create your WordPress admin account."
        echo "  You'll use these credentials to log in at /wp-admin."
        echo ""

        if [ -z "$wp_user" ]; then
            while [ -z "$wp_user" ]; do
                printf "  Admin username: "
                read wp_user
                if [ -z "$wp_user" ]; then
                    echo "  Username cannot be empty."
                fi
            done
        fi

        if [ -z "$wp_pass" ]; then
            local wp_pass2=""
            while [ -z "$wp_pass" ]; do
                printf "  Admin password: "
                stty -echo 2>/dev/null
                read wp_pass
                stty echo 2>/dev/null
                echo ""
                if [ -z "$wp_pass" ]; then
                    echo "  Password cannot be empty."
                    continue
                fi
                printf "  Confirm password: "
                stty -echo 2>/dev/null
                read wp_pass2
                stty echo 2>/dev/null
                echo ""
                if [ "$wp_pass" != "$wp_pass2" ]; then
                    echo "  Passwords do not match. Try again."
                    wp_pass=""
                fi
            done
        fi

        printf "  Site title [OnionPress]: "
        read wp_title_input
        if [ -n "$wp_title_input" ]; then
            wp_title="$wp_title_input"
        fi
    fi

    if [ -z "$wp_email" ]; then
        wp_email="${wp_user}@onionpress.local"
    fi

    echo ""
    echo "  Installing WordPress (multisite)..."
    log "Running WP-CLI core multisite-install for first-time setup"

    # No --admin_password: ps shows every user's command lines. wp-cli
    # generates a password, printed on the stdout dropped here, and
    # wp_set_user_password then sets the user's on stdin.
    if wp_cli core multisite-install \
        --url="http://localhost" \
        --title="$wp_title" \
        --admin_user="$wp_user" \
        --admin_email="$wp_email" \
        --skip-email >/dev/null 2>>"$LOG_FILE"; then
        log "WordPress multisite installed successfully via WP-CLI"
    else
        log "ERROR: WP-CLI core multisite-install failed"
        echo "  ERROR: WordPress installation failed. Check $LOG_FILE for details."
        return 1
    fi
    if ! wp_set_user_password "$wp_user" "$wp_pass" >> "$LOG_FILE" 2>&1; then
        log "ERROR: setting the WordPress admin password failed"
        echo "  ERROR: WordPress was installed, but the admin password could not be set. Check $LOG_FILE for details."
        return 1
    fi
    echo "  WordPress installed successfully!"
}

main() {
    case "${1:-start}" in
        start)
            # PID lock — prevent double-starting
            if [ -f "$PIDFILE" ]; then
                # If PID file is older than system boot, it's from a previous
                # boot session — definitely stale (PID may have been recycled)
                boot_sec=$(sysctl -n kern.boottime 2>/dev/null | sed 's/.*sec = \([0-9]*\).*/\1/')
                pid_mtime=$(stat -f %m "$PIDFILE" 2>/dev/null || echo 0)
                if [ -n "$boot_sec" ] && [ "$pid_mtime" -lt "$boot_sec" ] 2>/dev/null; then
                    log "Removing stale PID file from previous boot"
                    rm -f "$PIDFILE"
                else
                    old_pid=$(cat "$PIDFILE" 2>/dev/null)
                    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                        echo "OnionPress is already running (PID $old_pid)." >&2
                        osascript -e 'display dialog "OnionPress is already running." buttons {"OK"} default button "OK" with icon caution with title "OnionPress"' 2>/dev/null || true
                        exit 1
                    fi
                    # Stale pid file — process no longer running
                    rm -f "$PIDFILE"
                fi
            fi
            echo $$ > "$PIDFILE"
            # On exit: clean PID file and kill our background children.
            # The `|| true` is load-bearing: under `set -e`, a failing command
            # inside the EXIT trap becomes the SCRIPT's exit status. `kill`
            # fails when the jobs table is empty or only holds already-finished
            # jobs — so a fully successful `start` exited 1 whenever its
            # background children happened to finish first (race), which any
            # caller that checks the exit code (a managing app's stack installer) read
            # as a start failure.
            trap 'rm -f "$PIDFILE"; kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM HUP

            # Note: orphaned background processes from previous launches may exist
            # but are harmless (sleeping poll loops). The exit trap kills our own
            # children, and the PID lock prevents double-starting.

            # Detect container runtime (install if needed on first run)
            if ! RUNTIME=$(detect_container_runtime); then
                install_docker || exit $?
                # Re-detect after install
                RUNTIME=$(detect_container_runtime) || { log "ERROR: Container runtime still not available after install"; exit 1; }
            fi

            log "Detected container runtime: $RUNTIME"

            # Point DOCKER_HOST at our own VM's socket (never a foreign Colima)
            ensure_docker_socket || true

            # Setup database passwords (generates random passwords on first run)
            setup_db_passwords

            # Start containers
            start_containers

            # Actively poll until services are ready (replaces fixed sleep)
            wait_for_services

            log_start_summary

            log "OnionPress is running!"
            log "Onion address: $ONION_ADDR"
            log "Local access: http://localhost:${ONIONPRESS_WP_PORT:-8080}"
            log "OnionPress is now running! Check the menu bar for status."
            ;;

        stop)
            setup_db_passwords
            stop_containers
            ;;

        quit)
            # CLI-equivalent of the menubar Quit button: take the app
            # fully off — MenubarApp, containers, Colima VM, PID lock.
            # If the MenubarApp is alive, SIGTERM it: that fires
            # NSApplicationWillTerminateNotification → _handle_terminate
            # which runs the full cleanup synchronously. Then we run
            # the process-independent steps as belt-and-suspenders so
            # this command is always a reliable teardown for scripting,
            # CI, pre-update, and pre-scrub — even if the MenubarApp
            # was already gone or got SIGKILLed.

            FAILED_STEPS=""

            # Capture MenubarApp PID. Prefer the PID file
            # (authoritative), but fall back to pgrep — the PID file
            # can be missing after a prior unclean shutdown, manual rm,
            # or a MenubarApp code path that never wrote it, and we
            # still need to find and stop the running MenubarApp in
            # that case. `-u $(whoami)` restricts to this user's
            # processes per the multi-user rule in CLAUDE.md.
            MENUBAR_PID=""
            if [ -f "$PIDFILE" ]; then
                MENUBAR_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
            fi
            if [ -z "$MENUBAR_PID" ] || ! kill -0 "$MENUBAR_PID" 2>/dev/null; then
                # Match the py2app-frozen MenubarApp binary path, anchored
                # so only a command line that IS that executable matches —
                # not a shell, grep or tail that merely names the path in
                # its arguments (a bare substring match would SIGTERM
                # those instead of the app).
                MENUBAR_PID=$(pgrep -u "$(whoami)" -f '^[^ ]*MenubarApp/Contents/MacOS/OnionPress( |$)' 2>/dev/null | head -1)
            fi

            if [ -n "$MENUBAR_PID" ] && kill -0 "$MENUBAR_PID" 2>/dev/null; then
                log "quit: SIGTERM to MenubarApp (pid $MENUBAR_PID)"
                kill -TERM "$MENUBAR_PID" 2>/dev/null || true
                # Wait up to 60s for graceful exit. _handle_terminate
                # runs ~90s in the worst case (30s launcher stop + 60s
                # colima stop) but in practice exits well before that.
                # We need to stay under ~90s total or we SIGKILL mid-
                # cleanup and leave things wedged.
                WAITED=0
                while kill -0 "$MENUBAR_PID" 2>/dev/null && [ "$WAITED" -lt 120 ]; do
                    sleep 0.5
                    WAITED=$((WAITED + 1))
                done
                if kill -0 "$MENUBAR_PID" 2>/dev/null; then
                    log "quit: MenubarApp still alive after 60s, sending SIGKILL"
                    kill -9 "$MENUBAR_PID" 2>/dev/null || true
                    FAILED_STEPS="$FAILED_STEPS menubar-app"
                fi
            else
                log "quit: MenubarApp not running"
            fi

            # Now do the process-independent cleanup. These steps run
            # whether the MenubarApp quit cleanly or not — belt and
            # suspenders.
            log "quit: stopping containers"
            setup_db_passwords
            if ! stop_containers; then
                FAILED_STEPS="$FAILED_STEPS containers"
            fi

            log "quit: stopping Colima VM"
            COLIMA_BIN="$BIN_DIR/colima"
            if [ -x "$COLIMA_BIN" ]; then
                # The three env vars are already exported at script-top
                # (lines 144-146) so this invocation uses the OnionPress-
                # specific Colima profile.
                if ! "$COLIMA_BIN" stop >> "$LOG_FILE" 2>&1; then
                    FAILED_STEPS="$FAILED_STEPS colima"
                fi
            else
                log "quit: colima binary not found at $COLIMA_BIN — skipping"
                FAILED_STEPS="$FAILED_STEPS colima-missing"
            fi

            # Leave a clean slate: lima's usernet daemon outlives `colima
            # stop` and leaking it tends to wedge the next cold boot.
            reap_lima_usernet

            # Remove the PID file, but only if it still matches the PID
            # we saw at the top (mirrors _remove_pid_file safety in
            # src/menubar.py:1349-1357 — avoids nuking a freshly-started
            # OnionPress instance that raced in between).
            if [ -f "$PIDFILE" ]; then
                STORED_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
                if [ -z "$MENUBAR_PID" ] || [ "$STORED_PID" = "$MENUBAR_PID" ]; then
                    rm -f "$PIDFILE"
                fi
            fi

            if [ -n "$FAILED_STEPS" ]; then
                log "quit: completed with issues in:$FAILED_STEPS"
                echo "onionpress quit: some steps failed:$FAILED_STEPS" >&2
                exit 1
            fi
            log "quit: clean"
            ;;

        restart)
            # Adaptive restart: if Docker is reachable, just bounce the
            # containers (fast, ~30s). If it isn't, the Lima VM is most
            # likely in the wedged "Running but SSH refused" state that
            # occasionally happens after long uptime / sleep — force-
            # stop and restart the VM first, then proceed. This turns
            # the menubar "Restart" item into a reliable recovery for
            # the wedge we've seen 5× in 30 days on a single machine.
            # The same recovery runs from the start path when its Docker
            # wait times out (see wait_for_docker_or_recover_vm).
            if ! docker info >/dev/null 2>&1; then
                recover_lima_vm restart || exit 1
                log "restart: resuming normal restart"
            fi
            setup_db_passwords
            # Pull updated images before stop_containers: the OnionHeaven
            # farm respawns takeover-* containers within ~2s of being
            # stopped, racing the pull. If the pull runs after, takeover
            # containers persist on a stale cached image while compose
            # containers refresh, splitting the cluster across image
            # versions (e.g. missing `has` command in queue-manager).
            update_images
            stop_containers
            start_containers
            wait_for_services
            ;;

        status)
            get_status
            ;;

        address)
            get_onion_address
            ;;

        start-tor)
            setup_db_passwords
            cd "$DOCKER_DIR"
            # Starting tor mounts onionpress-onion-keys, creating it empty if
            # it is not there yet; an install that last ran on arti has to
            # have its key moved there first, as start_containers does.
            if ! migrate_key_volume; then
                log "ERROR: Tor not started: the onion service key volume is not in place (see $LOG_FILE)"
                exit 1
            fi
            # No --pull always: the tor image is pinned by digest, so a
            # forced pull could only re-confirm the bytes already here, at
            # the price of a registry round trip on every start (issue #36).
            # Compose's default (missing) still fetches a pin a new release
            # moved, and leaves a locally built image alone.
            _tor_rc=0
            docker compose up -d tor >> "$LOG_FILE" 2>&1 || _tor_rc=$?
            if [ "$_tor_rc" -eq 0 ]; then
                log "Tor containers started"
            else
                log "ERROR: Failed to start tor container (rc=$_tor_rc) — see $LOG_FILE"
            fi
            ;;

        import-key)
            import_key "$2"
            ;;

        logs)
            cd "$DOCKER_DIR"
            docker compose logs -f
            ;;

        launch)
            # Full app launch — opens the OnionPress.app bundle, which runs the
            # launcher script (boots Colima VM, starts MenubarApp, starts containers).
            # Safe to call when already running (launcher detects and exits).
            APP_BUNDLE="$(dirname "$APP_DIR")"
            open "$APP_BUNDLE"
            ;;

        upload-analytics)
            # Trigger an immediate analytics upload via file trigger (polled by MenubarApp)
            local pid_file="$DATA_DIR/menubar.pid"
            if [ ! -f "$pid_file" ]; then
                echo "OnionPress is not running (no PID file)."
                exit 1
            fi
            local pid
            pid=$(cat "$pid_file")
            if ! kill -0 "$pid" 2>/dev/null; then
                echo "OnionPress is not running (PID $pid is stale)."
                exit 1
            fi
            touch "$DATA_DIR/.upload-analytics"
            echo "Analytics upload triggered. Check logs for result."
            ;;

        validate-oh-address)
            # Validate an OnionHeaven hub address. Returns JSON result.
            # Used by both the menubar settings dialog and WordPress settings page.
            _validate_oh_address "$2"
            ;;

        get)
            # Fetch a URL over Tor and print the body — for checking whether
            # a .onion is reachable. Delegated to src/onionpress/cli.py
            # cmd_get, which runs curl inside the tor container (a SOCKS
            # connection from the host does not work through Colima's port
            # forwarding). "${@:2}" forwards the URL and flags verbatim.
            bundled_python -m onionpress.cli get "${@:2}"
            ;;

        provision-post-install)
            # Delegated to src/onionpress/multisite.py:provision_post_install
            # so Mac and Linux share one implementation. The bash sub-
            # functions (ensure_multisite, install_multisite_domain_map,
            # etc.) still exist below and are still called by start_
            # containers — only this subcommand entry point goes through
            # Python for now.
            bundled_python -m onionpress.cli provision-post-install \
                --themes-dir "$RESOURCES_DIR/themes" \
                --plugins-dir "$RESOURCES_DIR/plugins"
            ;;

        setup-bundled-plugins)
            # Configure and activate Cache Enabler and the Link Fixer
            # (setup_bundled_plugins). setup_logic.install_fresh_wordpress
            # starts this in the background once setup has made the user's
            # site, so a new install has them without waiting for a restart.
            setup_bundled_plugins
            ;;

