# Configure Cache Enabler: 1-hour TTL, auto-purge on publish/comment/term changes.
# Idempotent — skips if onionpress_cache_enabler_configured=1.
# Keeping defaults for query-string/cookie exclusions (they're sensible: bypass
# cache for any non-tracking query string and for wp-postpass/wordpress_logged_in
# cookies). See cache_enabler_engine.class.php::is_excluded() for the regexes.
configure_cache_enabler() {
    local install_plugin="yes"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^INSTALL_CACHE_ENABLER=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            install_plugin="$config_value"
        fi
    fi

    if [ "$install_plugin" != "yes" ]; then
        return 0
    fi

    if ! wp_is_installed; then
        return 0
    fi

    if ! docker exec onionpress-wordpress test -f /var/www/html/wp-content/plugins/cache-enabler/cache-enabler.php 2>/dev/null; then
        return 0
    fi

    local configured
    configured=$(docker exec onionpress-wordpress wp option get onionpress_cache_enabler_configured --allow-root 2>/dev/null || echo "")
    if [ "$configured" = "1" ]; then
        return 0
    fi

    log "Configuring Cache Enabler: 1h TTL, auto-purge on content changes..."

    # Ensure FS_METHOD=direct before the settings update triggers Cache
    # Enabler's on_update_option hook, which calls WP_Filesystem to write
    # its per-hostname settings file. Without this, WP_Filesystem falls
    # back to FTP mode when wp-cli runs as root (ownership mismatch vs.
    # www-data) and throws "FTP hostname is required". Idempotent.
    docker exec onionpress-wordpress wp config set FS_METHOD direct --type=constant --allow-root >> "$LOG_FILE" 2>&1 \
        || log "WARNING: Failed to set FS_METHOD=direct"

    # Pass the full settings array as JSON — wp-cli converts to a PHP array
    # for storage. on_update_option() hooks this and syncs to disk.
    local settings_json='{"cache_expires":1,"cache_expiry_time":1,"clear_site_cache_on_saved_post":1,"clear_site_cache_on_saved_comment":1,"clear_site_cache_on_saved_term":1,"clear_site_cache_on_saved_user":0,"clear_site_cache_on_changed_plugin":1,"convert_image_urls_to_webp":0,"mobile_cache":0,"compress_cache":0,"minify_html":0,"minify_inline_css_js":0,"excluded_post_ids":"","excluded_page_paths":"","excluded_query_strings":"","excluded_cookies":""}'

    docker exec onionpress-wordpress wp option update cache_enabler "$settings_json" --format=json --allow-root >> "$LOG_FILE" 2>&1 \
        || log "WARNING: Failed to set cache_enabler option"

    docker exec onionpress-wordpress wp option update onionpress_cache_enabler_configured 1 --allow-root >> "$LOG_FILE" 2>&1 \
        || log "WARNING: Failed to mark Cache Enabler as configured"

    log "✓ Cache Enabler configured (1h TTL, auto-purge enabled)"
    return 0
}


# WP-Statistics plugin removed — it phoned home to connect.wp-statistics.com
# despite telemetry settings being disabled.  OnionPress's built-in hit counter
# (onionpress-hit-counter plugin) provides the same functionality without
# any clearnet leaks.  On existing installs the plugin is deactivated on the
# next launch (see deactivate_wp_statistics below).

# Function to initialize container runtime
install_docker() {
    log "Container runtime initialization required"

    # Read VM memory from config (default: 2 GB — the stack idles at ~840 MB)
    VM_MEMORY=2
    VM_CPU=2
    if [ -f "$DATA_DIR/config" ]; then
        config_mem=$(grep "^VM_MEMORY=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_mem" ]; then
            VM_MEMORY="$config_mem"
        fi
        config_cpu=$(grep "^VM_CPU=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_cpu" ]; then
            VM_CPU="$config_cpu"
        fi
    fi

    # Should not happen if launcher worked, but handle it
    if [ "$VM_ARCH" = "aarch64" ]; then
        # Apple Silicon: use VZ backend (Virtualization.framework)
        "$BIN_DIR/colima" start \
            --vm-type vz \
            --mount-type virtiofs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$VM_CPU" \
            --memory "$VM_MEMORY" \
            --arch "$VM_ARCH" \
            --vz-rosetta=false \
            >> "$LOG_FILE" 2>&1
    else
        # Intel: use QEMU backend
        "$BIN_DIR/colima" start \
            --vm-type qemu \
            --mount-type sshfs \
            --mount "$DATA_DIR/shared:w" \
            $(docs_mount_args) \
            --cpu "$VM_CPU" \
            --memory "$VM_MEMORY" \
            --arch "$VM_ARCH" \
            >> "$LOG_FILE" 2>&1
    fi

    if [ $? -eq 0 ]; then
        touch "$COLIMA_HOME/.initialized"
        log "Container runtime initialized successfully"
        return 0
    else
        log "ERROR: Failed to initialize container runtime"
        echo "ERROR: Failed to initialize container runtime." >&2
        echo "Check the logs for details: $LOG_FILE" >&2
        echo "Or file an issue at: https://github.com/brewsterkahle/onionpress/issues" >&2
        exit 1
    fi
}

# Function to update Docker images if enabled
update_images() {
    # Check if auto-update is enabled in config
    local update_enabled="no"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^UPDATE_ON_LAUNCH=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            update_enabled="$config_value"
        fi
    fi

    if [ "$update_enabled" != "yes" ]; then
        return 0
    fi

    log "Checking for Docker image updates..."

    cd "$DOCKER_DIR"

    # Pull latest images (WordPress, MariaDB, Tor)
    local images=("ghcr.io/brewsterkahle/onionpress-tor:latest" "ghcr.io/brewsterkahle/onionpress-wordpress:latest" "mariadb:latest")
    local updated=false

    for image in "${images[@]}"; do
        log "Pulling $image..."
        if docker pull "$image" >> "$LOG_FILE" 2>&1; then
            log "✓ $image up to date"
            updated=true
        else
            log "WARNING: Failed to pull $image (continuing with cached version)"
        fi
    done

    if [ "$updated" = true ]; then
        log "✓ Image update check complete"
        # Issue #230: reclaim disk from old <none> image tags created by
        # the pull above. Dangling-only (no -a) so in-use and freshly
        # tagged images are untouched.
        local prune_out
        prune_out=$(docker image prune -f 2>&1 | tail -1)
        if [ -n "$prune_out" ]; then
            log "$prune_out"
        fi
    fi

    return 0
}

# Install OnionPress theme and plugins into the WordPress container
configure_site_timezones() {
    # Set each site's timezone_string to the host machine's IANA TZ
    # (e.g. America/Los_Angeles) the first time we see each site.
    # Without this, fresh WordPress installs default to empty string /
    # gmt_offset=0, and imported tweet timestamps (stored as UTC
    # post_date_gmt) end up displayed in UTC. Matching the host TZ
    # reflects the times the user saw when they posted originally.
    #
    # Only sets when timezone_string is empty — never clobbers a
    # user's intentional choice. Idempotent across launches.
    if ! wp_is_installed; then
        return 0
    fi

    local host_tz
    host_tz="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
    if [ -z "$host_tz" ]; then
        log "Skipping timezone config: host TZ undetectable"
        return 0
    fi

    # On multisite, iterate all sites; on single-site, fall back to the
    # main siteurl. Empty output from `wp site list` means single-site.
    local sites
    sites="$(docker exec onionpress-wordpress wp site list --field=url --allow-root 2>/dev/null)"
    if [ -z "$sites" ]; then
        sites="$(docker exec onionpress-wordpress wp option get siteurl --allow-root 2>/dev/null)"
    fi

    local site_url current
    for site_url in $sites; do
        current="$(docker exec onionpress-wordpress wp option get timezone_string --url="$site_url" --allow-root 2>/dev/null || echo "")"
        if [ -z "$current" ]; then
            if docker exec onionpress-wordpress wp option update timezone_string "$host_tz" --url="$site_url" --allow-root >> "$LOG_FILE" 2>&1; then
                log "✓ Set timezone_string=$host_tz for $site_url"
            else
                log "WARNING: Failed to set timezone for $site_url"
            fi
            # With timezone_string set, gmt_offset becomes redundant;
            # blank it so WP uses the IANA name rather than a fixed offset.
            docker exec onionpress-wordpress wp option update gmt_offset "" --url="$site_url" --allow-root >> "$LOG_FILE" 2>&1 || true
        fi
    done
}

# Function to set up OnionHeaven (onionheaven mode only)
# Registration API now runs in the onionheaven container (web-server.py),
# which creates its own data directories on the shared volume at startup.
# Function to start containers
start_containers() {
    log "Starting OnionPress containers..."

    cd "$DOCKER_DIR"

    # Handle pending key import (volume couldn't be removed when Docker wasn't running)
    if [ -f "$DATA_DIR/.import-key-pending" ]; then
        log "Pending key import detected — removing old arti-state and tor-state volumes..."
        # Both keystores must be wiped: arti-state holds the Arti key, tor-state
        # holds C Tor's /var/lib/tor/hidden_service/<name>/ pair. The entrypoint
        # only converts Arti→C Tor when CTOR_SECRET is missing, so a stale
        # tor-state would silently override the imported identity.
        for vol in onionpress-arti-state onionpress-tor-state; do
            docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
            if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -qx "$vol"; then
                log "Volume $vol still in use — force-removing containers using it..."
                docker rm -f $(docker ps -aq --filter "volume=$vol") >> "$LOG_FILE" 2>&1 || true
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
                if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -qx "$vol"; then
                    log "ERROR: Could not remove old $vol volume"
                fi
            fi
        done
        # Also remove old tor-keys volume if it exists (migration leftover)
        docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
        rm -f "$DATA_DIR/.import-key-pending"
    fi

    # Check if this is first run (no arti-state volume exists)
    # Use --format + exact grep to avoid matching onionpress-arti-state-client
    if ! docker volume ls --format '{{.Name}}' | grep -qx "onionpress-arti-state"; then
        log "First run detected - generating custom onion address..."

        # Read address prefix from config, default to "op2"
        # Fall back to old VANITY_PREFIX for migration from older configs
        ADDRESS_PREFIX="op2"
        if [ -f "$DATA_DIR/config" ]; then
            CUSTOM_PREFIX=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
            if [ -z "$CUSTOM_PREFIX" ]; then
                CUSTOM_PREFIX=$(grep "^VANITY_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
            fi
            if [ ! -z "$CUSTOM_PREFIX" ]; then
                ADDRESS_PREFIX="$CUSTOM_PREFIX"
            fi
        fi

        log "Using address prefix: '$ADDRESS_PREFIX'"

        # Validate prefix: base32 only (a-z, 2-7), max 5 chars
        if [ ${#ADDRESS_PREFIX} -gt 5 ]; then
            log "ERROR: ADDRESS_PREFIX '$ADDRESS_PREFIX' is too long (${#ADDRESS_PREFIX} chars, max 5). Using default 'op2'."
            ADDRESS_PREFIX="op2"
        elif ! echo "$ADDRESS_PREFIX" | grep -qE '^[a-z2-7]+$'; then
            log "ERROR: ADDRESS_PREFIX '$ADDRESS_PREFIX' contains invalid characters. Only a-z and 2-7 allowed. Using default 'op2'."
            ADDRESS_PREFIX="op2"
        fi

        # Check for pre-existing imported key before generating a new one
        VANITY_DIR=""
        if [ -d "$DATA_DIR/shared/vanity-keys" ]; then
            VANITY_DIR=$(find "$DATA_DIR/shared/vanity-keys" -maxdepth 1 -type d -name "*.onion" | head -1)
            if [ -n "$VANITY_DIR" ]; then
                log "Using pre-imported key: $(basename "$VANITY_DIR")"
            fi
        fi

        # Generate custom onion address if no imported key found
        if [ -z "$VANITY_DIR" ]; then
            if VANITY_DIR=$(generate_vanity_address "$ADDRESS_PREFIX"); then
                log "Custom onion address generated successfully"
            fi
        fi

        if [ -n "$VANITY_DIR" ]; then
            # Create arti-state volume and install OpenSSH key to Arti keystore path
            if ! docker volume create onionpress-arti-state >> "$LOG_FILE" 2>&1; then
                log "ERROR: Failed to create arti-state volume"
                return 1
            fi
            if ! docker run --rm \
                -v onionpress-arti-state:/dest \
                --mount type=bind,source="$VANITY_DIR",target=/src \
                alpine sh -c 'mkdir -p /dest/state/keystore/hss/wordpress && cp /src/ks_hs_id.ed25519_expanded_private /dest/state/keystore/hss/wordpress/ && chown -R 100:100 /dest/state && chmod 700 /dest/state /dest/state/keystore /dest/state/keystore/hss /dest/state/keystore/hss/wordpress && chmod 600 /dest/state/keystore/hss/wordpress/*' >> "$LOG_FILE" 2>&1; then
                log "ERROR: Failed to copy address key to arti-state volume"
                return 1
            fi

            log "Address key installed to arti-state volume"
            log "Onion address: $(cat "$VANITY_DIR/hostname" 2>/dev/null || basename "$VANITY_DIR")"
        else
            # Vanity generation failed. Continue with a random address so
            # the user gets a working install, but leave detailed
            # diagnostic lines in the log (written by generate_vanity_address)
            # so we can find out after the fact why the op2… generation
            # didn't work. Common cause: quarantined nested mkp224o helper
            # on a fresh Apple Silicon install from onionpress.org.
            log "WARNING: vanity generation failed — continuing with random onion address (see ERROR lines above)"
        fi
    else
        # Not first run. The vanity prefix is fixed at install (#256 phase 4b)
        # — the old "config ADDRESS_PREFIX changed -> regenerate the onion
        # identity on startup" path was removed: it shared the churny
        # compose-down + delete-arti-state + regenerate flow and risked
        # clobbering the address. Nothing to do here.
        :
    fi

    # Wait for Docker daemon to be ready (on first run, Colima VM may still be booting)
    local docker_wait=0
    while ! docker info >/dev/null 2>&1; do
        if [ $docker_wait -eq 0 ]; then
            log "Waiting for Docker daemon to be ready..."
        fi
        docker_wait=$((docker_wait + 2))
        if [ $docker_wait -ge 180 ]; then
            log "ERROR: Docker daemon not ready after 180s"
            break
        fi
        sleep 2
    done
    if [ $docker_wait -gt 0 ] && docker info >/dev/null 2>&1; then
        log "Docker daemon ready after ${docker_wait}s"
    fi

    # Update images if enabled in config
    update_images

    # Pull pre-built images from GHCR (avoids local build when both image: and build: are set)
    log "Pulling pre-built images..."
    docker compose pull >> "$LOG_FILE" 2>&1 || log "WARNING: Failed to pull images (will build locally)"

    # Always start WordPress and DB first
    local max_attempts=3
    local attempt=1
    while [ $attempt -le $max_attempts ]; do
        if docker compose up -d wordpress db onionheaven autoheal >> "$LOG_FILE" 2>&1; then
            break
        fi
        log "WARNING: 'docker compose up -d wordpress db onionheaven autoheal' failed (attempt $attempt/$max_attempts). Check $LOG_FILE for details."
        if [ $attempt -eq $max_attempts ]; then
            log "ERROR: 'docker compose up -d wordpress db onionheaven autoheal' failed after $max_attempts attempts."
            return 1
        fi
        attempt=$((attempt + 1))
        sleep 5
    done
    log "WordPress, DB, and Tor client containers starting"

    # Wait for WordPress container to be ready before checking install status
    local wp_wait=0
    while [ $wp_wait -lt 60 ]; do
        if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT:-8080}" >/dev/null 2>&1; then
            break
        fi
        sleep 2
        wp_wait=$((wp_wait + 2))
    done

    # Check if WordPress is already set up (admin account created)
    # Retry a few times — the DB may still be warming up even though
    # WordPress HTTP is responding (wp core is-installed needs a live DB)
    local wp_installed=false
    local wp_check=0
    while [ $wp_check -lt 5 ]; do
        if wp_is_installed; then
            wp_installed=true
            break
        fi
        sleep 2
        wp_check=$((wp_check + 1))
    done

    # Ensure .htaccess exists — WordPress REST API (block editor publishing)
    # requires rewrite rules. These can be lost if WordPress auto-updates or
    # the volume is recreated. Check on every launch, not just first setup.
    if $wp_installed; then
        log "WordPress is installed"
        if ! docker exec onionpress-wordpress test -s /var/www/html/.htaccess 2>/dev/null; then
            log "Restoring .htaccess rewrite rules (missing or empty)"
            docker exec onionpress-wordpress bash -c 'cat > /var/www/html/.htaccess << "HTEOF"
# Privacy: prevent onion address leaking in Referer headers
<IfModule mod_headers.c>
Header set Referrer-Policy "no-referrer"
</IfModule>

# BEGIN WordPress Multisite
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]

# add a trailing slash to /wp-admin
RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ $1wp-admin/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(wp-(content|admin|includes).*) $2 [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(.*\.php)$ $2 [L]
RewriteRule . index.php [L]
# END WordPress Multisite
HTEOF
chown www-data:www-data /var/www/html/.htaccess' >> "$LOG_FILE" 2>&1 && \
                log "✓ .htaccess restored" || \
                log "WARNING: Failed to restore .htaccess"
        fi
    else
        log "WordPress not yet installed — will be configured by setup window"
    fi

    # Always start Tor — generate the onion address in parallel with WordPress
    # setup so it's ready when the user finishes configuring.
    log "Starting Tor containers..."
    docker compose up -d tor onionheaven >> "$LOG_FILE" 2>&1 || log "ERROR: Failed to start tor/onionheaven containers"

    # Install Internet Archive Wayback Machine Link Fixer plugin —
    # stays bash for now (uses install_plugin.sh + activate_plugin.sh
    # helpers; bigger lift to port).
    install_ia_plugin

    # Install and configure Cache Enabler page-caching plugin
    # (Mac-only — no Linux equivalent at present)
    install_cache_enabler
    configure_cache_enabler

    # The WP-side post-start provisioning is shared with Linux now:
    # configure-ia-plugin, deactivate-wp-statistics, then
    # provision-post-install (which internally handles ensure_multisite,
    # install_multisite_domain_map, install_onionpress_theme, the perm
    # fixes, and the shared-onion-address write — in the right order).
    # See src/onionpress/multisite.py.
    # install-from-backup: if a backup was staged for this install, import its
    # DB + content into the now-running containers BEFORE the WP provisioning
    # below, so configure-ia/provision-post-install operate on the restored site.
    # provision-post-install then refreshes the OnionPress-managed theme/
    # mu-plugins/sunrise.php to the CURRENT version, fixing any backup version skew.
    _ifb_marker="$DATA_DIR/.install-from-backup"
    _ifb_staging=""
    if [ -f "$_ifb_marker" ]; then
        _ifb_staging=$(head -1 "$_ifb_marker" 2>/dev/null)
        if [ -n "$_ifb_staging" ] && [ -d "$_ifb_staging" ]; then
            log "Install-from-backup: importing artifacts from $_ifb_staging"
            if ! bundled_python -m onionpress.cli import-backup-artifacts --staging "$_ifb_staging"; then
                log "ERROR: install-from-backup import failed — leaving marker for retry"
                _ifb_staging=""
            fi
        else
            log "Install-from-backup: marker present but staging missing ($_ifb_staging); ignoring"
            _ifb_staging=""
        fi
    fi

    bundled_python -m onionpress.cli configure-ia-plugin
    bundled_python -m onionpress.cli deactivate-wp-statistics
    bundled_python -m onionpress.cli provision-post-install \
        --themes-dir "$RESOURCES_DIR/themes" \
        --plugins-dir "$RESOURCES_DIR/plugins"

    # install-from-backup: clean up staging + marker only after a successful
    # import + provisioning, so an interrupted run re-imports on the next start.
    if [ -n "$_ifb_staging" ]; then
        rm -rf "$_ifb_staging"
        rm -f "$_ifb_marker"
        log "Install-from-backup: complete (staging cleaned up)"
    fi

    # Tor-routed archive.org login can take 30s — background it so the
    # rest of start_containers returns promptly. No-op if keys are set.
    bundled_python -m onionpress.cli ensure-archive-s3-keys &

    # Configure site timezones to match the host machine so imported
    # social-media timestamps display in local time. Idempotent.
    configure_site_timezones

    # Install iptables rules to log clearnet access from non-Tor containers
    install_clearnet_logging

    # Conditionally start Cloudflare Tunnel
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        log "Cloudflare Tunnel enabled, starting cloudflared..."
        docker compose $CF_COMPOSE up -d cloudflared >> "$LOG_FILE" 2>&1 || log "ERROR: Failed to start cloudflared container"
    else
        # Stop cloudflared if it was previously running but token was removed
        docker stop onionpress-cloudflared 2>/dev/null || true
    fi
}

# Function to add iptables rules that log clearnet access from non-Tor containers.
# Only the tor containers legitimately need clearnet (for Tor relay connections).
# WordPress and MariaDB should never touch the internet directly.
install_clearnet_logging() {
    local bridge net_id
    # Bridge name is br-<first 12 chars of network ID> (unless custom name set)
    bridge=$(docker network inspect onionpress-network --format '{{index .Options "com.docker.network.bridge.name"}}' 2>/dev/null || true)
    if [ -z "$bridge" ]; then
        net_id=$(docker network inspect onionpress-network --format '{{.Id}}' 2>/dev/null | cut -c1-12 || true)
        [ -n "$net_id" ] && bridge="br-${net_id}"
    fi
    if [ -z "$bridge" ]; then
        log "WARNING: Could not determine Docker bridge interface for clearnet logging"
        return
    fi

    # Get container IPs (skip tor containers — they need clearnet for Tor relays)
    local wp_ip db_ip
    wp_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' onionpress-wordpress 2>/dev/null || true)
    db_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' onionpress-db 2>/dev/null || true)

    local subnet
    subnet=$(docker network inspect onionpress-network --format '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null || echo "172.18.0.0/16")

    # Run iptables inside the VM — rules are idempotent (check before insert)
    "$BIN_DIR/limactl" shell colima -- sh -c "
        check_and_add() {
            local src=\"\$1\" prefix=\"\$2\"
            if ! sudo iptables -C DOCKER-USER -i $bridge ! -o $bridge -s \"\$src\" ! -d $subnet -j LOG --log-prefix \"\$prefix\" --log-level 4 2>/dev/null; then
                sudo iptables -I DOCKER-USER -i $bridge ! -o $bridge -s \"\$src\" ! -d $subnet -j LOG --log-prefix \"\$prefix\" --log-level 4
            fi
        }
        [ -n \"$wp_ip\" ] && check_and_add \"$wp_ip\" \"CLEARNET-wordpress: \"
        [ -n \"$db_ip\" ] && check_and_add \"$db_ip\" \"CLEARNET-db: \"
    " 2>/dev/null && log "✓ Clearnet logging rules installed" || log "WARNING: Failed to install clearnet logging rules"
}

# Function to stop containers
stop_containers() {
    log "Stopping OnionPress containers..."
    # Stop farm containers first (they depend on the onionheaven container's DB)
    stop_onionheaven_farm
    cd "$DOCKER_DIR"
    # Stop all containers (including onionheaven; cloudflared via override file if token set)
    docker compose $CF_COMPOSE down 2>&1 | tee -a "$LOG_FILE"
    log "Containers stopped"
}

# Reap lima's shared usernet daemon. It survives `colima stop` and leaks
# across restarts, holding the user-v2 network sockets — the likely cause of
# the next *cold* boot wedging (fresh VM's guest agent can't bring up
# networking -> gray icon; the same "5x in 30 days" wedge the restart path
# recovers via limactl stop -f). lima respawns it on the next start, so
# reaping at quit is safe
# and leaves a clean slate. Scoped by LIMA_HOME so multi-user installs don't
# touch each other; kill is per-user anyway. Mirrors _reap_lima_usernet in
# src/menubar.py for the path where the MenubarApp was SIGKILLed and never
# ran its own cleanup.
reap_lima_usernet() {
    local pidfile pid cmd
    for pidfile in "$LIMA_HOME"/_networks/*/usernet_*.pid; do
        [ -f "$pidfile" ] || continue
        pid=$(tr -d '[:space:]' < "$pidfile" 2>/dev/null)
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        cmd=$(ps -o command= -p "$pid" 2>/dev/null)
        case "$cmd" in
            *limactl*usernet*"$LIMA_HOME"*)
                log "quit: reaping leaked lima usernet daemon (pid $pid)"
                kill -TERM "$pid" 2>/dev/null || true
                ;;
        esac
    done
}

# Function to get container status
get_status() {
    cd "$DOCKER_DIR"
    # Convert newline-delimited JSON to JSON array
    docker compose ps --format json 2>/dev/null | jq -s '.' 2>/dev/null || echo "[]"
}

# Function to get onion address (non-blocking, single attempt)
get_onion_address() {
    cd "$DOCKER_DIR"
    ONION_ADDR=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
    if [ ! -z "$ONION_ADDR" ]; then
        echo "$ONION_ADDR"
        return 0
    fi
    echo "Generating..."
    return 1
}

# Function to get healthcheck onion address (non-blocking, single attempt)
get_healthcheck_address() {
    cd "$DOCKER_DIR"
    local addr
    addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/healthcheck/hostname 2>/dev/null || echo "")
    if [ ! -z "$addr" ]; then
        echo "$addr"
        # Save to data dir for menubar app to read
        echo "$addr" > "$DATA_DIR/healthcheck-address"
        return 0
    fi
    return 1
}

# Function to wait for services to be ready using active probing
wait_for_services() {
    cd "$DOCKER_DIR"
    local max_wait=120
    local waited=0
    local wp_ready=false
    local onion_ready=false
    local onion_addr=""

    log "Waiting for services to be ready (polling with curl)..."

    while [ $waited -lt $max_wait ]; do
        # Step 1: Get onion address if we don't have it yet
        if [ -z "$onion_addr" ] || [ "$onion_addr" = "Generating..." ]; then
            onion_addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
        fi

        # Step 2: Check if WordPress is responding locally
        if [ "$wp_ready" = false ]; then
            if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT:-8080}" >/dev/null 2>&1; then
                log "✓ WordPress is responding on localhost:${ONIONPRESS_WP_PORT:-8080}"
                log "Waiting for Tor to bootstrap and onion service to be reachable (est. 30-90s)..."
                wp_ready=true

                # If WordPress is not yet installed, skip waiting for Tor
                if ! wp_is_installed; then
                    log "WordPress not installed — setup required, skipping Tor wait"
                    return 0
                fi
            fi
        fi

        # Step 3: Check Tor bootstrap and WordPress reachable from Tor container
        # (SOCKS proxy doesn't work through Colima VM port forwarding,
        # so we test the actual path: tor -> wordpress via Docker network)
        if [ "$onion_ready" = false ] && [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
            # Check Tor is bootstrapped
            if docker compose logs --tail 100 tor 2>/dev/null | grep -q -E "Bootstrapped 100% \(done\)|Sufficiently bootstrapped"; then
                # Check WordPress is reachable from Tor container
                if docker compose exec -T tor wget -q -O /dev/null --timeout=5 http://wordpress:80/ 2>/dev/null; then
                    log "✓ Onion service ready: ${onion_addr}"
                    onion_ready=true
                fi
            fi
        fi

        # Both ready — done
        if [ "$wp_ready" = true ] && [ "$onion_ready" = true ]; then
            log "All services are ready after ${waited}s"
            ONION_ADDR="$onion_addr"
            # Read and save healthcheck address
            if hc_addr=$(get_healthcheck_address); then
                log "Healthcheck address: ${hc_addr}"
            fi

            # Write onion address to shared volume for WordPress plugins
            docker exec onionpress-tor cp /var/lib/tor/hidden_service/wordpress/hostname /var/lib/onionpress/onion_address 2>>"$LOG_FILE" && \
                log "✓ Onion address written to shared volume" || \
                log "WARNING: Failed to write onion address to shared volume"

            return 0
        fi

        sleep 2
        waited=$((waited + 2))
    done

    # Timed out — report what we have
    log "WARNING: Services not fully ready after ${max_wait}s (wp=${wp_ready}, onion=${onion_ready})"
    if [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
        ONION_ADDR="$onion_addr"
    else
        ONION_ADDR="Generating..."
    fi
    return 1
}

# Main execution
# ─── Validate OnionHeaven address ─────────────────────────────────────
# Returns JSON: {"valid":true/false, "status":"hub"|"site"|"unreachable"|"self"|"invalid_format", "message":"..."}
# Called by: menubar settings dialog, WordPress settings page
_validate_oh_address() {
    local addr="$1"

    # Format check
    if [ -z "$addr" ] || [ ${#addr} -ne 62 ] || ! echo "$addr" | grep -qE '\.onion$'; then
        echo '{"valid":false,"status":"invalid_format","message":"Address must be a valid 56-character .onion address."}'
        return 1
    fi

    # Self check — compare against our own address
    local our_address=""
    if [ -d "$DATA_DIR/shared/vanity-keys" ]; then
        our_address=$(basename "$(find "$DATA_DIR/shared/vanity-keys" -maxdepth 1 -type d -name "*.onion" | head -1)" 2>/dev/null)
    fi
    if [ -z "$our_address" ] || [ "$our_address" = "." ]; then
        our_address=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
    fi
    if [ -n "$our_address" ] && [ "$addr" = "$our_address" ]; then
        echo '{"valid":false,"status":"self","message":"You cannot use your own onion address as the OnionHeaven hub."}'
        return 1
    fi

    # Probe the OnionHeaven API endpoint (:8083/status)
    local api_result
    api_result=$(docker exec onionheaven curl -s --max-time 30 \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}:8083/status" 2>/dev/null) || true

    if [ -n "$api_result" ] && echo "$api_result" | grep -q '"version"'; then
        echo '{"valid":true,"status":"hub","message":"Valid OnionHeaven hub."}'
        return 0
    fi

    # API didn't respond — try the base address (port 80)
    local http_code
    http_code=$(docker exec onionheaven curl -s --max-time 30 \
        -o /dev/null -w "%{http_code}" \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}/" 2>/dev/null) || true

    if [ "$http_code" = "200" ] || [ "$http_code" = "301" ] || [ "$http_code" = "302" ]; then
        echo '{"valid":true,"status":"site","message":"This address is reachable but is not running OnionHeaven yet."}'
        return 0
    fi

    echo '{"valid":true,"status":"unreachable","message":"Could not reach this address over Tor. It may be offline or invalid."}'
    return 0
}

# ===========================================================================
# CLI subcommands: setup, backup, restore, reset
# ===========================================================================

setup_wordpress_cli() {
    local wp_user="" wp_pass="" wp_email="" wp_title="OnionPress"
    local from_backup_pass="" from_backup_path=""

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --user)  wp_user="$2";  shift 2 ;;
            --pass)  wp_pass="$2";  shift 2 ;;
            --email) wp_email="$2"; shift 2 ;;
            --title) wp_title="$2"; shift 2 ;;
            --from-backup)
                from_backup_pass="$2"
                from_backup_path="$3"
                shift 3 ;;
            *) shift ;;
        esac
    done

    # --from-backup mode: extract config from backup, use dummy WP credentials
    # (restore will overwrite the database with real users afterward)
    if [ -n "$from_backup_pass" ]; then
        if [ -z "$from_backup_path" ] || [ ! -f "$from_backup_path" ]; then
            echo "Usage: $0 setup --from-backup <password> <backup.zip>"
            return 1
        fi
        echo "  Extracting config from backup..."
        local staging
        staging=$(mktemp -d -t onionpress-setup-XXXXXX)
        trap "rm -rf '$staging'" RETURN
        if ! unzip -P "$from_backup_pass" -o "$from_backup_path" -d "$staging" >>"$LOG_FILE" 2>&1; then
            echo "ERROR: Failed to extract backup (wrong password or corrupt zip)" >&2
            return 1
        fi
        # Restore config if present
        if [ -f "$staging/config" ]; then
            cp "$staging/config" "$DATA_DIR/config"
            log "Setup: restored config from backup"
            echo "  Config restored from backup."
        fi
        # Restore vanity keys if present (accept either C Tor or Arti format)
        if { [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] || [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ]; } && [ -f "$staging/metadata.json" ]; then
            local onion_address
            onion_address=$(bundled_python -c "import json, sys; print(json.load(open(sys.argv[1])).get('onion_address',''))" "$staging/metadata.json" 2>/dev/null || echo "")
            if [ -n "$onion_address" ]; then
                rm -rf "$DATA_DIR/shared/vanity-keys/"
                local addr_dir="$DATA_DIR/shared/vanity-keys/$onion_address"
                mkdir -p "$addr_dir"
                [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] && cp "$staging/tor-keys/hs_ed25519_secret_key" "$addr_dir/"
                [ -f "$staging/tor-keys/hs_ed25519_public_key" ] && cp "$staging/tor-keys/hs_ed25519_public_key" "$addr_dir/"
                [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ] && cp "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" "$addr_dir/"
                echo "$onion_address" > "$addr_dir/hostname"
                log "Setup: restored Tor keys for $onion_address from backup"
                echo "  Tor keys restored from backup ($onion_address)."
            fi
        fi
        # Use dummy credentials — restore will overwrite the database
        wp_user="admin"
        wp_pass="$from_backup_pass"
        wp_email="admin@onionpress.local"
        echo "  Installing WordPress with temporary credentials (restore will overwrite)..."
    fi

    # If credentials not provided, prompt interactively
    if [ -z "$wp_user" ] || [ -z "$wp_pass" ]; then
        echo ""
        echo "  ======================================="
        echo "  OnionPress First-Time Setup"
        echo "  ======================================="
        echo ""
        echo "  Create your WordPress admin account."
        echo "  You'll use these credentials to log in at /wp-admin."
        echo ""

        if [ -z "$wp_user" ]; then
            while [ -z "$wp_user" ]; do
                printf "  Admin username: "
                read wp_user
                if [ -z "$wp_user" ]; then
                    echo "  Username cannot be empty."
                fi
            done
        fi

        if [ -z "$wp_pass" ]; then
            local wp_pass2=""
            while [ -z "$wp_pass" ]; do
                printf "  Admin password: "
                stty -echo 2>/dev/null
                read wp_pass
                stty echo 2>/dev/null
                echo ""
                if [ -z "$wp_pass" ]; then
                    echo "  Password cannot be empty."
                    continue
                fi
                printf "  Confirm password: "
                stty -echo 2>/dev/null
                read wp_pass2
                stty echo 2>/dev/null
                echo ""
                if [ "$wp_pass" != "$wp_pass2" ]; then
                    echo "  Passwords do not match. Try again."
                    wp_pass=""
                fi
            done
        fi

        printf "  Site title [OnionPress]: "
        read wp_title_input
        if [ -n "$wp_title_input" ]; then
            wp_title="$wp_title_input"
        fi
    fi

    if [ -z "$wp_email" ]; then
        wp_email="${wp_user}@onionpress.local"
    fi

    echo ""
    echo "  Installing WordPress (multisite)..."
    log "Running WP-CLI core multisite-install for first-time setup"

    if docker exec onionpress-wordpress wp core multisite-install \
        --url="http://localhost" \
        --title="$wp_title" \
        --admin_user="$wp_user" \
        --admin_password="$wp_pass" \
        --admin_email="$wp_email" \
        --skip-email \
        --allow-root >> "$LOG_FILE" 2>&1; then
        log "WordPress multisite installed successfully via WP-CLI"
        echo "  WordPress installed successfully!"
    else
        log "ERROR: WP-CLI core multisite-install failed"
        echo "  ERROR: WordPress installation failed. Check $LOG_FILE for details."
        return 1
    fi
}

restore_backup() {
    # Restores from a password-protected backup zip.
    # Usage: restore_backup <password> <zip_path>
    local password="$1"
    local zip_path="$2"
    local staging

    if [ -z "$password" ] || [ -z "$zip_path" ]; then
        echo "ERROR: Password and zip path are required" >&2
        return 1
    fi
    if [ ! -f "$zip_path" ]; then
        echo "ERROR: Backup file not found: $zip_path" >&2
        return 1
    fi

    staging=$(mktemp -d -t onionpress-restore-XXXXXX)
    trap "rm -rf '$staging'" RETURN

    # Extract zip
    log "Restore: extracting backup archive..."
    if ! unzip -P "$password" -o "$zip_path" -d "$staging" >>"$LOG_FILE" 2>&1; then
        log "ERROR: Failed to extract backup (wrong password or corrupt zip)"
        echo "ERROR: Failed to extract backup (wrong password or corrupt zip)" >&2
        return 1
    fi

    # Verify metadata exists
    if [ ! -f "$staging/metadata.json" ]; then
        log "ERROR: Not a valid OnionPress backup (no metadata.json)"
        echo "ERROR: Not a valid OnionPress backup (no metadata.json)" >&2
        return 1
    fi

    local onion_address
    onion_address=$(bundled_python -c "import json, sys; print(json.load(open(sys.argv[1])).get('onion_address',''))" "$staging/metadata.json" 2>/dev/null || echo "")
    log "Restore: backup from $onion_address"

    # 1. Restore Tor keys — accept either C Tor or Arti format.
    #    Mac uses Arti only; if backup has only C Tor keys, convert to Arti PEM.
    local ctor_secret="$staging/tor-keys/hs_ed25519_secret_key"
    local ctor_public="$staging/tor-keys/hs_ed25519_public_key"
    local arti_key="$staging/tor-keys/ks_hs_id.ed25519_expanded_private"
    if { [ -f "$ctor_secret" ] || [ -f "$arti_key" ]; } && [ -n "$onion_address" ]; then
        log "Restore: writing Tor keys..."
        rm -rf "$DATA_DIR/shared/vanity-keys/"

        local addr_dir="$DATA_DIR/shared/vanity-keys/$onion_address"
        mkdir -p "$addr_dir"

        # Copy all key formats present in backup
        [ -f "$arti_key" ] && cp "$arti_key" "$addr_dir/"
        [ -f "$ctor_secret" ] && cp "$ctor_secret" "$addr_dir/"
        [ -f "$ctor_public" ] && cp "$ctor_public" "$addr_dir/"

        # Ensure both key formats exist (derives whichever is missing)
        ensure_key_formats "$addr_dir" || log "WARNING: Failed to synchronize key formats"

        echo "$onion_address" > "$addr_dir/hostname"

        # Update ADDRESS_PREFIX in config to match restored address
        local addr_base="${onion_address%.onion}"
        if [ -f "$DATA_DIR/config" ]; then
            local old_prefix
            old_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2 || echo "")
            if [ -n "$old_prefix" ]; then
                local prefix_len=${#old_prefix}
                local new_prefix="${addr_base:0:$prefix_len}"
                sed -i '' "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$new_prefix/" "$DATA_DIR/config"
                log "Restore: updated ADDRESS_PREFIX to $new_prefix"
            fi
        fi
        log "Restore: Tor keys written for $onion_address"
    else
        log "WARNING: No Tor keys in backup — skipping key restore"
    fi

    # 2. Restore database
    local sql_file="$staging/database/wordpress.sql"
    if [ -f "$sql_file" ]; then
        log "Restore: importing database..."
        local db_pass="${WORDPRESS_DB_PASSWORD:-}"
        if [ -z "$db_pass" ]; then
            setup_db_passwords
            db_pass="$WORDPRESS_DB_PASSWORD"
        fi
        docker cp "$sql_file" onionpress-db:/tmp/wordpress.sql 2>>"$LOG_FILE"
        docker exec onionpress-db mariadb -u wordpress "-p${db_pass}" wordpress -e "source /tmp/wordpress.sql" 2>>"$LOG_FILE"
        if [ $? -ne 0 ]; then
            log "ERROR: Database import failed"
            echo "ERROR: Database import failed" >&2
            return 1
        fi
        docker exec onionpress-db rm -f /tmp/wordpress.sql 2>/dev/null
        log "Restore: database imported"
    else
        log "WARNING: No database dump in backup — skipping"
    fi

    # 3. Restore wp-content
    local wpcontent_dir="$staging/wp-content"
    if [ -d "$wpcontent_dir" ]; then
        log "Restore: copying wp-content (themes, plugins, uploads)..."
        docker cp "$wpcontent_dir/." onionpress-wordpress:/var/www/html/wp-content/ 2>>"$LOG_FILE"
        docker exec onionpress-wordpress chown -R www-data:www-data /var/www/html/wp-content/ 2>>"$LOG_FILE"
        log "Restore: wp-content restored"
    else
        log "WARNING: No wp-content in backup — skipping"
    fi

    # 4. Restore config
    if [ -f "$staging/config" ]; then
        log "Restore: restoring config..."
        cp "$staging/config" "$DATA_DIR/config"
        log "Restore: config restored"
    fi

    # 5. Restore OnionHeaven registry + keys (if present in backup)
    if [ -d "$staging/onionheaven" ] && [ -s "$staging/onionheaven/registry.db" ]; then
        if docker inspect onionheaven >/dev/null 2>&1; then
            log "Restore: restoring OnionHeaven registry and keys..."
            docker cp "$staging/onionheaven/registry.db" onionheaven:/var/lib/onionpress/onionheaven/registry.db 2>>"$LOG_FILE"
            if [ -d "$staging/onionheaven/keys" ]; then
                docker exec onionheaven mkdir -p /var/lib/onionpress/onionheaven/keys 2>>"$LOG_FILE"
                docker cp "$staging/onionheaven/keys/." onionheaven:/var/lib/onionpress/onionheaven/keys/ 2>>"$LOG_FILE"
            fi
            log "Restore: OnionHeaven data restored"
        else
            log "WARNING: Backup contains OnionHeaven data but onionheaven container is not running — skipping"
            echo "WARNING: OnionHeaven data found in backup but container not running. Start with OnionHeaven enabled to restore." >&2
        fi
    fi

    log "Restore: complete (from $onion_address)"
    echo "Restore complete: $onion_address"
}

main() {
    case "${1:-start}" in
        start)
            # PID lock — prevent double-starting
            if [ -f "$PIDFILE" ]; then
                # If PID file is older than system boot, it's from a previous
                # boot session — definitely stale (PID may have been recycled)
                boot_sec=$(sysctl -n kern.boottime 2>/dev/null | sed 's/.*sec = \([0-9]*\).*/\1/')
                pid_mtime=$(stat -f %m "$PIDFILE" 2>/dev/null || echo 0)
                if [ -n "$boot_sec" ] && [ "$pid_mtime" -lt "$boot_sec" ] 2>/dev/null; then
                    log "Removing stale PID file from previous boot"
                    rm -f "$PIDFILE"
                else
                    old_pid=$(cat "$PIDFILE" 2>/dev/null)
                    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                        echo "OnionPress is already running (PID $old_pid)." >&2
                        osascript -e 'display dialog "OnionPress is already running." buttons {"OK"} default button "OK" with icon caution with title "OnionPress"' 2>/dev/null || true
                        exit 1
                    fi
                    # Stale pid file — process no longer running
                    rm -f "$PIDFILE"
                fi
            fi
            echo $$ > "$PIDFILE"
            # On exit: clean PID file and kill our background children.
            # The `|| true` is load-bearing: under `set -e`, a failing command
            # inside the EXIT trap becomes the SCRIPT's exit status. `kill`
            # fails when the jobs table is empty or only holds already-finished
            # jobs — so a fully successful `start` exited 1 whenever its
            # background children happened to finish first (race), which any
            # caller that checks the exit code (a managing app's stack installer) read
            # as a start failure.
            trap 'rm -f "$PIDFILE"; kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM HUP

            # Note: orphaned background processes from previous launches may exist
            # but are harmless (sleeping poll loops). The exit trap kills our own
            # children, and the PID lock prevents double-starting.

            # Detect container runtime (install if needed on first run)
            if ! RUNTIME=$(detect_container_runtime); then
                install_docker || exit $?
                # Re-detect after install
                RUNTIME=$(detect_container_runtime) || { log "ERROR: Container runtime still not available after install"; exit 1; }
            fi

            log "Detected container runtime: $RUNTIME"

            # Create symlink for Docker socket if needed
            # Colima forwards the socket to ~/.colima/default/docker.sock
            # but we configure DOCKER_HOST to use ~/.onionpress/colima/default/docker.sock
            # Create symlink to bridge this gap
            SOCKET_DIR="$COLIMA_HOME/default"
            SOCKET_PATH="$SOCKET_DIR/docker.sock"
            COLIMA_SOCKET="$HOME/.colima/default/docker.sock"

            if [ -S "$COLIMA_SOCKET" ]; then
                if [ ! -e "$SOCKET_PATH" ] || [ ! -S "$SOCKET_PATH" ]; then
                    log "Creating Docker socket symlink..."
                    mkdir -p "$SOCKET_DIR"
                    ln -sf "$COLIMA_SOCKET" "$SOCKET_PATH"
                    log "Docker socket symlink created: $SOCKET_PATH -> $COLIMA_SOCKET"
                fi
            fi

            # Setup database passwords (generates random passwords on first run)
            setup_db_passwords

            # Start containers
            start_containers

            # Actively poll until services are ready (replaces fixed sleep)
            wait_for_services

            log "OnionPress is running!"
            log "Onion address: $ONION_ADDR"
            log "Local access: http://localhost:${ONIONPRESS_WP_PORT:-8080}"
            log "OnionPress is now running! Check the menu bar for status."
            ;;

        stop)
            setup_db_passwords
            stop_containers
            ;;

        quit)
            # CLI-equivalent of the menubar Quit button: take the app
            # fully off — MenubarApp, containers, Colima VM, PID lock.
            # If the MenubarApp is alive, SIGTERM it: that fires
            # NSApplicationWillTerminateNotification → _handle_terminate
            # which runs the full cleanup synchronously. Then we run
            # the process-independent steps as belt-and-suspenders so
            # this command is always a reliable teardown for scripting,
            # CI, pre-update, and pre-scrub — even if the MenubarApp
            # was already gone or got SIGKILLed.

            FAILED_STEPS=""

            # Capture MenubarApp PID. Prefer the PID file
            # (authoritative), but fall back to pgrep — the PID file
            # can be missing after a prior unclean shutdown, manual rm,
            # or a MenubarApp code path that never wrote it, and we
            # still need to find and stop the running MenubarApp in
            # that case. `-u $(whoami)` restricts to this user's
            # processes per the multi-user rule in CLAUDE.md.
            MENUBAR_PID=""
            if [ -f "$PIDFILE" ]; then
                MENUBAR_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
            fi
            if [ -z "$MENUBAR_PID" ] || ! kill -0 "$MENUBAR_PID" 2>/dev/null; then
                # Match the py2app-frozen MenubarApp binary path — narrow
                # enough that we don't collide with other OnionPress
                # processes (launcher, shell scripts).
                MENUBAR_PID=$(pgrep -u "$(whoami)" -f "MenubarApp/Contents/MacOS/OnionPress" 2>/dev/null | head -1)
            fi

            if [ -n "$MENUBAR_PID" ] && kill -0 "$MENUBAR_PID" 2>/dev/null; then
                log "quit: SIGTERM to MenubarApp (pid $MENUBAR_PID)"
                kill -TERM "$MENUBAR_PID" 2>/dev/null || true
                # Wait up to 60s for graceful exit. _handle_terminate
                # runs ~90s in the worst case (30s launcher stop + 60s
                # colima stop) but in practice exits well before that.
                # We need to stay under ~90s total or we SIGKILL mid-
                # cleanup and leave things wedged.
                WAITED=0
                while kill -0 "$MENUBAR_PID" 2>/dev/null && [ "$WAITED" -lt 120 ]; do
                    sleep 0.5
                    WAITED=$((WAITED + 1))
                done
                if kill -0 "$MENUBAR_PID" 2>/dev/null; then
                    log "quit: MenubarApp still alive after 60s, sending SIGKILL"
                    kill -9 "$MENUBAR_PID" 2>/dev/null || true
                    FAILED_STEPS="$FAILED_STEPS menubar-app"
                fi
            else
                log "quit: MenubarApp not running"
            fi

            # Now do the process-independent cleanup. These steps run
            # whether the MenubarApp quit cleanly or not — belt and
            # suspenders.
            log "quit: stopping containers"
            setup_db_passwords
            if ! stop_containers; then
                FAILED_STEPS="$FAILED_STEPS containers"
            fi

            log "quit: stopping Colima VM"
            COLIMA_BIN="$BIN_DIR/colima"
            if [ -x "$COLIMA_BIN" ]; then
                # The three env vars are already exported at script-top
                # (lines 144-146) so this invocation uses the OnionPress-
                # specific Colima profile.
                if ! "$COLIMA_BIN" stop >> "$LOG_FILE" 2>&1; then
                    FAILED_STEPS="$FAILED_STEPS colima"
                fi
            else
                log "quit: colima binary not found at $COLIMA_BIN — skipping"
                FAILED_STEPS="$FAILED_STEPS colima-missing"
            fi

            # Leave a clean slate: lima's usernet daemon outlives `colima
            # stop` and leaking it tends to wedge the next cold boot.
            reap_lima_usernet

            # Remove the PID file, but only if it still matches the PID
            # we saw at the top (mirrors _remove_pid_file safety in
            # src/menubar.py:1349-1357 — avoids nuking a freshly-started
            # OnionPress instance that raced in between).
            if [ -f "$PIDFILE" ]; then
                STORED_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
                if [ -z "$MENUBAR_PID" ] || [ "$STORED_PID" = "$MENUBAR_PID" ]; then
                    rm -f "$PIDFILE"
                fi
            fi

            if [ -n "$FAILED_STEPS" ]; then
                log "quit: completed with issues in:$FAILED_STEPS"
                echo "onionpress quit: some steps failed:$FAILED_STEPS" >&2
                exit 1
            fi
            log "quit: clean"
            ;;

        restart)
            # Adaptive restart: if Docker is reachable, just bounce the
            # containers (fast, ~30s). If it isn't, the Lima VM is most
            # likely in the wedged "Running but SSH refused" state that
            # occasionally happens after long uptime / sleep — force-
            # stop and restart the VM first, then proceed. This turns
            # the menubar "Restart" item into a reliable recovery for
            # the wedge we've seen 5× in 30 days on a single machine.
            if ! docker info >/dev/null 2>&1; then
                log "restart: Docker daemon not reachable — restarting Lima VM first"
                export COLIMA_HOME LIMA_HOME
                "$BIN_DIR/limactl" stop -f colima >> "$LOG_FILE" 2>&1 || true
                # Wait briefly for hostagent processes to fully die
                # before starting again — lima can trip over itself
                # otherwise.
                sleep 3
                if ! "$BIN_DIR/limactl" start colima >> "$LOG_FILE" 2>&1; then
                    log "restart: limactl start failed — giving up, user may need to reboot"
                    exit 1
                fi
                log "restart: Lima VM restarted, resuming normal restart"
            fi
            setup_db_passwords
            # Pull updated images before stop_containers: the OnionHeaven
            # farm respawns takeover-* containers within ~2s of being
            # stopped, racing the pull. If the pull runs after, takeover
            # containers persist on a stale cached image while compose
            # containers refresh, splitting the cluster across image
            # versions (e.g. missing `has` command in queue-manager).
            update_images
            stop_containers
            start_containers
            wait_for_services
            ;;

        status)
            get_status
            ;;

        address)
            get_onion_address
            ;;

        start-tor)
            setup_db_passwords
            cd "$DOCKER_DIR"
            docker compose up -d --pull always tor >> "$LOG_FILE" 2>&1 || log "ERROR: Failed to start tor container"
            log "Tor containers started"
            ;;

        import-key)
            import_key "$2"
            ;;

        logs)
            cd "$DOCKER_DIR"
            docker compose logs -f
            ;;

        launch)
            # Full app launch — opens the OnionPress.app bundle, which runs the
            # launcher script (boots Colima VM, starts MenubarApp, starts containers).
            # Safe to call when already running (launcher detects and exits).
            APP_BUNDLE="$(dirname "$APP_DIR")"
            open "$APP_BUNDLE"
            ;;

        upload-analytics)
            # Trigger an immediate analytics upload via file trigger (polled by MenubarApp)
            local pid_file="$DATA_DIR/menubar.pid"
            if [ ! -f "$pid_file" ]; then
                echo "OnionPress is not running (no PID file)."
                exit 1
            fi
            local pid
            pid=$(cat "$pid_file")
            if ! kill -0 "$pid" 2>/dev/null; then
                echo "OnionPress is not running (PID $pid is stale)."
                exit 1
            fi
            touch "$DATA_DIR/.upload-analytics"
            echo "Analytics upload triggered. Check logs for result."
            ;;

        validate-oh-address)
            # Validate an OnionHeaven hub address. Returns JSON result.
            # Used by both the menubar settings dialog and WordPress settings page.
            _validate_oh_address "$2"
            ;;

        provision-post-install)
            # Delegated to src/onionpress/multisite.py:provision_post_install
            # so Mac and Linux share one implementation. The bash sub-
            # functions (ensure_multisite, install_multisite_domain_map,
            # etc.) still exist below and are still called by start_
            # containers — only this subcommand entry point goes through
            # Python for now.
            bundled_python -m onionpress.cli provision-post-install \
                --themes-dir "$RESOURCES_DIR/themes" \
                --plugins-dir "$RESOURCES_DIR/plugins"
            ;;

        setup)
            # Usage: onionpress setup [--user USER] [--pass PASS] [--email EMAIL] [--title TITLE]
            #        onionpress setup --from-backup <password> <backup.zip>
            setup_db_passwords
            cd "$DOCKER_DIR"
            if wp_is_installed; then
                echo "WordPress is already installed."
                exit 0
            fi
            # Make sure WordPress container is running
            if ! docker exec onionpress-wordpress wp --info --allow-root >/dev/null 2>&1; then
                echo "WordPress container is not running. Start OnionPress first."
                exit 1
            fi
            shift  # remove "setup" from args
            local has_from_backup=""
            for arg in "$@"; do
                [ "$arg" = "--from-backup" ] && has_from_backup=1 && break
            done
            setup_wordpress_cli "$@"
            if [ -n "$has_from_backup" ]; then
                # --from-backup restored keys to vanity-keys/ — need to reinstall
                # into the arti-state volume so Tor uses the restored address.
                # Use .import-key-pending flag so start_containers removes the old
                # arti-state volume and installs the restored key.
                log "Setup --from-backup: flagging key reimport..."
                touch "$DATA_DIR/.import-key-pending"
                stop_containers
                start_containers
                wait_for_services
            else
                # Start Tor if not running
                if ! docker compose ps tor --format json 2>/dev/null | grep -q running; then
                    echo "  Starting Tor..."
                    docker compose up -d tor >> "$LOG_FILE" 2>&1
                fi
            fi
            echo ""
            echo "  Setup complete! Your site is now running."
            echo "  Admin panel: http://localhost:${ONIONPRESS_WP_PORT}/wp-admin"
            ;;

        backup)
            shift  # drop "backup"
            if [ $# -eq 0 ] || [ -z "$1" ]; then
                echo "Usage: $0 backup <password> [output_path] [--user <login>]"
                echo "Creates a password-protected backup of your OnionPress site."
                echo "Password must match a WordPress administrator account."
                exit 1
            fi
            bundled_python -m onionpress.cli backup "$@"
            ;;

        restore)
            setup_db_passwords
            local restore_pass="${2:-}"
            local restore_path="${3:-}"
            if [ -z "$restore_path" ] && [ -n "$restore_pass" ]; then
                # Only one arg: treat as path, prompt for password
                restore_path="$restore_pass"
                restore_pass=""
            fi
            if [ -z "$restore_path" ]; then
                echo "Usage: $0 restore [password] <backup_file.zip>"
                echo "Restores from an OnionPress backup. Containers must be running."
                echo "If password is omitted, you will be prompted."
                exit 1
            fi
            if [ -z "$restore_pass" ]; then
                read -r -s -p "Backup password: " restore_pass
                echo ""
                if [ -z "$restore_pass" ]; then
                    echo "ERROR: Password is required."
                    exit 1
                fi
            fi
            # install-from-backup: the Python CLI tears the install down and
            # rebuilds it from the backup (seeded key + imported DB/content),
            # replacing the old in-place overwrite + arti-state key-swap churn
            # (no .import-key-pending, no manual multisite/Tor dance).
            bundled_python -m onionpress.cli restore "$restore_pass" "$restore_path"
            echo "Done! OnionPress rebuilt from backup."
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config, secrets.
            # After reset + start + setup, restore from backup to get data back.
            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo ""
                echo "  This will ERASE everything: WordPress, database, Tor state,"
                echo "  onion address keys, config, and secrets."
                echo ""
                echo "  To preserve your data, run 'onionpress backup' first."
                echo ""
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            log "Resetting OnionPress (full wipe)..."

            # Stop everything
            setup_db_passwords 2>/dev/null || true
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            log "Removing Docker volumes..."
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 && log "Removed volume: $vol" || log "WARNING: Failed to remove volume: $vol"
            done

            # Wipe data directory (keep colima VM and docker-config)
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            rm -f "$DATA_DIR/onionheaven-registration.json"
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            log "Removed keys, config, secrets, and logs"

            echo ""
            echo "  Reset complete. Everything wiped. Starting fresh containers..."
            echo ""

            # Start fresh containers
            setup_db_passwords
            start_containers
            wait_for_services

            log "OnionPress reset and restarted"
            echo "  Containers running. Run 'onionpress setup' to initialize WordPress."
            ;;

        scrub)
            # Scrub: full lifecycle test — backup, reset, restore, verify.
            # Proves backup/restore integrity and that reset truly cleans up.
            # Usage: onionpress scrub [wp-admin-password]
            echo ""
            echo "OnionPress Scrub"
            echo "================"
            echo "This will: backup → reset → restore → verify"
            echo ""

            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            # ── Step 1: Backup ──────────────────────────────────────────
            echo ""
            echo "── Step 1/4: Backup ──"
            setup_db_passwords
            local scrub_pass="${2:-}"
            if [ -z "$scrub_pass" ]; then
                read -r -s -p "WordPress admin password (for backup): " scrub_pass
                echo ""
            fi
            if [ -z "$scrub_pass" ]; then
                echo "ERROR: Password is required for backup."
                exit 1
            fi
            local scrub_backup="/tmp/onionpress-scrub-$(date +%Y%m%d-%H%M%S).zip"
            bundled_python -m onionpress.cli backup "$scrub_pass" "$scrub_backup"

            # Capture the live identity + a log mark BEFORE teardown so Step 4 can
            # prove install-from-backup preserved the address and did not
            # regenerate a vanity key during the restore.
            local scrub_addr_before scrub_log_mark
            scrub_addr_before=$(docker compose -f "$DOCKER_DIR/docker-compose.yml" exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
            scrub_log_mark=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
            echo "  Pre-scrub address: ${scrub_addr_before:-<none>}"

            # ── Step 2: Reset ───────────────────────────────────────────
            echo ""
            echo "── Step 2/4: Reset ──"
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
            done

            # Wipe data directory (keep colima VM and docker-config)
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            rm -f "$DATA_DIR/onionheaven-registration.json"
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            echo "  Reset complete."

            # ── Step 3: Restore ─────────────────────────────────────────
            echo ""
            echo "── Step 3/4: Restore (install-from-backup) ──"
            setup_db_passwords
            # cli restore tears down (already reset above) and rebuilds the
            # install directly from the backup — seeded key + imported DB/
            # content, no in-place overwrite or arti-state key-swap churn.
            bundled_python -m onionpress.cli restore "$scrub_pass" "$scrub_backup"
            echo "  Restore and restart complete."

            # ── Step 4: Verify ──────────────────────────────────────────
            echo ""
            echo "── Step 4/4: Verify ──"
            local scrub_ok=true

            # Check containers are running
            local expected_containers="onionpress-tor onionpress-wordpress onionpress-db onionheaven"
            for ctr in $expected_containers; do
                if docker ps --format '{{.Names}}' | grep -q "^${ctr}$"; then
                    echo "  ✓ $ctr running"
                else
                    echo "  ✗ $ctr NOT running"
                    scrub_ok=false
                fi
            done

            # Check onion address is present
            local scrub_addr
            scrub_addr=$(docker compose -f "$DOCKER_DIR/docker-compose.yml" exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
            if [ -n "$scrub_addr" ]; then
                echo "  ✓ Onion address: $scrub_addr"
            else
                echo "  ✗ No onion address found"
                scrub_ok=false
            fi

            # install-from-backup criteria: the restored identity must MATCH the
            # pre-scrub address (proves the backup key was reused, not a freshly
            # generated vanity), and no vanity generation ran during the scrub.
            if [ -n "$scrub_addr_before" ]; then
                if [ "$scrub_addr" = "$scrub_addr_before" ]; then
                    echo "  ✓ Address preserved (rebuilt from backup key, no regeneration)"
                else
                    echo "  ✗ Address CHANGED: was $scrub_addr_before, now $scrub_addr"
                    scrub_ok=false
                fi
            fi
            if tail -n +"$((scrub_log_mark + 1))" "$LOG_FILE" 2>/dev/null | \
                 grep -qiE "Generating custom onion address|Generated custom address"; then
                echo "  ✗ Vanity address regenerated during restore (should reuse backup key)"
                scrub_ok=false
            else
                echo "  ✓ No vanity regeneration during restore"
            fi

            # Check WordPress responds
            local wp_status
            wp_status=$(docker exec onionpress-wordpress curl -s -o /dev/null -w '%{http_code}' http://localhost:80/ 2>/dev/null || echo "000")
            if [ "$wp_status" = "200" ] || [ "$wp_status" = "301" ] || [ "$wp_status" = "302" ]; then
                echo "  ✓ WordPress responding (HTTP $wp_status)"
            else
                echo "  ✗ WordPress not responding (HTTP $wp_status)"
                scrub_ok=false
            fi

            echo ""
            if [ "$scrub_ok" = "true" ]; then
                echo "Scrub PASSED — backup/reset/restore all working."
            else
                echo "Scrub FAILED — see errors above."
            fi

            # Clean up backup file
            rm -f "$scrub_backup"
            echo "  Cleaned up: $scrub_backup"

            # Stop everything so the app can do a clean start
            echo ""
            echo "Stopping containers for clean app launch..."
            stop_containers 2>/dev/null || true
            echo "Done. Launch OnionPress from /Applications to start fresh."
            ;;

        update)
            # Self-update from a GitHub release. Two modes:
            #   --check     dry-run check (no install)
            #   -y / --yes  install without prompting (use in scripts)
            # Ported from the former onionpress-cli wrapper so there's a
            # single CLI surface; the wrapper's check-for-update path
            # delegates to onionpress.cli for the canonical presentation.
            shift  # drop "update"
            YES_FLAG="0"
            CHECK_ONLY="0"
            for arg in "$@"; do
                case "$arg" in
                    -y|--yes) YES_FLAG="1" ;;
                    --check)  CHECK_ONLY="1" ;;
                    -h|--help)
                        cat <<EOF
Usage: $0 update [--check] [-y|--yes]

  --check     Only check for an update; don't install.
  -y, --yes   Install without prompting (use in scripts).
EOF
                        exit 0 ;;
                    *)
                        echo "Unknown update option: $arg" >&2
                        exit 2 ;;
                esac
            done

            if [ ! -x "$_BUNDLED_PYTHON_BIN" ]; then
                echo "Bundled Python not found at $_BUNDLED_PYTHON_BIN" >&2
                exit 1
            fi

            if [ "$CHECK_ONLY" = "1" ]; then
                exec bundled_python -m onionpress.cli check-for-update
            fi

            ONIONPRESS_APP_PATH="$(dirname "$APP_DIR")" \
            ONIONPRESS_YES="$YES_FLAG" \
                bundled_python - <<'PY'
import os, sys, plistlib
from onionpress import updater

app_path = os.environ["ONIONPRESS_APP_PATH"]
with open(os.path.join(app_path, "Contents", "Info.plist"), "rb") as f:
    current = plistlib.load(f).get("CFBundleShortVersionString", "0")

print(f"Installed: {current}")
print("Checking GitHub for updates...")
result = updater.check_for_update(current, log=lambda m: None)
if not result:
    print("Already up to date.")
    sys.exit(0)

release_data, latest = result
print(f"Update available: {latest}  (published {release_data.get('published_at', '?')})")

notes = (release_data.get("body") or "").strip()
if notes:
    print()
    snippet = notes if len(notes) <= 800 else notes[:800] + "\n... (truncated)"
    print(snippet)
    print()

others = updater.detect_other_instances()
if others:
    print("Note: other users are running OnionPress:")
    for o in others:
        print(f"  - {o['user']} (pid {o['pid']})")
    print("Updating replaces the shared app bundle for everyone.")
    print()

if os.environ.get("ONIONPRESS_YES") != "1":
    if not sys.stdin.isatty():
        print("Re-run with --yes to install non-interactively.", file=sys.stderr)
        sys.exit(2)
    reply = input(f"Install v{latest} now? [y/N] ").strip().lower()
    if reply not in ("y", "yes"):
        print("Aborted.")
        sys.exit(0)

print(f"Downloading and installing v{latest}...")
updater.download_and_install(release_data, latest, app_path, log=print)
print(f"Installed v{latest}. Quit and relaunch OnionPress to use the new version.")
PY
            ;;

        help|-h|--help)
            cat <<EOF
OnionPress - WordPress + Tor Onion Service

Usage: $0 <command> [args]

User commands:
  start         Start WordPress and Tor containers
  stop          Stop all containers (leaves MenubarApp + VM running)
  quit          Fully shut down: containers + Colima VM + MenubarApp
                (equivalent of clicking Quit in the menubar)
  restart       Restart all containers
  status        Show container status
  address       Show your .onion address
  logs          Tail container logs
  update        Check GitHub for a new release and install it
                (--check to only check, -y to skip prompt)
  backup        Create an encrypted backup zip
  restore       Restore from an encrypted backup zip
  setup         Run the first-time WordPress setup
  import-key    Import an existing onion service key

Advanced / internal (used by the menubar app or scripts):
  start-tor, launch, upload-analytics, validate-oh-address,
  reset, scrub

Examples:
  $0 status
  $0 address
  $0 update --check
  $0 update -y
  $0 backup <password> [output_path]
  $0 restore [password] <backup.zip>

Your WordPress site will be available at:
  - Via Tor: http://[your-onion-address].onion
  - Locally (testing): http://localhost:8080

EOF
            exit 0
            ;;

        *)
            echo "Usage: $0 <command> [args]   (run '$0 help' for the full list)" >&2
            exit 1
            ;;
    esac
}

main "$@"
