            # restore (src/onionpress/cli.py, hub_backup.py). The hub's
            # registry and registrants' keys in its backups are sealed to
            # it. The private half is printed once by create and otherwise
            # read from ONIONPRESS_HUB_RECOVERY_KEY, stdin or a prompt,
            # never from argv. The public half goes to
            # $DATA_DIR/hub-backup-recovery.pub, outside the VM's mounts.
            ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" \
                bundled_python -m onionpress.cli --data-dir "$DATA_DIR" hub-recovery-key "${@:2}"
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config, secrets.
            # After reset + start + setup, restore from backup to get data back.
            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo ""
                echo "  This will ERASE everything: WordPress, database, Tor state,"
                echo "  onion address keys, config, and secrets."
                echo ""
                echo "  To preserve your data, run 'onionpress backup' first."
                echo ""
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            # The onion service key goes with the reset: OnionHeaven hubs
            # that may hold a copy are asked to delete it first, while it
            # can still sign the request.
            if ! onionheaven_release reset; then
                echo "Cancelled."
                exit 1
            fi

            log "Resetting OnionPress (full wipe)..."

            # Stop everything
            setup_db_passwords 2>/dev/null || true
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            log "Removing Docker volumes..."
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 && log "Removed volume: $vol" || log "WARNING: Failed to remove volume: $vol"
            done

            # Wipe data directory (keep colima VM and docker-config). The
            # OnionHeaven registration record stays when a hub may still
            # hold a key: it is what says what remains on which hub.
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            if [ "$ONIONHEAVEN_RELEASE_RC" -eq 0 ]; then
                rm -f "$DATA_DIR/onionheaven-registration.json"
            fi
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            log "Removed keys, config, secrets, and logs"

            echo ""
            echo "  Reset complete. Everything wiped. Starting fresh containers..."
            echo ""

            # Start fresh containers
            setup_db_passwords
            start_containers
            wait_for_services

            log "OnionPress reset and restarted"
            echo "  Containers running. Run 'onionpress setup' to initialize WordPress."
            ;;

        scrub)
            # Scrub: full lifecycle test — backup, reset, restore, verify.
            # Proves backup/restore integrity and that reset truly cleans up.
            # Usage: onionpress scrub [wp-admin-password]
            echo ""
            echo "OnionPress Scrub"
            echo "================"
            echo "This will: backup → reset → restore → verify"
            echo ""

            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            # ── Step 1: Backup ──────────────────────────────────────────
            echo ""
            echo "── Step 1/4: Backup ──"
            setup_db_passwords
            local scrub_pass="${2:-}"
            if [ -z "$scrub_pass" ]; then
                read -r -s -p "WordPress admin password (for backup): " scrub_pass
                echo ""
            fi
            if [ -z "$scrub_pass" ]; then
                echo "ERROR: Password is required for backup."
                exit 1
            fi
            local scrub_backup="/tmp/onionpress-scrub-$(date +%Y%m%d-%H%M%S).zip"
            ONIONPRESS_BACKUP_PASSWORD="$scrub_pass" bundled_python -m onionpress.cli backup --output "$scrub_backup"

            # Capture the live identity + a log mark BEFORE teardown so Step 4 can
            # prove install-from-backup preserved the address and did not
            # regenerate a vanity key during the restore.
            local scrub_addr_before scrub_log_mark
            scrub_addr_before=$(docker compose -f "$DOCKER_DIR/docker-compose.yml" exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
            scrub_log_mark=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
            echo "  Pre-scrub address: ${scrub_addr_before:-<none>}"

            # ── Step 2: Reset ───────────────────────────────────────────
            echo ""
            echo "── Step 2/4: Reset ──"
            # The reset wipes the config (OnionHeaven back to undecided, so
            # no heartbeat follows the restore): hubs that may hold the key
            # are asked to delete their copy, as by `reset`, or one would
            # take the restored, running site over.
            if ! onionheaven_release scrub; then
                echo "Cancelled. Backup kept at: $scrub_backup"
                exit 1
            fi
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
            done

            # Wipe data directory (keep colima VM and docker-config); the
            # OnionHeaven record stays when a hub may still hold a key.
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            if [ "$ONIONHEAVEN_RELEASE_RC" -eq 0 ]; then
                rm -f "$DATA_DIR/onionheaven-registration.json"
            fi
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            echo "  Reset complete."

            # ── Step 3: Restore ─────────────────────────────────────────
            echo ""
            echo "── Step 3/4: Restore (install-from-backup) ──"
            setup_db_passwords
            # cli restore tears down (already reset above) and rebuilds the
            # install directly from the backup — seeded key + imported DB/
            # content, no in-place overwrite or key-volume swap churn.
            ONIONPRESS_BACKUP_PASSWORD="$scrub_pass" bundled_python -m onionpress.cli restore "$scrub_backup"
            echo "  Restore and restart complete."

            # ── Step 4: Verify ──────────────────────────────────────────
            echo ""
            echo "── Step 4/4: Verify ──"
            local scrub_ok=true

            # Check containers are running
            local expected_containers="onionpress-tor onionpress-wordpress onionpress-db onionheaven"
            for ctr in $expected_containers; do
                if docker ps --format '{{.Names}}' | grep -q "^${ctr}$"; then
                    echo "  ✓ $ctr running"
                else
                    echo "  ✗ $ctr NOT running"
                    scrub_ok=false
                fi
            done

            # Check onion address is present
            local scrub_addr
            scrub_addr=$(docker compose -f "$DOCKER_DIR/docker-compose.yml" exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
            if [ -n "$scrub_addr" ]; then
                echo "  ✓ Onion address: $scrub_addr"
            else
                echo "  ✗ No onion address found"
                scrub_ok=false
            fi

            # install-from-backup criteria: the restored identity must MATCH the
            # pre-scrub address (proves the backup key was reused, not a freshly
            # generated vanity), and no vanity generation ran during the scrub.
            if [ -n "$scrub_addr_before" ]; then
                if [ "$scrub_addr" = "$scrub_addr_before" ]; then
                    echo "  ✓ Address preserved (rebuilt from backup key, no regeneration)"
                else
                    echo "  ✗ Address CHANGED: was $scrub_addr_before, now $scrub_addr"
                    scrub_ok=false
                fi
            fi
            if tail -n +"$((scrub_log_mark + 1))" "$LOG_FILE" 2>/dev/null | \
                 grep -qiE "Generating custom onion address|Generated custom address"; then
                echo "  ✗ Vanity address regenerated during restore (should reuse backup key)"
                scrub_ok=false
            else
                echo "  ✓ No vanity regeneration during restore"
            fi

            # Check WordPress responds
            local wp_status
            wp_status=$(docker exec onionpress-wordpress curl -s -o /dev/null -w '%{http_code}' http://localhost:80/ 2>/dev/null || echo "000")
            if [ "$wp_status" = "200" ] || [ "$wp_status" = "301" ] || [ "$wp_status" = "302" ]; then
                echo "  ✓ WordPress responding (HTTP $wp_status)"
            else
                echo "  ✗ WordPress not responding (HTTP $wp_status)"
                scrub_ok=false
            fi

            echo ""
            if [ "$scrub_ok" = "true" ]; then
                echo "Scrub PASSED — backup/reset/restore all working."
            else
                echo "Scrub FAILED — see errors above."
            fi

            # Clean up backup file
            rm -f "$scrub_backup"
            echo "  Cleaned up: $scrub_backup"

            # Stop everything so the app can do a clean start
            echo ""
            echo "Stopping containers for clean app launch..."
            stop_containers 2>/dev/null || true
            echo "Done. Launch OnionPress from /Applications to start fresh."
            ;;

        update)
            # Self-update from a GitHub release. Two modes:
            #   --check     dry-run check (no install)
            #   -y / --yes  install without prompting (use in scripts)
            # Ported from the former onionpress-cli wrapper so there's a
            # single CLI surface; the wrapper's check-for-update path
            # delegates to onionpress.cli for the canonical presentation.
            shift  # drop "update"
            YES_FLAG="0"
            CHECK_ONLY="0"
            for arg in "$@"; do
                case "$arg" in
                    -y|--yes) YES_FLAG="1" ;;
                    --check)  CHECK_ONLY="1" ;;
                    -h|--help)
                        cat <<EOF
Usage: $0 update [--check] [-y|--yes]

  --check     Only check for an update; don't install.
  -y, --yes   Install without prompting (use in scripts).
EOF
                        exit 0 ;;
                    *)
                        echo "Unknown update option: $arg" >&2
                        exit 2 ;;
                esac
            done

            if [ ! -x "$_BUNDLED_PYTHON_BIN" ]; then
                echo "Bundled Python not found at $_BUNDLED_PYTHON_BIN" >&2
                exit 1
            fi

            if [ "$CHECK_ONLY" = "1" ]; then
                exec bundled_python -m onionpress.cli check-for-update
            fi

            ONIONPRESS_APP_PATH="$(dirname "$APP_DIR")" \
            ONIONPRESS_YES="$YES_FLAG" \
                bundled_python - <<'PY'
import os, sys, plistlib
from onionpress import updater

app_path = os.environ["ONIONPRESS_APP_PATH"]
with open(os.path.join(app_path, "Contents", "Info.plist"), "rb") as f:
    current = plistlib.load(f).get("CFBundleShortVersionString", "0")

print(f"Installed: {current}")
print("Checking GitHub for updates...")
result = updater.check_for_update(current, log=lambda m: None)
if not result:
    print("Already up to date.")
    sys.exit(0)

release_data, latest = result
print(f"Update available: {latest}  (published {release_data.get('published_at', '?')})")

notes = (release_data.get("body") or "").strip()
if notes:
    print()
    snippet = notes if len(notes) <= 800 else notes[:800] + "\n... (truncated)"
    print(snippet)
    print()

others = updater.detect_other_instances()
if others:
    print("Note: other users are running OnionPress:")
    for o in others:
        print(f"  - {o['user']} (pid {o['pid']})")
    print("Updating replaces the shared app bundle for everyone.")
    print()

if os.environ.get("ONIONPRESS_YES") != "1":
    if not sys.stdin.isatty():
        print("Re-run with --yes to install non-interactively.", file=sys.stderr)
        sys.exit(2)
    reply = input(f"Install v{latest} now? [y/N] ").strip().lower()
    if reply not in ("y", "yes"):
        print("Aborted.")
        sys.exit(0)

print(f"Downloading and installing v{latest}...")
updater.download_and_install(release_data, latest, app_path, log=print)
print(f"Installed v{latest}. Quit and relaunch OnionPress to use the new version.")
PY
            ;;

        help|-h|--help)
            cat <<EOF
OnionPress - WordPress + Tor Onion Service

Usage: $0 <command> [args]

User commands:
  start         Start WordPress and Tor containers
  stop          Stop all containers (leaves MenubarApp + VM running)
  quit          Fully shut down: containers + Colima VM + MenubarApp
