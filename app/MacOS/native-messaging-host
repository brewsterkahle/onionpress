# The browser extension's native messaging host (issue #318): what the
# manifests install_native_messaging writes name as "path". The browser runs
# it with the user's environment and no Python of the app's; a Mac ships no
# usable python3, so the host module runs on the MenubarApp's own Python,
# with the launcher's bundled_python environment (PYTHONSAFEPATH: `-m`
# would otherwise put the browser's current directory first on sys.path,
# issue #470). The browser's arguments (Chrome: the caller's origin;
# Firefox: the manifest's path and the extension's id) are not passed on:
# the host reads only its messages on stdin.

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RESOURCES_DIR="$(dirname "$SCRIPT_DIR")/Resources"
PYTHONHOME="$RESOURCES_DIR/MenubarApp/Contents/Resources" PYTHONSAFEPATH=1 \
    exec "$RESOURCES_DIR/MenubarApp/Contents/MacOS/python" -m onionpress.native_messaging_host
