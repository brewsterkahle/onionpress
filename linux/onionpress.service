[Unit]
Description=OnionPress - WordPress over Tor Onion Service
# Soft dependency: rootless docker.service may already be running
Wants=docker.service
After=docker.service

[Service]
# `onionpress start` brings the containers up and returns; the unit stays
# active (RemainAfterExit) so `is-active` says so and ExecStop runs at a
# stop or a restart. The long-running work (status, probe, heartbeat, the
# Settings page's requests, log capture) is onionpress-daemon.service's,
# which is ordered before this unit (issue #407; until then `start` kept
# a 30 s status loop alive as a Type=notify unit).
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/onionpress/onionpress start
ExecStop=/opt/onionpress/onionpress stop
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
