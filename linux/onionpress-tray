# ─── Logging ────────────────────────────────────────────────────────────

# The menubar's RotatingLog redaction (log_rotation, redact): the home
# folder is "~" in every line as it is written, and a rolled file is
# scrubbed (redact.make_scrub_fn: tokens, credentials) before it is kept.
_HOME = os.path.expanduser("~")
_scrub_rolled = redact.make_scrub_fn(DATA_DIR, scrub_ips=False)


class _HomeAsTilde(logging.Filter):
    def filter(self, record):
        if _HOME and _HOME != os.sep:
            record.msg = record.getMessage().replace(_HOME, "~")
            record.args = None
        return True


def _rotate_scrubbed(source: str, dest: str) -> None:
    """RotatingFileHandler's rotator: *source* scrubbed into *dest*
    (0600). Fail-open as RotatingLog is: a scrubbing bug never costs the
    log history."""
    with open(source, "rb") as f:
        raw = f.read()
    try:
        raw = _scrub_rolled(raw)
    except Exception:
        pass
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(raw)
    os.remove(source)


os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
_log_handler = logging.handlers.RotatingFileHandler(
    TRAY_LOG, maxBytes=5 * 1024 * 1024, backupCount=3
)
_log_handler.rotator = _rotate_scrubbed
_log_handler.setFormatter(logging.Formatter(
    "%(asctime)s %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
))
logger = logging.getLogger("onionpress-tray")
logger.setLevel(logging.INFO)
logger.addFilter(_HomeAsTilde())
logger.addHandler(_log_handler)
logger.addHandler(logging.StreamHandler())


def log(msg: str) -> None:
    logger.info(msg)


# ─── 1. Single-instance lock ────────────────────────────────────────────

def acquire_single_instance_lock() -> Optional[int]:
    """flock our PID file. Returns the fd on success, None if another
    tray instance already holds the lock (we then exit quietly).
    """
    fd = os.open(PIDFILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    return fd


# ─── 2. Status reader (the daemon's state file, polled) ─────────────────

def _read_status() -> Optional[dict]:
    """status.json's content from the daemon's state file, or None."""
    state = daemon_client.read_state(DATA_DIR)
    status = state.get("status") if state else None
    return status if isinstance(status, dict) else None


class Status:
    """Owns the latest view of the daemon's state file
    (ui_client.status_view, as the menubar's: a state older than 90 s or
    from a dead pid is "reconnecting", never the last thing it said).
    Polls every POLL_INTERVAL_SEC seconds via GLib so callbacks fire on
    the GTK main thread.
    """

    def __init__(self, on_change):
        self.view = ui_client.status_view(None, time.time(), daemon_seen=False)
        self.state = self.view.category
        self.onion_address = ""
        self.wp_installed = False
        self.onboarded = False
        self.mkp224o_available = False
        self.serving_from_wayback = False
        self.bootstrap_pct = 0
        self.uptime_seconds = 0
        self.containers = {}
        self.wp_port = 8080
        self.raw = {}
        self.host_cloudflared_notice = None
        self._doc = None
        self._daemon_seen = False
        self._mtime = 0.0
        self._on_change = on_change
        GLib.timeout_add_seconds(POLL_INTERVAL_SEC, self._poll)

    def _poll(self) -> bool:
        # The file is read again only when it changed; the view is
        # recomputed every tick, so a daemon that stopped writing turns
        # into "reconnecting".
        try:
            mtime = os.path.getmtime(STATE_FILE)
        except OSError:
            mtime = 0.0
        if mtime != self._mtime:
            self._mtime = mtime
            self._doc = daemon_client.read_state(DATA_DIR) if mtime else None

        old = (self.view, self.wp_installed, self.onboarded,
               self.onion_address, self.serving_from_wayback, self.host_cloudflared_notice)
        now = time.time()
        self.view = ui_client.status_view(self._doc, now, daemon_seen=self._daemon_seen)
        self.state = self.view.category
        if daemon_client.state_is_fresh(self._doc, now):
            self._daemon_seen = True
            # The daemon's host check (onionpress.host_cloudflared, #547).
            self.host_cloudflared_notice = ui_client.host_cloudflared_notice(self._doc, "linux")
            data = self._doc.get("status")
            if isinstance(data, dict):
                self._take(data)
        new = (self.view, self.wp_installed, self.onboarded,
               self.onion_address, self.serving_from_wayback, self.host_cloudflared_notice)

        if old != new:
            try:
                self._on_change(old[0].category, new[0].category)
            except Exception as e:
                log(f"on_change handler raised: {e}")
        return True

    def _take(self, data: dict) -> None:
        self.raw = data
        self.onion_address = data.get("onion_address", "") or ""
        self.wp_installed = bool(data.get("wp_installed"))
        self.onboarded = bool(data.get("onboarded"))
        self.mkp224o_available = bool(data.get("mkp224o_available"))
        self.serving_from_wayback = bool(data.get("serving_from_wayback"))
        self.bootstrap_pct = int(data.get("bootstrap_pct", 0))
        self.uptime_seconds = int(data.get("uptime_seconds", 0))
        self.containers = dict(data.get("containers", {}))
        # wp_port reflects the launcher's port-offset detection so the
        # tray opens the right localhost URL on multi-user / port-conflict
        # installs (e.g. system tor on 9050 pushes WP to 18080).
        try:
            self.wp_port = int(data.get("wp_port", 8080))
        except (TypeError, ValueError):
            self.wp_port = 8080


# ─── 3. The launcher client ─────────────────────────────────────────────
#
# Every action runs `/opt/onionpress/onionpress <subcommand>` through the
# UIs' shared client (onionpress.ui_client, issue #526): a password or a
# hub's recovery key in the environment, never on argv (tray.log gets
# the subcommand's name only), stdin /dev/null, the CLI's last JSON line
# as the answer. The check/confirm protocol (onionpress.confirm, issue
# #375) is its too: `onionpress backup` and `onionpress restore` are
# asked first what they would do (`--check --json`), the dialogs here
# are built from the facts (_GtkBackupUI, _GtkRestoreUI, _ask_question),
# and the command runs again with `--confirmed <what>` for every
# question asked. Cancel is the default in every dialog, and no answer
# in QUESTION_TIMEOUT_SEC is Cancel (_run_dialog).

Launcher = ui_client.Launcher(LAUNCHER, log)
QUESTION_TIMEOUT_SEC = ui_client.QUESTION_TIMEOUT_SEC


