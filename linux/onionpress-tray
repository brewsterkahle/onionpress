def show_backup_dialog(parent=None):
    """Create a backup through `onionpress backup` (ui_client.plan_backup:
    `backup --check --json` verifies the password as the owner's and names
    the file before the long-running backup, so a typo is "Password does
    not match" in 1-2 s instead of a backup that fails at the end; then
    run_backup). The password goes in the environment, never on argv."""
    ui = _GtkBackupUI(parent)

    def _run():
        try:
            plan = ui_client.plan_backup(Launcher, ui, log=log)
        except Exception as e:
            log(f"backup check error: {e}")
            _notify_failed("Backup failed")
            return
        if plan is None:
            return
        # No time limit here (issue #317): a fixed 300 s ended large sites'
        # backups, and killing the launcher stopped only the shell, not the
        # docker and Python steps under it. The copies there carry their own
        # limits, sized to the site, and fail the launcher when one is hit.
        try:
            result = ui_client.run_backup(Launcher, plan, log=log)
            Notify.Notification.new(
                "Backup complete" if result.ok else "Backup failed",
                result.message[:400], "onionpress",
            ).show()
        except Exception as e:
            log(f"backup error: {e}")
            _notify_failed("Backup failed")
    threading.Thread(target=_run, daemon=True).start()


def show_restore_dialog(parent=None):
    """Restore from a backup .zip through `onionpress restore` (install-
    from-backup). The launcher is asked first what the backup is
    (`restore <zip> --check --json`, ui_client.plan_restore): the password
    it needs, the facts for the confirmation dialog, and whether a hub's
    sealed data needs the recovery key. The dialogs are this process's
    (_GtkRestoreUI); the password and the key go in the environment,
    never on argv."""
    chooser = Gtk.FileChooserNative.new(
        "Choose a backup .zip", parent, Gtk.FileChooserAction.OPEN,
        "_Restore", "_Cancel",
    )
    filt = Gtk.FileFilter()
    filt.set_name("OnionPress backups (.zip)")
    filt.add_pattern("*.zip")
    chooser.add_filter(filt)
    chooser.set_current_folder(os.path.expanduser("~/OnionPress/backups"))
    response = chooser.run()
    backup_path = chooser.get_filename() if response == Gtk.ResponseType.ACCEPT else None
    chooser.destroy()
    if not backup_path:
        return

    ui = _GtkRestoreUI(parent, backup_path)

    def _run():
        # The checks wait on the launcher (reading a large backup takes a
        # while); each dialog is marshalled to the main loop.
        try:
            plan = ui_client.plan_restore(Launcher, backup_path, ui, log=log)
        except Exception as e:
            log(f"restore check error: {e}")
            _notify_failed("Restore failed")
            return
        if plan is None:
            return
        # No time limit, as for the backup above: a fixed 600 s ended large
        # sites' restores halfway, the launcher's own steps still running.
        try:
            result = ui_client.run_restore(
                Launcher, plan, data_dir=DATA_DIR,
                log_path=os.path.join(DATA_DIR, "onionpress.log"))
            if result.ok:
                Notify.Notification.new(
                    "Restore complete",
                    "OnionPress has been restored. Containers restarting.",
                    "onionpress",
                ).show()
                _on_main_thread(lambda: _info_dialog(
                    parent, "Restore complete",
                    ui_client.restore_summary(result.answer, plan.facts)))
            else:
                Notify.Notification.new(
                    "Restore failed", result.failure[:200], "onionpress",
                ).show()
        except Exception as e:
            log(f"restore error: {e}")
            _notify_failed("Restore failed")
    threading.Thread(target=_run, daemon=True).start()


