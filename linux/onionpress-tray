class SetupDialog:
    """First-run wizard: welcome form → provisioning progress.

    Shown by the tray until the site is onboarded. Runs `onionpress
    setup --json` (or `provision --json` for a WordPress the start
    installed) through the launcher in a background thread (issue #527:
    setup_logic in the CLI, the onionname registered with OnionHome
    first); GLib.idle_add bridges thread → GTK.

    on_done(success: bool) is called on the GTK thread after provisioning
    completes.
    """

    _STEPS = [
        "Configuring your site title",
        "Creating your account",
        "Setting up your blog",
        "Finishing up",
    ]

    def __init__(self, parent=None, on_done=None):
        self._on_done = on_done
        self._step_idx = 0

        self._dlg = Gtk.Dialog(title="Welcome to OnionPress", parent=parent,
                               flags=0)
        self._dlg.set_deletable(False)
        self._dlg.set_default_size(480, -1)

        self._stack = Gtk.Stack()
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
        self._stack.set_transition_duration(300)

        self._build_welcome()
        self._build_progress()

        content = self._dlg.get_content_area()
        content.set_border_width(0)
        content.add(self._stack)
        self._dlg.show_all()
        self._stack.set_visible_child_name("welcome")

    def run(self):
        self._dlg.run()

    def destroy(self):
        self._dlg.destroy()

    # ── Welcome phase ─────────────────────────────────────────────────

    def _build_welcome(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_border_width(24)

        # Icon-left-of-heading header — same layout idea as the Mac
        # NSAlert About dialog. Falls back to a heading-only row if the
        # bundled app-icon.png can't be loaded for some reason.
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        if os.path.exists(APP_ICON_PATH):
            try:
                from gi.repository import GdkPixbuf  # noqa: WPS433
                pix = GdkPixbuf.Pixbuf.new_from_file_at_size(
                    APP_ICON_PATH, 64, 64)
                img = Gtk.Image.new_from_pixbuf(pix)
                header.add(img)
            except Exception as e:
                log(f"setup dialog icon load failed: {e}")
        heading = Gtk.Label()
        heading.set_markup("<big><b>Set up your OnionPress site</b></big>")
        heading.set_xalign(0)
        heading.set_valign(Gtk.Align.CENTER)
        header.pack_start(heading, True, True, 0)
        box.add(header)

        sub = Gtk.Label(label=(
            "Choose a username and password for your WordPress account. "
            "You can change these later from the dashboard."))
        sub.set_line_wrap(True)
        sub.set_xalign(0)
        box.add(sub)

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)

        row = 0
        grid.attach(Gtk.Label(label="Site title:", xalign=1), 0, row, 1, 1)
        self._title_entry = Gtk.Entry()
        self._title_entry.set_hexpand(True)
        self._title_entry.set_text(_setup_logic.default_site_title())
        self._title_entry.set_placeholder_text("e.g. Alice's OnionPress")
        self._title_entry.connect("changed", self._validate_form)
        grid.attach(self._title_entry, 1, row, 1, 1)

        row += 1
        grid.attach(Gtk.Label(label="Username:", xalign=1), 0, row, 1, 1)
        # Username + Suggest button share row 1 column 1 via an HBox.
        # The Suggest button re-rolls the adjective-noun onionname,
        # matching the Mac SetupWindow's "Suggest" affordance.
        name_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self._name_entry = Gtk.Entry()
        self._name_entry.set_hexpand(True)
        suggestion = _setup_logic.suggest_onionname() or ""
        self._name_entry.set_text(suggestion)
        self._name_entry.set_placeholder_text("letters and numbers only")
        self._name_entry.connect("changed", self._on_name_changed)
        name_row.pack_start(self._name_entry, True, True, 0)
        suggest_btn = Gtk.Button(label="Suggest")
        suggest_btn.set_tooltip_text("Suggest a random onionname")
        suggest_btn.connect("clicked", self._on_suggest_clicked)
        name_row.pack_start(suggest_btn, False, False, 0)
        grid.attach(name_row, 1, row, 1, 1)

        row += 1
        self._name_error = Gtk.Label(label="")
        self._name_error.set_xalign(0)
        grid.attach(self._name_error, 1, row, 1, 1)

        row += 1
        grid.attach(Gtk.Label(label="Password:", xalign=1), 0, row, 1, 1)
        self._pw_entry = Gtk.Entry()
        self._pw_entry.set_hexpand(True)
        self._pw_entry.set_visibility(False)
        self._pw_entry.set_placeholder_text("choose a strong password")
        self._pw_entry.connect("changed", self._validate_form)
        grid.attach(self._pw_entry, 1, row, 1, 1)

        row += 1
        grid.attach(Gtk.Label(label="Confirm:", xalign=1), 0, row, 1, 1)
        self._pw2_entry = Gtk.Entry()
        self._pw2_entry.set_hexpand(True)
        self._pw2_entry.set_visibility(False)
        self._pw2_entry.set_placeholder_text("repeat password")
        self._pw2_entry.connect("changed", self._validate_form)
        self._pw2_entry.connect("activate", self._on_setup_clicked)
        grid.attach(self._pw2_entry, 1, row, 1, 1)

        row += 1
        self._pw_error = Gtk.Label(label="")
        self._pw_error.set_xalign(0)
        grid.attach(self._pw_error, 1, row, 1, 1)

        # Language selector — same list/codes as the Mac SetupWindow so
        # both platforms ship the same default options (setup_logic.
        # SETUP_LANGUAGES, test-held). Passed as `setup --language`.
        row += 1
        grid.attach(Gtk.Label(label="Language:", xalign=1), 0, row, 1, 1)
        self._language_options = [
            ("English", "en_US"),
            ("Français", "fr_FR"),
            ("Español", "es_ES"),
            ("Deutsch", "de_DE"),
            ("Nederlands", "nl_NL"),
            ("Português", "pt_BR"),
            ("日本語", "ja"),
            ("中文", "zh_CN"),
            ("العربية", "ar"),
        ]
        self._language_combo = Gtk.ComboBoxText()
        for name, _code in self._language_options:
            self._language_combo.append_text(name)
        self._language_combo.set_active(0)
        grid.attach(self._language_combo, 1, row, 1, 1)

        # Analytics share checkbox — opt-in, off by default. Writes
        # SHARE_ANALYTICS_WITH_ONIONHOME to ~/.onionpress/config so the
        # daemon picks it up the next time it loads config (analytics
        # uploads gated in src/onionpress/analytics_sharing.py).
        row += 1
        self._analytics_check = Gtk.CheckButton(
            label="Share diagnostic logs with OnionHome")
        self._analytics_check.set_tooltip_text(
            "Helps the OnionPress project diagnose issues. Off by default.")
        grid.attach(self._analytics_check, 1, row, 1, 1)

        box.add(grid)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btn_box.set_halign(Gtk.Align.END)
        self._setup_btn = Gtk.Button(label="Set Up My Site")
        self._setup_btn.get_style_context().add_class("suggested-action")
        self._setup_btn.connect("clicked", self._on_setup_clicked)
        self._setup_btn.set_sensitive(False)
        btn_box.pack_end(self._setup_btn, False, False, 0)
        box.add(btn_box)

        self._stack.add_named(box, "welcome")
        # Trigger initial validation so the button state is correct.
        self._validate_form()

    def _on_suggest_clicked(self, *_):
        name = _setup_logic.suggest_onionname() or ""
        if name:
            # Triggers _on_name_changed via the "changed" signal, which
            # revalidates and updates the inline hint.
            self._name_entry.set_text(name)

    def _on_name_changed(self, *_):
        name = self._name_entry.get_text().strip()
        if name:
            ok, reason = _setup_logic.validate_onionname(name)
            if not ok:
                self._name_error.set_text(
                    _setup_logic.onionname_error_message(reason))
            else:
                self._name_error.set_text("")
        else:
            self._name_error.set_text("")
        self._validate_form()

    def _validate_form(self, *_):
        title_ok = bool(self._title_entry.get_text().strip())
        name = self._name_entry.get_text().strip()
        name_ok = bool(name)
        if name_ok:
            name_ok, _ = _setup_logic.validate_onionname(name)
        pw = self._pw_entry.get_text()
        pw2 = self._pw2_entry.get_text()
        pw_ok = len(pw) >= 6
        match_ok = pw == pw2
        if pw2 and not match_ok:
            self._pw_error.set_text("Passwords don't match")
        elif pw and not pw_ok:
            self._pw_error.set_text("Password too short (min 6 characters)")
        else:
            self._pw_error.set_text("")
        if self._setup_btn:
            self._setup_btn.set_sensitive(
                title_ok and name_ok and pw_ok and match_ok)

    # ── Progress phase ────────────────────────────────────────────────

    def _build_progress(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(24)

        heading = Gtk.Label()
        heading.set_markup("<big><b>Setting up your site…</b></big>")
        heading.set_xalign(0)
        box.add(heading)

        self._step_labels = []
        for step in self._STEPS:
            lbl = Gtk.Label(label=f"  · {step}")
            lbl.set_xalign(0)
            box.add(lbl)
            self._step_labels.append(lbl)

        self._progress_bar = Gtk.ProgressBar()
        box.add(self._progress_bar)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_size_request(-1, 120)
        scrolled.set_hexpand(True)
        self._log_view = Gtk.TextView()
        self._log_view.set_editable(False)
        self._log_view.set_monospace(True)
        self._log_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scrolled.add(self._log_view)
        box.add(scrolled)

        self._stack.add_named(box, "progress")

    # ── Button click / provisioning ───────────────────────────────────

    def _on_setup_clicked(self, *_):
        title = self._title_entry.get_text().strip()
        onionname = self._name_entry.get_text().strip()
        password = self._pw_entry.get_text()
        if not (title and onionname and len(password) >= 6
                and password == self._pw2_entry.get_text()):
            return
        ok, _ = _setup_logic.validate_onionname(onionname)
        if not ok:
            return

        lang_idx = self._language_combo.get_active()
        language = (self._language_options[lang_idx][1]
                    if 0 <= lang_idx < len(self._language_options)
                    else "en_US")
        share_analytics = "yes" if self._analytics_check.get_active() else "no"

        self._stack.set_visible_child_name("progress")
        threading.Thread(
            target=self._provision,
            args=(title, onionname, password, language, share_analytics),
            daemon=True,
        ).start()

    def _provision(self, title, onionname, password, language, share_analytics):
        # Persist analytics preference up front so the setting takes
        # effect even if provisioning is interrupted mid-way (the
        # bootstrap user is still set, and the daemon will respect
        # the opt-in/out flag on next config reload). Through
        # `onionpress config set`, the one writer of the config (#365).
        try:
            r = Launcher.run("config", "set", "SHARE_ANALYTICS_WITH_ONIONHOME",
                             share_analytics, capture=True)
            if r.returncode != 0:
                self._log("warn: failed to persist analytics pref: "
                          f"{(r.stderr or r.stdout).strip()}")
        except Exception as e:
            self._log(f"warn: failed to persist analytics pref: {e}")

        # `setup` installs WordPress (the new path); `provision` takes one
        # an older start auto-installed (the legacy bootstrap). Both
        # register the onionname with OnionHome before WordPress gets it;
        # a name OnionHome has for another site is asked again and the
        # command run again (nothing was installed).
        verb = "provision" if self._status_wp_installed() else "setup"
        later = []
        ok = False
        for _ in range(5):
            rc, answer, out, err = Launcher.run_json(
                verb, "--user", onionname, "--title", title, "--language", language,
                *later, "--json", env={ui_client.SETUP_PASSWORD_ENV: password},
                on_line=self._log, timeout=None)
            answer = answer or {}
            if answer.get("error") == "taken":
                new_name = _on_main_thread(
                    lambda: _ask_another_onionname(self._dlg, onionname,
                                                   answer.get("suggestions") or []))
                if new_name:
                    onionname = new_name
                else:
                    later = ["--register-later"]
                continue
            ok = rc == 0 and bool(answer.get("ok"))
            if not ok:
                self._log("setup failed: " + (answer.get("error") or ui_client.launcher_failure(
                    out, err, "see the OnionPress log")))
            break
        GLib.idle_add(self._done, ok)

    def _status_wp_installed(self) -> bool:
        # The tray's Status snapshot lives on a different thread; this
        # helper reads the file to avoid races during provisioning.
        return bool((_read_status() or {}).get("wp_installed"))

    # ── Thread-safe UI helpers ────────────────────────────────────────

    def _log(self, msg: str) -> None:
        logger.info("setup: %s", msg)
        GLib.idle_add(self._append_log, msg)
        if "Site title set" in msg:
            GLib.idle_add(self._advance_step)
        elif "Username set" in msg or "Username update" in msg:
            GLib.idle_add(self._advance_step)
        elif "Subsite /" in msg and "ready" in msg:
            GLib.idle_add(self._advance_step)
        elif "Marked as onboarded" in msg:
            GLib.idle_add(self._advance_step)

    def _append_log(self, msg: str) -> bool:
        buf = self._log_view.get_buffer()
        buf.insert(buf.get_end_iter(), f"{msg}\n")
        self._log_view.scroll_to_mark(buf.get_insert(), 0.0, False, 0, 0)
        return False

    def _advance_step(self) -> bool:
        if self._step_idx > 0:
            i = self._step_idx - 1
            self._step_labels[i].set_label(f"  ✓ {self._STEPS[i]}")
        if self._step_idx < len(self._step_labels):
            self._step_labels[self._step_idx].set_label(
                f"  ⟳ {self._STEPS[self._step_idx]}")
        self._step_idx += 1
        self._progress_bar.set_fraction(
            min(self._step_idx / len(self._STEPS), 1.0))
        return False

    def _done(self, success: bool) -> bool:
        logger.info("setup %s", "PASSED" if success else "FAILED")
        if self._step_idx > 0 and self._step_idx <= len(self._step_labels):
            i = self._step_idx - 1
            self._step_labels[i].set_label(f"  ✓ {self._STEPS[i]}")
        self._progress_bar.set_fraction(1.0)
        if self._on_done:
            self._on_done(success)
        self._dlg.response(Gtk.ResponseType.OK)
        return False


# ─── 7. The tray itself ────────────────────────────────────────────────

class OnionPressTray:
    def __init__(self):
        # Icons are registered in the standard user hicolor theme by
        # install.sh (tray-running/starting/stopped at 16/22/24/32px),
        # so GNOME Shell finds them by name without a custom theme path.
        # new_with_path + a custom path caused GNOME to render at native
        # pixel size rather than scaling to the panel slot, causing clipping.
        self.indicator = AppIndicator.Indicator.new(
            "onionpress",
            ICON_STARTING,
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("OnionPress")

        self.notifier = Notifier()
        # Re-entrancy guards so impatient clicks during Tor Browser
        # bootstrap (a 30-60s window) don't spawn a second torbrowser-
        # launcher — which would hit the lock file and pop the "Tor
        # Browser is already running" dialog at the user.
        self._tor_launch_in_progress = False
        self.menu = Gtk.Menu()
        self._build_menu()
        self.indicator.set_menu(self.menu)

        self.status = Status(on_change=self._on_status_change)
        self._update_icon()
        self._update_status_line()

        self._announced_starting = False
        self._host_cloudflared_warned = False
        self._announced_online = False
        self._setup_shown = False

    def _build_menu(self):
        # Layout mirrors the Mac menubar (src/menubar.py:472) so users
        # switching between platforms see the same options in the same
        # order. Linux-specific tweaks: "Open in Browser" routes through
        # `onionpress dashboard` for one-click auto-login (same magic-
        # link plugin the Mac uses); "Open .onion (Tor Browser)" sits
        # alongside it as a Linux convenience since torbrowser-launcher
        # is a Recommends.
        self.menu_status = Gtk.MenuItem(label="OnionPress is starting…")
        self.menu_status.set_sensitive(False)
        self.menu.append(self.menu_status)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.menu_copy_address = self._item("Copy Onion Address", self._on_copy_address)
        self.menu_open_local = self._item("Open Local Site", self._on_open_local)
        self.menu_open_onion = self._item("Open in Tor Browser", self._on_open_onion)
        self.menu.append(Gtk.SeparatorMenuItem())

        self.menu_start = self._item("Start", lambda *_: Launcher.run_async("start"))
        self.menu_stop = self._item("Stop", lambda *_: Launcher.run_async("stop"))
        self.menu_restart = self._item("Restart", lambda *_: Launcher.run_async("restart"))
        self.menu.append(Gtk.SeparatorMenuItem())

        self._item("View Logs", lambda *_: show_log_viewer())
        self._item("Settings…", self._on_open_settings)
        self.menu.append(Gtk.SeparatorMenuItem())

        self.menu_backup = self._item("Backup…", lambda *_: show_backup_dialog())
        self.menu_restore = self._item("Restore…", lambda *_: show_restore_dialog())
        self.menu.append(Gtk.SeparatorMenuItem())

        self._item("Check for Updates…", self._on_check_updates)
        self._item("About OnionPress", lambda *_: show_about_dialog())
        self._item("Uninstall OnionPress…", self._on_uninstall)
        self.menu.append(Gtk.SeparatorMenuItem())

        self._item("Quit", self._on_quit)

        self.menu.show_all()

    def _item(self, label, callback):
        it = Gtk.MenuItem(label=label)
        it.connect("activate", callback)
        self.menu.append(it)
        return it

    def _on_status_change(self, old_state, new_state):
        log(f"status: {old_state} -> {new_state}")
        self._update_icon()
        self._update_status_line()
        self._maybe_announce()
        self._maybe_warn_host_cloudflared()
        self._maybe_show_setup()

    def _maybe_warn_host_cloudflared(self):
        """A cloudflared on the host serving the same tunnel (the daemon's
        state says so): a notification, once while it lasts."""
        notice = self.status.host_cloudflared_notice
        if notice and not self._host_cloudflared_warned:
            self._host_cloudflared_warned = True
            log("host cloudflared detected (the daemon's state)")
            self.notifier.notify("host-cloudflared", notice.title, notice.body,
                                 urgency="critical")
        elif not notice:
            self._host_cloudflared_warned = False

    def _update_icon(self):
        view = self.status.view
        self.indicator.set_icon_full(ICONS.get(view.icon, ICON_STOPPED), view.title)
        # Trigger a redraw — some shells (Ubuntu Wayland) cache the previous
        # IconName and only refresh when properties change. Calling
        # set_status() with the same value forces a NewIcon signal.
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)

    def _update_status_line(self):
        """The view's title and the actions it enables (the menubar's)."""
        view = self.status.view
        self.menu_status.set_label(view.title)
        for item, action in ((self.menu_start, "start"), (self.menu_stop, "stop"),
                             (self.menu_restart, "restart"), (self.menu_backup, "backup"),
                             (self.menu_restore, "restore"), (self.menu_open_onion, "open_onion"),
                             (self.menu_open_local, "open_local")):
            item.set_sensitive(action in view.actions)
        self.menu_copy_address.set_sensitive(bool(self.status.onion_address))

    def _maybe_announce(self):
        if not self._announced_starting and (
                self.status.state == "available" or self.status.state in STARTING_STATES):
            if not self.status.wp_installed:
                self._announced_starting = True
                if is_raspberry_pi():
                    body = "First launch downloads ~500 MB of containers. Takes 5–8 minutes on a Pi."
                else:
                    body = "First launch downloads ~500 MB of containers. Takes 2–3 minutes."
                self.notifier.notify(
                    "starting", "OnionPress is setting up", body,
                )

        marker = os.path.join(DATA_DIR, ".first-online-notified")
        if (not self._announced_online
                and self.status.state == "available"
                and self.status.onion_address
                and not os.path.exists(marker)):
            self._announced_online = True
            try:
                with open(marker, "w") as f:
                    f.write("1")
            except OSError:
                pass
            addr = self.status.onion_address
            self.notifier.notify(
                "address-ready",
                "OnionPress is online",
                f"Your site: {addr}",
                actions=[
                    ("open-dashboard", "Open Dashboard",
                     lambda: Launcher.run_async("dashboard")),
                ],
            )

    def _maybe_show_setup(self):
        if self._setup_shown:
            return
        if self.status.onboarded:
            return
        # Trigger as soon as containers are up — WP may or may not be
        # installed. SetupDialog's _provision branches on wp_installed
        # to either `onionpress setup` (new path) or `onionpress
        # provision` (legacy auto-bootstrap path).
        if self.status.state != "available" and self.status.state not in STARTING_STATES:
            return
        self._setup_shown = True
        self._show_setup_dialog()

    def _show_setup_dialog(self):
        """Run SetupDialog synchronously on the GTK main thread.

        gtk.Dialog.run() runs a nested event loop, so status polling
        continues while the dialog is open.
        """
        def _on_done(success):
            if success:
                Launcher.run_async("open", "site")
            else:
                # Mirror the Mac menubar: keep re-showing the dialog
                # until setup succeeds. There's no "Setup…" menu item
                # to recover with, so the auto-popup is the only path.
                self._setup_shown = False

        dlg = SetupDialog(on_done=_on_done)
        dlg.run()
        dlg.destroy()

    def _on_copy_address(self, *_):
        addr = self.status.onion_address
        if not addr:
            return
        # Match the Mac menubar's copy_address(): full URL including the
        # /<onionname>/ subsite path so the copied URL takes the recipient
        # straight to the user's site, not to the network root. NO login
        # token is appended — copied URLs are for sharing, and a token
        # would log anyone who follows the link in as admin. Use
        # "Open in Tor Browser" for the personal auto-login flow. The URL
        # is the one `onionpress address --url` gives (ui_client.site_url).
        url = ui_client.site_url(addr, _onionname())

        # Gtk.Clipboard.set_text() from a window-less tray callback is
        # a silent no-op on Wayland (no window to own the clipboard;
        # no clipboard manager wired up by default). Pop the same
        # window-having dialog the "Open in Tor Browser" path uses —
        # its window owns the clipboard so the Copy button actually
        # lands the bytes.
        try:
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clip.set_text(url, -1)
            clip.store()
        except Exception as e:
            log(f"clipboard set failed: {e}")
        self._show_text_copy_dialog(
            title="Copy Onion Address",
            heading="Your .onion site URL\n(share this link — no auto-login token)",
            text=url,
        )

    def _show_text_copy_dialog(self, title: str, heading: str, text: str) -> None:
        """Small modal with `text` in a selectable entry plus a Copy button.

        The dialog window owns the clipboard while open, so the Copy
        button reliably lands bytes even when set_text() from a window-
        less tray context silently no-ops (Wayland + no clipboard manager).
        """
        dlg = Gtk.Dialog(title=title, parent=None, flags=0)
        dlg.set_default_size(560, -1)
        copy_btn = dlg.add_button("Copy", 1)
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        dlg.set_default_response(1)

        box = dlg.get_content_area()
        box.set_border_width(12)
        box.set_spacing(8)

        label = Gtk.Label(label=heading, xalign=0.0)
        label.set_line_wrap(True)
        box.pack_start(label, False, False, 0)

        entry = Gtk.Entry()
        entry.set_text(text)
        entry.set_editable(False)
        entry.set_can_focus(True)
        entry.select_region(0, -1)
        box.pack_start(entry, False, False, 0)

        def on_copy(_btn):
            try:
                clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clipboard.set_text(text, -1)
                clipboard.store()
            except Exception as e:
                log(f"clipboard set failed: {e}")
        copy_btn.connect("clicked", on_copy)

        dlg.show_all()
        entry.grab_focus()
        entry.select_region(0, -1)
        dlg.run()
        dlg.destroy()

    def _show_url_copy_dialog(self, url: str) -> None:
        """Pop a small modal showing the URL in a selectable entry, with a
        Copy button. Used when Tor Browser is already running and we
        can't inject a tab via Firefox remoting (TB suppresses DBus
        registration). Window ownership of the clipboard is what makes
        the Copy reliable on Wayland; window-less Gtk.Clipboard.set_text
        from the tray silently no-ops there.
        """
        self._show_text_copy_dialog(
            title="Open in Tor Browser",
            heading=("Tor Browser is already running.\n"
                     "Copy this URL and paste (Ctrl-V) into a new tab.\n"
                     "The auto-login token is included."),
            text=url,
        )

    def _on_open_settings(self, *_):
        # Logged in: `onionpress open` hands the browser a file:// page,
        # never the token on a command line.
        Launcher.run_async("open", "settings")

    def _on_open_local(self, *_):
        # The local site at /<onionname>/, logged in.
        Launcher.run_async("open", "site")

    def _on_open_onion(self, *_):
        """`onionpress open onion --json` (the one implementation, issue
        #527): Tor Browser cold-launched with the
        site as a tab once it is up; the token-bearing URL to paste when
        Tor Browser runs already (it takes no new tab); the default
        browser without torbrowser-launcher."""
        if not self.status.onion_address:
            return
        if self._tor_launch_in_progress:
            self.notifier.notify(
                "tor-launching", "Tor Browser is starting",
                "Already loading — your site will open once Tor connects.",
            )
            return
        self._tor_launch_in_progress = True

        def on_line(line):
            if "Tor Browser is starting" in line:
                GLib.idle_add(lambda: self.notifier.notify(
                    "tor-launching", "Tor Browser is starting",
                    "Once it connects to Tor, your site will load automatically.") and False)

        def run():
            try:
                rc, answer, out, err = Launcher.run_json("open", "onion", "--json",
                                                         on_line=on_line, timeout=None)
            finally:
                self._tor_launch_in_progress = False
            answer = answer or {}
            if answer.get("paste_url"):
                # The token-bearing URL reaches Tor Browser by paste, on
                # no command line.
                GLib.idle_add(lambda: self._show_url_copy_dialog(answer["paste_url"]) and False)
            elif answer.get("launching"):
                GLib.idle_add(lambda: self.notifier.notify(
                    "tor-launching", "Tor Browser is starting",
                    "Already loading — your site will open once Tor connects.") and False)
            elif rc != 0 or not answer.get("ok"):
                log("open onion failed: " + (answer.get("error") or ui_client.launcher_failure(
                    out, err, "see the OnionPress log")))
        threading.Thread(target=run, daemon=True).start()

    def _open_data_folder(self):
        subprocess.Popen(
            ["xdg-open", DATA_DIR],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


    def _on_check_updates(self, *_):
        def _run():
            try:
                # Through the launcher, as every tray action: the one
                # updater of both platforms (cli.cmd_update, #525), the
                # same lookup and report the Mac's Check for Updates reads
                # (ui_client.update_outcome).
                rc, _ans, out, err = Launcher.run_json("update", "--check", "--json")
                outcome = ui_client.update_outcome(rc, out, err)
                body = outcome.body
                if outcome.kind == "available":
                    body = ("Run 'onionpress update' in a terminal to install it "
                            "(it checks the package against the release's SHA256SUMS).")
                category = "update-available" if outcome.kind == "available" else "update-check"
                actions = None
                if outcome.release_url:
                    actions = [(
                        "open-release", "View release",
                        lambda url=outcome.release_url: subprocess.Popen(["xdg-open", url]),
                    )]
                self.notifier.notify(
                    category, outcome.title, body,
                    urgency=outcome.urgency, actions=actions)
            except Exception as e:
                log(f"update check error: {e}")
        threading.Thread(target=_run, daemon=True).start()

    def _on_uninstall(self, *_):
        """The questions, then the launcher's `uninstall` in a terminal
        window (issue #529, as the menubar's Uninstall): `uninstall --check
        --json` says what to ask (onionpress.confirm: "hub-holds-key" when
        an OnionHeaven hub may hold a copy of the key and OnionPress is not
        running to ask it to let go, then "uninstall", the typed DELETE),
        each answered here (ui_client.run_confirmed, _ask_question) and
        given back as --confirmed to the run in the terminal, where the
        uninstaller offers a backup first and sudo asks its password.

        A terminal rather than pkexec: uninstall touches BOTH root-level
        state (/opt/onionpress, system service-file remnants) AND user-
        level state (rootless docker compose down, systemctl --user stop,
        ~/.config/systemd/user/...); root for everything breaks the
        user-level half, and the user for everything leaves sudo's prompt
        nowhere to be answered.

        When uninstall reaches `pkill -f onionpress-tray` this process
        dies and the icon disappears: no Gtk.main_quit here. ~/OnionPress
        (backups, Creations) is kept.
        """
        outcome = ui_client.run_confirmed(
            Launcher, ["uninstall", "--check", "--json"],
            lambda what, facts, action="Uninstall": _ask_question(None, what, facts, action),
            action="Uninstall", timeout=300)
        if outcome.declined:
            log(f"uninstall cancelled at the '{(outcome.answer or {}).get('confirm')}' question")
            return
        if not outcome.ok:
            failure = outcome.failure("see the OnionPress log")
            log(f"uninstall: check failed: {failure}")
            try:
                Notify.Notification.new("Uninstall could not start",
                                        f"OnionPress could not check what to ask: {failure}"[:200],
                                        "onionpress").show()
            except Exception:
                pass
            return
        flags = " ".join(outcome.flags)

        # Shell command: run uninstaller, then pause so the user can read
        # any final output before the terminal window closes.
        uninstall_cmd = (
            f"/opt/onionpress/onionpress uninstall {flags};"
            ' rc=$?; printf "\\n[uninstall exited with rc=%s] '
            'Press Enter to close..." "$rc"; read'
        )

        # Argv builders for each terminal emulator. Ordered by preference
        # (ptyxis is the default on Ubuntu 24+ / GNOME 47; gnome-terminal
        # legacy; konsole/xfce4 for non-GNOME desktops; xterm last-ditch).
        import shutil as _sh
        terminals = [
            ("ptyxis",         ["ptyxis", "--new-window", "--",
                                "bash", "-c", uninstall_cmd]),
            ("gnome-terminal", ["gnome-terminal", "--",
                                "bash", "-c", uninstall_cmd]),
            ("konsole",        ["konsole", "-e",
                                "bash", "-c", uninstall_cmd]),
            ("xfce4-terminal", ["xfce4-terminal", "--command",
                                "bash -c '" + uninstall_cmd.replace("'", "'\\''") + "'"]),
            ("mate-terminal",  ["mate-terminal", "--",
                                "bash", "-c", uninstall_cmd]),
            ("tilix",          ["tilix", "-e",
                                "bash", "-c", uninstall_cmd]),
            ("kitty",          ["kitty", "bash", "-c", uninstall_cmd]),
            ("alacritty",      ["alacritty", "-e",
                                "bash", "-c", uninstall_cmd]),
            ("xterm",          ["xterm", "-e",
                                "bash", "-c", uninstall_cmd]),
        ]

        chosen = None
        for name, argv in terminals:
            if _sh.which(name):
                chosen = (name, argv)
                break

        if chosen is None:
            log("uninstall: no terminal emulator found")
            try:
                Notify.Notification.new(
                    "Uninstall needs a terminal",
                    "No terminal emulator was found. Run "
                    "`/opt/onionpress/onionpress uninstall` manually.",
                    "onionpress",
                ).show()
            except Exception:
                pass
            return

        try:
            subprocess.Popen(
                chosen[1],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, start_new_session=True,
            )
        except (OSError, FileNotFoundError) as e:
            log(f"failed to launch {chosen[0]} for uninstall: {e}")
            try:
                Notify.Notification.new(
                    "Uninstall failed to start",
                    str(e)[:200], "onionpress",
                ).show()
            except Exception:
                pass

    def _on_quit(self, *_):
        if not confirm_quit():
            return

        # Tear the UI down NOW, before launching the background stop.
        # The launcher's quit can take a while (the hub's /offline, the
        # containers, the units), and Gtk.main_quit
        # alone only unwinds one nested loop — any open About / Setup /
        # Backup / Log dialog would keep its own dlg.run() loop alive
        # and the tray icon would linger via the AppIndicator's D-Bus
        # name. Hiding the indicator + destroying every toplevel makes
        # the click feel instant; the background thread still finishes
        # the stop and then hard-exits the process.
        try:
            self.indicator.set_status(AppIndicator.IndicatorStatus.PASSIVE)
        except Exception as e:
            log(f"hiding indicator on quit: {e}")
        for w in Gtk.Window.list_toplevels():
            try:
                w.destroy()
            except Exception as e:
                log(f"destroying window on quit: {e}")

        def _run():
            # The launcher's `quit` (the Mac's verb, issue #547): the
            # daemon, the site and its unit; this tray quits itself.
            try:
                Launcher.run("quit", "--leave-tray", capture=True, timeout=240)
            except Exception as e:
                log(f"quit: {e}")
            # os._exit (not Gtk.main_quit) — guarantees the process
            # terminates and the StatusNotifierItem D-Bus name drops
            # even if some other main loop is still on the stack.
            os._exit(0)
        threading.Thread(target=_run, daemon=True).start()


# ─── 8. main ─────────────────────────────────────────────────────────────

def main() -> int:
    lock = acquire_single_instance_lock()
    if lock is None:
        log("another tray instance is running; exiting")
        return 0

    log(f"onionpress-tray starting (pid={os.getpid()})")

    # Dock identity: prgname becomes the window WM_CLASS, which is what
    # GNOME matches against StartupWMClass= in our .desktop file to pick
    # the dock icon. Application name is the human label shown next to
    # it. set_default_icon_from_file is the belt-and-braces fallback for
    # shells whose icon theme can't find a sized "onionpress" entry.
    try:
        GLib.set_prgname("onionpress-tray")
        GLib.set_application_name("OnionPress")
    except Exception as e:
        log(f"setting prgname/app-name failed: {e}")
    if os.path.exists(APP_ICON_PATH):
        try:
            Gtk.Window.set_default_icon_from_file(APP_ICON_PATH)
        except Exception as e:
            log(f"set_default_icon_from_file failed: {e}")
    else:
        try:
            Gtk.Window.set_default_icon_name("onionpress")
        except Exception as e:
            log(f"set_default_icon_name failed: {e}")

    def _shutdown(signum, _frame):
        # Signal handlers must do as little as possible — schedule the
        # actual cleanup on the main loop via GLib.idle_add, but also
        # arm a hard-exit watchdog because Gtk.main_quit alone only
        # unwinds one nested loop. If a dialog (Setup, About, Backup,
        # …) is open, its dlg.run() keeps a nested loop on the stack
        # and the indicator's D-Bus name lingers. Mirrors the _on_quit
        # menu handler's belt-and-braces shutdown.
        log(f"received shutdown signal ({signum})")

        def _force_exit():
            time.sleep(2)
            log("shutdown watchdog firing — force-exiting")
            os._exit(0)
        threading.Thread(target=_force_exit, daemon=True).start()

        GLib.idle_add(Gtk.main_quit)
    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT, _shutdown)

    OnionPressTray()
    Gtk.main()
    log("onionpress-tray exiting")
    return 0


if __name__ == "__main__":
    sys.exit(main())
