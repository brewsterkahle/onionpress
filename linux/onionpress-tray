        return password

    def confirm(self, facts):
        return _on_main_thread(lambda: self._confirm(facts))

    def _confirm(self, facts):
        # The CLI validated the address and username and sanitized the
        # rest (cli.cmd_restore_check); the text is ui_client's.
        dlg = Gtk.MessageDialog(
            parent=self.parent, flags=0,
            message_type=Gtk.MessageType.WARNING,
