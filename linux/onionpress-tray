def show_log_viewer(parent=None):
    log_file = os.path.expanduser("~/.onionpress/onionpress.log")
    dlg = Gtk.Dialog(
        title="OnionPress logs",
        parent=parent, flags=0,
        buttons=("Close", Gtk.ResponseType.CLOSE),
    )
    dlg.set_default_size(720, 480)

    box = dlg.get_content_area()
    box.set_border_width(8)

    text_view = Gtk.TextView()
    text_view.set_editable(False)
    text_view.set_monospace(True)
    text_view.set_wrap_mode(Gtk.WrapMode.NONE)
    buf = text_view.get_buffer()

    scrolled = Gtk.ScrolledWindow()
    scrolled.set_hexpand(True)
    scrolled.set_vexpand(True)
    scrolled.add(text_view)
    box.pack_start(scrolled, True, True, 0)

    # Initial load: last 5000 lines. Track byte position so the poller
    # can append new content incrementally.
    last_pos = 0
    try:
        with open(log_file) as f:
            f.seek(0, os.SEEK_END)
            last_pos = f.tell()
            f.seek(0)
            lines = f.readlines()[-5000:]
            buf.set_text("".join(lines))
    except OSError:
        buf.set_text(f"(log file {log_file} not found)")

    vadj = scrolled.get_vadjustment()

    def is_at_bottom() -> bool:
        # ~20px tolerance so micro-jitter doesn't break follow mode.
        return vadj.get_value() + vadj.get_page_size() >= vadj.get_upper() - 20.0

    def scroll_to_end() -> bool:
        # Use a temporary mark + scroll_mark_onscreen so the scroll
        # happens once GTK has laid out any text we just inserted.
        end_iter = buf.get_end_iter()
        mark = buf.create_mark(None, end_iter, False)
        text_view.scroll_mark_onscreen(mark)
        buf.delete_mark(mark)
        return False  # one-shot idle callback

    # scroll_to_iter pre-show_all is a no-op (the widget has no real
    # viewport yet); defer until GTK has realised the dialog.
    GLib.idle_add(scroll_to_end)

    def poll() -> bool:
        nonlocal last_pos
        try:
            with open(log_file) as f:
                f.seek(0, os.SEEK_END)
                end = f.tell()
                if end < last_pos:
                    # Log rotated/truncated — reload tail.
                    f.seek(0)
                    lines = f.readlines()[-5000:]
                    buf.set_text("".join(lines))
                    last_pos = end
                    GLib.idle_add(scroll_to_end)
                elif end > last_pos:
                    # Sticky-tail: snapshot whether we *were* at the
                    # bottom before mutating the buffer; only re-scroll
                    # if so. Once the user scrolls up, we stop following
                    # until they scroll back to the bottom themselves.
                    follow = is_at_bottom()
                    f.seek(last_pos)
                    new = f.read()
                    last_pos = end
                    if new:
                        buf.insert(buf.get_end_iter(), new)
                        if follow:
                            GLib.idle_add(scroll_to_end)
        except OSError:
            pass
        return True  # keep polling

    timer_id = GLib.timeout_add(500, poll)
    dlg.connect("destroy", lambda *_: GLib.source_remove(timer_id))

    dlg.show_all()
    dlg.run()
    dlg.destroy()


def _notify_failed(title: str) -> None:
    """Tell the user a backup or restore ended without a result (the
    launcher could not be run): they would otherwise wait for nothing."""
    try:
        Notify.Notification.new(
            title, "Check the OnionPress log for details.", "onionpress").show()
    except Exception as e:
        log(f"notification failed: {e}")


def show_backup_dialog(parent=None):
    # Custom Gtk.Dialog (not MessageDialog) so we can verify the password
    # inline against WordPress before kicking off the long-running backup
    # — matches the Mac flow where `verify_wp_admin` runs before the zip
    # work starts. Bash already re-verifies inside create_backup, so this
    # is purely a UX improvement: the user sees "Password does not match"
    # in 1-2s instead of waiting for the full backup to fail.
    dlg = Gtk.Dialog(
        title="Create OnionPress backup",
        parent=parent,
        flags=0,
    )
    dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
    ok_btn = dlg.add_button("_Back Up", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    ok_btn.get_style_context().add_class("suggested-action")

    body = dlg.get_content_area()
    body.set_border_width(16)
    body.set_spacing(8)

    blurb = Gtk.Label(label=(
        "A password-protected .zip will be created in "
        "~/OnionPress/backups/. Enter your WordPress admin password to "
        "authorise the backup."))
    blurb.set_line_wrap(True)
    blurb.set_xalign(0)
    body.add(blurb)

    entry = Gtk.Entry()
    entry.set_visibility(False)
    entry.set_activates_default(True)
    entry.set_placeholder_text("admin password")
    body.add(entry)

    error_lbl = Gtk.Label()
    error_lbl.set_xalign(0)
    error_lbl.set_line_wrap(True)
    body.add(error_lbl)

    body.show_all()

    def _verify_then_start():
        password = entry.get_text()
        if not password:
            error_lbl.set_markup(
                "<span foreground='red'>"
                "Please enter your admin password.</span>")
            return False
        # Disable input + button during verification so accidental
        # double-clicks don't fire a second wp eval.
        ok_btn.set_sensitive(False)
        entry.set_sensitive(False)
        error_lbl.set_markup(
            "<i>Verifying password…</i>")

        def _verify():
            ok, msg = False, "verification unavailable"
            try:
                from onionpress import backup as _b  # type: ignore
                ok, msg = _b.verify_wp_admin_password_any(password)
            except Exception as e:
                msg = f"verification failed: {e}"
                log(f"backup verify: {e}")

            def _apply():
                if ok:
                    dlg.response(Gtk.ResponseType.APPLY)
                    return False
                error_lbl.set_markup(
                    f"<span foreground='red'>{GLib.markup_escape_text(msg)}</span>")
                ok_btn.set_sensitive(True)
                entry.set_sensitive(True)
                entry.grab_focus()
                return False
            GLib.idle_add(_apply)
        threading.Thread(target=_verify, daemon=True).start()
        return True

    password = None
    while True:
        response = dlg.run()
        if response == Gtk.ResponseType.OK:
            if _verify_then_start():
                continue  # wait for APPLY/error
            # Empty password — just keep dialog open.
            continue
        if response == Gtk.ResponseType.APPLY:
            password = entry.get_text()
            break
        # Cancel / close.
        break
    dlg.destroy()

    if not password:
        return

    def _run():
        # No time limit here (issue #317): a fixed 300 s ended large sites'
        # backups, and killing the launcher stopped only the shell, not the
        # docker and Python steps under it. The copies there carry their own
        # limits, sized to the site, and fail the launcher when one is hit.
        try:
            r = Launcher.run("backup", capture=True, timeout=None,
                             password=password)
            if r.returncode == 0:
                Notify.Notification.new(
                    "Backup complete", r.stdout.strip() or "Saved.",
                    "onionpress",
                ).show()
            else:
                Notify.Notification.new(
                    "Backup failed", (r.stderr or "")[:200], "onionpress",
                ).show()
        except Exception as e:
            log(f"backup error: {e}")
            _notify_failed("Backup failed")
    threading.Thread(target=_run, daemon=True).start()


