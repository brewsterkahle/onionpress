def show_log_viewer(parent=None):
    log_file = os.path.expanduser("~/.onionpress/onionpress.log")
    dlg = Gtk.Dialog(
        title="OnionPress logs",
        parent=parent, flags=0,
        buttons=("Close", Gtk.ResponseType.CLOSE),
    )
    dlg.set_default_size(720, 480)

    box = dlg.get_content_area()
    box.set_border_width(8)

    text_view = Gtk.TextView()
    text_view.set_editable(False)
    text_view.set_monospace(True)
    text_view.set_wrap_mode(Gtk.WrapMode.NONE)
    buf = text_view.get_buffer()

    scrolled = Gtk.ScrolledWindow()
    scrolled.set_hexpand(True)
    scrolled.set_vexpand(True)
    scrolled.add(text_view)
    box.pack_start(scrolled, True, True, 0)

    # Initial load: last 5000 lines. Track byte position so the poller
    # can append new content incrementally.
    last_pos = 0
    try:
        with open(log_file) as f:
            f.seek(0, os.SEEK_END)
            last_pos = f.tell()
            f.seek(0)
            lines = f.readlines()[-5000:]
            buf.set_text("".join(lines))
    except OSError:
        buf.set_text(f"(log file {log_file} not found)")

    vadj = scrolled.get_vadjustment()

    def is_at_bottom() -> bool:
        # ~20px tolerance so micro-jitter doesn't break follow mode.
        return vadj.get_value() + vadj.get_page_size() >= vadj.get_upper() - 20.0

    def scroll_to_end() -> bool:
        # Use a temporary mark + scroll_mark_onscreen so the scroll
        # happens once GTK has laid out any text we just inserted.
        end_iter = buf.get_end_iter()
        mark = buf.create_mark(None, end_iter, False)
        text_view.scroll_mark_onscreen(mark)
        buf.delete_mark(mark)
        return False  # one-shot idle callback

    # scroll_to_iter pre-show_all is a no-op (the widget has no real
    # viewport yet); defer until GTK has realised the dialog.
    GLib.idle_add(scroll_to_end)

    def poll() -> bool:
        nonlocal last_pos
        try:
            with open(log_file) as f:
                f.seek(0, os.SEEK_END)
                end = f.tell()
                if end < last_pos:
                    # Log rotated/truncated — reload tail.
                    f.seek(0)
                    lines = f.readlines()[-5000:]
                    buf.set_text("".join(lines))
                    last_pos = end
                    GLib.idle_add(scroll_to_end)
                elif end > last_pos:
                    # Sticky-tail: snapshot whether we *were* at the
                    # bottom before mutating the buffer; only re-scroll
                    # if so. Once the user scrolls up, we stop following
                    # until they scroll back to the bottom themselves.
                    follow = is_at_bottom()
                    f.seek(last_pos)
                    new = f.read()
                    last_pos = end
                    if new:
                        buf.insert(buf.get_end_iter(), new)
                        if follow:
                            GLib.idle_add(scroll_to_end)
        except OSError:
            pass
        return True  # keep polling

    timer_id = GLib.timeout_add(500, poll)
    dlg.connect("destroy", lambda *_: GLib.source_remove(timer_id))

    dlg.show_all()
    dlg.run()
    dlg.destroy()


def _notify_failed(title: str) -> None:
    """Tell the user a backup or restore ended without a result (the
    launcher could not be run): they would otherwise wait for nothing."""
    try:
        Notify.Notification.new(
            title, "Check the OnionPress log for details.", "onionpress").show()
    except Exception as e:
        log(f"notification failed: {e}")


def _run_dialog(dlg, timeout: int = QUESTION_TIMEOUT_SEC):
    """dlg.run(), answered Cancel after *timeout* seconds without one: a
    question left on the screen is not a yes (onionpress.confirm)."""
    fired = []

    def _give_up():
        fired.append(True)
        dlg.response(Gtk.ResponseType.CANCEL)
        return False

    source = GLib.timeout_add_seconds(timeout, _give_up)
    try:
        return dlg.run()
    finally:
        if not fired:
            GLib.source_remove(source)


def _on_main_thread(fn):
    """Run fn() in the GTK main loop (dialogs are its) and return what it
    returned; for a worker thread that waits on the launcher. On the main
    thread itself fn() is simply called (waiting there would stop the
    loop that has to run it)."""
    if threading.current_thread() is threading.main_thread():
        return fn()
    done = threading.Event()
    box = {}

    def _call():
        try:
            box["result"] = fn()
        except Exception as e:  # noqa: BLE001 - handed back to the caller
            box["error"] = e
        finally:
            done.set()
        return False

    GLib.idle_add(_call)
    done.wait()
    if "error" in box:
        raise box["error"]
    return box.get("result")


def _error_dialog(parent, title: str, message: str,
                  message_type=Gtk.MessageType.ERROR) -> None:
    dlg = Gtk.MessageDialog(
        parent=parent, flags=0,
        message_type=message_type,
        buttons=Gtk.ButtonsType.CLOSE,
        text=title,
    )
    dlg.format_secondary_text(message)
    _run_dialog(dlg)
    dlg.destroy()


def _info_dialog(parent, title: str, message: str) -> None:
    _error_dialog(parent, title, message, message_type=Gtk.MessageType.INFO)


def _ask_question(parent, what: str, facts: dict, action: str = "Continue") -> bool:
    """A question the CLI stopped at (onionpress.confirm), as a GTK dialog
    worded by ui_client.question_text (one wording for both UIs); True
    only for the explicit yes. Cancel is the default, and no answer in
    QUESTION_TIMEOUT_SEC is Cancel (_run_dialog). A question with a word
    to type (the uninstall's DELETE) is a yes only when it was typed."""
    q = ui_client.question_text(what, facts, action)
    if q is None:
        log(f"unknown question from the CLI: '{what}' (cancelled)")
        return False
    dlg = Gtk.MessageDialog(
        parent=parent, flags=0,
        message_type=Gtk.MessageType.WARNING,
        buttons=Gtk.ButtonsType.NONE,
        text=q.title,
    )
    dlg.format_secondary_text(q.message)
    entry = None
    if q.typed:
        entry = Gtk.Entry()
        entry.set_placeholder_text(q.typed)
        dlg.get_content_area().pack_end(entry, False, False, 8)
    dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
    yes_btn = dlg.add_button(q.yes, Gtk.ResponseType.OK)
    if q.style == "critical":
        yes_btn.get_style_context().add_class("destructive-action")
    dlg.set_default_response(Gtk.ResponseType.CANCEL)
    dlg.show_all()
    response = _run_dialog(dlg)
    typed = entry.get_text() if entry is not None else None
    dlg.destroy()
    if response != Gtk.ResponseType.OK:
        return False
    if q.typed and not ui_client.typed_confirmation(typed, q.typed):
        _error_dialog(parent, f"{action} Cancelled",
                      ui_client.typed_mismatch_message(typed, q.typed, action))
        return False
    return True


class _GtkRestoreUI(ui_client.RestoreUI):
    """plan_restore's dialogs, each run in the GTK main loop; the flow
    itself runs in a worker thread, so the tray stays responsive while
    the launcher reads the backup."""

    def __init__(self, parent, backup_path):
        self.parent = parent
        self.backup_name = os.path.basename(backup_path)

    def ask_password(self, backup_user):
        return _on_main_thread(lambda: self._ask_password(backup_user))

    def _ask_password(self, backup_user):
        dlg = Gtk.MessageDialog(
            parent=self.parent, flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Restore from backup",
        )
        who = f"of '{backup_user}' " if backup_user else ""
        dlg.format_secondary_text(
            f"Enter the password {who}that was used when\n"
            f"{self.backup_name} was created.")
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_activates_default(True)
        dlg.get_content_area().pack_end(entry, False, False, 8)
        dlg.set_default_response(Gtk.ResponseType.OK)
        dlg.show_all()
        response = _run_dialog(dlg)
        password = entry.get_text()
        dlg.destroy()
