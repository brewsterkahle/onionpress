        dlg.set_default_response(Gtk.ResponseType.CANCEL)
        response = _run_dialog(dlg)
        dlg.destroy()
        return response == Gtk.ResponseType.OK

    def ask_recovery_key(self, facts, problem):
        return _on_main_thread(lambda: self._ask_recovery_key(facts, problem))

    def _ask_recovery_key(self, facts, problem):
        q = ui_client.question_text(ui_client.SEALED_HUB_DATA_QUESTION, facts)
        dlg = Gtk.Dialog(title=q.title, parent=self.parent, flags=0)
        dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button(q.alternative, Gtk.ResponseType.REJECT)
        dlg.add_button(q.yes, Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.CANCEL)
        body = dlg.get_content_area()
        body.set_border_width(16)
        body.set_spacing(8)
        blurb = Gtk.Label(label=q.message)
        blurb.set_line_wrap(True)
        blurb.set_xalign(0)
        blurb.set_max_width_chars(60)
        body.add(blurb)
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_placeholder_text("recovery key")
        body.add(entry)
        if problem:
            problem_lbl = Gtk.Label()
            problem_lbl.set_xalign(0)
            problem_lbl.set_line_wrap(True)
            problem_lbl.set_markup(
                f"<span foreground='red'>{GLib.markup_escape_text(problem)}</span>")
            body.add(problem_lbl)
        body.show_all()
        response = _run_dialog(dlg)
        text = entry.get_text().strip()
        dlg.destroy()
        if response == Gtk.ResponseType.REJECT:
            return ""
        if response != Gtk.ResponseType.OK or not text:
