# ─── OnionHeaven on/off ─────────────────────────────────────────────

# Before this install forgets its onion service key (reset, key import, a
# restore to another address, uninstall): ask every OnionHeaven hub that
# may hold a copy to delete it, while the key is still here to sign the
# request. onionpress.cli onionheaven-unregister sends the signed
# /unregister for the whole address to the hub the registration record
# names, through the tor container (which must be running), and says what
# it did; with nothing registered it does and prints nothing (the daemon's
# own beats are held off a released key by the record, as on the Mac).
# Usage: onionheaven_release <reason> [<address whose key stays>]. Sets
# ONIONHEAVEN_RELEASE_RC (0 nothing left on a hub, 1 something the user
# could still take back, 3 something nothing here can take back, other:
# the command failed) and returns 1 only when the user chose to stop at
# the question. Kept identical to the Mac launcher's.
onionheaven_release() {
    local answer=""
    ONIONHEAVEN_RELEASE_RC=0
    op_py onionheaven-unregister --reason "$1" \
        ${2:+--keep-address "$2"} || ONIONHEAVEN_RELEASE_RC=$?
    # 0 and 3: nothing the user could still do. Anything else (1, or a
    # failure of the command itself) may leave a key on a hub: ask.
    case "$ONIONHEAVEN_RELEASE_RC" in 0|3) return 0 ;; esac
    [ "$ONIONPRESS_YES" = "true" ] && return 0
    printf "Continue anyway? The hub keeps the key listed above. [y/N] "
    read -r answer || true
    [ "$answer" = "y" ] || [ "$answer" = "Y" ]
}

# `onionpress onionheaven enable|disable|status [--json]`: one
