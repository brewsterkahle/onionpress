# ─── OnionHeaven farm (takeover containers) ─────────────────────────
#
# Takeover container lifecycle is now managed by the heartbeat monitor
# inside the onionheaven container (via docker socket). The shell script
# only needs to stop containers on shutdown.

stop_onionheaven_farm() {
    # Stop all takeover containers, all at once, with a second's grace each:
    # their onion services are ephemeral (ADD_ONION), and one after another
    # at Docker's default 10 s a farm of any size outlasted a stop.
    local container pids=""
    for container in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^onionheaven-(poll|takeover)-[0-9]+$'); do
        {
            docker stop -t 1 "$container" >> "$LOG_FILE" 2>&1 || true
            docker rm "$container" >> "$LOG_FILE" 2>&1 || true
            log "OnionHeaven farm: stopped $container"
        } &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# Clean stress-test entries and refresh takeover workers with current code.
# reset_onionheaven() drives Docker through the farm controller, which only
# the onionheaven container can reach — onionpress-tor's /reset-onionheaven
# answers 503 — so run it there. Prints the JSON stats; its log lines go to
# $LOG_FILE.
reset_onionheaven_in_container() {
    docker exec onionheaven python3 -c '
import json, sys
sys.path.insert(0, "/")
from onionheaven_common import reset_onionheaven
print(json.dumps({"reset": True, **reset_onionheaven()}))
' 2>>"$LOG_FILE"
}

# ─── OnionHeaven on a hub ─────────────────────────────────────────────
#
# The onionheaven container is a core service (containers.CORE_SERVICES,
# `restart: unless-stopped`, under autoheal): every start brings it up on
# every node, hub or not, as the Mac's does. This launcher keeps no watcher
# for it (issue #504: the old 30 s poll, forked from every CLI run, outlived
# it, one orphan per `restart` or `setup`, each carrying its parent's
# command line in ps). web-server.py's activation flag is a hint nothing
# on the host reads.
# The end of the start, once the core is up (start.post_up, #442.7): Tor,
# the SOCKS port check, the Cloudflare tunnel (only once WordPress is
# installed; removed when the token goes), the pinned plugins, the
# provisioning steps, the plugins' setup and the image rebuild (detached:
# out of this script's job table, and out of the settings watcher's
# cgroup through systemd-run). Best effort: it never stops the start.
# $1: whether WordPress is installed.
start_post_up() {
    op_py --data-dir "$DATA_DIR" start-post-up \
        --wordpress-installed "$([ "$1" = true ] && echo yes || echo no)" \
        --docker-dir "$DOCKER_DIR" --scripts-dir "$SCRIPTS_DIR" \
        --themes-dir "$THEMES_DIR" --plugins-dir "$PLUGINS_DIR" 2>&1 | tee -a "$LOG_FILE"
    return 0
}



# Whether Docker has volume $1: 0 yes, 1 no, 2 Docker could not say (the
# daemon is not up yet, e.g. the Colima VM is still booting). Callers must
# treat 2 as "stop", never as "no": a missing key volume is the first-run
# signal, so reading a Docker error as absence turns an upgrade into a first
# run. Kept identical in the macOS and Linux launchers; a test enforces that.
docker_volume_state() {
    local names
    names=$(docker volume ls --format '{{.Name}}' 2>>"$LOG_FILE") || return 2
    printf '%s\n' "$names" | grep -qx -- "$1"
}


# Wait up to $1 seconds for the Docker daemon to answer; returns 1 if it
# never does. Kept identical in the macOS and Linux launchers.
wait_for_docker() {
    local limit="$1" waited=0
    while ! docker info >/dev/null 2>&1; do
        if [ "$waited" -ge "$limit" ]; then
            return 1
        fi
        if [ "$waited" -eq 0 ]; then
            log "Waiting for Docker daemon to be ready..."
        fi
        sleep 2
        waited=$((waited + 2))
    done
    if [ "$waited" -gt 0 ]; then
        log "Docker daemon ready after ${waited}s"
    fi
    return 0
}


# One-time migration of the onion service key volume from its historical
# name, onionpress-arti-state (until 2026-09-25), to onionpress-onion-keys:
# ContainerManager.migrate_key_volume (Phase 4, #120; CLAUDE.md, "The key
# volume migration fails loudly"), run through the shared CLI. It runs
# before the first-run check, which keys off the NEW volume's existence, so
# its exit status is this function's and a 1 stops the start (the callers'
# `if ! migrate_key_volume`): an empty onionpress-onion-keys that starting
# tor would create passes for the migrated key on the next start. The log
# lines reach the log and the terminal as log's do; PIPESTATUS keeps the
# Python's status past tee.
migrate_key_volume() {
    op_py --data-dir "$DATA_DIR" migrate-key-volume 2>&1 | tee -a "$LOG_FILE"
    return "${PIPESTATUS[0]}"
}

# Rootless Docker's default port driver (RootlessKit "builtin") does not
# carry a visitor's address: everyone who opens WordPress's published port,
# this machine and other devices on the LAN alike, reaches WordPress from
# its network's gateway (measured on Docker 27.4 / RootlessKit 2.3: a LAN
# client and 127.0.0.1 both arrived as the gateway). Auto-login's "local"
# scope admits that address, so with WordPress on every interface (the
# default here, for a headless setup) a LAN device passes the scope check;
# it still needs a fresh single-use token, which only this machine's
# browser is handed. slirp4netns and pasta's drivers carry the address;
# RootlessKit 3's builtin can, only with Docker's userland proxy off. Said
# once per start, so whoever reads the log knows; ONIONPRESS_BIND_HOST=
# 127.0.0.1 is the way out.
note_if_lan_looks_local() {
    local pid driver
    case "$ONIONPRESS_BIND_HOST" in 127.*) return 0 ;; esac
    pid=$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dockerd-rootless/child_pid" 2>/dev/null) || return 0
    driver=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | sed -n 's/^--port-driver=//p' | head -1)
    case "$driver" in
        slirp4netns|implicit|pesto) return 0 ;;
    esac
    log "NOTE: rootless Docker's ${driver:-builtin} port driver hands every visitor of port $ONIONPRESS_WP_PORT to WordPress from one address, so other devices on your network pass auto-login's this-machine check (a fresh one-time token is still needed). ONIONPRESS_BIND_HOST=127.0.0.1 in $DATA_DIR/config keeps the port on this machine."
    return 0
}

# WordPress and MariaDB reach nothing outside Docker (issue #144). Their
# network's bridge (onionpress-wp0, docker-compose.yml) gets the
# ONIONPRESS-WP chain before anything starts on it: only replies to
# connections made from outside (the published port, LAN browsers,
# docker-proxy) leave the bridge or reach the host itself. Where the rules
# go, from onionpress/wordpress_egress.py (shared with macOS):
#   rootless Docker  RootlessKit's network namespace, entered as its owner
#                    (nsenter -U --preserve-credentials -n -m), as Docker's
#                    rootless docs do;
#   system Docker    the host, through a one-shot helper container
#                    (--privileged --pid host --network none, the pinned
#                    tor image) running the host's own iptables. The docker
#                    group can do that already; this user is not root. The
#                    .deb's docker.service drop-in does it at boot, before
#                    Docker restarts the containers.
# The same call shuts the Tor side (onionpress-network, bridge
# onionpress-tor0: tor, onionheaven, cloudflared, takeover workers) off from
# this machine and private addresses (the LAN), and refuses WordPress's
# published port (ONIONPRESS_WP_PORT) from anything but loopback: a
# container on any bridge, other projects' too, would otherwise reach it
# through docker-proxy and arrive as the gateway auto-login trusts.
# Best effort: without the chain the site still starts (WordPress's own
# requests still go through Tor) and the log says so. The body is
# onionpress.cli's (Phase 4, #120): it logs the verdict in this script's
# log format, tee'd into the log, and its status never stops the start.
block_wordpress_egress() {
    op_py --data-dir "$DATA_DIR" wordpress-egress --wp-port "$ONIONPRESS_WP_PORT" 2>&1 | tee -a "$LOG_FILE"
    return 0
}

# Rootless Docker's network namespace, as /proc names it ("" under system
# Docker). It is new, and holds none of the rules above, each time the
# rootless daemon starts; the status loop re-applies them when it changes.
rootless_netns() {
    local pid
    pid=$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dockerd-rootless/child_pid" 2>/dev/null) || return 0
    readlink "/proc/$pid/ns/net" 2>/dev/null || true
}

start_containers() {
    log "Starting OnionPress containers..."

    cd "$DOCKER_DIR"

    # Docker has to answer before anything below asks whether a volume
    # exists. Those checks used to read "Docker is not up yet" as "no such
    # volume", and a missing key volume is the first-run signal: upgrading
    # to 2.5.0 on 2026-09-30 while the Docker daemon (there, the Colima VM)
    # was still starting took the first-run path instead of migrating the
    # key volume.
    if ! wait_for_docker 180; then
        log "ERROR: Docker daemon not ready after 180s; not starting"
        return 1
    fi

    # onionpress.start (#442.8), up to the core services: a pending key
    # import, the key volume's migration and the first run's key (each
    # before anything that could start Tor, each stopping the start when it
    # cannot be done), then the core services, egress rules first.
    # WordPress's port: 127.0.0.1 until a start has seen WordPress
    # installed (issue #464; compose reads it from the environment).
    local wp_installed=false rc
    ONIONPRESS_BIND_HOST="$(wordpress_bind_host_for_start)" \
        op_py --data-dir "$DATA_DIR" start-containers --until-core \
        --docker-dir "$DOCKER_DIR" --wp-port "$ONIONPRESS_WP_PORT" 2>&1 | tee -a "$LOG_FILE"
    rc=${PIPESTATUS[0]}
    case "$rc" in
        0) wp_installed=true ;;
        3) ;;
        *) return 1 ;;
    esac

    # WordPress install is no longer driven by the launcher — both the
    # GTK tray's SetupDialog and `onionpress setup` (SSH/TUI) call
    # setup_logic.install_fresh_wordpress with user-typed credentials.
    # This matches the Mac architecture where containers come up empty
    # and the user's setup wizard does `wp core install`. See the plan
    # discussion in commit 25c285fa / fbfcc4b2 era.
    if $wp_installed; then
        log "WordPress is installed -- starting Tor"
        after_wordpress_installed
    else
        log "WordPress not installed -- run 'onionpress setup' or open the OnionPress tray's Setup dialog to configure"
        bind_wordpress_port_for_install_state false
        hold_heartbeat_client_until_installed
    fi
    note_if_lan_looks_local
    # Tor, the SOCKS port check, the plugins,
    # provisioning and the image rebuild (start_post_up): best effort.
    start_post_up "$wp_installed"

    # Last: the clearnet sees the site once it is provisioned.
    start_cloudflare_tunnel "$wp_installed"
}

# Cloudflare Tunnel (#352), one rule on both platforms (this function is
# test-held identical in the two launchers): cloudflared runs only while the
# config holds a token AND WordPress is installed. Before that its install
# page, then an unprovisioned site, would be on the open internet. Called at
# the end of a start, after provisioning and the bundled plugins (the
# clearnet's first page comes from a site with its cache policy in place),
# and at the end of every setup path, so a new site needs no restart.
# Otherwise the container is removed, not just stopped, so a removed token
# does not linger in its configuration. --no-deps: wordpress is up already,
# and a setup path's call must not recreate it. Its ingress must point at
# http://wordpress:80; the ONIONPRESS-TOR chain refuses the LAN and the host.
start_cloudflare_tunnel() {
    local wp_installed=$1
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ] && [ "$wp_installed" = true ]; then
        log "Cloudflare Tunnel enabled, starting cloudflared..."
        (cd "$DOCKER_DIR" && docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml \
            up -d --no-deps cloudflared) >> "$LOG_FILE" 2>&1 \
            || log "ERROR: Failed to start cloudflared container"
        return 0
    fi
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        log "Cloudflare Tunnel: waiting until WordPress is set up (it starts when setup finishes)"
    fi
    if docker container inspect onionpress-cloudflared >/dev/null 2>&1; then
        log "Cloudflare Tunnel off (no token, or WordPress not set up): removing cloudflared"
        docker rm -f onionpress-cloudflared >> "$LOG_FILE" 2>&1 || true
    fi
}

stop_containers() {
    log "Stopping OnionPress containers..."
    stop_container_log_capture
    stop_onionheaven_farm
    # Capture the offset BEFORE compose-down so the next start can wait
    # for the TIME_WAIT sockets to clear and reuse the same offset.
    # Without this the next start sees the post-down TIME_WAIT sockets
    # as "taken" and bumps to a higher offset, leaving the user on a
    # different port number across restarts. Best-effort.
    echo "${ONIONPRESS_PORT_OFFSET:-0}" > "$DATA_DIR/.previous-port-offset" 2>/dev/null || true
    cd "$DOCKER_DIR"
    # The status is compose's, not tee's or log's: `stop` reports a failed
    # stop (tests/test_launcher_dispatch_linux.py).
    local down_out down_rc=0
    down_out=$(docker compose "${COMPOSE_WITH_CF[@]}" down 2>&1) || down_rc=$?
    [ -z "$down_out" ] || printf '%s\n' "$down_out" | tee -a "$LOG_FILE"
    if [ "$down_rc" -ne 0 ]; then
        log "ERROR: stopping the containers failed (compose down exited $down_rc)"
        write_status 2>/dev/null || true
        return "$down_rc"
    fi
    log "Containers stopped"
    # Write a final stopped status.json so any surviving tray process
    # (the tray runs as its own user process, not under our service)
    # flips its icon to gray instead of holding the previous "running"
    # snapshot indefinitely. write_status's `docker compose ps` will
    # return empty here, which the state derivation maps to "stopped".
    write_status 2>/dev/null || true
}

