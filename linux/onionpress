# OnionPress launcher script for Linux / Raspberry Pi
# This script manages the WordPress + Tor onion service containers
# See: https://github.com/brewsterkahle/onionpress

set -e

# An OnionHeaven hub's backup recovery key, when the app's Restore... (or the
# operator) passes one in the environment: taken out of it at once and handed
# only to the commands that use it (restore, hub-recovery-key), so that no
# other child of this script inherits it.
_HUB_RECOVERY_KEY="${ONIONPRESS_HUB_RECOVERY_KEY:-}"
unset ONIONPRESS_HUB_RECOVERY_KEY

# Determine install and data directories
INSTALL_DIR="${ONIONPRESS_INSTALL_DIR:-/opt/onionpress}"
DOCKER_DIR="$INSTALL_DIR/docker"
PLUGINS_DIR="$INSTALL_DIR/plugins"
THEMES_DIR="$INSTALL_DIR/themes"
SCRIPTS_DIR="$INSTALL_DIR/scripts"
DATA_DIR="$HOME/.onionpress"
DOCUMENTS_DIR="$HOME/OnionPress"

# Shared Python package (also used by the tray app and, eventually, the Mac
# menubar app). Lives at $INSTALL_DIR/lib/onionpress/ — install scripts
# copy src/onionpress/ there. Setting PYTHONPATH lets us run `python3 -m
# onionpress.cli` without a system-wide pip install.
ONIONPRESS_PYTHONPATH="${ONIONPRESS_PYTHONPATH:-$INSTALL_DIR/lib}"
op_py() {
    # Run a subcommand of the shared Python CLI.
    PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -m onionpress.cli "$@"
}

# True only for a well-formed v3 onion address: 56 lowercase base32
# characters, then ".onion", and nothing else (no newline, no "/"). The
# rule of key_manager.is_valid_onion_address; a test keeps the two
# together. The letters are spelled out because a range like a-z can take
# in other characters in some locales.
is_onion_address() {
    [[ "$1" =~ ^[abcdefghijklmnopqrstuvwxyz234567]{56}\.onion$ ]]
}

# The imported or generated key's directory under vanity-keys/: the first
# one whose name is a whole onion address (is_onion_address), not merely
# "*.onion". Its name is taken for the address and the directory is
# bind-mounted into a container. Prints nothing and fails if there is none.
vanity_key_dir() {
    local d
    for d in "$DATA_DIR/shared/vanity-keys"/*.onion; do
        if [ -d "$d" ] && [ ! -L "$d" ] && is_onion_address "$(basename "$d")"; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Hand a file to the WordPress container, written as www-data: stdin goes to
# $1, mode ${2:-600} once in place (a temporary file beside it, renamed
# over it). Never as root: www-data owns /var/lib/onionpress and the web
# root, and root's `cat >` or docker cp followed a link planted at the name
# to any file in the container. The script is
# onionpress.wp_files.PUT_FILE_SCRIPT; a test keeps the copies equal.
wp_put() {
    docker exec -i -u www-data onionpress-wordpress \
        sh -c 't=$(mktemp "$1.XXXXXX") || exit 1; if cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"; then exit 0; fi; rm -f "$t"; exit 1' \
        sh "$1" "${2:-600}"
}

# Run a command in the WordPress container as www-data: what the launcher
# reads from or removes in www-data's folders (a root `cat` would follow a
# planted link to a file only root may read).
wp_exec() {
    docker exec -u www-data onionpress-wordpress "$@"
}

# Run wp-cli in the WordPress container as www-data: wp_cli <args...>, and
# wp_cli_in for what wp-cli reads from stdin (docker exec -i). wp-cli loads
# WordPress (wp-config.php, mu-plugins, plugins, themes), every file of it
# www-data's to write, so run as root a plugin bug became root in the
# container. No --allow-root: wp-cli refuses to run as root. The command is
# onionpress.wp_files.wp_cli_args; a test keeps the copies equal.
wp_cli() {
    docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}
wp_cli_in() {
    docker exec -i -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}

# Per-user lock file to prevent double-starting
PIDFILE="$DATA_DIR/onionpress.pid"

# Ensure data dir exists
mkdir -p "$DATA_DIR"

# One-time host-side migration: ~/Documents/onionpress (Linux default)
# or ~/Documents/OnionPress (cross-platform) → ~/OnionPress. Walks the
# source tree recursively so empty subdirs in the destination (from a
# previous launcher pass) don't block the mv. Issue #239.
#
# REMOVE-AFTER 2026-08-01: by then every active install will have
# migrated. Delete this block and _op_migrate_tree.
_op_migrate_tree() {
    local src="$1" dst="$2"
    [ -d "$src" ] || return 0
    mkdir -p "$dst"
    shopt -s dotglob nullglob 2>/dev/null || true
    local entry base target
    for entry in "$src"/*; do
        [ -e "$entry" ] || continue
        base=$(basename "$entry")
        target="$dst/$base"
        if [ -d "$entry" ] && [ -d "$target" ]; then
            _op_migrate_tree "$entry" "$target"
            rmdir "$entry" 2>/dev/null || true
        else
            mv -n "$entry" "$target" 2>/dev/null || true
        fi
    done
}

if ! grep -qE '^PATH_MIGRATION_2026_05=done$' "$DATA_DIR/config" 2>/dev/null; then
    _migration_residual=0
    _migration_did_work=0
    for OLD in "$HOME/Documents/onionpress" "$HOME/Documents/OnionPress"; do
        [ -d "$OLD" ] || continue
        _migration_did_work=1
        rm -f "$OLD/MOVED.txt" 2>/dev/null || true
        _op_migrate_tree "$OLD" "$DOCUMENTS_DIR"
        rmdir "$OLD" 2>/dev/null || true
        if [ -d "$OLD" ]; then
            _migration_residual=1
            echo "OnionPress content moved to $DOCUMENTS_DIR" \
                > "$OLD/MOVED.txt" 2>/dev/null || true
        fi
    done
    if [ "$_migration_did_work" = "0" ]; then
        mkdir -p "$DOCUMENTS_DIR"
    fi
    if [ "$_migration_residual" = "0" ]; then
        printf 'PATH_MIGRATION_2026_05=done\n' >> "$DATA_DIR/config" 2>/dev/null || true
    fi
fi

# Ensure subtree exists for compose bind-mounts.
mkdir -p "$DOCUMENTS_DIR/backups"
mkdir -p "$DOCUMENTS_DIR/Creations/My Creations"
# docker-compose.yml bind-mounts ${ONIONPRESS_DOCUMENTS_DIR}/Creations; without
# this export it fell back to /tmp/onionpress-no-docs and ~/OnionPress/Creations
# was never served on Linux (the macOS launcher has always exported it).
export ONIONPRESS_DOCUMENTS_DIR="$DOCUMENTS_DIR"
mkdir -p "$DOCUMENTS_DIR/Social Archives"
touch "$DOCUMENTS_DIR/Social Archives/.onionpress-activated"

# Log file with rotation (keep 3 x 5MB files)
LOG_FILE="$DATA_DIR/onionpress.log"
LOG_MAX_SIZE=$((5 * 1024 * 1024))  # 5 MB
LOG_KEEP=3

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$size" -ge "$LOG_MAX_SIZE" ]; then
        # Rotate: .log.3 → delete, .log.2 → .log.3, .log.1 → .log.2, .log → .log.1
        local i=$LOG_KEEP
        while [ $i -gt 1 ]; do
            local prev=$((i - 1))
            [ -f "${LOG_FILE}.$prev" ] && mv -f "${LOG_FILE}.$prev" "${LOG_FILE}.$i"
            i=$((i - 1))
        done
        mv -f "$LOG_FILE" "${LOG_FILE}.1"
        : > "$LOG_FILE"
    fi
}
rotate_log

# Read version
ONIONPRESS_VERSION="unknown"
if [ -f "$INSTALL_DIR/VERSION" ]; then
    ONIONPRESS_VERSION=$(cat "$INSTALL_DIR/VERSION")
fi
export ONIONPRESS_VERSION

# Timezone detection (Linux)
export TZ="$(cat /etc/timezone 2>/dev/null || echo UTC)"
export PYTHONDONTWRITEBYTECODE=1

# Rootless Docker: point CLI and compose at the user's rootless daemon socket
_rootless_sock="/run/user/$(id -u)/docker.sock"
if [ -S "$_rootless_sock" ]; then
    export DOCKER_HOST="unix://$_rootless_sock"
    export DOCKER_SOCK="$_rootless_sock"
fi

# Port-offset detection. Mirrors app/MacOS/onionpress's detect_port_offset
# (Mac multi-user). Probes all three host-exposed ports — WP 8080, SOCKS
# 9050, proxy 9077 — and bumps the offset by 10000 if any is in use. The
# common Linux collision is a system tor on 9050 (apt-installed by
# torbrowser-launcher); offset 10000 publishes OnionPress SOCKS on 19050
# instead. The container internally still listens on 9050, so the onion
# service is unaffected. Uses real socket bind (not lsof) so it sees
# ports owned by other users / system services.
detect_port_offset() {
    local offset=0
    while true; do
        local wp=$((8080 + offset))
        local socks=$((9050 + offset))
        local proxy=$((9077 + offset))
        if [ $proxy -gt 65535 ]; then
            offset=0
            break
        fi
        if python3 -c '
import socket, sys
for p in sys.argv[1:]:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("127.0.0.1", int(p)))
    except OSError:
        sys.exit(1)
    finally:
        s.close()
' "$wp" "$socks" "$proxy" 2>/dev/null; then
            break
        fi
        offset=$((offset + 10000))
    done
    echo "$offset"
}

if [ -z "$ONIONPRESS_PORT_OFFSET" ]; then
    # If the service is already running, read its offset from status.json
    # rather than re-detecting via socket bind. The bind test returns 0
    # when nothing currently holds port 8080 (e.g. between restarts or
    # when another user's containers hold it but the bind test runs as a
    # different uid), causing standalone commands like `onionpress setup`
    # to target the wrong port.
    _status_json="$DATA_DIR/status.json"
    if [ -f "$_status_json" ] && command -v python3 >/dev/null 2>&1; then
        _running_wp_port=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    p = int(d.get('wp_port', 0))
    if p > 0:
        print(p - 8080)
except Exception:
    pass
" "$_status_json" 2>/dev/null)
        if [ -n "$_running_wp_port" ] && [ "$_running_wp_port" -ge 0 ] 2>/dev/null; then
            ONIONPRESS_PORT_OFFSET="$_running_wp_port"
        fi
    fi
fi

if [ -z "$ONIONPRESS_PORT_OFFSET" ]; then
    # Sticky-offset recovery (mirrors src/menubar.py:258). If we just
    # quit/restarted, our previous offset's ports are likely in
    # TIME_WAIT for ~30-60s. Naive detection sees them as "taken" and
    # bumps to the next offset, giving the user a different port number
    # for the rest of the session even after the old socket frees.
    # Avoid this by reading a sentinel written on stop and waiting up
    # to 15s for the prior offset's ports to come back. Stale sentinels
    # (>60s) are ignored — likely from a crash where we never got to
    # write a fresh one.
    _prev_sentinel="$DATA_DIR/.previous-port-offset"
    if [ -f "$_prev_sentinel" ]; then
        _age=$(( $(date +%s) - $(stat -c %Y "$_prev_sentinel" 2>/dev/null || echo 0) ))
        if [ "$_age" -lt 60 ]; then
            _prev=$(cat "$_prev_sentinel" 2>/dev/null | tr -dc '0-9')
            if [ -n "$_prev" ]; then
                _desired=$((8080 + _prev))
                for _i in $(seq 1 30); do  # up to 15s, 0.5s each
                    if python3 -c '
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
    s.close()
except OSError:
    s.close(); sys.exit(1)
' "$_desired" 2>/dev/null; then
                        break
                    fi
                    sleep 0.5
                done
            fi
        fi
        rm -f "$_prev_sentinel"
    fi
    ONIONPRESS_PORT_OFFSET=$(detect_port_offset)
fi
export ONIONPRESS_PORT_OFFSET
export ONIONPRESS_WP_PORT=$((8080 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_SOCKS_PORT=$((9050 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_PROXY_PORT=$((9077 + ONIONPRESS_PORT_OFFSET))

# Bind host for WordPress's published port. Only WordPress: Tor's SOCKS
# port is fixed to 127.0.0.1 in the compose file. Linux is typically
# headless (a Pi set up from a phone or laptop on the LAN), so WordPress
# listens on all interfaces by default. ONIONPRESS_BIND_HOST=127.0.0.1 in
# ~/.onionpress/config keeps it on this machine; the environment wins over
# the config. Mac (Colima) doesn't run this launcher and gets 127.0.0.1
# from the compose file. Anything but an IPv4 address would fail `docker
# compose up` and take the site down, so it falls back to 127.0.0.1, the
# narrower choice, with a warning. Same grep | cut idiom as below, so a
# missing key doesn't kill the script under `set -e`.
if [ -z "${ONIONPRESS_BIND_HOST:-}" ] && [ -f "$DATA_DIR/config" ]; then
    ONIONPRESS_BIND_HOST=$(grep "^ONIONPRESS_BIND_HOST=" "$DATA_DIR/config" | head -1 | cut -d= -f2- | tr -d "[:space:]\"'")
fi
case "${ONIONPRESS_BIND_HOST:-}" in
    "") ONIONPRESS_BIND_HOST=0.0.0.0 ;;
    localhost) ONIONPRESS_BIND_HOST=127.0.0.1 ;;
esac
if ! [[ "$ONIONPRESS_BIND_HOST" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: ONIONPRESS_BIND_HOST=$ONIONPRESS_BIND_HOST is not an IPv4 address; using 127.0.0.1" \
        | tee -a "$LOG_FILE" >&2
    ONIONPRESS_BIND_HOST=127.0.0.1
fi
export ONIONPRESS_BIND_HOST

# Only the OnionHeaven hub accepts registrations: the canonical hub address,
# or ONIONHEAVEN_ACCEPT_REGISTRATIONS=yes in the config (read below). The API
# server runs inside the tor container on every node (~15MB overhead) and
# refuses registrations elsewhere; the onionheaven container runs on every
# node too, but its heartbeat monitor stays idle off the hub. On the hub,
# takeover workers spawn on demand when a registered site goes offline.
# ONIONHEAVEN_HUB=1 enables 10 intro points (auto-detected).
# OnionHome analytics directory (bind-mounted into tor container)
export ONIONPRESS_SHARED_DIR="$DATA_DIR/shared"
mkdir -p "$ONIONPRESS_SHARED_DIR/analytics"

export ONIONHEAVEN="1"
export ONIONHEAVEN_HUB="${ONIONHEAVEN_HUB:-0}"
export ONIONHEAVEN_MAX_SERVICES="${ONIONHEAVEN_MAX_SERVICES:-50}"
export ONIONHEAVEN_PROPAGATION_DELAY="${ONIONHEAVEN_PROPAGATION_DELAY:-180}"
export ONIONHEAVEN_HUB_THRESHOLD="${ONIONHEAVEN_HUB_THRESHOLD:-5}"

# Locally built container images (development).
#
# build/build-images.sh builds the tor and wordpress images from this repo and
# prints these two exports. Setting either here, or in ~/.onionpress/config,
# repoints the whole stack: compose's tor/wordpress/onionheaven services, the
# image pulls below, and vanity-key generation. See docs/BUILDING.md.
#
# The `| cut` is load-bearing, not cosmetic — a bare `var=$(grep ...)` takes
# grep's exit status, so a missing key returns 1 and kills the script under
# `set -e`. -f2- rather than -f2 so a value containing '=' is not truncated.
for _img_var in ONIONPRESS_TOR_IMAGE ONIONPRESS_WORDPRESS_IMAGE; do
    if [ -z "$(eval echo \"\$$_img_var\")" ] && [ -f "$DATA_DIR/config" ]; then
        _img_val=$(grep "^${_img_var}=" "$DATA_DIR/config" | head -1 | cut -d= -f2-)
        if [ -n "$_img_val" ]; then
            eval "export ${_img_var}=\"\$_img_val\""
        fi
    fi
done
unset _img_var _img_val

# True when the stack points at images built on this machine rather than
# published ones. Every pull below is gated on it: without the gate they
# overwrite a local tag with the registry's copy, so a developer would build
# an image, start the app, and silently test someone else's build.
using_local_images() {
    local _ref
    for _ref in "${ONIONPRESS_TOR_IMAGE:-}" "${ONIONPRESS_WORDPRESS_IMAGE:-}"; do
        [ -n "$_ref" ] || continue
        case "$_ref" in
            ghcr.io/*) ;;   # explicitly pointed at a published image
            *) return 0 ;;
        esac
    done
    return 1
}

# The image every one-shot helper that handles the onion service key runs
# from (the key volume migration, the key seeds, the backup's key reads):
# the stack's own tor image, pinned by digest like the rest, or the locally
# built one. Never a floating tag such as `alpine`, which a registry or a
# mirror could swap for an image that reads the key. Each run overrides the
# entrypoint and joins no network (tests/test_container_capabilities.py).
KEY_HELPER_IMAGE="${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:79b18a6190e3ba8d3c261fd2782ee0a5871cbfebc663cbe12e6ade918e10aa4f}"

# Make sure KEY_HELPER_IMAGE is here before a helper runs from it: the key
# volume migration and the first-run seed come before any pull. A missing
# image is pulled by its pinned reference, never when the stack runs locally
# built images. Returns 1 when it is not here and cannot be. Kept identical
# in the macOS and Linux launchers; a test enforces that.
ensure_key_helper_image() {
    if docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1; then
        return 0
    fi
    if using_local_images; then
        log "ERROR: the locally built tor image $KEY_HELPER_IMAGE is not here (build it with build/build-images.sh)"
        return 1
    fi
    log "Pulling $KEY_HELPER_IMAGE for the onion service key helpers..."
    if ! docker pull "$KEY_HELPER_IMAGE" >> "$LOG_FILE" 2>&1; then
        log "ERROR: could not pull $KEY_HELPER_IMAGE"
        return 1
    fi
    docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1
}

# Read config
CLOUDFLARE_TUNNEL_TOKEN=""
export CLOUDFLARE_TUNNEL_TOKEN

# Create default config if it doesn't exist
if [ ! -f "$DATA_DIR/config" ]; then
    cat > "$DATA_DIR/config" <<EOF
ADDRESS_PREFIX=op2
INSTALL_IA_PLUGIN=yes
UPDATE_ON_LAUNCH=no
START_ON_BOOT=yes
# OnionHeaven is opt-in: unset = not decided (you will be asked), yes = on, no = off.
# Enable with: onionpress onionheaven enable
REGISTER_WITH_ONIONHEAVEN=
ONIONHEAVEN_ADDRESS=oheavenfhbohpdjijmxo3xgvvuo6eleyhhorbompoycle6x5eajlp7qd.onion
# WordPress's local web port (normally 8080) is open to other devices on
# your network, so a headless machine can be set up from a phone or laptop.
# Uncomment to keep it on this machine only. Tor's SOCKS port is always
# this machine only.
#ONIONPRESS_BIND_HOST=127.0.0.1
EOF
fi

# Read settings from config (override defaults)
if [ -f "$DATA_DIR/config" ]; then
    _val=$(grep "^ONIONHEAVEN_MAX_SERVICES=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_MAX_SERVICES="$_val"
    _val=$(grep "^ONIONHEAVEN_PROPAGATION_DELAY=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_PROPAGATION_DELAY="$_val"
    _val=$(grep "^ONIONHEAVEN_HUB_THRESHOLD=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_HUB_THRESHOLD="$_val"
fi

# Run as an OnionHeaven hub (config-file-only; only an exact "yes" counts,
# checked in the containers). Kept in step with app/MacOS/onionpress and
# onionpress.containers: compose hands it to tor and onionheaven.
ONIONHEAVEN_ACCEPT_REGISTRATIONS=""
if [ -f "$DATA_DIR/config" ]; then
    ONIONHEAVEN_ACCEPT_REGISTRATIONS=$(grep "^ONIONHEAVEN_ACCEPT_REGISTRATIONS=" "$DATA_DIR/config" | head -1 | cut -d= -f2-)
fi
export ONIONHEAVEN_ACCEPT_REGISTRATIONS

# ─── Parse global flags ────────────────────────────────────────────
# --yes / -y skips interactive confirmations (for scripted/automated use).
# Honour ONIONPRESS_YES inherited from the environment so callers like
# scrub's phase_uninstall (which exports it) can suppress prompts.
ONIONPRESS_YES=${ONIONPRESS_YES:-false}
_filtered_args=()
for _arg in "$@"; do
    case "$_arg" in
        --yes|-y) ONIONPRESS_YES=true ;;
        *) _filtered_args+=("$_arg") ;;
    esac
done
set -- "${_filtered_args[@]}"

# ─── Helper functions ───────────────────────────────────────────────

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Host part of the WordPress URLs we print. On every interface that's the
# LAN address; on loopback a LAN URL would not open, so it's localhost.
wp_access_host() {
    case "$ONIONPRESS_BIND_HOST" in
        0.0.0.0) hostname -I 2>/dev/null | awk '{print $1}' | grep . || echo localhost ;;
        127.*) echo localhost ;;
        *) echo "$ONIONPRESS_BIND_HOST" ;;
    esac
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if WordPress core is installed (setup wizard completed)
wp_is_installed() {
    wp_cli core is-installed >/dev/null 2>&1
}

# Verify a WP admin password without making a backup. Used by scrub/
# uninstall to pre-validate the password BEFORE any destructive work —
# otherwise create_backup verifies mid-script and the user can end up
# in a half-uninstalled state on a bad password. create_backup's own
# check calls it too.
#
# Stdin: the password (never argv, never spliced into PHP).
# Returns 0 if valid, non-zero otherwise.
verify_wp_admin_password() {
    op_py verify-admin-password
}

# Prompt for + validate a WP admin password. Sets PROMPTED_WP_PASS on
# success. Retries up to 3 times; returns 1 if user gives up.
prompt_and_validate_wp_password() {
    local prompt="${1:-WordPress admin password: }"
    local attempt
    PROMPTED_WP_PASS=""
    for attempt in 1 2 3; do
        local pw
        read -r -s -p "$prompt" pw
        echo ""
        if [ -z "$pw" ]; then
            echo "  (empty — aborting)"
            return 1
        fi
        if printf '%s' "$pw" | verify_wp_admin_password; then
            PROMPTED_WP_PASS="$pw"
            return 0
        fi
        echo "  Password does not match any WordPress admin account."
        if [ "$attempt" -lt 3 ]; then
            echo "  ($((3 - attempt)) more attempt$([ $attempt -lt 2 ] && echo s) remaining)"
        fi
    done
    echo "  Too many bad attempts — aborting."
    return 1
}

# Backup passwords are handed over in ONIONPRESS_BACKUP_PASSWORD, never on a
# command line: other local users can read any process's argv (ps,
# /proc/<pid>/cmdline) but not its environment. Sets BACKUP_PASS from the
# first of: $1 (the old positional form; warns), the variable, a line on
# stdin, a no-echo prompt. Unsets the variable so the commands this script
# runs don't inherit it; pass it on as ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" cmd.
# Identical in app/MacOS/onionpress and linux/onionpress (test-enforced).
read_backup_password() {
    BACKUP_PASS="${ONIONPRESS_BACKUP_PASSWORD:-}"
    unset ONIONPRESS_BACKUP_PASSWORD
    if [ -n "${1:-}" ]; then
        echo "WARNING: a password on the command line is visible to other users of this computer. Leave it out to be prompted, or set ONIONPRESS_BACKUP_PASSWORD." >&2
        BACKUP_PASS="$1"
    elif [ -z "$BACKUP_PASS" ]; then
        if [ -t 0 ]; then
            read -r -s -p "Backup password: " BACKUP_PASS || true
            echo "" >&2
        else
            IFS= read -r BACKUP_PASS || true
        fi
    fi
}

# ─── Secrets management ─────────────────────────────────────────────

setup_db_passwords() {
    local secrets_file="$DATA_DIR/secrets"

    if [ ! -f "$secrets_file" ]; then
        log "Generating random database passwords..."

        local wordpress_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)
        local root_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)

        touch "$secrets_file"
        chmod 600 "$secrets_file"

        cat > "$secrets_file" <<EOF
# Database passwords - generated on $(date)
# DO NOT SHARE THESE PASSWORDS
WORDPRESS_DB_PASSWORD='$wordpress_pass'
MYSQL_PASSWORD='$wordpress_pass'
MYSQL_ROOT_PASSWORD='$root_pass'
EOF

        log "Database passwords generated and saved to $secrets_file"
    fi

    if [ -f "$secrets_file" ]; then
        source "$secrets_file"
        export WORDPRESS_DB_PASSWORD
        export MYSQL_PASSWORD
        export MYSQL_ROOT_PASSWORD
    else
        log "ERROR: Secrets file not found at $secrets_file"
        exit 1
    fi
}

# Run a MariaDB client in onionpress-db: db_client <password> <client> [args...]
# The password goes in on stdin and reaches the client as MYSQL_PWD. As
# -p<password> it would sit in the process list, where ps shows every
# user's command lines.
db_client() {
    local db_pass="$1"
    shift
    printf '%s\n' "$db_pass" | docker exec -i onionpress-db \
        sh -c 'IFS= read -r MYSQL_PWD; export MYSQL_PWD; exec "$@"' sh "$@"
}

# Import a restored dump into the wordpress DB: db_import <password> <sql_file>
# The password is the first stdin line (reaches the client as MYSQL_PWD); the
# dump is streamed after it. The client runs with its own command parsing OFF
# so nothing in a crafted dump can run anything but SQL in the db container:
#   --sandbox        refuses \!/system, \./source, tee, pager (a sourced dump
#                    runs them as OS root otherwise — a shell in onionpress-db)
#   --binary-mode    treats the dump as data, not \x client escapes, and keeps
#                    binary blobs intact (mariadb-dump's own output imports)
#   --local-infile=0 refuses LOAD DATA LOCAL INFILE (reading the exec'd
#                    process's inherited MYSQL_ROOT_PASSWORD from /proc)
# No docker cp of the dump to a fixed /tmp/wordpress.sql + `source`.
# Identical in app/MacOS/onionpress and linux/onionpress (test-enforced).
db_import() {
    local db_pass="$1"
    local sql_file="$2"
    if ! docker exec onionpress-db sh -c 'mariadb --help 2>/dev/null | grep -q -- --sandbox'; then
        log "ERROR: the onionpress-db MariaDB client is too old (no --sandbox); refusing to import a backup unsandboxed"
        return 1
    fi
    { printf '%s\n' "$db_pass"; cat "$sql_file"; } | docker exec -i onionpress-db \
        sh -c 'IFS= read -r MYSQL_PWD; export MYSQL_PWD; exec "$@"' sh \
        mariadb --sandbox --binary-mode --local-infile=0 -u wordpress wordpress
}

# Set a WordPress user's password: wp_set_user_password <login> <password>
# Both reach a fixed `wp eval` PHP on stdin. As --admin_password or
# --user_pass the password would sit in the process list, where ps shows
# every user's command lines. Identical in app/MacOS/onionpress and
# linux/onionpress, and the PHP is setup_logic.WP_SET_PASSWORD_PHP
# (test-enforced).
wp_set_user_password() {
    printf '%s\n%s' "$1" "$2" | wp_cli_in eval '
$in = explode("\n", file_get_contents("php://stdin"), 2);
$u = get_user_by("login", trim($in[0]));
$pw = isset($in[1]) ? trim($in[1]) : "";
if (!$u || $pw === "") { fwrite(STDERR, "Error: no such user, or an empty password\n"); exit(1); }
wp_set_password($pw, $u->ID);
delete_user_meta($u->ID, "default_password_nag");
echo "Success: password set for ", $u->user_login, "\n";
'
}

# ─── Key import ──────────────────────────────────────────────────────

import_key() {
    local key_b32="$1"

    mkdir -p "$DATA_DIR"

    if [ -z "$key_b32" ] || [ "$key_b32" = "--help" ] || [ "$key_b32" = "-h" ]; then
        cat <<HELPEOF
Usage: onionpress import-key <base32-secret-key>

Import a pre-generated ed25519 key for your onion service.

The base32 key should encode the 64-byte expanded ed25519 secret key.
OnionPress will derive the .onion address automatically.

HOW TO GET THE KEY FROM mkp224o OUTPUT:

  OnionPress stores vanity keys in ~/.onionpress/shared/vanity-keys/.
  Each address has its own directory containing hs_ed25519_secret_key.
  Encode that file to base32:

    python3 -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())"

EXAMPLE:

  KEY=\$(python3 -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())")
  onionpress import-key "\$KEY"

WHAT THIS COMMAND DOES:

  1. Decodes the base32 key and checks it is a usable 64-byte expanded
     ed25519 key; nothing is changed for a key that is refused
  2. Derives the .onion address from it
  3. Keeps a copy of the current key in ~/.onionpress/replaced-keys/
     <address>-<time>/ (import that key again to go back)
  4. Writes key files to ~/.onionpress/shared/vanity-keys/<address>/
     - ks_hs_id.ed25519_expanded_private  (OpenSSH PEM, the format the container takes)
     - hostname                           (the .onion address)
  5. On next start, OnionPress will use this key

NOTE: If an onion address already exists, you will be prompted to
confirm the replacement. OnionPress will handle stopping and
removing the old keys automatically.

HELPEOF
        return 0
    fi

    # Check the key and derive its .onion address before anything is
    # touched: a key that is refused changes nothing.
    local address
    # The key goes to key_manager.py on stdin ("-"): in argv it would show
    # in ps to every user.
    if ! address=$(printf '%s\n' "$key_b32" | python3 "$SCRIPTS_DIR/key_manager.py" decode-key - 2>&1); then
        echo "$address" >&2
        return 1
    fi

    # Check if this is the same key already installed
    local current_addr
    current_addr=$(find "$DATA_DIR/shared/vanity-keys" -name hostname -exec cat {} \; 2>/dev/null | head -1)
    if [ "$current_addr" = "$address" ]; then
        echo "Key already installed for: $address"
        echo "Nothing to do."
        return 0
    fi

    # Check if a key volume already exists (either name: an install that never
    # started on this version has not migrated yet)
    if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -qx 'onionpress-onion-keys\|onionpress-arti-state'; then
        echo "An onion address key already exists."
        echo ""
        if [ -n "$current_addr" ]; then
            echo "Current address: $current_addr"
            echo ""
        fi
        echo "Importing a new key will REPLACE your current onion address."
        echo "A copy of the current key is kept in $DATA_DIR/replaced-keys/."
        echo ""
        printf "Continue? [y/N] "
        local confirm=""
        read -r confirm || true
        if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
            echo "Cancelled."
            return 1
        fi
    fi

    # Keep a copy of the current key, ask the OnionHeaven hubs that may hold
    # it to delete theirs (this stops the heartbeat client, which holds the
    # old key; the next start of OnionPress brings it back with the new one),
    # stop OnionPress and put the new key in place.
    local rc=0
    replace_onion_key "$key_b32" || rc=$?
    if [ "$rc" -eq 2 ]; then
        echo "Key already installed for: $address"
        echo "Nothing to do."
        return 0
    elif [ "$rc" -ne 0 ]; then
        echo "ERROR: $REPLACE_KEY_ERROR" >&2
        if [ "$REPLACE_KEY_STOPPED" = "yes" ]; then
            echo "OnionPress was stopped; start it again with 'onionpress restart'." >&2
        fi
        start_heartbeat_client
        return 1
    fi

    echo "Imported key for: $address"
    echo "Key files written to: $DATA_DIR/shared/vanity-keys/$address"
    if [ -n "$REPLACE_KEY_KEPT" ]; then
        echo "The replaced key is kept in:"
        printf '%s\n' "$REPLACE_KEY_KEPT" | sed 's/^/  /'
    fi
    echo ""
    echo "Run 'onionpress restart' to use this address."
    # Back on: it waits for Tor to serve the new key, and loads that one.
    start_heartbeat_client
    return 0
}

# Replace this site's onion service key, in an order that never loses the
# current one (onionpress import-key comes here; the Settings page never
# replaces the key on Linux: its import-key-file is refused):
#   1. check: the key goes to key_manager.py on stdin, which refuses one Tor
#      would not serve as the address it derives (check_expanded_secret_key)
#      and writes it to a staging folder; the staged files are read back as
#      that address;
#   2. keep: a copy of every key this install may be using (what the tor
#      container holds, and vanity-keys/) goes to $DATA_DIR/replaced-keys/
#      <address>-<UTC time>/ (host only: not under shared/, which the
#      containers mount; 0700, key_manager.keep_replaced_key). If no
#      copy can be made, or nothing could be read while a key volume exists
#      (or Docker cannot say), nothing is replaced;
#   3. only then the OnionHeaven hubs are asked to delete the old key
#      (onionheaven_release, which asks unless ONIONPRESS_YES=true) and
#      OnionPress is stopped;
#   4. the staged folder becomes vanity-keys/ and .import-key-pending is
#      set: the next start removes the old key volumes (only a confirmed
#      removal counts) and installs the new key from vanity-keys/;
#   5. ADDRESS_PREFIX follows the new address.
# Usage: replace_onion_key <base32 key> (a function argument, never a
# command's argv). Sets REPLACE_KEY_ADDRESS (the new address),
# REPLACE_KEY_KEPT (the kept folders, one per line), REPLACE_KEY_STOPPED
# (yes once OnionPress was stopped) and, on failure, REPLACE_KEY_ERROR (one
# line for the user or the Settings page). Returns 0 replaced, 2 already
# this site's key (nothing done), 1 refused or failed. Never starts
# OnionPress again: the caller does.
replace_onion_key() {
    local staging new_addr staged rc vdir vol state
    local vdirs=()
    REPLACE_KEY_ADDRESS=""
    REPLACE_KEY_KEPT=""
    REPLACE_KEY_STOPPED=""
    REPLACE_KEY_ERROR=""
    mkdir -p "$DATA_DIR/shared"
    if ! staging=$(mktemp -d "$DATA_DIR/.key-import-XXXXXX"); then
        REPLACE_KEY_ERROR="Could not make a staging folder in $DATA_DIR"
        return 1
    fi
    mkdir "$staging/vanity-keys"

    # 1. Check and stage.
    if ! new_addr=$(printf '%s\n' "$1" | python3 "$SCRIPTS_DIR/key_manager.py" import-key - "$staging/vanity-keys" 2>"$staging/error"); then
        REPLACE_KEY_ERROR=$(head -c 400 "$staging/error" | tr -d '\r' | head -1)
        REPLACE_KEY_ERROR="${REPLACE_KEY_ERROR#Error: }"
        REPLACE_KEY_ERROR="${REPLACE_KEY_ERROR:-The key could not be read}"
        rm -rf "$staging"
        log "Key import refused: $REPLACE_KEY_ERROR"
        return 1
    fi
    staged=$(python3 "$SCRIPTS_DIR/key_manager.py" staged-address "$staging/vanity-keys/$new_addr" 2>>"$LOG_FILE") || staged=""
    if ! is_onion_address "$new_addr" || [ "$staged" != "$new_addr" ]; then
        REPLACE_KEY_ERROR="The imported key did not read back as one onion address"
        rm -rf "$staging"
        log "Key import refused: $REPLACE_KEY_ERROR"
        return 1
    fi
    REPLACE_KEY_ADDRESS="$new_addr"

    # Already the address Tor serves (or, with Tor not answering, the one in
    # vanity-keys/): nothing to replace.
    vdir=$(vanity_key_dir || true)
    staged=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ') || staged=""
    if [ "$staged" = "$new_addr" ] \
            || { [ -z "$staged" ] && [ -n "$vdir" ] && [ "$(basename "$vdir")" = "$new_addr" ]; }; then
        rm -rf "$staging"
        log "Key import: $new_addr is already this site's address"
        return 2
    fi

    # 2. Keep a copy of the current key.
    [ -n "$vdir" ] && vdirs=("$vdir")
    rc=0
    REPLACE_KEY_KEPT=$(python3 "$SCRIPTS_DIR/key_manager.py" keep-current "$DATA_DIR/replaced-keys" "${vdirs[@]}" 2>>"$LOG_FILE") || rc=$?
    if [ "$rc" -eq 3 ]; then
        # Nothing could be read. Only Docker's confirmed "no such volume"
        # for every place a key lives means there is no key to keep.
        for vol in onionpress-onion-keys onionpress-arti-state onionpress-tor-state; do
            state=0; docker_volume_state "$vol" || state=$?
            if [ "$state" -ne 1 ]; then
                REPLACE_KEY_ERROR="The current onion service key could not be read, so no copy of it could be kept. Start OnionPress and try again; nothing was changed."
                rm -rf "$staging"
                log "Key import refused: no copy of the current key (volume $vol: state $state)"
                return 1
            fi
        done
        REPLACE_KEY_KEPT=""
        log "Key import: no current key to keep (no key volume)"
    elif [ "$rc" -ne 0 ]; then
        REPLACE_KEY_ERROR="A copy of the current onion service key could not be kept (see $LOG_FILE); nothing was changed."
        rm -rf "$staging"
        log "Key import refused: keeping the current key failed"
        return 1
    else
        log "Kept a copy of the current onion service key: $(printf '%s' "$REPLACE_KEY_KEPT" | tr '\n' ' ')"
    fi

    # 3. Only now: the hubs, then OnionPress.
    if ! onionheaven_release key-import; then
        REPLACE_KEY_ERROR="Cancelled: an OnionHeaven hub may still hold the current key"
        rm -rf "$staging"
        return 1
    fi
    REPLACE_KEY_STOPPED=yes
    stop_containers 2>/dev/null || true

    # 4. The staged key becomes vanity-keys/; the next start does the rest.
    if [ -e "$DATA_DIR/shared/vanity-keys" ] || [ -L "$DATA_DIR/shared/vanity-keys" ]; then
        if ! mv "$DATA_DIR/shared/vanity-keys" "$staging/replaced-vanity-keys"; then
            REPLACE_KEY_ERROR="Could not move the old vanity-keys folder aside; the key was not replaced"
            rm -rf "$staging/vanity-keys"
            log "ERROR: $REPLACE_KEY_ERROR (staging folder $staging)"
            return 1
        fi
    fi
    if ! mv "$staging/vanity-keys" "$DATA_DIR/shared/vanity-keys"; then
        mv "$staging/replaced-vanity-keys" "$DATA_DIR/shared/vanity-keys" 2>/dev/null || true
        REPLACE_KEY_ERROR="Could not put the new key in place; the key was not replaced"
        log "ERROR: $REPLACE_KEY_ERROR (staging folder $staging)"
        return 1
    fi
    touch "$DATA_DIR/.import-key-pending"
    # A replaced identity ends any unfinished move of the old key into
    # its new volume: the next start must not copy it back.
    rm -f "$DATA_DIR/.key-volume-migration-pending"
    rm -rf "$staging"

    # 5.
    set_address_prefix_for "$new_addr"
    log "Imported key for address: $new_addr"
    return 0
}

# ADDRESS_PREFIX follows an imported address, keeping the configured
# prefix's length (3 when there is none).
set_address_prefix_for() {
    local address="$1"
    # Update ADDRESS_PREFIX in config to match imported address
    local current_prefix=""
    if [ -f "$DATA_DIR/config" ]; then
        current_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
    fi
    local prefix_len=${#current_prefix}
    if [ "$prefix_len" -lt 2 ]; then
        prefix_len=3
    fi
    local addr_prefix=$(echo "$address" | cut -c1-$prefix_len)
    if [ -f "$DATA_DIR/config" ] && grep -q "^ADDRESS_PREFIX=" "$DATA_DIR/config"; then
        sed -i "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$addr_prefix/" "$DATA_DIR/config"
    else
        echo "ADDRESS_PREFIX=$addr_prefix" >> "$DATA_DIR/config"
    fi
    log "Updated ADDRESS_PREFIX to '$addr_prefix' to match imported key"
}

# The Settings page's key result (import-result.json), built with a JSON
# encoder.
# Usage: write_key_result <file> <time field> true <address> |
#        write_key_result <file> <time field> false <error>
write_key_result() {
    python3 -c '
import datetime, json, sys
ok = sys.argv[2] == "true"
result = {"success": ok, ("address" if ok else "error"): sys.argv[3],
          sys.argv[1]: datetime.datetime.now(datetime.timezone.utc)
                       .strftime("%Y-%m-%dT%H:%M:%SZ")}
print(json.dumps(result))
' "$2" "$3" "$4" | wp_put "/var/lib/onionpress/$1" 2>/dev/null
}

# ─── Plugin installation ─────────────────────────────────────────────

# Is a WordPress.org plugin wanted? plugin_wanted INSTALL_CACHE_ENABLER |
# INSTALL_IA_PLUGIN: yes unless ~/.onionpress/config sets it to something
# else; missing or empty means yes, as it always has.
plugin_wanted() {
    local value
    value=$(grep "^$1=" "$DATA_DIR/config" 2>/dev/null | tail -1 | cut -d= -f2)
    [ -z "$value" ] || [ "$value" = "yes" ]
}

# Is the plugin file $1 (<folder>/<main file>.php) in the WordPress
# container's plugins folder? Looked at as www-data, whose folder it is.
wp_plugin_present() {
    wp_exec test -f "/var/www/html/wp-content/plugins/$1" 2>/dev/null
}

# The Version: header of the plugin file $1, as installed ('' if none).
# Compared with the pin only; kept to version characters for the log.
wp_plugin_version() {
    wp_exec sed -n 's/^[[:space:]*]*Version:[[:space:]]*//p' \
        "/var/www/html/wp-content/plugins/$1" 2>/dev/null | head -1 | tr -cd '0-9A-Za-z.-'
}

# Put the pinned release of a WordPress.org plugin in the WordPress
# container: install_wp_org_plugin <slug> <name for the log>. Downloaded
# over Tor and checked against its pin (install_plugin.sh); a copy of any
# other version (installed before plugins were pinned) is replaced, so
# what gets activated is the release that was reviewed. Activation is
# setup_bundled_plugins's.
install_wp_org_plugin() {
    local slug="$1" name="$2"
    local pinned installed temp_dir

    if [ ! -d "$SCRIPTS_DIR" ] || [ ! -f "$SCRIPTS_DIR/install_plugin.sh" ]; then
        log "Plugin installation scripts not available, skipping $name"
        return 0
    fi
    if ! pinned=$("$SCRIPTS_DIR/install_plugin.sh" --pinned-version "$slug"); then
        log "No pinned release of $name — not installing it"
        return 0
    fi

    installed=$(wp_plugin_version "$slug/$slug.php")
    if [ "$installed" = "$pinned" ]; then
        log "$name $installed already installed"
        return 0
    fi
    if [ -n "$installed" ]; then
        log "Replacing $name $installed with the pinned release $pinned..."
    else
        log "Installing $name $pinned..."
    fi

    temp_dir=$(mktemp -d)
    if "$SCRIPTS_DIR/install_plugin.sh" "$slug" "$temp_dir" >>"$LOG_FILE" 2>&1; then
        # Written as www-data, not docker cp + chown -R as root (both
        # followed links www-data can plant in plugins/).
        if op_py put-wp-tree --src "$temp_dir/$slug" \
                --dest "/var/www/html/wp-content/plugins/$slug" 2>>"$LOG_FILE"; then
            log "✓ $name $pinned installed with verified checksum"
        else
            log "Failed to copy $name to container"
        fi
    else
        log "Failed to download and verify $name - check log for details"
    fi
    rm -rf "$temp_dir"
    return 0
}

# Internet Archive Wayback Machine Link Fixer: points links archive.org
# finds broken at their Wayback copies. INSTALL_IA_PLUGIN=no leaves it out.
install_ia_plugin() {
    if ! plugin_wanted INSTALL_IA_PLUGIN; then
        log "Internet Archive plugin installation disabled in config"
        return 0
    fi
    install_wp_org_plugin internet-archive-wayback-machine-link-fixer \
        "Internet Archive Wayback Machine Link Fixer"
}

# Cache Enabler, a page cache for what Tor visitors see (what it may keep:
# onionpress-cache-policy.php). INSTALL_CACHE_ENABLER=no leaves it out.
install_cache_enabler() {
    if ! plugin_wanted INSTALL_CACHE_ENABLER; then
        log "Cache Enabler plugin installation disabled in config"
        return 0
    fi
    install_wp_org_plugin cache-enabler "Cache Enabler"
}

# Configure, then activate, the plugins install_cache_enabler and
# install_ia_plugin put in place (each while still wanted in the config),
# and for Cache Enabler then check its settings against OnionPress's cache
# policy. Configured first: Cache Enabler validates its settings (through
# onionpress-cache-policy.php) and writes its files when it is activated,
# and the Link Fixer shows its setup wizard unless it is completed by then.
# Cache Enabler is network-activated (one drop-in and page cache for the
# network; the mu-plugin gives every site, also one made later, its
# settings); the Link Fixer site by site, as it creates its link table only
# in the site it is activated on. The configure-* steps refuse, and nothing
# is activated, without the policy mu-plugins, so this runs after
# provision-post-install. Also run by the setup-bundled-plugins subcommand,
# which setup_logic.install_fresh_wordpress starts once setup has made the
# user's site. Idempotent; activation is repeated at every start
# (INSTALL_*=no stops that, and leaves an active plugin as it is).
setup_bundled_plugins() {
    if ! wp_is_installed; then
        log "WordPress not installed yet — Cache Enabler and the Link Fixer are set up after setup"
        return 0
    fi

    if plugin_wanted INSTALL_CACHE_ENABLER && wp_plugin_present cache-enabler/cache-enabler.php; then
        if op_py configure-cache-enabler >>"$LOG_FILE" 2>&1 \
                && "$SCRIPTS_DIR/activate_plugin.sh" onionpress-wordpress \
                    cache-enabler/cache-enabler.php --network >>"$LOG_FILE" 2>&1 \
                && op_py apply-cache-policy >>"$LOG_FILE" 2>&1; then
            log "✓ Cache Enabler active, cache policy applied"
        else
            log "WARNING: Cache Enabler not set up — see $LOG_FILE"
        fi
    fi

    if plugin_wanted INSTALL_IA_PLUGIN \
            && wp_plugin_present internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php; then
        if op_py configure-ia-plugin >>"$LOG_FILE" 2>&1 \
                && "$SCRIPTS_DIR/activate_plugin.sh" onionpress-wordpress \
                    internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php \
                    --each-site >>"$LOG_FILE" 2>&1; then
            log "✓ Internet Archive Wayback Machine Link Fixer active on every site"
        else
            log "WARNING: Internet Archive Link Fixer not set up — see $LOG_FILE"
        fi
    fi
    return 0
}

# WP-Statistics plugin removed — it phoned home to connect.wp-statistics.com
# despite telemetry settings being disabled.  OnionPress's built-in hit counter
# (onionpress-hit-counter plugin) provides the same functionality without
# any clearnet leaks.  On existing installs the plugin is deactivated on the
# next launch via src/onionpress/multisite.py:deactivate_wp_statistics
# (called from start_containers as `op_py deactivate-wp-statistics`).

# ─── Image updates ────────────────────────────────────────────────────

update_images() {
    local update_enabled="no"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^UPDATE_ON_LAUNCH=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            update_enabled="$config_value"
        fi
    fi

    if [ "$update_enabled" != "yes" ]; then
        return 0
    fi

    if using_local_images; then
        log "Skipping image update: running locally built images"
        return 0
    fi

    log "Checking for Docker image updates..."

    cd "$DOCKER_DIR"

    # GHCR images pinned to digest. The pins come from build/image-pins.env,
    # which build/refresh-image-digests.sh regenerates at each release and
    # propagates here; tests/test_image_pins.py fails the build if they drift.
    # Exporting ONIONPRESS_TOR_IMAGE / ONIONPRESS_WORDPRESS_IMAGE overrides
    # them, which is how a locally built stack is pulled into this loop
    # (build/build-images.sh prints the exports). The third-party images are
    # pinned too (they floated on :latest through 2.5.3), so a pull here
    # fetches something only when a new OnionPress moved a pin. No
    # cloudflared: the Linux launcher never starts it.
    local images=(
        "${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:79b18a6190e3ba8d3c261fd2782ee0a5871cbfebc663cbe12e6ade918e10aa4f}"
        "${ONIONPRESS_WORDPRESS_IMAGE:-ghcr.io/brewsterkahle/onionpress-wordpress:latest@sha256:2e3fbc5cc60bf51bc453e32836e05a442c836006e86d06b96c37654a7806d291}"
        "mariadb:13.0.2@sha256:f1bba652ba57bea3099ca2fe1af692af537c27d96e0bcde39dce29e2ba1ec4f3"
        "willfarrell/autoheal:latest@sha256:fe88c69806c71ac82fd3a483596011742f5ef319f84744cc3128e5b92b10af77"
        "ghcr.io/wollomatic/socket-proxy:1.13.1@sha256:e78e68ba3ea4a6bf8ee47865ac1d1f98d525c3660df948554e766283c40d3f4b"
    )
    local pulled=0

    for image in "${images[@]}"; do
        log "Pulling $image..."
        if docker pull "$image" >> "$LOG_FILE" 2>&1; then
            log "$image up to date"
            pulled=1
        else
            log "WARNING: Failed to pull $image (continuing with cached version)"
        fi
    done

    if [ "$pulled" = "1" ]; then
        # Issue #230: reclaim disk from old <none> image tags created by
        # the pull above. Dangling-only (no -a) so in-use and freshly
        # tagged images are untouched.
        local prune_out
        prune_out=$(docker image prune -f 2>&1 | tail -1)
        if [ -n "$prune_out" ]; then
            log "$prune_out"
        fi
    fi

    return 0
}

