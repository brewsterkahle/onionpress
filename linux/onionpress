# ─── Archive.org credential exchange ─────────────────────────────────

# Convert Archive.org login (email/username + password) into S3 API keys.
# Sets ia_s3_access and ia_s3_secret on success, empty on failure.
#
# Over Tor, like the Mac (onion_proxy._fetch_archive_s3_keys,
# multisite.ensure_archive_s3_keys): curl runs in the onionheaven container
# and goes through its Tor SOCKS port. From the host, the login would tie
# the publisher's IP address to their archive.org account. The target is
# archive.org's onion service, as in ensure_archive_s3_keys: clearnet
# archive.org turns most Tor exits away. -k because that onion's
# certificate is self-issued; the onion address itself authenticates it.
fetch_archive_s3_keys() {
    local ia_email="$1" ia_pass="$2"
    local onion="https://archivep75mbjunhxc6x4j5mwjmomyxb573v42baldlqu56ruil2oiad.onion"
    ia_s3_access=""
    ia_s3_secret=""

    # curl URL-encodes both fields itself, and the password goes in on
    # stdin: neither is ever part of any code, so quotes and backslashes in
    # them arrive intact.
    local response
    response=$(printf '%s' "$ia_pass" | docker exec -i onionheaven \
        curl -sk --socks5-hostname 127.0.0.1:9050 --max-time 60 -X POST \
        -H "User-Agent: OnionPress (+https://github.com/brewsterkahle/onionpress)" \
        --data-urlencode "email=$ia_email" \
        --data-urlencode "password@-" \
        "$onion/services/xauthn/?op=login" 2>/dev/null) || {
        log "Archive.org login: could not reach archive.org's onion service through Tor (onionheaven container)"
        return 1
    }

    local success
    success=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',''))" 2>/dev/null)
    if [ "$success" != "True" ]; then
        local reason
        reason=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('values',{}).get('reason','unknown'))" 2>/dev/null)
        log "Archive.org login failed: $reason"
        return 1
    fi

    # Try S3 keys from login response
    ia_s3_access=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('values',{}).get('s3',{}).get('access',''))" 2>/dev/null)
    ia_s3_secret=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('values',{}).get('s3',{}).get('secret',''))" 2>/dev/null)

    if [ -n "$ia_s3_access" ] && [ -n "$ia_s3_secret" ]; then
        return 0
    fi

    # Fallback: fetch S3 keys separately using cookies
    local sig user
    sig=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('values',{}).get('cookies',{}).get('logged-in-sig',''))" 2>/dev/null)
    user=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('values',{}).get('cookies',{}).get('logged-in-user',''))" 2>/dev/null)

    if [ -n "$sig" ] && [ -n "$user" ]; then
        # The session cookie is a credential too: curl reads that header
        # from stdin (-H @-), not from argv.
        local s3_response
        s3_response=$(printf 'Cookie: logged-in-sig=%s; logged-in-user=%s\n' "$sig" "$user" \
            | docker exec -i onionheaven \
            curl -sk --socks5-hostname 127.0.0.1:9050 --max-time 60 \
            -H "User-Agent: OnionPress (+https://github.com/brewsterkahle/onionpress)" \
            -H @- \
            "$onion/account/s3.php?output_json=1" 2>/dev/null)
        ia_s3_access=$(echo "$s3_response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('key',{}).get('s3accesskey',''))" 2>/dev/null)
        ia_s3_secret=$(echo "$s3_response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('key',{}).get('s3secretkey',''))" 2>/dev/null)
        if [ -n "$ia_s3_access" ] && [ -n "$ia_s3_secret" ]; then
            return 0
        fi
    fi

    log "Archive.org login succeeded but could not retrieve S3 keys"
    return 1
}

# ─── First-time WordPress setup ──────────────────────────────────────

# Usage: setup_wordpress_interactive [--user USER] [--pass PASS] [--title TITLE] [--ia-account EMAIL] [--ia-password PASS]
# If args are provided, runs non-interactively. Otherwise prompts.
setup_wordpress_interactive() {
    local wp_user="" wp_pass="" wp_email="" wp_title="OnionPress"
    local ia_access="" ia_secret=""
    local from_backup_pass="" from_backup_path=""

    # Parse optional arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --user)        wp_user="$2";    shift 2 ;;
            --pass)        wp_pass="$2";    shift 2 ;;
            --email)       wp_email="$2";   shift 2 ;;
            --title)       wp_title="$2";   shift 2 ;;
            --ia-account)  ia_access="$2";  shift 2 ;;
            --ia-password) ia_secret="$2";  shift 2 ;;
            --from-backup)
                from_backup_pass="$2"
                from_backup_path="$3"
                shift 3 ;;
            *) shift ;;
        esac
    done

    # --from-backup mode: extract config and keys from backup, use dummy WP credentials
    # (restore will overwrite the database with real users afterward)
    if [ -n "$from_backup_pass" ]; then
        if [ -z "$from_backup_path" ] || [ ! -f "$from_backup_path" ]; then
            echo "Usage: $0 setup --from-backup <password> <backup.zip>"
            return 1
        fi
        echo "  Extracting config from backup..."
        local staging
        staging=$(mktemp -d -t onionpress-setup-XXXXXX)
        trap "rm -rf '$staging'" RETURN
        if ! printf '%s' "$from_backup_pass" | op_py extract-backup --archive "$from_backup_path" --dest "$staging" >>"$LOG_FILE" 2>&1; then
            echo "ERROR: Failed to extract backup (wrong password, corrupt zip or not a valid OnionPress backup)" >&2
            return 1
        fi
        # metadata.json and the key files are whoever made the backup file's
        # (a password proves nothing about that). backup-address checks
        # them and prints the address the key belongs to, or nothing if the
        # backup has no key; that address names a directory below, so it is
        # never read from metadata.json. Refused before anything is copied.
        local onion_address
        if ! onion_address=$(op_py backup-address --staging "$staging" 2>>"$LOG_FILE") \
            || { [ -n "$onion_address" ] && ! is_onion_address "$onion_address"; }; then
            echo "ERROR: Not a valid OnionPress backup (invalid metadata or onion service key)" >&2
            return 1
        fi
        # Restore the backup's user preferences. The backup's config is
        # its author's: every other key keeps this install's value
        # (backup.RESTORABLE_CONFIG), never a straight copy.
        if op_py restore-config --staging "$staging" --config "$DATA_DIR/config" \
            --address "$onion_address" 2>>"$LOG_FILE"; then
            log "Setup: restored settings from backup"
            echo "  Settings restored from backup."
        fi
        # Restore vanity keys if present (accept either C Tor or Arti format)
        if { [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] || [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ]; } && [ -f "$staging/metadata.json" ]; then
            if [ -n "$onion_address" ]; then
                rm -rf "$DATA_DIR/shared/vanity-keys/"
                local addr_dir="$DATA_DIR/shared/vanity-keys/$onion_address"
                mkdir -p "$addr_dir"
                [ -f "$staging/tor-keys/hs_ed25519_secret_key" ] && cp "$staging/tor-keys/hs_ed25519_secret_key" "$addr_dir/"
                [ -f "$staging/tor-keys/hs_ed25519_public_key" ] && cp "$staging/tor-keys/hs_ed25519_public_key" "$addr_dir/"
                [ -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ] && cp "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" "$addr_dir/"
                echo "$onion_address" > "$addr_dir/hostname"
                log "Setup: restored Tor keys for $onion_address from backup"
                echo "  Tor keys restored from backup ($onion_address)."
            fi
        fi
        # Use dummy credentials — restore will overwrite the database
        wp_user="admin"
        wp_pass="$from_backup_pass"
        wp_email="admin@onionpress.local"
        echo "  Installing WordPress with temporary credentials (restore will overwrite)..."
    fi

    # If credentials not provided, prompt interactively
    if [ -z "$wp_user" ] || [ -z "$wp_pass" ]; then
        echo ""
        echo "  ======================================="
        echo "  OnionPress First-Time Setup"
        echo "  ======================================="
        echo ""
        echo "  Create your WordPress admin account."
        echo "  You'll use these credentials to log in at /wp-admin."
        echo ""

        if [ -z "$wp_user" ]; then
            while [ -z "$wp_user" ]; do
                printf "  Admin username: "
                read wp_user
                if [ -z "$wp_user" ]; then
                    echo "  Username cannot be empty."
                fi
            done
        fi

        if [ -z "$wp_pass" ]; then
            local wp_pass2=""
            while [ -z "$wp_pass" ]; do
                printf "  Admin password: "
                stty -echo 2>/dev/null
                read wp_pass
                stty echo 2>/dev/null
                echo ""
                if [ -z "$wp_pass" ]; then
                    echo "  Password cannot be empty."
                    continue
                fi
                printf "  Confirm password: "
                stty -echo 2>/dev/null
                read wp_pass2
                stty echo 2>/dev/null
                echo ""
                if [ "$wp_pass" != "$wp_pass2" ]; then
                    echo "  Passwords do not match. Try again."
                    wp_pass=""
                fi
            done
        fi

        printf "  Site title [OnionPress]: "
        read wp_title_input
        if [ -n "$wp_title_input" ]; then
            wp_title="$wp_title_input"
        fi

    fi

    if [ -z "$wp_email" ]; then
        wp_email="${wp_user}@onionpress.local"
    fi

    echo ""
    echo "  Installing WordPress..."
    log "Running WP-CLI core multisite-install for first-time setup"

    # sunrise.php is installed by provision-post-install before WordPress exists.
    # It queries wp_site on load, which fails during a fresh install because the
    # multisite tables don't exist yet. Move it aside for the duration of the
    # install, then restore it.
    wp_exec bash -c \
        '[ -f wp-content/sunrise.php ] && mv wp-content/sunrise.php wp-content/sunrise.php.bak || true' \
        >> "$LOG_FILE" 2>&1

    # No --admin_password: ps shows every user's command lines. wp-cli
    # generates a password, printed on the stdout dropped here, and
    # wp_set_user_password then sets the user's on stdin.
    local _wp_install_ok=false
    if wp_cli core multisite-install \
        --url="http://localhost" \
        --title="$wp_title" \
        --admin_user="$wp_user" \
        --admin_email="$wp_email" \
        --skip-email >/dev/null 2>>"$LOG_FILE"; then
        _wp_install_ok=true
    fi

    wp_exec bash -c \
        '[ -f wp-content/sunrise.php.bak ] && mv wp-content/sunrise.php.bak wp-content/sunrise.php || true' \
        >> "$LOG_FILE" 2>&1

    if $_wp_install_ok; then
        log "WordPress installed successfully via WP-CLI"
    else
        log "ERROR: WP-CLI core install failed"
        echo "  ERROR: WordPress installation failed. Check $LOG_FILE for details."
        echo "  You can complete setup manually at http://$(wp_access_host):${ONIONPRESS_WP_PORT}"
        return 1
    fi
    if ! wp_set_user_password "$wp_user" "$wp_pass" >> "$LOG_FILE" 2>&1; then
        log "ERROR: setting the WordPress admin password failed"
        echo "  ERROR: WordPress was installed, but the admin password could not be set. Check $LOG_FILE for details."
        return 1
    fi
    echo "  WordPress installed successfully!"

    # Convert Archive.org login to S3 API keys and save to wp_options.
    # `wp option update <key>` reads the value from stdin: the secret key
    # stays out of argv.
    if [ -n "$ia_access" ] && [ -n "$ia_secret" ]; then
        echo "  Logging in to Archive.org (over Tor)..."
        local ia_s3_access="" ia_s3_secret=""
        if fetch_archive_s3_keys "$ia_access" "$ia_secret"; then
            printf '%s' "$ia_s3_access" | wp_cli_in option update onionpress_archive_s3_access >> "$LOG_FILE" 2>&1
            printf '%s' "$ia_s3_secret" | wp_cli_in option update onionpress_archive_s3_secret >> "$LOG_FILE" 2>&1
            log "Archive.org S3 keys saved (from login)"
            echo "  Archive.org credentials saved."
        else
            echo "  WARNING: Archive.org login failed. You can set credentials later in Settings."
            log "Archive.org login failed during setup — skipping S3 key save"
        fi
    fi
}

# ─── OnionHeaven farm (takeover containers) ─────────────────────────
#
# Takeover container lifecycle is now managed by the heartbeat monitor
# inside the onionheaven container (via docker socket). The shell script
# only needs to stop containers on shutdown.

stop_onionheaven_farm() {
    # Stop all takeover containers, all at once, with a second's grace each:
    # their onion services are ephemeral (ADD_ONION), and one after another
    # at Docker's default 10 s a farm of any size outlasted a stop.
    local container pids=""
    for container in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^onionheaven-(poll|takeover)-[0-9]+$'); do
        {
            docker stop -t 1 "$container" >> "$LOG_FILE" 2>&1 || true
            docker rm "$container" >> "$LOG_FILE" 2>&1 || true
            log "OnionHeaven farm: stopped $container"
        } &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# Containers an OnionPress from before the OnionHeaven data had a volume of
# its own started still read and write the hub's registry and keys where
# they used to be, onionheaven/ on onionpress-persistent-data. The move
# (onionheaven-data-migrate.py, in the onionheaven and onionpress-tor
# entrypoints) must not race them, and nothing may go on using that copy
# after it. So before compose starts anything, every OnionHeaven worker and
# Tor-side container that does not mount onionpress-onionheaven-data is
# removed, all at once: compose recreates onionpress-tor and onionheaven,
# and the heartbeat starts new workers. Identical in both launchers
# (tests/test_onionheaven_data_move_hardening.py).
retire_old_onionheaven_containers() {
    local name mounts pids=""
    for name in $(docker ps -a --format '{{.Names}}' 2>/dev/null \
            | grep -E '^(onionpress-tor|onionheaven|onionheaven-(poll|takeover)-[0-9]+)$'); do
        mounts=$(docker inspect --format '{{range .Mounts}}{{.Name}}:{{.Destination}} {{end}}' "$name" 2>/dev/null) || continue
        case " $mounts" in
            *" onionpress-onionheaven-data:/var/lib/onionheaven "*) continue ;;
        esac
        log "Removing $name: it does not mount onionpress-onionheaven-data (started by an older OnionPress)"
        docker rm -f "$name" >> "$LOG_FILE" 2>&1 &
        pids="$pids $!"
    done
    if [ -n "$pids" ]; then
        wait $pids || true
    fi
}

# Clean stress-test entries and refresh takeover workers with current code.
# reset_onionheaven() drives Docker, and only the onionheaven container has
# the socket — onionpress-tor's /reset-onionheaven answers 503 — so run it
# there. Prints the JSON stats; its log lines go to $LOG_FILE.
reset_onionheaven_in_container() {
    docker exec onionheaven python3 -c '
import json, sys
sys.path.insert(0, "/")
from onionheaven_common import reset_onionheaven
print(json.dumps({"reset": True, **reset_onionheaven()}))
' 2>>"$LOG_FILE"
}

# ─── OnionHeaven lazy activation ──────────────────────────────────────
#
# The activation flag marks a hub. web-server.py writes it once it knows the
# node is one (canonical hub address, or ONIONHEAVEN_ACCEPT_REGISTRATIONS=yes)
# and removes it on every other node; registrations no longer write it.

ONIONHEAVEN_WATCHER_PID=""

start_onionheaven_activation_watcher() {
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^onionheaven$'; then
        log "OnionHeaven container already running"
    fi

    # If the activation flag already exists (this node is a hub), start immediately.
    local activate_flag
    activate_flag=$(docker exec onionpress-tor cat /var/lib/onionheaven/activate 2>/dev/null) || true
    if [ -n "$activate_flag" ]; then
        log "OnionHeaven activation flag found — starting heartbeat container"
        _activate_onionheaven
    fi

    if [ -z "$activate_flag" ]; then
        log "OnionHeaven: no activation flag — not a hub (the heartbeat monitor stays idle)"
    fi

    # Start persistent watcher — monitors the activation flag and restarts
    # the onionheaven container if it goes down on a hub.
    _onionheaven_activation_watcher &
    ONIONHEAVEN_WATCHER_PID=$!
}

_onionheaven_activation_watcher() {
    # Disable errexit — this runs as a background function and any transient
    # docker failure would silently kill the entire watcher loop (bash 4+).
    set +e
    # Persistent loop: poll for the activation flag every 30s.
    # If the flag exists but the onionheaven container is not running,
    # restart it.  This handles the case where the container was stopped
    # externally (e.g., by a test cleanup).
    while true; do
        sleep 30
        local flag
        flag=$(docker exec onionpress-tor cat /var/lib/onionheaven/activate 2>/dev/null) || true
        if [ -n "$flag" ]; then
            if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^onionheaven$'; then
                log "OnionHeaven activation flag detected — starting heartbeat container"
                _activate_onionheaven
            fi
        fi
    done
}

_activate_onionheaven() {
    cd "$DOCKER_DIR"
    docker compose up -d onionheaven >> "$LOG_FILE" 2>&1 || log "WARNING: Failed to start OnionHeaven container"
    # Takeover container management is now handled by the heartbeat inside onionheaven
}

stop_onionheaven_activation_watcher() {
    if [ -n "$ONIONHEAVEN_WATCHER_PID" ] && kill -0 "$ONIONHEAVEN_WATCHER_PID" 2>/dev/null; then
        kill "$ONIONHEAVEN_WATCHER_PID" 2>/dev/null || true
        wait "$ONIONHEAVEN_WATCHER_PID" 2>/dev/null || true
        ONIONHEAVEN_WATCHER_PID=""
    fi
}

# ─── Container management ────────────────────────────────────────────

# Whether Docker has volume $1: 0 yes, 1 no, 2 Docker could not say (the
# daemon is not up yet, e.g. the Colima VM is still booting). Callers must
# treat 2 as "stop", never as "no": a missing key volume is the first-run
# signal, so reading a Docker error as absence turns an upgrade into a first
# run. Kept identical in the macOS and Linux launchers; a test enforces that.
docker_volume_state() {
    local names
    names=$(docker volume ls --format '{{.Name}}' 2>>"$LOG_FILE") || return 2
    printf '%s\n' "$names" | grep -qx -- "$1"
}

# Wait up to $1 seconds for the Docker daemon to answer; returns 1 if it
# never does. Kept identical in the macOS and Linux launchers.
wait_for_docker() {
    local limit="$1" waited=0
    while ! docker info >/dev/null 2>&1; do
        if [ "$waited" -ge "$limit" ]; then
            return 1
        fi
        if [ "$waited" -eq 0 ]; then
            log "Waiting for Docker daemon to be ready..."
        fi
        sleep 2
        waited=$((waited + 2))
    done
    if [ "$waited" -gt 0 ]; then
        log "Docker daemon ready after ${waited}s"
    fi
    return 0
}

# One-time migration of the onion service key volume from its historical
# name. Until 2026-09-25 the delivered PEM lived in onionpress-arti-state at
# state/keystore/hss/<name>/ (arti's keystore layout); it now lives in
# onionpress-onion-keys at <name>/. This runs before the first-run check,
# which keys off the NEW volume's existence — without it an upgraded install
# would look like a fresh one and mint a new address. For the same reason it
# refuses to let the start continue when the copy fails, or when Docker cannot
# say which volumes exist: the old volume is left untouched and the next
# start retries. Kept identical in the macOS and Linux launchers; a test
# enforces that.
migrate_key_volume() {
    local state=0
    docker_volume_state onionpress-onion-keys || state=$?
    case "$state" in
        0) return 0 ;;
        2) log "ERROR: Docker did not say whether onionpress-onion-keys exists; not starting"
           return 1 ;;
    esac
    state=0
    docker_volume_state onionpress-arti-state || state=$?
    case "$state" in
        1) return 0 ;;   # nothing to migrate: a fresh install, or one that never had a key volume
        2) log "ERROR: Docker did not say whether onionpress-arti-state exists; not starting"
           return 1 ;;
    esac
    log "Migrating the onion service key volume: onionpress-arti-state -> onionpress-onion-keys"
    if ! docker volume create onionpress-onion-keys >> "$LOG_FILE" 2>&1; then
        log "ERROR: could not create onionpress-onion-keys; not starting (the old key volume is untouched)"
        return 1
    fi
    if ! docker run --rm \
        -v onionpress-arti-state:/old:ro \
        -v onionpress-onion-keys:/new \
        alpine sh -c '
            set -e
            if [ -d /old/state/keystore/hss ]; then
                cp -a /old/state/keystore/hss/. /new/
            fi
            chmod 700 /new
            find /new -mindepth 1 -type d -exec chmod 700 {} +
            find /new -type f -exec chmod 600 {} +
            for n in $(ls /old/state/keystore/hss 2>/dev/null); do
                if [ -f "/old/state/keystore/hss/$n/ks_hs_id.ed25519_expanded_private" ] \
                   && ! cmp -s "/old/state/keystore/hss/$n/ks_hs_id.ed25519_expanded_private" \
                              "/new/$n/ks_hs_id.ed25519_expanded_private"; then
                    echo "key for $n did not copy intact" >&2
                    exit 1
                fi
            done
        ' >> "$LOG_FILE" 2>&1; then
        docker volume rm onionpress-onion-keys >> "$LOG_FILE" 2>&1 || true
        log "ERROR: key volume migration failed; not starting so the old key volume stays intact (see $LOG_FILE)"
        return 1
    fi
    log "Key volume migrated; onionpress-arti-state is kept as a fallback until uninstall sweeps it"
    return 0
}

# Image derivatives (issue #257): backups carry original images only, so a
# restore leaves the resized copies (-WxH sizes, -scaled) to be rebuilt. True
# when that rebuild is still owed: the host marker the restore paths write,
# or the marker a backup archive carries inside wp-content/uploads/ (which a
# restore by an OnionPress version that predates the host marker still copies
# into the container). start_containers then runs
# `onionpress.cli regenerate-derivatives` detached in the background; it uses
# `wp media regenerate --only-missing`, so an interrupted sweep resumes on the
# next start, and it clears both markers only when it completes. Kept
# identical in the macOS and Linux launchers; a test enforces that.
regenerate_derivatives_pending() {
    [ -f "$DATA_DIR/.regenerate-derivatives-pending" ] && return 0
    docker exec onionpress-wordpress test -f \
        /var/www/html/wp-content/uploads/.onionpress-regenerate-derivatives >/dev/null 2>&1
}

# Run "$@" in the background so that it outlives this script; its output
# goes to $LOG_FILE. The settings watcher (onionpress-watcher.service) is a
# Type=oneshot unit: systemd kills everything left in its cgroup when
# handle-action returns, a `( cmd & )` included, so there the command goes
# into a transient user unit of its own (issue #316). Only the environment
# it needs is passed (systemd-run puts --setenv values on a command line
# and in the unit's properties, so never a secret). Anywhere else (the
# long-running onionpress.service, a terminal) a detached subshell lives
# long enough.
run_detached() {
    if [ "${ONIONPRESS_IN_WATCHER:-}" = "true" ] && command -v systemd-run >/dev/null 2>&1; then
        local setenv=(--setenv=PYTHONDONTWRITEBYTECODE=1)
        [ -z "${DOCKER_HOST:-}" ] || setenv+=(--setenv=DOCKER_HOST="$DOCKER_HOST")
        if systemd-run --user --quiet --collect --no-block \
                --property=StandardOutput=append:"$LOG_FILE" \
                --property=StandardError=append:"$LOG_FILE" \
                "${setenv[@]}" -- "$@" 2>>"$LOG_FILE"; then
            return 0
        fi
        log "WARNING: systemd-run failed; running in the background here (it may not finish)"
    fi
    ( "$@" >> "$LOG_FILE" 2>&1 & )
}

# The heartbeat client (onionpress-heartbeat.service) is a systemd *user*
# unit: install.sh and the .deb both install it as one. stop, restart and
# reset asked system-scope systemctl about it, which never saw it, so the
# containers went down without the client's /offline (issue #316).
# stop_heartbeat_client stops it if it runs and is true if it did; the
# caller restarts it only then (starting it would also start
# onionpress.service, which it Wants=).
stop_heartbeat_client() {
    if systemctl --user is-active --quiet onionpress-heartbeat.service 2>/dev/null; then
        log "Stopping heartbeat client..."
        systemctl --user stop onionpress-heartbeat.service 2>>"$LOG_FILE" || true
        return 0
    fi
    return 1
}
start_heartbeat_client() {
    log "Starting heartbeat client..."
    systemctl --user start "$@" onionpress-heartbeat.service 2>>"$LOG_FILE" \
        || log "WARNING: Failed to start heartbeat client"
}

# Tor's SOCKS port must be published on 127.0.0.1 only (docker-compose.yml).
# A compose file from before that, which re-running install.sh leaves in
# place (it copies the new one into docker/docker), still publishes it on
# ONIONPRESS_BIND_HOST. Docker's own mapping is the authority, so ask it
# and say so on every start; the site itself is unaffected.
warn_if_socks_port_exposed() {
    local exposed
    exposed=$(docker port onionpress-tor 9050/tcp 2>/dev/null | grep -v '^127\.0\.0\.1:' | tr '\n' ' ' || true)
    if [ -n "$exposed" ]; then
        log "WARNING: Tor's SOCKS port is published beyond this machine (${exposed% }): $DOCKER_DIR/docker-compose.yml is out of date. Install the current OnionPress .deb to replace it."
    fi
}

start_containers() {
    log "Starting OnionPress containers..."

    cd "$DOCKER_DIR"

    # Docker has to answer before anything below asks whether a volume
    # exists. Those checks used to read "Docker is not up yet" as "no such
    # volume", and a missing key volume is the first-run signal: upgrading
    # to 2.5.0 on 2026-09-30 while the Docker daemon (there, the Colima VM)
    # was still starting took the first-run path instead of migrating the
    # key volume.
    local vol_state key_state
    if ! wait_for_docker 180; then
        log "ERROR: Docker daemon not ready after 180s; not starting"
        return 1
    fi

    # Handle pending key import
    if [ -f "$DATA_DIR/.import-key-pending" ]; then
        log "Pending key import detected -- removing old key and tor-state volumes..."
        # Both keystores must be wiped: onion-keys holds the delivered PEM key,
        # tor-state holds C Tor's /var/lib/tor/hidden_service/<name>/ pair. The
        # entrypoint only converts PEM->C Tor when CTOR_SECRET is missing, so a
        # stale tor-state would silently override the imported identity. The
        # pre-2026-09-25 volume name goes too, or the migration below would
        # bring the replaced identity back.
        for vol in onionpress-onion-keys onionpress-arti-state onionpress-tor-state; do
            docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
            vol_state=0; docker_volume_state "$vol" || vol_state=$?
            if [ "$vol_state" -eq 0 ]; then
                log "Volume $vol still in use -- force-removing containers using it..."
                docker rm -f $(docker ps -aq --filter "volume=$vol") >> "$LOG_FILE" 2>&1 || true
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 || true
                vol_state=0; docker_volume_state "$vol" || vol_state=$?
            fi
            # Only a confirmed absence counts. Dropping the marker while an
            # old keystore survives (or could not be checked) would silently
            # keep the replaced identity, so leave it for the next start.
            if [ "$vol_state" -ne 1 ]; then
                log "ERROR: could not remove the old $vol volume; keeping the pending key import and not starting"
                return 1
            fi
        done
        docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
        rm -f "$DATA_DIR/.import-key-pending"
    fi

    # Upgraded installs: bring the key volume over from its old name before
    # the first-run check below looks for the new one.
    if ! migrate_key_volume; then
        log "ERROR: cannot start without the onion service key volume"
        return 1
    fi

    # Set up onion address key. Only Docker's confirmed "no" makes this a
    # first run: an unanswered question is not a fresh install.
    FIRST_RUN=false
    key_state=0; docker_volume_state onionpress-onion-keys || key_state=$?
    if [ "$key_state" -eq 2 ]; then
        log "ERROR: Docker did not say whether onionpress-onion-keys exists; not starting"
        return 1
    fi
    if [ "$key_state" -eq 1 ]; then
        FIRST_RUN=true
        log "First run detected"
    fi

    # Read address prefix from config
    ADDRESS_PREFIX="op2"
    if [ -f "$DATA_DIR/config" ]; then
        CUSTOM_PREFIX=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
        if [ -z "$CUSTOM_PREFIX" ]; then
            CUSTOM_PREFIX=$(grep "^VANITY_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
        fi
        if [ ! -z "$CUSTOM_PREFIX" ]; then
            ADDRESS_PREFIX="$CUSTOM_PREFIX"
        fi
    fi

    # First-run vanity generation. mkp224o lives in the tor container image
    # (see app/Resources/docker/tor/Dockerfile) so Docker's multi-arch
    # manifest list handles amd64/arm64 transparently — the host .deb stays
    # Architecture: all. We deliberately do NOT pre-pull the tor image
    # here: `docker compose pull` with the registry's manifest-list image
    # would overwrite any locally-built image (the digest differs), which
    # is the wrong thing during development and harmless but unnecessary
    # in production (the main container-start pull below covers it).
    # Strategy: if mkp224o is already in the local image, generate vanity
    # now; otherwise log and continue, the user gets a random address
    # this run and can run `onionpress handle-action regenerate-vanity`
    # later once the next-published tor image bundles mkp224o.
    if $FIRST_RUN && [ -n "$ADDRESS_PREFIX" ] \
       && [ ${#ADDRESS_PREFIX} -ge 2 ] && [ ${#ADDRESS_PREFIX} -le 6 ] \
       && ! vanity_key_dir >/dev/null; then
        log "First run with ADDRESS_PREFIX=$ADDRESS_PREFIX -- checking tor image for mkp224o..."
        if op_py generate-vanity >> "$LOG_FILE" 2>&1; then
            log "Vanity address generated; will be installed below"
        else
            log "Vanity generation skipped or failed; falling back to random address"
        fi
    fi

    # Check for pre-existing imported key (or one we just generated)
    VANITY_DIR=""
    if [ -d "$DATA_DIR/shared/vanity-keys" ]; then
        VANITY_DIR=$(vanity_key_dir || true)
        if [ -n "$VANITY_DIR" ]; then
            log "Using pre-imported key: $(basename "$VANITY_DIR")"
        fi
    fi

    if [ -n "$VANITY_DIR" ]; then
        # Ensure both key formats exist (derives whichever is missing)
        python3 "$SCRIPTS_DIR/key_manager.py" ensure-formats "$VANITY_DIR" 2>>"$LOG_FILE" \
            && log "Key formats synchronized" \
            || log "WARNING: Failed to synchronize key formats"

        # Sync imported key to the key volume the entrypoint reads the PEM from
        # (<name>/ks_hs_id.ed25519_expanded_private, read as root)
        docker volume create onionpress-onion-keys >> "$LOG_FILE" 2>&1 || true
        if ! docker run --rm \
            -v onionpress-onion-keys:/dest \
            --mount type=bind,source="$VANITY_DIR",target=/src \
            alpine sh -c 'mkdir -p /dest/wordpress && cp /src/ks_hs_id.ed25519_expanded_private /dest/wordpress/ && chown -R 0:0 /dest && chmod 700 /dest /dest/wordpress && chmod 600 /dest/wordpress/*' >> "$LOG_FILE" 2>&1; then
            log "WARNING: Failed to copy address key to the onionpress-onion-keys volume"
        fi
        log "Address key installed to the onionpress-onion-keys volume"

        # C Tor keys were already ensured by ensure-formats above

        # Sync imported key to C Tor state volume as well
        if [ -f "$VANITY_DIR/hs_ed25519_secret_key" ]; then
            docker volume create onionpress-tor-state >> "$LOG_FILE" 2>&1 || true
            if docker run --rm \
                -v onionpress-tor-state:/dest \
                --mount type=bind,source="$VANITY_DIR",target=/src \
                alpine sh -c '
                    mkdir -p /dest/hidden_service/wordpress/authorized_clients
                    cp /src/hs_ed25519_secret_key /dest/hidden_service/wordpress/
                    cp /src/hs_ed25519_public_key /dest/hidden_service/wordpress/ 2>/dev/null || true
                    cp /src/hostname /dest/hidden_service/wordpress/
                    chown -R 100:100 /dest/hidden_service
                    chmod 700 /dest/hidden_service /dest/hidden_service/wordpress
                    chmod 600 /dest/hidden_service/wordpress/hs_ed25519_secret_key
                    chmod 644 /dest/hidden_service/wordpress/hostname
                ' >> "$LOG_FILE" 2>&1; then
                log "Address key installed to tor-state volume (C Tor)"
            else
                log "WARNING: Failed to copy address key to tor-state volume"
            fi
        else
            log "WARNING: No C Tor key file (hs_ed25519_secret_key) -- C Tor will generate a random address"
        fi

        # Restore healthcheck keys if present (saved by backup)
        local hc_keys="$DATA_DIR/shared/healthcheck-keys"
        if [ -d "$hc_keys" ] && [ -f "$hc_keys/hs_ed25519_secret_key" ]; then
            docker volume create onionpress-tor-state >> "$LOG_FILE" 2>&1 || true
            if docker run --rm \
                -v onionpress-tor-state:/dest \
                --mount type=bind,source="$hc_keys",target=/src \
                alpine sh -c '
                    mkdir -p /dest/hidden_service/healthcheck
                    cp /src/hs_ed25519_secret_key /dest/hidden_service/healthcheck/
                    cp /src/hs_ed25519_public_key /dest/hidden_service/healthcheck/ 2>/dev/null || true
                    cp /src/hostname /dest/hidden_service/healthcheck/ 2>/dev/null || true
                    chown -R 100:100 /dest/hidden_service/healthcheck
                    chmod 700 /dest/hidden_service/healthcheck
                    chmod 600 /dest/hidden_service/healthcheck/hs_ed25519_secret_key
                ' >> "$LOG_FILE" 2>&1; then
                log "Healthcheck key installed to tor-state volume"
            else
                log "WARNING: Failed to copy healthcheck key to tor-state volume"
            fi
        fi

        log "Onion address: $(cat "$VANITY_DIR/hostname" 2>/dev/null || basename "$VANITY_DIR")"
    elif $FIRST_RUN; then
        log "No imported key found -- using random onion address"
    fi

    # Update images if enabled
    update_images

    # Pull pre-built images, but only ones we don't already have locally.
    # --policy missing avoids a 5-min network hang on every start when images
    # are already cached. update_images (gated by UPDATE_ON_LAUNCH=yes) is the
    # path for refreshing images to latest.
    #
    # Tee docker's output so per-image "Pulling"/"Pulled" lines reach stdout
    # → systemd journal → install.sh's live tail. Without the tee, the user
    # sees 2-3 minutes of silence on first run while a few hundred MB land.
    # `set -o pipefail` is not enabled in this script, so we rely on
    # PIPESTATUS to get the docker exit code through the pipe.
    if using_local_images; then
        log "Skipping image pull: running locally built images"
    else
        log "Pulling pre-built images (missing only)..."
        docker compose pull --policy missing 2>&1 | tee -a "$LOG_FILE"
        if [ "${PIPESTATUS[0]}" -ne 0 ]; then
            log "WARNING: Failed to pull images (will use cached)"
        fi
    fi

    # Nothing from before the OnionHeaven data volume may run beside the
    # containers about to start (the data move must not race them).
    retire_old_onionheaven_containers

    # Start WordPress, DB, and OnionHeaven first
    local max_attempts=3
    local attempt=1
    while [ $attempt -le $max_attempts ]; do
        # tee for the same reason as docker compose pull above — keeps the
        # journal tail visible while compose creates networks/volumes/containers.
        docker compose up -d wordpress db onionheaven 2>&1 | tee -a "$LOG_FILE"
        if [ "${PIPESTATUS[0]}" -eq 0 ]; then
            break
        fi
        log "WARNING: docker compose up failed (attempt $attempt/$max_attempts)"
        if [ $attempt -eq $max_attempts ]; then
            log "ERROR: docker compose up failed after $max_attempts attempts"
            return 1
        fi
        attempt=$((attempt + 1))
        sleep 5
    done
    log "WordPress, DB, and Tor client containers starting"

    # Wait for WordPress HTTP
    local wp_wait=0
    while [ $wp_wait -lt 60 ]; do
        if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT}" >/dev/null 2>&1; then
            break
        fi
        sleep 2
        wp_wait=$((wp_wait + 2))
    done

    # Check if WordPress is set up (retry up to 30s — DB can be slow on cold start)
    local wp_installed=false
    local wp_check=0
    while [ $wp_check -lt 15 ]; do
        if wp_is_installed; then
            wp_installed=true
            break
        fi
        sleep 2
        wp_check=$((wp_check + 1))
    done

    # WordPress install is no longer driven by the launcher — both the
    # GTK tray's SetupDialog and `onionpress setup` (SSH/TUI) call
    # setup_logic.install_fresh_wordpress with user-typed credentials.
    # This matches the Mac architecture where containers come up empty
    # and the user's setup wizard does `wp core install`. See the plan
    # discussion in commit 25c285fa / fbfcc4b2 era.
    if $wp_installed; then
        log "WordPress is installed -- starting Tor"
    else
        log "WordPress not installed -- run 'onionpress setup' or open the OnionPress tray's Setup dialog to configure"
    fi
    docker compose up -d tor onionheaven >> "$LOG_FILE" 2>&1 || log "ERROR: Failed to start tor/onionheaven containers"
    warn_if_socks_port_exposed

    # OnionHeaven: the API server runs inside the tor container (always on).
    # On a hub, the watcher keeps the onionheaven container (heartbeat
    # monitor + takeover Tor) running (signaled by an activation flag file).
    start_onionheaven_activation_watcher

    # Put the pinned Internet Archive Link Fixer and Cache Enabler releases
    # in place (downloaded over Tor, checked against their pins).
    # setup_bundled_plugins configures and activates them below, once
    # provision-post-install has installed the mu-plugins that say what
    # they may do.
    install_ia_plugin
    install_cache_enabler

    # Everything else is now in src/onionpress/multisite.py. Each call
    # used to be a bash function defined later in this file; the bash
    # implementations are kept for now (called from no one but ourselves)
    # and can be deleted in a follow-up once we're confident the Python
    # ports cover every scenario.
    op_py deactivate-wp-statistics
    # provision-post-install handles the wp_is_installed gating
    # internally — the multisite/theme steps short-circuit when WP
    # isn't yet set up; the permission fixes run unconditionally so
    # the Setup dialog's later wp-cli calls can write under
    # /var/lib/onionpress and wp-content/uploads.
    op_py provision-post-install \
        --themes-dir "$THEMES_DIR" \
        --plugins-dir "$PLUGINS_DIR"
    setup_bundled_plugins

    # Image derivatives (#257): if a restore left resized images to rebuild,
    # do it in the background — niced, detached (run_detached: out of this
    # script's job table, and out of the settings watcher's cgroup when a
    # Settings-page restore got here), resumable across restarts. After
    # provision-post-install so the image-fallback mu-plugin is in place.
    if $wp_installed && regenerate_derivatives_pending; then
        log "Image derivatives: rebuild pending — starting in the background"
        run_detached env PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -m onionpress.cli regenerate-derivatives
    fi
}

stop_containers() {
    log "Stopping OnionPress containers..."
    stop_container_log_capture
    stop_onionheaven_activation_watcher
    stop_onionheaven_farm
    # Capture the offset BEFORE compose-down so the next start can wait
    # for the TIME_WAIT sockets to clear and reuse the same offset.
    # Without this the next start sees the post-down TIME_WAIT sockets
    # as "taken" and bumps to a higher offset, leaving the user on a
    # different port number across restarts. Best-effort.
    echo "${ONIONPRESS_PORT_OFFSET:-0}" > "$DATA_DIR/.previous-port-offset" 2>/dev/null || true
    cd "$DOCKER_DIR"
    docker compose down 2>&1 | tee -a "$LOG_FILE"
    log "Containers stopped"
    # Write a final stopped status.json so any surviving tray process
    # (the tray runs as its own user process, not under our service)
    # flips its icon to gray instead of holding the previous "running"
    # snapshot indefinitely. write_status's `docker compose ps` will
    # return empty here, which the state derivation maps to "stopped".
    write_status 2>/dev/null || true
}

# ─── Status queries ──────────────────────────────────────────────────

get_status() {
    cd "$DOCKER_DIR"
    docker compose ps --format json 2>/dev/null | jq -s '.' 2>/dev/null || echo "[]"
}

# ─── OnionHeaven opt-in ──────────────────────────────────────────────
# Prints the explanation shown to the user wherever we ask them to enable
# OnionHeaven (installer footer, `onionpress onionheaven`, tray prompt).
onionheaven_explain() {
    cat <<'EOF'
  OnionHeaven keeps your .onion address reachable when this machine is
  off, asleep, or disconnected. While OnionPress runs it sends a heartbeat
  to the OnionHeaven hub. If the heartbeats stop, the hub takes over your
  address and redirects visitors to the Wayback Machine's archived copy of
  your site. When you come back online, your live site takes over again.

  What is shared: a copy of your onion service private key is sent to the
  hub (run by the Internet Archive) so it can publish your address while
  you are away. It is used only to keep your site reachable.

  We strongly recommend enabling it:

      onionpress onionheaven enable

  To opt out and stop being asked:  onionpress onionheaven disable
EOF
}

# Write REGISTER_WITH_ONIONHEAVEN=<value> into the config (replace or append).
set_onionheaven_choice() {
    local value="$1"
    [ -f "$DATA_DIR/config" ] || touch "$DATA_DIR/config"
    if grep -q "^REGISTER_WITH_ONIONHEAVEN=" "$DATA_DIR/config"; then
        sed -i "s/^REGISTER_WITH_ONIONHEAVEN=.*/REGISTER_WITH_ONIONHEAVEN=$value/" "$DATA_DIR/config"
    else
        echo "REGISTER_WITH_ONIONHEAVEN=$value" >> "$DATA_DIR/config"
    fi
}

onionheaven_cmd() {
    local sub="$1" current
    current=$(grep "^REGISTER_WITH_ONIONHEAVEN=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    case "$sub" in
        enable)
            set_onionheaven_choice yes
            log "OnionHeaven enabled by user (onionpress onionheaven enable)"
            echo "OnionHeaven enabled. Your site will register with the hub within a minute"
            echo "and stay reachable at your .onion address when this machine is off."
            ;;
        disable)
            set_onionheaven_choice no
            log "OnionHeaven disabled by user (onionpress onionheaven disable)"
            echo "OnionHeaven disabled. Visitors will get an error whenever this machine is off."
            echo "Re-enable at any time with: onionpress onionheaven enable"
            ;;
        status)
            case "$current" in
                yes) echo "OnionHeaven: enabled" ;;
                no)  echo "OnionHeaven: disabled (enable with: onionpress onionheaven enable)" ;;
                *)   echo "OnionHeaven: not enabled yet"; echo ""; onionheaven_explain ;;
            esac
            ;;
        *)
            echo "Usage: onionpress onionheaven {enable|disable|status}"
            return 1
            ;;
    esac
}

get_onion_address() {
    cd "$DOCKER_DIR"
    ONION_ADDR=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
    # The whole value must be an onion address: callers cache it and put it
    # into URLs. Anything else reads as not generated yet.
    if is_onion_address "$ONION_ADDR"; then
        echo "$ONION_ADDR"
        return 0
    fi
    echo "Generating..."
    return 1
}

# Read and cache healthcheck onion address
get_healthcheck_address() {
    cd "$DOCKER_DIR"
    local addr
    addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/healthcheck/hostname 2>/dev/null || echo "")
    if is_onion_address "$addr"; then
        echo "$addr"
        echo "$addr" > "$DATA_DIR/healthcheck-address"
        return 0
    fi
    return 1
}

# ─── Container log capture ───────────────────────────────────────────
# Capture stdout/stderr from key containers to rotating log files.
# Runs as background processes; PIDs saved for cleanup on stop.

CONTAINER_LOG_DIR="$DATA_DIR/logs"
CONTAINER_LOG_PIDS=""

_status_poll_loop() {
    # Transient failures (docker hiccup, network blip) must not kill this loop.
    set +e
    while true; do
        sleep 30
        write_status
    done
}

start_container_log_capture() {
    mkdir -p "$CONTAINER_LOG_DIR"
    for container in onionpress-tor onionheaven; do
        local logfile="$CONTAINER_LOG_DIR/container-${container#onionpress-}.log"
        # Rotate container log if over 5MB
        if [ -f "$logfile" ]; then
            local sz
            sz=$(stat -c%s "$logfile" 2>/dev/null || echo 0)
            if [ "$sz" -ge "$LOG_MAX_SIZE" ]; then
                mv -f "$logfile" "${logfile}.1"
            fi
        fi
        docker logs -f --tail 200 "$container" >> "$logfile" 2>&1 &
        CONTAINER_LOG_PIDS="$CONTAINER_LOG_PIDS $!"
    done
}

stop_container_log_capture() {
    for pid in $CONTAINER_LOG_PIDS; do
        kill "$pid" 2>/dev/null || true
    done
    CONTAINER_LOG_PIDS=""
}

# Copy the tor hostname into the shared volume so WP code (theme,
# mu-plugins, REST endpoints) can answer "what's my .onion?" without
# parsing Host headers — needed when the site is hit via localhost.
# Idempotent; safe to call from multiple places. Read from the tor
# container, written by www-data: root's cp in the tor container followed a
# link www-data can plant at onion_address to any file there (its key).
write_shared_onion_address() {
    local addr
    addr=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
    is_onion_address "$addr" || return 1
    printf '%s\n' "$addr" | wp_put /var/lib/onionpress/onion_address 644 >/dev/null 2>&1
}

wait_for_services() {
    cd "$DOCKER_DIR"
    local max_wait=120
    local waited=0
    local wp_ready=false
    local onion_ready=false
    local onion_addr=""

    log "Waiting for services to be ready..."

    while [ $waited -lt $max_wait ]; do
        # Get onion address
        if [ -z "$onion_addr" ] || [ "$onion_addr" = "Generating..." ]; then
            onion_addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
        fi

        # Check WordPress
        if [ "$wp_ready" = false ]; then
            if curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT}" >/dev/null 2>&1; then
                log "WordPress is responding on localhost:${ONIONPRESS_WP_PORT}"
                wp_ready=true

                if ! wp_is_installed; then
                    log "WordPress not installed -- setup required, skipping Tor wait"
                    # Even on the early-bail path, write the address so
                    # the Setup dialog (and later, the theme accessed via
                    # localhost) can read it.  No-op if hostname not yet
                    # generated.
                    if [ -n "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
                        write_shared_onion_address && \
                            log "Onion address written to shared volume" || true
                    fi
                    return 0
                fi
                log "Waiting for Tor to bootstrap and onion service to be reachable..."
            fi
        fi

        # Check Tor bootstrap
        if [ "$onion_ready" = false ] && [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
            if docker compose logs --tail 100 tor 2>/dev/null | grep -q -E "Bootstrapped 100% \(done\)|Sufficiently bootstrapped"; then
                if docker compose exec -T tor wget -q -O /dev/null --timeout=5 http://wordpress:80/ 2>/dev/null; then
                    log "Onion service ready: ${onion_addr}"
                    onion_ready=true
                fi
            fi
        fi

        # Both ready
        if [ "$wp_ready" = true ] && [ "$onion_ready" = true ]; then
            log "All services are ready after ${waited}s"
            ONION_ADDR="$onion_addr"

            # Write onion address to shared volume for WordPress plugins
            write_shared_onion_address && \
                log "Onion address written to shared volume" || \
                log "WARNING: Failed to write onion address to shared volume"

            # Read and save healthcheck address
            if hc_addr=$(get_healthcheck_address); then
                log "Healthcheck address: ${hc_addr}"
            fi

            return 0
        fi

        sleep 2
        waited=$((waited + 2))
    done

    log "WARNING: Services not fully ready after ${max_wait}s (wp=${wp_ready}, onion=${onion_ready})"
    if [ ! -z "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
        ONION_ADDR="$onion_addr"
    else
        ONION_ADDR="Generating..."
    fi
    # Return success — containers are running, Tor may still be bootstrapping.
    # Failing here would cause systemd to kill the running containers.
    return 0
}

# ─── Backup & Restore ─────────────────────────────────────────────────

create_backup() {
    # Creates a password-protected zip with Tor keys, database, wp-content, and metadata.
    # Usage: create_backup <password> <output_path>
    local password="$1"
    local output_path="$2"
    local staging

    if [ -z "$password" ]; then
        echo "ERROR: Password is required" >&2
        return 1
    fi

    # Verify password matches a WordPress admin account before creating backup
    # (backup contains Tor private keys — only WP admins should be able to export them).
    # The password reaches the verifier on stdin and is never part of any PHP
    # source, so no character in it can change the code that runs.
    log "Backup: verifying WordPress admin password..."
    if ! printf '%s' "$password" | verify_wp_admin_password; then
        log "ERROR: Password does not match any WordPress admin account"
        echo "ERROR: Password does not match any WordPress admin account" >&2
        return 1
    fi
    log "Backup: password verified"

    # The onion address, for metadata.json. The tor container writes this
    # file, and a restore refuses a backup whose metadata holds anything
    # but a whole address — so refuse now, before any work and while the
    # site is still here. No address at all (tor not running) stays empty
    # as before: the restore takes the address from the key.
    local onion_addr
    onion_addr=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ' || echo "")
    if [ -n "$onion_addr" ] && ! is_onion_address "$onion_addr"; then
        log "ERROR: Backup: the tor container's onion address is not a valid v3 address — no backup made"
        echo "ERROR: The onion address the tor container reports is not a valid v3 .onion address; no backup was made." >&2
        return 1
    fi

    staging=$(mktemp -d -t onionpress-backup-XXXXXX)
    trap "rm -rf '$staging'" RETURN

    # 1. Extract Tor keys (both PEM and C Tor formats)
    log "Backup: extracting Tor keys..."
    mkdir -p "$staging/tor-keys"

    # PEM key (ks_hs_id.ed25519_expanded_private)
    local arti_key
    arti_key=$(find "$DATA_DIR/shared/vanity-keys" -name "ks_hs_id.ed25519_expanded_private" 2>/dev/null | head -1)
    if [ -n "$arti_key" ]; then
        cp "$arti_key" "$staging/tor-keys/"
    else
        # Try extracting from the key volume — the current name first, then the
        # pre-2026-09-25 one for an install backed up before its first start
        # on this version migrated it.
        docker run --rm -v onionpress-onion-keys:/src alpine cat /src/wordpress/ks_hs_id.ed25519_expanded_private > "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" 2>/dev/null \
            || docker run --rm -v onionpress-arti-state:/src alpine cat /src/state/keystore/hss/wordpress/ks_hs_id.ed25519_expanded_private > "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" 2>/dev/null \
            || true
        if [ ! -s "$staging/tor-keys/ks_hs_id.ed25519_expanded_private" ]; then
            rm -f "$staging/tor-keys/ks_hs_id.ed25519_expanded_private"
            log "WARNING: No PEM key found"
        fi
    fi

    # C Tor format keys (hs_ed25519_secret_key, hs_ed25519_public_key)
    local ctor_key
    ctor_key=$(find "$DATA_DIR/shared/vanity-keys" -name "hs_ed25519_secret_key" 2>/dev/null | head -1)
    if [ -n "$ctor_key" ]; then
        cp "$ctor_key" "$staging/tor-keys/"
        # Also grab public key if present
        local ctor_pub="${ctor_key%secret_key}public_key"
        [ -f "$ctor_pub" ] && cp "$ctor_pub" "$staging/tor-keys/"
    else
        # Try extracting from the tor-state volume
        docker run --rm -v onionpress-tor-state:/src alpine sh -c 'cat /src/hidden_service/wordpress/hs_ed25519_secret_key' > "$staging/tor-keys/hs_ed25519_secret_key" 2>/dev/null || true
        if [ ! -s "$staging/tor-keys/hs_ed25519_secret_key" ]; then
            rm -f "$staging/tor-keys/hs_ed25519_secret_key"
            log "WARNING: No C Tor secret key found"
        else
            docker run --rm -v onionpress-tor-state:/src alpine sh -c 'cat /src/hidden_service/wordpress/hs_ed25519_public_key' > "$staging/tor-keys/hs_ed25519_public_key" 2>/dev/null || true
            [ ! -s "$staging/tor-keys/hs_ed25519_public_key" ] && rm -f "$staging/tor-keys/hs_ed25519_public_key"
        fi
    fi

    if [ -z "$(ls -A "$staging/tor-keys/" 2>/dev/null)" ]; then
        log "WARNING: No Tor keys found — backup will not include keys"
    fi

    # Healthcheck onion service keys (separate address, random per install)
    mkdir -p "$staging/tor-keys/healthcheck"
    docker run --rm -v onionpress-tor-state:/src alpine sh -c 'cat /src/hidden_service/healthcheck/hs_ed25519_secret_key' > "$staging/tor-keys/healthcheck/hs_ed25519_secret_key" 2>/dev/null || true
    docker run --rm -v onionpress-tor-state:/src alpine sh -c 'cat /src/hidden_service/healthcheck/hs_ed25519_public_key' > "$staging/tor-keys/healthcheck/hs_ed25519_public_key" 2>/dev/null || true
    docker run --rm -v onionpress-tor-state:/src alpine sh -c 'cat /src/hidden_service/healthcheck/hostname' > "$staging/tor-keys/healthcheck/hostname" 2>/dev/null || true
    # Clean up empty files
    find "$staging/tor-keys/healthcheck" -empty -delete 2>/dev/null
    if [ -d "$staging/tor-keys/healthcheck" ] && [ -n "$(ls -A "$staging/tor-keys/healthcheck" 2>/dev/null)" ]; then
        log "Backup: healthcheck keys saved"
    else
        rmdir "$staging/tor-keys/healthcheck" 2>/dev/null || true
        log "Backup: no healthcheck keys found (will be regenerated)"
    fi

    # 2. Dump WordPress database
    log "Backup: exporting database..."
    mkdir -p "$staging/database"
    local db_pass="${WORDPRESS_DB_PASSWORD:-}"
    if [ -z "$db_pass" ]; then
        setup_db_passwords
        db_pass="$WORDPRESS_DB_PASSWORD"
    fi
    db_client "$db_pass" mariadb-dump -u wordpress wordpress > "$staging/database/wordpress.sql" 2>>"$LOG_FILE"
    if [ $? -ne 0 ] || [ ! -s "$staging/database/wordpress.sql" ]; then
        log "ERROR: Database export failed"
        return 1
    fi

    # 3. Copy wp-content from container. Read there as www-data (root's
    #    docker cp followed a wp-content link www-data can plant to any
    #    folder in the container) and unpacked here as plain files and
    #    folders: a link planted in the container would point at a host
    #    path, where zip would store the host file and the pruning and
    #    marker below would follow it (pack-backup sweeps the tree again).
    log "Backup: copying wp-content (themes, plugins, uploads)..."
    if ! op_py stage-wp-content --dest "$staging/wp-content" >>"$LOG_FILE" 2>&1; then
        log "ERROR: could not copy wp-content out of the container"
        return 1
    fi

    # 3b. Drop the regenerable image derivatives (-WxH sizes, -scaled) —
    #     about half of a media-heavy uploads/ (issue #257). The Python
    #     helper holds the one classification both platforms use (a file is
    #     a derivative only when its base image sits beside it). The marker
    #     it leaves in uploads/ rides along in the archive so the restore
    #     knows to rebuild the sizes. A helper failure keeps the full copy.
    local pruned excludes_derivatives="false"
    if pruned=$(op_py prune-image-derivatives --uploads-dir "$staging/wp-content/uploads" 2>>"$LOG_FILE"); then
        log "Backup: pruned ${pruned% *} regenerable image derivative(s) — the restore rebuilds them"
        mkdir -p "$staging/wp-content/uploads"
        echo "OnionPress: this backup carries original images only; the resized copies (-WxH, -scaled) are rebuilt after a restore by wp media regenerate --only-missing. Removed on completion." \
            > "$staging/wp-content/uploads/.onionpress-regenerate-derivatives"
        excludes_derivatives="true"
    else
        log "WARNING: derivative pruning failed — backing up uploads in full"
    fi

    # 4. Save config
    if [ -f "$DATA_DIR/config" ]; then
        log "Backup: saving config..."
        cp "$DATA_DIR/config" "$staging/config"
    fi

    # 5. OnionHeaven registry + keys, if this instance is an OnionHeaven hub
    #    (its volume holds registrants' keys or a registry with a row): a
    #    consistent copy of the registry and keys/, as plain files, nothing
    #    else from there (backup.stage_hub_data, shared with the Mac). It
    #    used to take every node with an onionheaven container, and copied
    #    registry.db without its write-ahead log.
    local hub_rc=0
    op_py stage-hub-data --dest "$staging/onionheaven" >>"$LOG_FILE" 2>&1 || hub_rc=$?
    case "$hub_rc" in
        0) ;;
        3) ;;   # not a hub
        4) log "WARNING: the onionheaven container did not say whether it holds OnionHeaven data; this backup does not" ;;
        *) log "ERROR: could not copy the OnionHeaven data out of the onionheaven container"
           return 1 ;;
    esac
    [ "$hub_rc" -eq 0 ] || rm -rf "$staging/onionheaven"

    # 6. Write metadata (onion_addr was read and checked at the top)
    local has_onionheaven="false"
    [ -d "$staging/onionheaven" ] && has_onionheaven="true"

    log "Backup: writing metadata..."
    python3 -c "
import json, sys
metadata = {
    'onion_address': sys.argv[1],
    'backup_date': sys.argv[2],
    'onionpress_version': sys.argv[3],
    'platform': 'linux',
    'has_onionheaven': sys.argv[4] == 'true',
    # uploads/ holds originals only; resized copies are rebuilt on restore (#257)
    'excludes_image_derivatives': sys.argv[6] == 'true'
}
with open(sys.argv[5], 'w') as f:
    json.dump(metadata, f, indent=2)
" "$onion_addr" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ONIONPRESS_VERSION" "$has_onionheaven" "$staging/metadata.json" "$excludes_derivatives"

    # 7. Zip and encrypt — backup format 2, written by the shared Python
    #    helper so both platforms produce the one format (not `zip -P`,
    #    whose ZipCrypto cipher is weak). It stamps backup_format into
    #    metadata.json. The password goes over stdin, not argv.
    log "Backup: creating encrypted archive..."
    if ! printf '%s' "$password" | op_py pack-backup --staging "$staging" --output "$output_path" >>"$LOG_FILE" 2>&1; then
        log "ERROR: creating the encrypted archive failed"
        return 1
    fi

    local size
    size=$(du -h "$output_path" | cut -f1)
    log "Backup: complete ($size) -> $output_path"
}

restore_backup() {
    # Restores from a password-protected backup zip.
    # Usage: restore_backup <password> <zip_path>
    local password="$1"
    local zip_path="$2"
    local staging

    if [ -z "$password" ] || [ -z "$zip_path" ]; then
        echo "ERROR: Password and zip path are required" >&2
        return 1
    fi
    if [ ! -f "$zip_path" ]; then
        echo "ERROR: Backup file not found: $zip_path" >&2
        return 1
    fi

    staging=$(mktemp -d -t onionpress-restore-XXXXXX)
    trap "rm -rf '$staging'" RETURN

    # Extract — either backup format (format 2 needs the Python decoder;
    # format 1 ZipCrypto zips still go through unzip inside it).
    log "Restore: extracting backup archive..."
    if ! printf '%s' "$password" | op_py extract-backup --archive "$zip_path" --dest "$staging" >>"$LOG_FILE" 2>&1; then
        log "ERROR: Failed to extract backup (wrong password, corrupt zip or not a valid OnionPress backup)"
        return 1
    fi

    # Verify metadata exists
    local metadata_file="$staging/metadata.json"
    if [ ! -f "$metadata_file" ]; then
        metadata_file="$staging/./metadata.json"
    fi
    if [ ! -f "$metadata_file" ]; then
        log "ERROR: Not a valid OnionPress backup (no metadata.json)"
        return 1
    fi

    # metadata.json and the key files are whoever made the backup file's (a
    # password proves nothing about that). backup-address checks them and
    # prints the address the key belongs to, or nothing if the backup has no
    # key; that address names a directory and goes into config below, so it
    # is never read from metadata.json. Refused before anything is touched.
    local onion_address
    if ! onion_address=$(op_py backup-address --staging "$staging" 2>>"$LOG_FILE") \
        || { [ -n "$onion_address" ] && ! is_onion_address "$onion_address"; }; then
        log "ERROR: Not a valid OnionPress backup (invalid metadata or onion service key)"
        return 1
    fi
    log "Restore: backup from ${onion_address:-a backup without a key}"

    # 1. Restore Tor keys — copy whatever formats the backup has to vanity-keys.
    #    start_containers() will derive C Tor keys from the PEM if needed.
    local arti_key="$staging/tor-keys/ks_hs_id.ed25519_expanded_private"
    local ctor_secret="$staging/tor-keys/hs_ed25519_secret_key"
    local ctor_public="$staging/tor-keys/hs_ed25519_public_key"
    if { [ -f "$arti_key" ] || [ -f "$ctor_secret" ]; } && [ -n "$onion_address" ]; then
        log "Restore: writing Tor keys..."
        # Mark the key volume for removal on next start (can't remove now — containers may be running)
        touch "$DATA_DIR/.import-key-pending"
        rm -rf "$DATA_DIR/shared/vanity-keys/"

        local addr_dir="$DATA_DIR/shared/vanity-keys/$onion_address"
        mkdir -p "$addr_dir"
        [ -f "$arti_key" ] && cp "$arti_key" "$addr_dir/"
        [ -f "$ctor_secret" ] && cp "$ctor_secret" "$addr_dir/"
        [ -f "$ctor_public" ] && cp "$ctor_public" "$addr_dir/"
        echo "$onion_address" > "$addr_dir/hostname"

        # Update ADDRESS_PREFIX in config to match restored address
        local addr_base="${onion_address%.onion}"
        if [ -f "$DATA_DIR/config" ]; then
            local old_prefix
            old_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2 || echo "")
            if [ -n "$old_prefix" ]; then
                local prefix_len=${#old_prefix}
                local new_prefix="${addr_base:0:$prefix_len}"
                sed -i "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$new_prefix/" "$DATA_DIR/config"
                log "Restore: updated ADDRESS_PREFIX to $new_prefix"
            fi
        fi
        log "Restore: Tor keys written for $onion_address"
    else
        log "WARNING: No Tor keys in backup — skipping key restore"
    fi

    # Restore healthcheck keys if present in backup
    local hc_backup="$staging/tor-keys/healthcheck"
    if [ -d "$hc_backup" ] && [ -f "$hc_backup/hs_ed25519_secret_key" ]; then
        local hc_dest="$DATA_DIR/shared/healthcheck-keys"
        rm -rf "$hc_dest"
        mkdir -p "$hc_dest"
        cp "$hc_backup/"* "$hc_dest/"
        log "Restore: healthcheck keys restored"
    fi

    # 2. Restore database
    local sql_file="$staging/database/wordpress.sql"
    if [ -f "$sql_file" ]; then
        log "Restore: importing database..."
        local db_pass="${WORDPRESS_DB_PASSWORD:-}"
        if [ -z "$db_pass" ]; then
            setup_db_passwords
            db_pass="$WORDPRESS_DB_PASSWORD"
        fi
        docker cp "$sql_file" onionpress-db:/tmp/wordpress.sql 2>>"$LOG_FILE"
        db_client "$db_pass" mariadb -u wordpress wordpress -e "source /tmp/wordpress.sql" 2>>"$LOG_FILE"
        if [ $? -ne 0 ]; then
            log "ERROR: Database import failed"
            return 1
        fi
        docker exec onionpress-db rm -f /tmp/wordpress.sql 2>/dev/null
        log "Restore: database imported"
    else
        log "WARNING: No database dump in backup — skipping"
    fi

    # 3. Restore wp-content
    local wpcontent_dir="$staging/wp-content"
    if [ -d "$wpcontent_dir" ]; then
        log "Restore: copying wp-content (themes, plugins, uploads)..."
        # As www-data, not docker cp + chown -R as root: both followed
        # links www-data can plant in wp-content (wp-content itself too).
        if ! op_py put-wp-tree --merge --src "$wpcontent_dir" \
                --dest /var/www/html/wp-content 2>>"$LOG_FILE"; then
            log "ERROR: could not copy wp-content into the WordPress container"
            return 1
        fi
        log "Restore: wp-content restored"
        # Resized images the backup left out (#257) are rebuilt in the
        # background by the start that follows this restore; the marker
        # survives interruptions until the rebuild completes.
        date -u +%Y-%m-%dT%H:%M:%SZ > "$DATA_DIR/.regenerate-derivatives-pending"
        log "Restore: scheduled rebuild of resized images"
    else
        log "WARNING: No wp-content in backup — skipping"
    fi

    # 4. Restore the backup's user preferences. The backup's config is its
    #    author's: every other key keeps this install's value
    #    (backup.RESTORABLE_CONFIG), never a straight copy.
    log "Restore: restoring settings..."
    op_py restore-config --staging "$staging" --config "$DATA_DIR/config" \
        --address "$onion_address" 2>>"$LOG_FILE" \
        || log "WARNING: could not restore settings from the backup"

    # 5. Restore OnionHeaven registry + keys (if present in backup), through
    #    the onionheaven container: the registry by SQLite's .restore, never
    #    a copy over the one in use, whose -wal SQLite would apply to it
    #    (backup.restore_hub_data, shared with the Mac).
    if [ -d "$staging/onionheaven" ] && { [ -s "$staging/onionheaven/registry.db" ] || [ -d "$staging/onionheaven/keys" ]; }; then
        if docker inspect onionheaven >/dev/null 2>&1; then
            log "Restore: restoring OnionHeaven registry and keys..."
            if op_py restore-hub-data --src "$staging/onionheaven" >>"$LOG_FILE" 2>&1; then
                log "Restore: OnionHeaven data restored"
            else
                log "WARNING: could not restore the OnionHeaven data (see above)"
            fi
        else
            log "WARNING: Backup contains OnionHeaven data but onionheaven container is not running — skipping"
            echo "WARNING: OnionHeaven data found in backup but container not running. Start with OnionHeaven enabled to restore." >&2
        fi
    fi

    log "Restore: complete (from $onion_address)"
    echo "$onion_address"
}

# Write the Settings page's restore-result.json. Built with a JSON encoder,
# not by pasting strings together: the address comes out of a backup file.
# Usage: write_restore_result true <address> | write_restore_result false <error>
write_restore_result() {
    python3 -c '
import datetime, json, sys
ok = sys.argv[1] == "true"
result = {"success": ok, ("address" if ok else "error"): sys.argv[2],
          "restored_at": datetime.datetime.now(datetime.timezone.utc)
                         .strftime("%Y-%m-%dT%H:%M:%SZ")}
print(json.dumps(result))
' "$1" "$2" | wp_put /var/lib/onionpress/restore-result.json 2>/dev/null
}

# ─── Write status (on-demand) ────────────────────────────────────────

write_status() {
    # Apply any pending config changes from the WordPress settings page
    if [ -z "${_IN_WRITE_STATUS:-}" ]; then
        _IN_WRITE_STATUS=1 apply_config_updates 2>/dev/null || true
    fi

    cd "$DOCKER_DIR"

    # Get container states
    local containers_json
    containers_json=$(docker compose ps --format json 2>/dev/null | python3 -c "
import sys, json
containers = {}
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        c = json.loads(line)
        name = c.get('Name', c.get('name', ''))
        state = c.get('State', c.get('state', 'unknown'))
        containers[name] = state
    except json.JSONDecodeError:
        pass
print(json.dumps(containers))
" 2>/dev/null || echo '{}')

    # Get onion address
    local onion_addr
    onion_addr=$(docker compose exec -T tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null || echo "")
    onion_addr=$(echo "$onion_addr" | tr -d '\n\r ')
    # status.json's address becomes the tray's URLs and the WordPress
    # status page's link: a whole onion address or nothing.
    is_onion_address "$onion_addr" || onion_addr=""

    # Get bootstrap percentage (use docker logs directly — compose logs needs env vars
    # and tail 50 may miss the bootstrap message in verbose logs)
    local bootstrap_pct=0
    if docker logs onionpress-tor 2>&1 | grep -q -E "Bootstrapped 100%|Sufficiently bootstrapped"; then
        bootstrap_pct=100
    else
        local pct_line
        pct_line=$(docker logs --tail 200 onionpress-tor 2>&1 | grep -oE "Bootstrapped [0-9]+%" | tail -1 || echo "")
        if [ -n "$pct_line" ]; then
            bootstrap_pct=$(echo "$pct_line" | grep -oE "[0-9]+" || echo 0)
        fi
    fi

    # Determine overall state
    local state="unknown"
    local tor_state
    tor_state=$(echo "$containers_json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('onionpress-tor','stopped'))" 2>/dev/null || echo "stopped")
    local wp_state
    wp_state=$(echo "$containers_json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('onionpress-wordpress','stopped'))" 2>/dev/null || echo "stopped")

    if [ "$tor_state" = "running" ] && [ "$wp_state" = "running" ] && [ "$bootstrap_pct" = "100" ]; then
        # Verify onion service is actually reachable via Tor network
        if [ -n "$onion_addr" ] && [ "$onion_addr" != "Generating..." ]; then
            local reach_code
            reach_code=$(docker exec onionheaven curl -s --socks5-hostname 127.0.0.1:9050 --max-time 10 -o /dev/null -w "%{http_code}" "http://${onion_addr}/" 2>/dev/null || echo "000")
            if [ "$reach_code" = "200" ] || [ "$reach_code" = "301" ] || [ "$reach_code" = "302" ]; then
                state="running"
            else
                state="starting"
            fi
        else
            state="starting"
        fi
    elif [ "$wp_state" = "running" ] || [ "$tor_state" = "running" ]; then
        state="starting"
    else
        state="stopped"
    fi

    # Log state transitions — especially when the onion address first becomes reachable
    local prev_state=""
    local state_file="$DATA_DIR/.last_status_state"
    if [ -f "$state_file" ]; then
        prev_state=$(cat "$state_file" 2>/dev/null || echo "")
    fi
    if [ "$state" != "$prev_state" ]; then
        if [ "$state" = "running" ]; then
            log "Onion service is now reachable at http://${onion_addr}/"
        elif [ "$state" = "starting" ] && [ "$prev_state" = "running" ]; then
            log "Onion service is no longer reachable (state: starting)"
        elif [ "$state" = "stopped" ] && [ "$prev_state" != "" ] && [ "$prev_state" != "stopped" ]; then
            log "OnionPress stopped"
        fi
        echo "$state" > "$state_file"
    fi

    # One-shot WEDGE WARNING after 10+ min in "starting" without reaching
    # "running". Mirrors src/menubar.py's wedge-recovery hint so a user
    # whose Docker daemon or rootless socket is stuck gets actionable
    # guidance in the log instead of an indefinitely yellow tray icon.
    local yellow_since_file="$DATA_DIR/.yellow-since"
    local wedge_marker="$DATA_DIR/.wedge-warning-fired"
    if [ "$state" = "running" ]; then
        rm -f "$yellow_since_file" "$wedge_marker" 2>/dev/null || true
    elif [ "$state" = "starting" ]; then
        if [ ! -f "$yellow_since_file" ]; then
            date +%s > "$yellow_since_file"
        elif [ ! -f "$wedge_marker" ]; then
            local yellow_since now_epoch elapsed
            yellow_since=$(cat "$yellow_since_file" 2>/dev/null || echo 0)
            now_epoch=$(date +%s)
            elapsed=$((now_epoch - yellow_since))
            if [ "$elapsed" -ge 600 ]; then
                log "WEDGE WARNING: WordPress unreachable for 10+ min. Try restarting the OnionPress service: \`systemctl --user restart onionpress\` (or the system equivalent). If still wedged, the Docker daemon may be stuck — restart it with \`systemctl --user restart docker\` (rootless) or \`sudo systemctl restart docker\` (system Docker)."
                : > "$wedge_marker"
            fi
        fi
    fi

    # Get uptime (seconds since tor container started)
    local uptime_seconds=0
    local started_at
    started_at=$(docker inspect --format '{{.State.StartedAt}}' onionpress-tor 2>/dev/null || echo "")
    if [ -n "$started_at" ] && [ "$started_at" != "0001-01-01T00:00:00Z" ]; then
        local started_epoch
        started_epoch=$(date -d "$started_at" +%s 2>/dev/null || echo 0)
        local now_epoch
        now_epoch=$(date +%s)
        if [ "$started_epoch" -gt 0 ] 2>/dev/null; then
            uptime_seconds=$((now_epoch - started_epoch))
        fi
    fi

    # Wayback queue count: posts not yet archived (waiting plus in flight),
    # from the plugin's own totals. The onionpress_wayback_queue option this
    # used to read was the v3 JSON queue, which the v4 plugin deleted, so
    # the count was always 0.
    local wayback_queue=0
    wayback_queue=$(wp_cli eval 'echo json_encode(onionpress_wayback_queue_totals());' 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(int(data.get('remaining', 0)) + int(data.get('in_flight', 0)))
except Exception:
    print(0)
" 2>/dev/null || echo 0)

    local now_iso
    now_iso=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Gather OnionHeaven stats
    local oh_server_active="false"
    local oh_registered_count=0
    local oh_online_count=0
    local oh_taken_over_count=0
    local oh_takeover_containers=0
    local oh_client_registered="false"
    local oh_client_hub=""
    local oh_config_enabled="false"

    # Read client registration state
    if [ -f "$DATA_DIR/onionheaven-registration.json" ]; then
        oh_client_registered=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print('true' if d.get('registered') else 'false')
except: print('false')
" "$DATA_DIR/onionheaven-registration.json" 2>/dev/null || echo "false")
    fi

    # Read config
    if [ -f "$DATA_DIR/config" ]; then
        oh_config_enabled=$(grep "^REGISTER_WITH_ONIONHEAVEN=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
        oh_client_hub=$(grep "^ONIONHEAVEN_ADDRESS=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    fi
    # Opt-in: only an explicit "yes" counts as enabled (unset = undecided).
    oh_config_enabled=${oh_config_enabled:-no}
    [ "$oh_config_enabled" = "yes" ] || oh_config_enabled=no
    oh_client_hub=${oh_client_hub:-oheavenfhbohpdjijmxo3xgvvuo6eleyhhorbompoycle6x5eajlp7qd.onion}

    # Check if this node is an OH server
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^onionheaven$'; then
        oh_server_active="true"
        # Query OH server stats from registry DB
        local oh_stats
        oh_stats=$(docker exec onionheaven sqlite3 /var/lib/onionheaven/registry.db \
            "SELECT
                COUNT(*) AS total,
                SUM(CASE WHEN status='online' THEN 1 ELSE 0 END) AS online,
                SUM(CASE WHEN status='taken-over' THEN 1 ELSE 0 END) AS taken_over
            FROM registry" 2>/dev/null || echo "0|0|0")
        oh_registered_count=$(echo "$oh_stats" | cut -d'|' -f1)
        oh_online_count=$(echo "$oh_stats" | cut -d'|' -f2)
        oh_taken_over_count=$(echo "$oh_stats" | cut -d'|' -f3)
        oh_registered_count=${oh_registered_count:-0}
        oh_online_count=${oh_online_count:-0}
        oh_taken_over_count=${oh_taken_over_count:-0}
        oh_takeover_containers=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -cE '^onionheaven-takeover-[0-9]+$' 2>/dev/null || true)
        oh_takeover_containers=${oh_takeover_containers:-0}
    fi

    # System load averages and host uptime (Linux)
    local load_avg_json="[]"
    if [ -f /proc/loadavg ]; then
        load_avg_json=$(awk '{printf "[%s, %s, %s]", $1, $2, $3}' /proc/loadavg 2>/dev/null || echo "[]")
    fi
    local host_uptime_seconds=0
    if [ -f /proc/uptime ]; then
        host_uptime_seconds=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || echo 0)
    fi

    # Extra fields for the Linux tray. Cheap probes that don't add measurable
    # latency to the 10s watcher tick.
    local wp_installed_str="false"
    if wp_is_installed 2>/dev/null; then
        wp_installed_str="true"
    fi
    local onboarded="false"
    if [ "$wp_installed_str" = "true" ]; then
        # Read via get_site_option — same call the onionpress-onboarding
        # mu-plugin uses to decide whether to redirect the admin. Reading
        # wp_options here would diverge after multisite-convert: per-blog
        # options stay set, but the network-wide table (wp_sitemeta) is
        # what the plugin checks, and that's where install_fresh_wordpress
        # now writes the marker.
        local _opt
        _opt=$(wp_cli eval 'echo (string) get_site_option("onionpress_onboarded", "");' 2>/dev/null | tr -d '\r\n ')
        if [ -n "$_opt" ] && [ "$_opt" != "0" ] && [ "$_opt" != "false" ]; then
            onboarded="true"
        fi
    fi
    local mkp224o_available="false"
    # Tag-only by design: pinning this to a digest would make a locally built
    # image fail the check and silently fall back to a random .onion (the
    # v2.4.101 regression). It follows ONIONPRESS_TOR_IMAGE so a local build
    # is recognised; build/build-images.sh also shadow-tags the GHCR name so
    # the default below keeps working either way.
    if docker image inspect "${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest}" >/dev/null 2>&1; then
        # Image presence is enough; we trust the build had mkp224o.
        mkp224o_available="true"
    fi
    local wp_admin_password_file=""
    if [ -f "$DATA_DIR/wp-admin-password" ]; then
        wp_admin_password_file="$DATA_DIR/wp-admin-password"
    fi
    local vanity_in_progress="false"
    if [ -f "$DATA_DIR/.vanity-running" ]; then
        vanity_in_progress="true"
    fi
    # OnionHeaven "serving from Wayback" — for now treat this as the case
    # where local state is not 'running' but the client is registered with
    # a hub. A more precise signal will come from the hub heartbeat.
    local serving_from_wayback="false"
    if [ "$state" != "running" ] && [ "$oh_client_registered" = "true" ]; then
        serving_from_wayback="true"
    fi

    # Build status.json
    local status_json
    status_json=$(python3 -c "
import json, sys
status = {
    'state': sys.argv[1],
    'version': sys.argv[2],
    'onion_address': sys.argv[3],
    'uptime_seconds': int(sys.argv[4]),
    'bootstrap_pct': int(sys.argv[5]),
    'containers': json.loads(sys.argv[6]),
    'wayback_queue_count': int(sys.argv[7]),
    'updated_at': sys.argv[8],
    'platform': 'linux',
    'load_avg': json.loads(sys.argv[17]),
    'host_uptime_seconds': int(sys.argv[18]),
    'onionheaven': {
        'server_active': sys.argv[9] == 'true',
        'registered_count': int(sys.argv[10]),
        'online_count': int(sys.argv[11]),
        'taken_over_count': int(sys.argv[12]),
        'takeover_containers': int(sys.argv[13]),
        'client_registered': sys.argv[14] == 'true',
        'client_hub': sys.argv[15],
        'client_enabled': sys.argv[16] == 'yes',
    },
    'wp_installed': sys.argv[19] == 'true',
    'onboarded': sys.argv[20] == 'true',
    'mkp224o_available': sys.argv[21] == 'true',
    'wp_admin_password_path': sys.argv[22] or None,
    'vanity_in_progress': sys.argv[23] == 'true',
    'serving_from_wayback': sys.argv[24] == 'true',
    'wp_port': int(sys.argv[25]),
}
print(json.dumps(status, indent=2))
" "$state" "$ONIONPRESS_VERSION" "$onion_addr" "$uptime_seconds" "$bootstrap_pct" "$containers_json" "$wayback_queue" "$now_iso" \
  "$oh_server_active" "$oh_registered_count" "$oh_online_count" "$oh_taken_over_count" "$oh_takeover_containers" \
  "$oh_client_registered" "$oh_client_hub" "$oh_config_enabled" \
  "$load_avg_json" "$host_uptime_seconds" \
  "$wp_installed_str" "$onboarded" "$mkp224o_available" \
  "$wp_admin_password_file" "$vanity_in_progress" "$serving_from_wayback" \
  "${ONIONPRESS_WP_PORT:-8080}")

    # Write to shared volume (consumed by the WP settings/status page): only
    # the fields those pages show (redact.WORDPRESS_STATUS_KEYS, shared with
    # the Mac app) — PHP can read the file, and wp_admin_password_path is a
    # path under $HOME. If the filter fails, leave the old copy alone rather
    # than write the full status.
    local wp_status_json
    if wp_status_json=$(printf '%s' "$status_json" | op_py --data-dir "$DATA_DIR" wordpress-status 2>>"$LOG_FILE"); then
        echo "$wp_status_json" | wp_put /var/lib/onionpress/status.json 2>>"$LOG_FILE"
    fi
    # Also write to the host data dir — the tray app reads this directly,
    # without going through docker exec on every poll.
    printf '%s\n' "$status_json" > "$DATA_DIR/status.json.tmp" 2>>"$LOG_FILE" \
        && mv -f "$DATA_DIR/status.json.tmp" "$DATA_DIR/status.json" 2>>"$LOG_FILE"

    # Write version file for the settings page update checker
    echo "$ONIONPRESS_VERSION" | wp_put /var/lib/onionpress/version 2>>"$LOG_FILE"

    # Build config-current.json from ~/.onionpress/config — allowlisted keys
    # only (SAFE_CONFIG_KEYS, shared with the Mac app): the file is readable
    # by WordPress/PHP and the config can hold secrets such as
    # CLOUDFLARE_TUNNEL_TOKEN. On failure write {}, never the raw config,
    # so an older full copy in the volume is still overwritten.
    local config_json
    config_json=$(op_py --data-dir "$DATA_DIR" safe-config 2>>"$LOG_FILE") || config_json="{}"

    echo "$config_json" | wp_put /var/lib/onionpress/config-current.json 2>>"$LOG_FILE"

    write_recent_logs
}

# The end of the log, for the status page's Recent Logs. PHP can read
# recent-logs.txt, so it is scrubbed first (redact.scrub_for_wordpress:
# no home path or user name, credentials or non-loopback IPs) and never
# copied raw: if the scrub fails, a placeholder goes instead.
write_recent_logs() {
    [ -f "$LOG_FILE" ] || return 0
    local logs
    logs=$(op_py --data-dir "$DATA_DIR" wordpress-logs --log-file "$LOG_FILE" 2>/dev/null) \
        || logs="(Recent logs unavailable: could not scrub $(basename "$LOG_FILE") for display.)"
    printf '%s\n' "$logs" | wp_put /var/lib/onionpress/recent-logs.txt 2>/dev/null
}

# ─── Config watcher (on-demand) ──────────────────────────────────────

apply_config_updates() {
    # Check if settings page wrote config-updates.json
    local updates result changed rejected
    updates=$(wp_exec cat /var/lib/onionpress/config-updates.json 2>/dev/null || echo "")

    if [ -z "$updates" ] || [ "$updates" = "{}" ]; then
        return 0
    fi

    log "Applying config updates from settings page..."

    # Anything running in WordPress can write that file, so the shared
    # allowlist (config.SETTINGS_PAGE_KEYS, as on the Mac) applies only the
    # settings page's own keys with valid values. It reports key names,
    # never values.
    if ! result=$(printf '%s' "$updates" | op_py --data-dir "$DATA_DIR" apply-settings-updates 2>>"$LOG_FILE"); then
        log "WARNING: Could not apply config updates from settings page"
        return 1
    fi
    changed=$(printf '%s\n' "$result" | sed -n 's/^changed //p' | tr '\n' ' ')
    rejected=$(printf '%s\n' "$result" | sed -n 's/^rejected //p' | tr '\n' ' ')
    [ -z "$changed" ] || log "Settings page changed: ${changed% }"
    [ -z "$rejected" ] || log "WARNING: Settings page update ignored (not a setting it may change, or an invalid value): ${rejected% }"

    # Clear the updates file
    wp_exec rm -f /var/lib/onionpress/config-updates.json 2>>"$LOG_FILE"

    # Handle START_ON_BOOT (re-applied whenever the page sends it)
    if printf '%s\n' "$result" | grep -qE '^(changed|unchanged) START_ON_BOOT$'; then
        local boot_val
        boot_val=$(grep "^START_ON_BOOT=" "$DATA_DIR/config" | cut -d= -f2)
        # User units, as installed (a system-scope enable never matched
        # them, issue #316). The heartbeat goes with onionpress.service: it
        # is WantedBy=default.target too and Wants= onionpress.service, so
        # left enabled it would start OnionPress at boot anyway.
        # onionpress.service starts it whenever it starts.
        if [ "$boot_val" = "yes" ]; then
            systemctl --user enable onionpress.service onionpress-heartbeat.service 2>>"$LOG_FILE" && log "Enabled start on boot" || log "WARNING: Failed to enable start on boot"
        else
            systemctl --user disable onionpress.service onionpress-heartbeat.service 2>>"$LOG_FILE" && log "Disabled start on boot" || log "WARNING: Failed to disable start on boot"
        fi
    fi

    # Write updated status
    write_status

    log "Config updates applied"
}

# ─── Update ───────────────────────────────────────────────────────────
#
# `onionpress update` (and the Settings page's Update button, through
# handle-action) installs a tagged release with that release's own
# installer: its .deb on a .deb install, its linux/install.sh on any other.
# The command used to keep a copy list of its own, which went stale: it
# copied src/onion_auth.py after that file moved into src/onionpress/, so
# under set -e it stopped with only the launcher replaced; it nested
# folders (docker/docker) as install.sh did; it never refreshed lib/, the
# themes, the tray or the units; it installed main's HEAD, not a release;
# and when a fast-forward failed it reset the first checkout it found under
# /home/* to origin/main, a developer's work included (issue #316). It now
# works in a temporary folder of its own and touches no other checkout.
ONIONPRESS_GITHUB_REPO="brewsterkahle/onionpress"

# Status 0: updated, or already on the latest release. 1: failed. 3: needs
# administrator rights (sudo) and has no terminal to ask for them in (the
# Settings page's watcher).
update_onionpress() {
    local tag="$1" new_version current tmp rc=0

    if [ -z "$tag" ]; then
        log "Checking for OnionPress updates..."
        echo "  Checking for updates..."
        tag=$(curl -fsSL --max-time 30 \
                "https://api.github.com/repos/$ONIONPRESS_GITHUB_REPO/releases/latest" 2>>"$LOG_FILE" \
              | jq -r '.tag_name // empty' 2>>"$LOG_FILE") || tag=""
    else
        tag="v${tag#v}"
    fi
    # The tag goes into a URL and a git ref: a release tag and nothing else.
    if ! [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log "ERROR: Update: could not find a release tag (vX.Y.Z)"
        echo "  ERROR: Could not find the OnionPress release to install. Check $LOG_FILE for details."
        return 1
    fi
    new_version="${tag#v}"

    # Without a tag named on the command line, only a newer release is
    # installed: a developer's install from a checkout is left alone.
    current=$(tr -d '[:space:]' < "$INSTALL_DIR/VERSION" 2>/dev/null || true)
    if [ -z "$1" ] && [[ "$current" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
            && [ "$(printf '%s\n%s\n' "$new_version" "$current" | sort -V | tail -1)" = "$current" ]; then
        log "Update: OnionPress $current is up to date (latest release $new_version)"
        echo "  OnionPress $current is up to date (latest release: $new_version)."
        return 0
    fi

    # Both installers need sudo. In a terminal sudo asks for the password;
    # the watcher has none, so there it works only without one.
    if [ ! -t 0 ] && ! sudo -n true 2>/dev/null; then
        log "Update to $new_version needs administrator rights: run 'onionpress update' in a terminal"
        echo "  Updating needs administrator rights: run 'onionpress update' in a terminal."
        return 3
    fi

    tmp=$(mktemp -d -t onionpress-update-XXXXXX) || return 1
    log "Updating OnionPress ${current:-?} -> $new_version..."
    echo "  Updating OnionPress to $new_version..."
    if dpkg-query -W -f='${Status}' onionpress 2>/dev/null | grep -q 'install ok installed'; then
        _update_from_deb "$tag" "$tmp" || rc=$?
    else
        _update_from_install_sh "$tag" "$tmp" || rc=$?
    fi
    rm -rf "$tmp"
    if [ "$rc" -ne 0 ]; then
        log "ERROR: Update to $new_version failed"
        echo "  ERROR: Update failed. Check $LOG_FILE for details."
        return 1
    fi
    log "Update complete: $new_version"
    echo "  Update complete! Now running OnionPress $new_version."
}

# Run "$@", its output to $LOG_FILE and, in a terminal, to the screen too.
_update_run() {
    if [ -t 1 ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"
        return "${PIPESTATUS[0]}"
    fi
    "$@" >> "$LOG_FILE" 2>&1
}

# A .deb install: the release's onionpress.deb through apt (dpkg replaces
# each file by rename, so this script keeps running), then a restart of
# onionpress.service if it runs. Its upgrade postinst restarts nothing.
# The restart's ExecStop stops the heartbeat client first, and the new
# `start` starts it again.
_update_from_deb() {
    local tag="$1" tmp="$2"
    if ! curl -fsSL --max-time 900 -o "$tmp/onionpress.deb" \
            "https://github.com/$ONIONPRESS_GITHUB_REPO/releases/download/$tag/onionpress.deb" 2>>"$LOG_FILE"; then
        log "ERROR: Update: could not download onionpress.deb for $tag"
        return 1
    fi
    chmod 755 "$tmp"
    chmod 644 "$tmp/onionpress.deb"
    if ! _update_run sudo apt-get install -y "$tmp/onionpress.deb"; then
        log "ERROR: Update: apt-get could not install onionpress.deb for $tag"
        return 1
    fi
    systemctl --user daemon-reload 2>>"$LOG_FILE" || true
    if systemctl --user is-active --quiet onionpress.service 2>/dev/null; then
        log "Restarting OnionPress..."
        echo "  Restarting OnionPress..."
        systemctl --user restart onionpress.service 2>>"$LOG_FILE" || return 1
    else
        echo "  OnionPress is not running; start it with: systemctl --user start onionpress"
    fi
}

# Any other install: the release's own linux/install.sh, from a shallow
# clone of its tag. It stops the services (the heartbeat client first),
# replaces every file and folder, reinstalls the units and restarts them.
_update_from_install_sh() {
    local tag="$1" tmp="$2"
    if ! git clone --quiet --depth 1 --branch "$tag" \
            "https://github.com/$ONIONPRESS_GITHUB_REPO.git" "$tmp/onionpress" >> "$LOG_FILE" 2>&1; then
        log "ERROR: Update: could not download OnionPress $tag"
        return 1
    fi
    if [ ! -f "$tmp/onionpress/linux/install.sh" ]; then
        log "ERROR: Update: $tag has no linux/install.sh"
        return 1
    fi
    echo "  Installing (this restarts OnionPress)..."
    _update_run bash "$tmp/onionpress/linux/install.sh" < /dev/null
}

# ─── Main ─────────────────────────────────────────────────────────────

# ─── Validate OnionHeaven address ─────────────────────────────────────
# Returns JSON: {"valid":true/false, "status":"hub"|"site"|"unreachable"|"self"|"invalid_format", "message":"..."}
# Called by: WordPress settings page
_validate_oh_address() {
    local addr="$1"

    # Format check: the whole value, as is_onion_address does. This was a
    # length of 62 and `echo | grep '\.onion$'`, which tests each line on
    # its own and passed any 62 characters ending in ".onion" (a clearnet
    # host and path included) on to curl.
    if ! is_onion_address "$addr"; then
        echo '{"valid":false,"status":"invalid_format","message":"Address must be a valid 56-character .onion address."}'
        return 1
    fi

    # Self check — compare against our own address
    local our_address=""
    our_address=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
    if [ -n "$our_address" ] && [ "$addr" = "$our_address" ]; then
        echo '{"valid":false,"status":"self","message":"You cannot use your own onion address as the OnionHeaven hub."}'
        return 1
    fi

    # Probe the OnionHeaven API endpoint (:8083/status)
    local api_result
    api_result=$(docker exec onionheaven curl -s --max-time 30 \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}:8083/status" 2>/dev/null) || true

    if [ -n "$api_result" ] && echo "$api_result" | grep -q '"version"'; then
        # Every node answers /status, but only a hub accepts registrations.
        # Images from before that gate omit the field; they took them all.
        if echo "$api_result" | grep -q '"accepting_registrations": *false'; then
            echo '{"valid":true,"status":"site","message":"This address runs OnionPress but is not an OnionHeaven hub, so it will refuse registrations."}'
            return 0
        fi
        echo '{"valid":true,"status":"hub","message":"Valid OnionHeaven hub."}'
        return 0
    fi

    # API didn't respond — try the base address (port 80)
    local http_code
    http_code=$(docker exec onionheaven curl -s --max-time 30 \
        -o /dev/null -w "%{http_code}" \
        --socks5-hostname 127.0.0.1:9050 \
        "http://${addr}/" 2>/dev/null) || true

    if [ "$http_code" = "200" ] || [ "$http_code" = "301" ] || [ "$http_code" = "302" ]; then
        echo '{"valid":true,"status":"site","message":"This address is reachable but is not running OnionHeaven yet."}'
        return 0
    fi

    echo '{"valid":true,"status":"unreachable","message":"Could not reach this address over Tor. It may be offline or invalid."}'
    return 0
}

main() {
    case "${1:-start}" in
        start)
            # PID lock
            if [ -f "$PIDFILE" ]; then
                old_pid=$(cat "$PIDFILE" 2>/dev/null)
                if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                    echo "OnionPress is already running (PID $old_pid)." >&2
                    exit 1
                fi
                rm -f "$PIDFILE"
            fi
            echo $$ > "$PIDFILE"
            trap 'rm -f "$PIDFILE"' EXIT INT TERM HUP

            # Check Docker is available
            if ! command_exists docker || ! docker info >/dev/null 2>&1; then
                log "ERROR: Docker is not available. Install Docker first."
                exit 1
            fi

            setup_db_passwords
            start_containers
            wait_for_services
            start_container_log_capture

            # Write initial status
            write_status

            log "OnionPress is running!"
            log "Onion address: $ONION_ADDR"
            log "Local access: http://$(wp_access_host):${ONIONPRESS_WP_PORT}"

            echo ""
            echo "OnionPress is running!"
            echo "  Onion address: $ONION_ADDR"
            echo "  Local access:  http://$(wp_access_host):${ONIONPRESS_WP_PORT}"
            echo "  Status page:   http://$(wp_access_host):${ONIONPRESS_WP_PORT}/onionpress-status"
            echo "  Logs:          $LOG_FILE"

            # Keep main process alive so systemd (KillMode=control-group)
            # doesn't kill our background monitors (farm, activation watcher).
            # Signal readiness to systemd, then poll status every 30s so the
            # tray icon and reachability state stay current.
            if [ "${NOTIFY_SOCKET:-}" ]; then
                systemd-notify --ready 2>/dev/null || true
                # Our ExecStop (`stop`) stops the heartbeat client so its
                # /offline goes out first; bring it back with the service.
                # --no-block: it is ordered After= this unit.
                start_heartbeat_client --no-block
            fi
            _status_poll_loop &
            wait
            ;;

        stop)
            setup_db_passwords
            # Stop heartbeat client first (sends /offline before containers
            # go down). This is onionpress.service's ExecStop too; `start`
            # starts the client again.
            stop_heartbeat_client || true
            stop_containers
            ;;

        restart)
            setup_db_passwords
            # Stop heartbeat client first (sends /offline before containers go down)
            local heartbeat_was_running=false
            stop_heartbeat_client && heartbeat_was_running=true
            stop_containers
            start_containers
            wait_for_services
            write_status
            if $heartbeat_was_running; then
                start_heartbeat_client
            fi
            ;;

        status)
            get_status
            ;;

        address)
            get_onion_address
            ;;

        dashboard)
            # Open wp-admin in the default browser, auto-logged-in as the first
            # admin user, through the onionpress-auto-login mu-plugin: a
            # one-shot token, 120 s TTL, deleted on use. The token is never
            # on a command line (ps shows every user's): open-login hands it
            # to WordPress on stdin and gives the browser a 0600 page that
            # redirects to the login URL (onionpress.auto_login).
            if ! command -v xdg-open >/dev/null 2>&1; then
                echo "xdg-open not found — open http://localhost:${ONIONPRESS_WP_PORT:-8080}/wp-admin manually."
                exit 1
            fi
            op_py open-login "http://localhost:${ONIONPRESS_WP_PORT:-8080}/wp-admin/" >/dev/null
            ;;

        setup)
            # Usage: onionpress setup [--user USER] [--pass PASS] [--email EMAIL] [--title TITLE]
            #        onionpress setup --from-backup <password> <backup.zip>
            setup_db_passwords
            cd "$DOCKER_DIR"
            if wp_is_installed; then
                echo "WordPress is already installed."
                exit 0
            fi
            # Make sure containers are running
            if ! curl -s --max-time 3 "http://localhost:${ONIONPRESS_WP_PORT}" >/dev/null 2>&1; then
                echo "WordPress container is not running. Start OnionPress first: systemctl --user start onionpress"
                exit 1
            fi
            shift  # remove "setup" from args
            local has_from_backup=""
            for arg in "$@"; do
                [ "$arg" = "--from-backup" ] && has_from_backup=1 && break
            done
            # A failed setup — for --from-backup, a backup refused before
            # anything was restored — must not go on to flag a key reimport.
            setup_wordpress_interactive "$@" || exit 1
            if [ -n "$has_from_backup" ]; then
                # --from-backup restored keys to vanity-keys/ — need to reinstall
                # into the key volume so Tor uses the restored address.
                # Use .import-key-pending flag so start_containers removes the old
                # key volume and installs the restored key.
                log "Setup --from-backup: flagging key reimport..."
                touch "$DATA_DIR/.import-key-pending"
                stop_containers
                start_containers
                wait_for_services
            else
                # Start Tor if not running
                if ! docker compose ps tor --format json 2>/dev/null | grep -q running; then
                    echo "  Starting Tor..."
                    docker compose up -d tor onionheaven >> "$LOG_FILE" 2>&1
                fi
                # Run post-install provisioning: theme, multisite, plugins.
                # provision-post-install ran at startup before WordPress existed
                # and short-circuited the theme/multisite steps. Now that WP is
                # installed, run it again to complete those steps.
                op_py provision-post-install \
                    --themes-dir "$THEMES_DIR" \
                    --plugins-dir "$PLUGINS_DIR" >> "$LOG_FILE" 2>&1 || true
                # Then Cache Enabler and the Link Fixer, which need the
                # mu-plugins provision-post-install has just installed.
                setup_bundled_plugins
                # Fetch archive.org S3 keys now that Tor is up and WP is
                # installed — same timing as the Mac setup flow.
                op_py ensure-archive-s3-keys >> "$LOG_FILE" 2>&1 &
            fi
            write_status
            echo ""
            echo "  Setup complete! Your site is now running."
            echo "  Admin panel: http://$(wp_access_host):${ONIONPRESS_WP_PORT}/wp-admin"
            echo "  Status page: http://$(wp_access_host):${ONIONPRESS_WP_PORT}/onionpress-status"
            ;;

        provision)
            # Provision an already-installed WordPress with user-chosen
            # site title, username, and password.  Used in headless / SSH
            # installs after the auto-install bootstrap (systemd path where
            # the container auto-installs WP with a random admin password).
            # Unlike `setup`, this works when WP is already installed.
            #
            # Usage: onionpress provision
            #   → interactive terminal prompts
            PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -c "
import sys
from onionpress.setup_logic import provision_interactive
sys.exit(0 if provision_interactive() else 1)
"
            ;;

        provision-post-install)
            # Run the post-`wp core install` provisioning steps —
            # multisite conversion, sunrise.php + mu-plugins + .htaccess,
            # OnionPress theme + bundled plugins, and permission fixes.
            # Called by setup_logic.install_fresh_wordpress after a fresh
            # wp core install completes; also safe to re-run by hand.
            # Idempotent — every step skips or no-ops when its work is
            # already done. Stays a bash subcommand for now; planned to
            # be ported to src/onionpress/multisite.py as a follow-up.
            #
            # Delegated to src/onionpress/multisite.py:provision_post_install.
            # The previous bash implementation lived here AND in
            # app/MacOS/onionpress as parallel copies; the Python module
            # is shared so the two platforms can't drift. Step ordering
            # (ensure_multisite BEFORE install_multisite_domain_map) is
            # enforced inside the module — see its docstring for why.
            op_py provision-post-install \
                --themes-dir "$THEMES_DIR" \
                --plugins-dir "$PLUGINS_DIR"
            ;;

        setup-bundled-plugins)
            # Configure and activate Cache Enabler and the Link Fixer
            # (setup_bundled_plugins). setup_logic.install_fresh_wordpress
            # starts this in the background once setup has made the user's
            # site, so a new install has them without waiting for a restart.
            setup_bundled_plugins
            ;;

        import-key)
            import_key "$2"
            ;;

        sleep-pre|sleep-post)
            # Called by /usr/lib/systemd/system-sleep/onionpress around
            # suspend. As of v2.4.99, all real work happens in the heartbeat
            # daemon's DBus delay-inhibitor (see SleepInhibitor in
            # onionpress-heartbeat.py): /offline POST on suspend and
            # DEL_ONION / ADD_ONION watchdog signals on both sides, all
            # while the inhibitor lock is still held — when docker is
            # still responsive (not throttled by NM teardown).
            #
            # This hook is kept as a no-op fallback so the system-sleep
            # contract still has something to call, and so its presence
            # in the journal proves the OnionPress install is wired in.
            # If the heartbeat daemon isn't running for some reason,
            # there's nothing useful we can do from here anyway —
            # docker exec is too slow at this point in the suspend flow.
            phase="${1#sleep-}"
            log "system-sleep $phase: hook called (no-op; daemon does the work)"
            ;;

        # ── Vanity + admin-password — thin wrappers around the Python CLI
        # (src/onionpress/launcher_ops.py). Code lives there so the Mac
        # menubar can reuse it; bash just hands off.
        generate-vanity)
            # Generate a vanity onion address via mkp224o inside the tor
            # container. On success, prints the new address on stdout and
            # writes the key bundle to ~/.onionpress/shared/vanity-keys/.
            # The next container start picks the key up automatically.
            op_py generate-vanity
            ;;

        admin-password)
            # Read the recovery admin password (only used if the user has
            # lost the credentials they set up via the onboarding wizard).
            op_py admin-password
            ;;

        get)
            # Fetch a URL over Tor and print the body — for checking whether
            # a .onion is reachable. cmd_get in src/onionpress/cli.py runs
            # curl inside the tor container. "${@:2}" forwards the URL and
            # flags (-i, --max-time) verbatim.
            op_py get "${@:2}"
            ;;

        logs)
            cd "$DOCKER_DIR"
            docker compose logs -f
            ;;

        backup)
            # backup [-o|--output <path>]; the password comes from
            # read_backup_password. The old `backup <password> [output_path]`
            # still works.
            setup_db_passwords
            shift
            local backup_path=""
            local -a backup_pos=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    -o|--output)
                        backup_path="${2:-}"
                        shift
                        if [ $# -gt 0 ]; then shift; fi
                        ;;
                    *) backup_pos+=("$1"); shift ;;
                esac
            done
            if [ -n "${backup_pos[1]:-}" ]; then
                backup_path="${backup_pos[1]}"
            fi
            read_backup_password "${backup_pos[0]:-}"
            if [ -z "$BACKUP_PASS" ]; then
                echo "Usage: $0 backup [-o|--output <path>]"
                echo "Creates a password-protected backup of your OnionPress site."
                echo "The password is read from ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt."
                exit 1
            fi
            if [ -z "$backup_path" ]; then
                mkdir -p "$HOME/OnionPress/backups"
                backup_path="$HOME/OnionPress/backups/onionpress-$(date +%Y-%m-%d)-$$.zip"
            fi
            create_backup "$BACKUP_PASS" "$backup_path"
            echo "Backup saved to: $backup_path"
            ;;

        restore)
            # restore <backup_file.zip>; the password comes from
            # read_backup_password and goes on to Python in the environment.
            # The old `restore <password> <backup_file.zip>` still works.
            setup_db_passwords
            local restore_legacy_pass=""
            local restore_path="${2:-}"
            if [ -n "${3:-}" ]; then
                restore_legacy_pass="$2"
                restore_path="$3"
            fi
            if [ -z "$restore_path" ]; then
                echo "Usage: $0 restore <backup_file.zip>"
                echo "Restores from an OnionPress backup. Containers must be running."
                echo "The password is read from ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt."
                exit 1
            fi
            read_backup_password "$restore_legacy_pass"
            if [ -z "$BACKUP_PASS" ]; then
                echo "ERROR: Password is required." >&2
                exit 1
            fi
            # install-from-backup: the shared Python CLI tears the install down
            # and rebuilds it from the backup (seeded key + imported DB/content),
            # replacing the in-place overwrite + key-volume swap churn (no
            # .import-key-pending, no manual stop/start).
            # The exit status is the caller's only sign of a refused or
            # failed restore (the tray and the menubar check it).
            if ! ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" op_py restore "$restore_path"; then
                echo "ERROR: Restore failed — see $LOG_FILE" >&2
                exit 1
            fi
            echo "Done! OnionPress rebuilt from backup."
            ;;

        update)
            # `onionpress update [vX.Y.Z]`: the latest release, or that one.
            update_onionpress "${2:-}"
            ;;

        write-status)
            setup_db_passwords
            write_status
            ;;

        apply-config)
            setup_db_passwords
            apply_config_updates
            ;;

        onionheaven)
            # Opt in to / out of OnionHeaven. REGISTER_WITH_ONIONHEAVEN is
            # tri-state: yes / no / unset (undecided — the tray asks). The
            # heartbeat daemon re-reads the config every cycle, so this
            # takes effect without a restart.
            onionheaven_cmd "${2:-status}"
            ;;

        handle-action)
            # Process action requests from the WordPress settings page.
            # This runs as onionpress-watcher.service, a oneshot: whatever
            # must outlive it goes through run_detached.
            ONIONPRESS_IN_WATCHER=true
            local action
            action=$(wp_exec cat /var/lib/onionpress/requested-action 2>/dev/null || echo "")
            if [ -z "$action" ]; then
                # No action requested — just refresh logs (cheap)
                # Full status is written on-demand when the status page detects stale data
                write_recent_logs
                exit 0
            fi
            wp_exec rm -f /var/lib/onionpress/requested-action /var/lib/onionpress/service-result.json 2>/dev/null
            if [ "$action" != "refresh-status" ]; then
                log "Handling requested action: $action"
            fi
            case "$action" in
                start)
                    setup_db_passwords
                    apply_config_updates 2>/dev/null || true
                    echo start | wp_put /var/lib/onionpress/service-pending 2>/dev/null
                    start_containers
                    wait_for_services
                    write_status
                    local containers_info
                    containers_info=$(docker ps --filter "name=onionpress" --format '{{.Names}}: {{.Status}}' 2>/dev/null | sed 's/onionpress-//g' | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
                    echo '{"success":true,"action":"start","message":"Started '"$containers_info"'","completed_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                        wp_put /var/lib/onionpress/service-result.json \&\& wp_exec rm -f /var/lib/onionpress/service-pending 2>/dev/null
                    ;;
                restart)
                    setup_db_passwords
                    apply_config_updates 2>/dev/null || true
                    # Write pending marker to shared volume before stopping (survives container restart)
                    echo restart | wp_put /var/lib/onionpress/service-pending 2>/dev/null
                    local heartbeat_was_running=false
                    stop_heartbeat_client && heartbeat_was_running=true
                    stop_containers
                    start_containers
                    wait_for_services
                    write_status
                    if $heartbeat_was_running; then
                        start_heartbeat_client
                    fi
                    local containers_info
                    containers_info=$(docker ps --filter "name=onionpress" --format '{{.Names}}: {{.Status}}' 2>/dev/null | sed 's/onionpress-//g' | tr '\n' ', ' | sed 's/,$//' | sed 's/,/, /g')
                    echo '{"success":true,"action":"restart","message":"Restarted '"$containers_info"'","completed_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                        wp_put /var/lib/onionpress/service-result.json \&\& wp_exec rm -f /var/lib/onionpress/service-pending 2>/dev/null
                    ;;
                stop)
                    setup_db_passwords
                    stop_heartbeat_client || true
                    stop_containers
                    ;;
                check-reachability)
                    log "Running Tor reachability test..."
                    local onion_addr_test
                    onion_addr_test=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
                    if [ -z "$onion_addr_test" ]; then
                        echo '{"reachable":false,"error":"No onion address found","tested_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/reachability-result.json 2>/dev/null
                        log "Reachability test: no onion address"
                    else
                        local http_code
                        http_code=$(docker exec onionheaven curl -s -o /dev/null -w '%{http_code}' --max-time 60 --socks5-hostname 127.0.0.1:9050 "http://$onion_addr_test/" 2>/dev/null || echo "000")
                        local reachable=false
                        if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 500 ] 2>/dev/null; then
                            reachable=true
                        fi
                        echo '{"reachable":'"$reachable"',"http_code":'"$http_code"',"address":"'"$onion_addr_test"'","tested_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/reachability-result.json 2>/dev/null
                        log "Reachability test: $onion_addr_test -> HTTP $http_code (reachable=$reachable)"
                    fi
                    ;;
                generate-vanity)
                    log "Starting vanity address generation..."
                    setup_db_passwords
                    local vanity_prefix
                    vanity_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
                    vanity_prefix="${vanity_prefix:-op2}"
                    local vanity_result_file="/tmp/onionpress-vanity-result.json"
                    if ! command -v mkp224o >/dev/null 2>&1; then
                        echo '{"success":false,"error":"mkp224o is not installed. Install it with: sudo apt install -y gcc libsodium-dev autoconf && cd /tmp && git clone https://github.com/cathugger/mkp224o && cd mkp224o && ./autogen.sh && ./configure && make && sudo cp mkp224o /usr/local/bin/","generated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/vanity-result.json 2>/dev/null
                        log "Vanity generation failed: mkp224o not installed"
                    else
                        local vanity_output_dir
                        vanity_output_dir=$(mktemp -d)
                        log "Generating vanity address with prefix: $vanity_prefix (this may take a while)..."
                        if mkp224o -n 1 -d "$vanity_output_dir" "$vanity_prefix" >> "$LOG_FILE" 2>&1; then
                            local vanity_addr_dir
                            vanity_addr_dir=$(find "$vanity_output_dir" -maxdepth 1 -type d -name "*.onion" | head -1)
                            if [ -n "$vanity_addr_dir" ] && [ -f "$vanity_addr_dir/hs_ed25519_secret_key" ]; then
                                local vanity_address
                                vanity_address=$(basename "$vanity_addr_dir")
                                # Import the key using the existing import flow
                                local vanity_b32_key
                                vanity_b32_key=$(python3 -c "import base64, sys; print(base64.b32encode(open(sys.argv[1],'rb').read()).decode())" "$vanity_addr_dir/hs_ed25519_secret_key")
                                # Non-interactive import: skip confirmation, force replace
                                stop_containers 2>/dev/null || true
                                docker volume rm onionpress-onion-keys onionpress-arti-state >> "$LOG_FILE" 2>&1 || true
                                docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
                                rm -rf "$DATA_DIR/shared/vanity-keys/"
                                # Run import-key logic inline (without interactive prompt)
                                import_key_noninteractive "$vanity_b32_key"
                                start_containers
                                wait_for_services
                                write_status
                                echo '{"success":true,"address":"'"$vanity_address"'","generated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                    wp_put /var/lib/onionpress/vanity-result.json 2>/dev/null
                                log "Vanity address generated and imported: $vanity_address"
                            else
                                echo '{"success":false,"error":"mkp224o did not produce a key","generated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                    wp_put /var/lib/onionpress/vanity-result.json 2>/dev/null
                                log "Vanity generation failed: no key produced"
                            fi
                        else
                            echo '{"success":false,"error":"mkp224o failed","generated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                wp_put /var/lib/onionpress/vanity-result.json 2>/dev/null
                            log "Vanity generation failed: mkp224o error"
                        fi
                        rm -rf "$vanity_output_dir"
                    fi
                    ;;
                import-key-file)
                    log "Processing key file import from settings page..."
                    setup_db_passwords
                    local key_data
                    key_data=$(wp_exec cat /var/lib/onionpress/import-key-data 2>/dev/null || echo "")
                    wp_exec rm -f /var/lib/onionpress/import-key-data 2>/dev/null
                    if [ -z "$key_data" ]; then
                        echo '{"success":false,"error":"No key data found","imported_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/import-result.json 2>/dev/null
                        log "Key import failed: no key data"
                    else
                        stop_containers 2>/dev/null || true
                        docker volume rm onionpress-onion-keys onionpress-arti-state >> "$LOG_FILE" 2>&1 || true
                        docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
                        rm -rf "$DATA_DIR/shared/vanity-keys/"
                        if import_key_noninteractive "$key_data"; then
                            start_containers
                            wait_for_services
                            write_status
                            local new_addr
                            new_addr=$(find "$DATA_DIR/shared/vanity-keys" -name hostname -exec cat {} \; 2>/dev/null | head -1)
                            echo '{"success":true,"address":"'"$new_addr"'","imported_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                wp_put /var/lib/onionpress/import-result.json 2>/dev/null
                            log "Key imported successfully: $new_addr"
                        else
                            echo '{"success":false,"error":"Key import failed - invalid key data","imported_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                wp_put /var/lib/onionpress/import-result.json 2>/dev/null
                            start_containers
                            wait_for_services
                            write_status
                            log "Key import failed: invalid key data"
                        fi
                    fi
                    ;;
                create-backup)
                    log "Creating backup from settings page..."
                    setup_db_passwords
                    local bp_password
                    bp_password=$(wp_exec cat /var/lib/onionpress/backup-password 2>/dev/null || echo "")
                    wp_exec rm -f /var/lib/onionpress/backup-password 2>/dev/null
                    if [ -z "$bp_password" ]; then
                        echo '{"success":false,"error":"No password provided","created_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/backup-result.json 2>/dev/null
                        log "Backup failed: no password"
                    else
                        local bp_onion
                        bp_onion=$(docker exec onionpress-tor cat /var/lib/tor/hidden_service/wordpress/hostname 2>/dev/null | tr -d '\n\r ')
                        # Its first 8 characters name the file, only from a
                        # whole address (create_backup refuses any other).
                        if is_onion_address "$bp_onion"; then
                            bp_onion="${bp_onion:0:8}"
                        else
                            bp_onion="site"
                        fi
                        local bp_filename="OnionPress-${bp_onion}-$(date +%Y-%m-%d-%H-%M).zip"
                        # A folder of our own, not a guessable name in /tmp.
                        local bp_dir bp_path
                        bp_dir=$(mktemp -d -t onionpress-settings-backup-XXXXXX) || bp_dir=/nonexistent
                        bp_path="$bp_dir/$bp_filename"
                        if create_backup "$bp_password" "$bp_path" 2>>"$LOG_FILE"; then
                            # Hand the zip to the WordPress container for
                            # download, written as www-data (the page's own
                            # user). Not docker cp + chown as root: both
                            # follow a link www-data can plant at this
                            # predictable name, and the chown made any file
                            # in the container its own.
                            docker exec -i -u www-data onionpress-wordpress \
                                sh -c 'umask 077; cat > "$1"' sh "/var/lib/onionpress/$bp_filename" \
                                < "$bp_path" 2>>"$LOG_FILE"
                            rm -rf "$bp_dir"
                            echo '{"success":true,"filename":"'"$bp_filename"'","created_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                wp_put /var/lib/onionpress/backup-result.json 2>/dev/null
                            log "Backup created: $bp_filename"
                        else
                            rm -rf "$bp_dir"
                            echo '{"success":false,"error":"Backup failed — check logs","created_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                wp_put /var/lib/onionpress/backup-result.json 2>/dev/null
                            log "Backup failed"
                        fi
                    fi
                    ;;
                restore-backup)
                    log "Restoring from backup via settings page..."
                    setup_db_passwords
                    local rp_password
                    rp_password=$(wp_exec cat /var/lib/onionpress/restore-password 2>/dev/null || echo "")
                    wp_exec rm -f /var/lib/onionpress/restore-password 2>/dev/null
                    local rp_file="/var/lib/onionpress/restore-upload.zip"
                    # Copy the uploaded zip out of the container, into a
                    # folder of our own. docker cp copies a symbolic link as
                    # a link: one planted at restore-upload.zip (www-data
                    # can) would point at a host file, so the copy must be a
                    # regular file, not a link, before the restore reads it.
                    local rp_dir rp_local
                    rp_dir=$(mktemp -d -t onionpress-restore-upload-XXXXXX) || rp_dir=""
                    rp_local="$rp_dir/restore-upload.zip"
                    [ -n "$rp_dir" ] && docker cp "onionpress-wordpress:$rp_file" "$rp_local" 2>>"$LOG_FILE"
                    wp_exec rm -f "$rp_file" 2>/dev/null
                    if [ -z "$rp_password" ] || [ -z "$rp_dir" ] \
                            || { [ ! -e "$rp_local" ] && [ ! -L "$rp_local" ]; }; then
                        [ -n "$rp_dir" ] && rm -rf "$rp_dir"
                        write_restore_result false "Missing password or backup file"
                        log "Restore failed: missing password or file"
                    elif [ -L "$rp_local" ] || [ ! -f "$rp_local" ]; then
                        rm -rf "$rp_dir"
                        write_restore_result false "The uploaded backup is not a regular file"
                        log "Restore refused: the uploaded backup is not a regular file"
                    else
                        local rp_addr
                        if rp_addr=$(restore_backup "$rp_password" "$rp_local" 2>>"$LOG_FILE"); then
                            rm -rf "$rp_dir"
                            # restore_backup's stdout is its log lines, then
                            # the address (empty for a backup without a key).
                            local rp_nl=$'\n'
                            rp_addr="${rp_addr##*$rp_nl}"
                            is_onion_address "$rp_addr" || rp_addr=""
                            # Restart to pick up restored keys
                            stop_containers 2>/dev/null || true
                            start_containers
                            wait_for_services
                            write_status
                            write_restore_result true "$rp_addr"
                            log "Restore complete: $rp_addr"
                        else
                            rm -rf "$rp_dir"
                            write_restore_result false "Restore failed — wrong password or invalid backup"
                            log "Restore failed"
                        fi
                    fi
                    ;;
                refresh-status)
                    setup_db_passwords
                    write_status
                    ;;
                update)
                    log "Update requested from settings page..."
                    # Run the update command and capture result. The
                    # installer replaces $0 by rename, so this copy runs on.
                    local update_rc=0
                    "$0" update >> "$LOG_FILE" 2>&1 || update_rc=$?
                    if [ "$update_rc" -eq 0 ]; then
                        local updated_ver
                        updated_ver=$(tr -cd '0-9A-Za-z.-' < "$INSTALL_DIR/VERSION" 2>/dev/null || true)
                        echo '{"success":true,"version":"'"${updated_ver:-unknown}"'","updated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/update-result.json 2>/dev/null
                        log "Update complete: ${updated_ver:-unknown}"
                    elif [ "$update_rc" -eq 3 ]; then
                        echo '{"success":false,"error":"Updating needs administrator rights: run onionpress update in a terminal","updated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/update-result.json 2>/dev/null
                        log "Update not started: needs administrator rights"
                    else
                        echo '{"success":false,"error":"Update failed — check logs","updated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            wp_put /var/lib/onionpress/update-result.json 2>/dev/null
                        log "Update failed"
                    fi
                    ;;
                *)
                    log "Unknown action: $action"
                    ;;
            esac
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config, secrets.
            # After reset + start + setup, restore from backup to get data back.
            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo ""
                echo "  This will ERASE everything: WordPress, database, Tor state,"
                echo "  onion address keys, config, and secrets."
                echo ""
                echo "  To preserve your data, run 'onionpress backup' first."
                echo ""
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            log "Resetting OnionPress (full wipe)..."

            # Stop everything
            setup_db_passwords 2>/dev/null || true
            local heartbeat_was_running=false
            stop_heartbeat_client && heartbeat_was_running=true
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            log "Removing Docker volumes..."
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 && log "Removed volume: $vol" || log "WARNING: Failed to remove volume: $vol"
            done

            # Wipe data directory (keep directory structure)
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            rm -f "$DATA_DIR/onionheaven-registration.json"
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            log "Removed keys, config, secrets, and logs"

            echo ""
            echo "  Reset complete. Everything wiped. Starting fresh containers..."
            echo ""

            # Start fresh containers
            setup_db_passwords
            start_containers
            wait_for_services
            write_status

            # Clean OnionHeaven state in the shared persistent volume
            if docker ps --format '{{.Names}}' | grep -q '^onionheaven$'; then
                log "Resetting OnionHeaven..."
                reset_onionheaven_in_container >> "$LOG_FILE" || true
            fi

            # The wiped config leaves OnionHeaven undecided, so the client
            # registers nothing until the user opts in again.
            if $heartbeat_was_running; then
                start_heartbeat_client
            fi

            log "OnionPress reset and restarted"
            echo "  Containers running. Run 'onionpress setup' to initialize WordPress."
            ;;

        validate-oh-address)
            _validate_oh_address "$2"
            ;;

        scrub)
            # Full lifecycle test — backup, uninstall, install, restore,
            # verify. Ported from ~300 lines of bash to src/onionpress/
            # scrub.py for the phase orchestration + structured verify
            # checks. Heavy phases (create_backup, restore_backup, the
            # install.sh run) still go through bash subcommands; the
            # Python module is the orchestration glue, sudo keep-alive,
            # and verify checks.
            #
            # Args forwarded verbatim — "${@:2}" skips this case label
            # itself. Supports: `onionpress scrub [<wp-admin-password>]
            # [--clean]`.
            op_py scrub "${@:2}"
            ;;

        uninstall)
            echo ""
            echo "OnionPress Uninstaller"
            echo "======================"
            echo ""
            echo "CRITICAL WARNING"
            echo ""
            echo "Uninstalling will PERMANENTLY DELETE:"
            echo "  - Your onion address and private key"
            echo "  - All WordPress content and data"
            echo "  - Database and configuration"
            echo "  - Systemd services"
            echo "  - /opt/onionpress installation"
            echo ""
            echo "Your site CANNOT BE RECOVERED unless you have a backup."
            echo ""

            if [ "$ONIONPRESS_YES" != "true" ]; then
                # Offer backup first (like Mac version)
                read -r -p "Create a backup before uninstalling? [Y/n] " backup_choice
                if [ "$backup_choice" != "n" ] && [ "$backup_choice" != "N" ]; then
                    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q onionpress-wordpress; then
                        # Pre-validate the WP admin password BEFORE any
                        # destructive work. Without this, a typo'd password
                        # makes create_backup error out mid-script, leaving
                        # the user in a "Fix it or Ctrl-C" limbo. Three
                        # tries; abort cleanly on failure — install stays
                        # intact.
                        if ! prompt_and_validate_wp_password \
                                "WordPress admin password (for backup): "; then
                            echo "Cancelled — install untouched."
                            exit 1
                        fi
                        mkdir -p "$HOME/OnionPress/backups"
                        bp_path="$HOME/OnionPress/backups/OnionPress-backup-$(date +%Y-%m-%d-%H-%M).zip"
                        if create_backup "$PROMPTED_WP_PASS" "$bp_path"; then
                            echo "Backup saved to: $bp_path"
                            echo ""
                            echo "IMPORTANT: Copy this file somewhere safe before continuing!"
                            echo "  e.g.: scp $(whoami)@$(hostname -I 2>/dev/null | awk '{print $1}'):$bp_path ."
                            echo ""
                        else
                            # Password was already validated, so this is
                            # a different kind of failure (disk full,
                            # docker hiccup). Bail rather than risk an
                            # uninstall without a backup.
                            echo "Backup failed. Aborting uninstall — install untouched."
                            exit 1
                        fi
                    else
                        echo "Containers are not running — cannot create backup."
                        echo "Start OnionPress first, or skip backup."
                        echo ""
                        read -r -p "Continue without backup? [y/N] " skip_backup
                        if [ "$skip_backup" != "y" ] && [ "$skip_backup" != "Y" ]; then
                            echo "Cancelled."
                            exit 0
                        fi
                    fi
                fi
                # No separate "type DELETE" gate — the sudo password
                # prompt that comes next is the actual "are you sure"
                # moment. Mac's uninstall doesn't have a DELETE prompt
                # either.
            fi

            echo ""

            # Unregister from OnionHeaven before stopping (needs running containers)
            if docker ps --format '{{.Names}}' 2>/dev/null | grep -q onionpress-tor; then
                echo "Unregistering from OnionHeaven..."
                # Send offline signal via the tor container's API server
                docker exec onionpress-tor curl -s -X POST http://127.0.0.1:9077/unregister 2>/dev/null || true
            fi

            USER_SYSTEMD_DIR="$HOME/.config/systemd/user"
            AUTOSTART_DIR="$HOME/.config/autostart"
            APPS_DIR="$HOME/.local/share/applications"
            ICONS_DIR="$HOME/.local/share/icons"

            echo "Stopping user services..."
            # Current installs use user-level systemd; legacy installs used
            # system-level. Stop both — whichever doesn't exist is a no-op.
            systemctl --user stop onionpress-heartbeat 2>/dev/null || true
            systemctl --user stop onionpress-watcher.timer 2>/dev/null || true
            systemctl --user stop onionpress 2>/dev/null || true
            sudo systemctl stop onionpress-heartbeat 2>/dev/null || true
            sudo systemctl stop onionpress-watcher.timer 2>/dev/null || true
            sudo systemctl stop onionpress 2>/dev/null || true

            echo "Killing tray process..."
            # The tray runs in the user session, not via systemd — it has
            # to be killed explicitly or the icon stays until logout.
            pkill -u "$(whoami)" -f onionpress-tray 2>/dev/null || true
            # Also kill any orphaned systemd-inhibit / dbus-monitor children
            # left behind if the service was force-killed earlier.
            pkill -u "$(whoami)" -f "systemd-inhibit.*OnionPress" 2>/dev/null || true
            pkill -u "$(whoami)" -f "dbus-monitor.*PrepareForSleep" 2>/dev/null || true

            echo "Removing containers and volumes..."
            setup_db_passwords 2>/dev/null || true
            cd "$DOCKER_DIR" 2>/dev/null && docker compose down -v 2>/dev/null || true

            # `compose down -v` only removes volumes Compose created.
            # Volumes pre-created by the launcher via `docker volume
            # create` (onion-keys, tor-state, and the older arti-state and
            # tor-keys names) are treated as
            # external and skipped — leaving the onion private key
            # behind across a supposed "PERMANENTLY DELETE" uninstall.
            # Sweep all onionpress-* volumes by name filter.
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" 2>/dev/null || true
            done

            echo "Disabling user services..."
            systemctl --user disable onionpress 2>/dev/null || true
            systemctl --user disable onionpress-heartbeat 2>/dev/null || true
            systemctl --user disable onionpress-watcher.timer 2>/dev/null || true
            rm -f "$USER_SYSTEMD_DIR/onionpress.service" \
                  "$USER_SYSTEMD_DIR/onionpress-heartbeat.service" \
                  "$USER_SYSTEMD_DIR/onionpress-watcher.service" \
                  "$USER_SYSTEMD_DIR/onionpress-watcher.timer"
            systemctl --user daemon-reload 2>/dev/null || true

            echo "Disabling and removing legacy system services..."
            sudo systemctl disable onionpress 2>/dev/null || true
            sudo systemctl disable onionpress-heartbeat 2>/dev/null || true
            sudo systemctl disable onionpress-watcher.timer 2>/dev/null || true
            sudo rm -f /etc/systemd/system/onionpress.service \
                       /etc/systemd/system/onionpress-heartbeat.service \
                       /etc/systemd/system/onionpress-watcher.service \
                       /etc/systemd/system/onionpress-watcher.timer
            sudo systemctl daemon-reload

            echo "Removing /opt/onionpress..."
            sudo rm -rf /opt/onionpress

            echo "Removing /usr/local/bin symlinks..."
            sudo rm -f /usr/local/bin/onionpress /usr/local/bin/onionpress-tray

            echo "Removing per-user desktop entries, icons, and autostart..."
            rm -f "$AUTOSTART_DIR/onionpress-tray.desktop"
            rm -f "$APPS_DIR/onionpress.desktop" "$APPS_DIR/onionpress-tray.desktop"
            # Hicolor icons may live under several size dirs (512x512, scalable).
            find "$ICONS_DIR/hicolor" -type f -name 'onionpress*' \
                -delete 2>/dev/null || true
            # Refresh caches so the launcher / icon theme drop stale entries.
            command -v gtk-update-icon-cache >/dev/null 2>&1 && \
                gtk-update-icon-cache -t -f "$ICONS_DIR/hicolor" >/dev/null 2>&1 || true
            command -v update-desktop-database >/dev/null 2>&1 && \
                update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true

            echo "Removing data directory ($DATA_DIR)..."
            rm -rf "$DATA_DIR"

            echo ""
            echo "OnionPress has been uninstalled."
            if [ -n "${bp_path:-}" ] && [ -f "${bp_path:-}" ]; then
                echo ""
                echo "Your backup is at: $bp_path"
                echo "Use it to restore: onionpress restore $bp_path"
            fi
            ;;

        reset-onionheaven)
            # Clean stress test entries and refresh takeover workers with current code.
            # Preserves real entries and their keys.
            log "Resetting OnionHeaven (clean stress tests + refresh workers)..."

            if ! docker ps --format '{{.Names}}' | grep -q '^onionheaven$'; then
                echo "ERROR: onionheaven container is not running"
                exit 1
            fi

            result=$(reset_onionheaven_in_container) \
                || { echo "ERROR: OnionHeaven reset failed — see $LOG_FILE"; exit 1; }
            echo "$result" | python3 -m json.tool 2>/dev/null || echo "$result"
            log "OnionHeaven reset complete"
            ;;

        *)
            echo "Usage: $0 {start|stop|restart|status|address|get|setup|onionheaven|reset|reset-onionheaven|import-key|backup|restore|update|logs|scrub|write-status|apply-config|handle-action|validate-oh-address|uninstall}"
            exit 1
            ;;
    esac
}

main "$@"
