# OnionPress launcher script for Linux / Raspberry Pi
# This script manages the WordPress + Tor onion service containers
# See: https://github.com/brewsterkahle/onionpress

set -e

# An OnionHeaven hub's backup recovery key, when the app's Restore... (or the
# operator) passes one in the environment: taken out of it at once and handed
# only to the commands that use it (restore, hub-recovery-key), so that no
# other child of this script inherits it.
_HUB_RECOVERY_KEY="${ONIONPRESS_HUB_RECOVERY_KEY:-}"
unset ONIONPRESS_HUB_RECOVERY_KEY

# Determine install and data directories
INSTALL_DIR="${ONIONPRESS_INSTALL_DIR:-/opt/onionpress}"
DOCKER_DIR="$INSTALL_DIR/docker"
PLUGINS_DIR="$INSTALL_DIR/plugins"
THEMES_DIR="$INSTALL_DIR/themes"
SCRIPTS_DIR="$INSTALL_DIR/scripts"
DATA_DIR="$HOME/.onionpress"

# The value of KEY in ~/.onionpress/config (config_value KEY [default]),
# by config.read_value's rule (issue #404): a line is KEY's when, stripped,
# it starts with `KEY=`; the first such line wins; the value is everything
# after its first `=`, blanks around it trimmed. $2 (default empty) when
# no line names KEY. Always succeeds, so `x=$(config_value K)` is safe
# under `set -e`. Identical in the three launcher scripts
# (tests/test_config_one_reader.py).
config_value() {
    local line value
    line=$(grep -E "^[[:space:]]*$1=" "$DATA_DIR/config" 2>/dev/null | head -1)
    if [ -z "$line" ]; then
        printf '%s\n' "${2-}"
        return 0
    fi
    value=${line#*=}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    printf '%s\n' "$value"
}
DOCUMENTS_DIR="$HOME/OnionPress"

# Shared Python package (also used by the tray app and, eventually, the Mac
# menubar app). Lives at $INSTALL_DIR/lib/onionpress/ — install scripts
# copy src/onionpress/ there. Setting PYTHONPATH lets us run `python3 -m
# onionpress.cli` without a system-wide pip install.
ONIONPRESS_PYTHONPATH="${ONIONPRESS_PYTHONPATH:-$INSTALL_DIR/lib}"
# Every python3 this script runs is isolated (-I: no current directory
# or script directory on sys.path, no PYTHON* environment, no user site):
# `python3 -m` and `python3 -I -c` put the current directory first on
# sys.path, and WordPress can write one directory the owner may run
# `onionpress` from, My Creations (issue #470). -P and PYTHONSAFEPATH
# need Python 3.11, which the .deb does not require, so the package's
# path reaches the interpreter as an argument instead of PYTHONPATH (-E
# ignores it), -B keeps PYTHONDONTWRITEBYTECODE's effect, and PYTHONPATH
# stays in the environment for the Python the CLI itself starts.
op_py() {
    # Run a subcommand of the shared Python CLI. Self-contained (tests
    # extract this function alone).
    PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -I -B -c 'import sys, runpy
sys.path[:0] = sys.argv.pop(1).split(":")
runpy.run_module("onionpress.cli", run_name="__main__", alter_sys=True)' "$ONIONPRESS_PYTHONPATH" "$@"
}

# True only for a well-formed v3 onion address: 56 lowercase base32
# characters, then ".onion", and nothing else (no newline, no "/"). The
# rule of key_manager.is_valid_onion_address; a test keeps the two
# together. The letters are spelled out because a range like a-z can take
# in other characters in some locales.
is_onion_address() {
    [[ "$1" =~ ^[abcdefghijklmnopqrstuvwxyz234567]{56}\.onion$ ]]
}

# The imported or generated key's directory under vanity-keys/: the first
# one whose name is a whole onion address (is_onion_address), not merely
# "*.onion". Its name is taken for the address and the directory is
# bind-mounted into a container. Prints nothing and fails if there is none.
vanity_key_dir() {
    local d
    for d in "$DATA_DIR/shared/vanity-keys"/*.onion; do
        if [ -d "$d" ] && [ ! -L "$d" ] && is_onion_address "$(basename "$d")"; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Hand a file to the WordPress container, written as www-data: stdin goes to
# $1, mode ${2:-600} once in place (a temporary file beside it, renamed
# over it). Never as root: www-data owns /var/lib/onionpress and the web
# root, and root's `cat >` or docker cp followed a link planted at the name
# to any file in the container. The script is
# onionpress.wp_files.PUT_FILE_SCRIPT; a test keeps the copies equal.
wp_put() {
    docker exec -i -u www-data onionpress-wordpress \
        sh -c 't=$(mktemp "$1.XXXXXX") || exit 1; if cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"; then exit 0; fi; rm -f "$t"; exit 1' \
        sh "$1" "${2:-600}"
}

# Run a command in the WordPress container as www-data: what the launcher
# reads from or removes in www-data's folders (a root `cat` would follow a
# planted link to a file only root may read).
wp_exec() {
    docker exec -u www-data onionpress-wordpress "$@"
}

# Run wp-cli in the WordPress container as www-data: wp_cli <args...>, and
# wp_cli_in for what wp-cli reads from stdin (docker exec -i). wp-cli loads
# WordPress (wp-config.php, mu-plugins, plugins, themes), every file of it
# www-data's to write, so run as root a plugin bug became root in the
# container. No --allow-root: wp-cli refuses to run as root. The command is
# onionpress.wp_files.wp_cli_args; a test keeps the copies equal.
wp_cli() {
    docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp "$@"
}

# Per-user lock file to prevent double-starting
PIDFILE="$DATA_DIR/onionpress.pid"

# Ensure data dir exists, this user's alone (issue #397: config holds the
# Cloudflare token). 0700 on every start, so an install made under a
# looser umask is fixed too.
mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"

# Ensure subtree exists for compose bind-mounts.
mkdir -p "$DOCUMENTS_DIR/backups"
mkdir -p "$DOCUMENTS_DIR/Creations/My Creations"
# docker-compose.yml bind-mounts ${ONIONPRESS_DOCUMENTS_DIR}/Creations; without
# this export it fell back to /tmp/onionpress-no-docs and ~/OnionPress/Creations
# was never served on Linux (the macOS launcher has always exported it).
export ONIONPRESS_DOCUMENTS_DIR="$DOCUMENTS_DIR"
mkdir -p "$DOCUMENTS_DIR/Social Archives"
touch "$DOCUMENTS_DIR/Social Archives/.onionpress-activated"

# Log file with rotation (keep 3 x 5MB files)
LOG_FILE="$DATA_DIR/onionpress.log"
LOG_MAX_SIZE=$((5 * 1024 * 1024))  # 5 MB
LOG_KEEP=3

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$size" -ge "$LOG_MAX_SIZE" ]; then
        # Rotate: .log.3 → delete, .log.2 → .log.3, .log.1 → .log.2, .log → .log.1
        local i=$LOG_KEEP
        while [ $i -gt 1 ]; do
            local prev=$((i - 1))
            [ -f "${LOG_FILE}.$prev" ] && mv -f "${LOG_FILE}.$prev" "${LOG_FILE}.$i"
            i=$((i - 1))
        done
        mv -f "$LOG_FILE" "${LOG_FILE}.1"
        : > "$LOG_FILE"
    fi
}
rotate_log

# Read version
ONIONPRESS_VERSION="unknown"
if [ -f "$INSTALL_DIR/VERSION" ]; then
    ONIONPRESS_VERSION=$(cat "$INSTALL_DIR/VERSION")
fi
export ONIONPRESS_VERSION

# Timezone detection (Linux)
export TZ="$(cat /etc/timezone 2>/dev/null || echo UTC)"
export PYTHONDONTWRITEBYTECODE=1

# The environment every verb runs with (issue #405): the ports and the
# paths, resolved once by the Python at the top of main() and exported
# here and nowhere else. `onionpress launcher-env` answers KEY=VALUE per
# line: ONIONPRESS_PORT_OFFSET and the three port variables compose and
# every start step read (onionpress.ports.resolve_at_start: a preset
# ONIONPRESS_PORT_OFFSET, the daemon's or the tray's, as it is; else the
# previous instance's port waited for, the running stack's published
# port, else the bind probe), DOCKER_DIR (platform.resolve_paths: the
# install tree's compose folder, a checkout's), and the Docker daemon the
# rest of OnionPress uses: DOCKER_HOST (a preset one kept, else the
# user's rootless socket when it exists, else the system one: the
# daemon's rule, issue #503) and DOCKER_SOCK, its path, for the compose
# file's socket mounts. Its log lines go to the log file only: stdout is
# what the tray reads. When the Python does not answer (a broken install)
# the launcher keeps going on the preset offset or 0, so `stop` still
# brings the containers down.
launcher_environment() {
    local answer key value
    answer=$(op_py --data-dir "$DATA_DIR" launcher-env 2>>"$LOG_FILE") || answer=""
    while IFS='=' read -r key value; do
        case "$key" in
            ONIONPRESS_PORT_OFFSET|ONIONPRESS_WP_PORT|ONIONPRESS_SOCKS_PORT|ONIONPRESS_PROXY_PORT)
                [[ "$value" =~ ^[0123456789]{1,5}$ ]] && export "$key=$value" ;;
            DOCKER_DIR)
                [ -n "$value" ] && [ -d "$value" ] && DOCKER_DIR="$value" ;;
            DOCKER_HOST|DOCKER_SOCK)
                [ -n "$value" ] && export "$key=$value" ;;
        esac
    done <<< "$answer"
    if ! [[ "${ONIONPRESS_WP_PORT:-}" =~ ^[0123456789]{1,5}$ ]]; then
        [[ "${ONIONPRESS_PORT_OFFSET:-}" =~ ^[0123456789]{1,5}$ ]] || ONIONPRESS_PORT_OFFSET=0
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: the ports could not be resolved (onionpress launcher-env gave no answer): using offset $ONIONPRESS_PORT_OFFSET" >> "$LOG_FILE"
        export ONIONPRESS_PORT_OFFSET
        export ONIONPRESS_WP_PORT=$((8080 + ONIONPRESS_PORT_OFFSET))
        export ONIONPRESS_SOCKS_PORT=$((9050 + ONIONPRESS_PORT_OFFSET))
        export ONIONPRESS_PROXY_PORT=$((9077 + ONIONPRESS_PORT_OFFSET))
    fi
}

# Bind host for WordPress's published port. Only WordPress: Tor's SOCKS
# port is fixed to 127.0.0.1 in the compose file. Linux is typically
# headless (a Pi set up from a phone or laptop on the LAN), so WordPress
# listens on all interfaces by default. ONIONPRESS_BIND_HOST=127.0.0.1 in
# ~/.onionpress/config keeps it on this machine; the environment wins over
# the config. Mac (Colima) doesn't run this launcher and gets 127.0.0.1
# from the compose file. Anything but an IPv4 address would fail `docker
# compose up` and take the site down, so it falls back to 127.0.0.1, the
# narrower choice, with a warning.
if [ -z "${ONIONPRESS_BIND_HOST:-}" ] && [ -f "$DATA_DIR/config" ]; then
    ONIONPRESS_BIND_HOST=$(config_value ONIONPRESS_BIND_HOST | tr -d "[:space:]\"'")
fi
case "${ONIONPRESS_BIND_HOST:-}" in
    "") ONIONPRESS_BIND_HOST=0.0.0.0 ;;
    localhost) ONIONPRESS_BIND_HOST=127.0.0.1 ;;
esac
if ! [[ "$ONIONPRESS_BIND_HOST" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: ONIONPRESS_BIND_HOST=$ONIONPRESS_BIND_HOST is not an IPv4 address; using 127.0.0.1" \
        | tee -a "$LOG_FILE" >&2
    ONIONPRESS_BIND_HOST=127.0.0.1
fi
export ONIONPRESS_BIND_HOST

# Only the OnionHeaven hub accepts registrations: the canonical hub address,
# or ONIONHEAVEN_ACCEPT_REGISTRATIONS=yes in the config (read below). The API
# server runs inside the tor container on every node (~15MB overhead) and
# refuses registrations elsewhere; the onionheaven container runs on every
# node too, but its heartbeat monitor stays idle off the hub. On the hub,
# takeover workers spawn on demand when a registered site goes offline.
# ONIONHEAVEN_HUB=1 enables 10 intro points (auto-detected).
# OnionHome analytics directory (bind-mounted into tor container)
export ONIONPRESS_SHARED_DIR="$DATA_DIR/shared"
mkdir -p "$ONIONPRESS_SHARED_DIR/analytics"

export ONIONHEAVEN="1"
export ONIONHEAVEN_HUB="${ONIONHEAVEN_HUB:-0}"
# The hub's takeover tunables (the Settings page writes them; compose hands
# ONIONHEAVEN_PROPAGATION_DELAY to tor and onionheaven as
# TOR_PROPAGATION_DELAY, ONIONHEAVEN_MAX_SERVICES to onionheaven and
# onionheaven-farm). Kept in step with app/MacOS/onionpress and
# onionpress.containers (issue #353).
export ONIONHEAVEN_MAX_SERVICES="${ONIONHEAVEN_MAX_SERVICES:-50}"
export ONIONHEAVEN_PROPAGATION_DELAY="${ONIONHEAVEN_PROPAGATION_DELAY:-180}"

# Locally built container images (development).
#
# build/build-images.sh builds the tor and wordpress images from this repo and
# prints these two exports. Setting either here, or in ~/.onionpress/config,
# repoints the whole stack: compose's tor/wordpress/onionheaven services, the
# image pulls below, and vanity-key generation. See docs/BUILDING.md.
for _img_var in ONIONPRESS_TOR_IMAGE ONIONPRESS_WORDPRESS_IMAGE; do
    if [ -z "$(eval echo \"\$$_img_var\")" ] && [ -f "$DATA_DIR/config" ]; then
        _img_val=$(config_value "$_img_var")
        if [ -n "$_img_val" ]; then
            eval "export ${_img_var}=\"\$_img_val\""
        fi
    fi
done
unset _img_var _img_val

# True when the stack points at images built on this machine rather than
# published ones. Every pull below is gated on it: without the gate they
# overwrite a local tag with the registry's copy, so a developer would build
# an image, start the app, and silently test someone else's build. The rule
# itself (a reference not on ghcr.io, from the environment or
# ~/.onionpress/config) is onionpress.containers.using_local_images, asked
# through the CLI (Phase 4, #120).
using_local_images() {
    op_py --data-dir "$DATA_DIR" using-local-images
}

# Whether the address given is the OnionHeaven hub's (issue #345): the Mac
# daemon's rule, onionheaven.is_onionheaven_instance. Every node runs an
# onionheaven container (its heartbeat monitor idles off the hub), so a
# running one says nothing about the node's mode.
is_onionheaven_hub() {
    op_py --data-dir "$DATA_DIR" is-onionheaven-hub "$1"
}

# The image every one-shot helper that handles the onion service key runs
# from (the key volume migration, the key seeds, the backup's key reads):
# the stack's own tor image, pinned by digest like the rest, or the locally
# built one. Never a floating tag such as `alpine`, which a registry or a
# mirror could swap for an image that reads the key. Each run overrides the
# entrypoint and joins no network (tests/test_container_capabilities.py).
KEY_HELPER_IMAGE="${ONIONPRESS_TOR_IMAGE:-ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:c309c64ac057c83b74a77921f5fc39f0f41bd63e386825a584eb43aef7ed1fe3}"

# Make sure KEY_HELPER_IMAGE is here before a helper runs from it: the key
# volume migration and the first-run seed come before any pull. A missing
# image is pulled by its pinned reference, never when the stack runs locally
# built images. Returns 1 when it is not here and cannot be. Linux only:
# create_backup's key read runs the helper; the Python start steps use
# containers.ensure_key_helper_image.
ensure_key_helper_image() {
    if docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1; then
        return 0
    fi
    if using_local_images; then
        log "ERROR: the locally built tor image $KEY_HELPER_IMAGE is not here (build it with build/build-images.sh)"
        return 1
    fi
    log "Pulling $KEY_HELPER_IMAGE for the onion service key helpers..."
    if ! docker pull "$KEY_HELPER_IMAGE" >> "$LOG_FILE" 2>&1; then
        log "ERROR: could not pull $KEY_HELPER_IMAGE"
        return 1
    fi
    docker image inspect --format '{{.Id}}' "$KEY_HELPER_IMAGE" >/dev/null 2>&1
}

# Create default config if it doesn't exist (0600, issue #397: it may hold
# CLOUDFLARE_TUNNEL_TOKEN).
if [ ! -f "$DATA_DIR/config" ]; then
    cat > "$DATA_DIR/config" <<EOF
ADDRESS_PREFIX=op2
INSTALL_IA_PLUGIN=yes
START_ON_BOOT=yes
# OnionHeaven is on by default: yes (or unset) = on, no = off.
# Turn off with: onionpress onionheaven disable
REGISTER_WITH_ONIONHEAVEN=yes
ONIONHEAVEN_ADDRESS=oheavenfhbohpdjijmxo3xgvvuo6eleyhhorbompoycle6x5eajlp7qd.onion
# WordPress's local web port (normally 8080) is open to other devices on
# your network, so a headless machine can be set up from a phone or laptop.
# Uncomment to keep it on this machine only. Tor's SOCKS port is always
# this machine only.
#ONIONPRESS_BIND_HOST=127.0.0.1
EOF
    chmod 600 "$DATA_DIR/config"
fi

# Read settings from config (override defaults)
if [ -f "$DATA_DIR/config" ]; then
    _val=$(config_value ONIONHEAVEN_MAX_SERVICES)
    [ -n "$_val" ] && export ONIONHEAVEN_MAX_SERVICES="$_val"
    _val=$(config_value ONIONHEAVEN_PROPAGATION_DELAY)
    [ -n "$_val" ] && export ONIONHEAVEN_PROPAGATION_DELAY="$_val"
fi

# Cloudflare Tunnel token (empty = no tunnel), read as the Mac launcher reads
# it: everything after the first `=`, since a token can end in `=` padding
# (#323). It reaches cloudflared only through compose's environment; never
# log it. docker-compose.cloudflare.yml adds the cloudflared service, so the
# calls that pull it take CF_COMPOSE (that file only with a token), the ones
# that stop or remove take COMPOSE_WITH_CF, so a tunnel whose token was just
# removed still goes down with the rest (#352), and start_cloudflare_tunnel
# names both files itself.
# The Settings page's Restart applies the page's changes (handle-action
# runs `apply-config`, then `restart`: this process reads the config
# fresh).
COMPOSE_WITH_CF=(-f docker-compose.yml -f docker-compose.cloudflare.yml)
read_cloudflare_token() {
    CLOUDFLARE_TUNNEL_TOKEN=""
    if [ -f "$DATA_DIR/config" ]; then
        CLOUDFLARE_TUNNEL_TOKEN=$(config_value CLOUDFLARE_TUNNEL_TOKEN)
    fi
    export CLOUDFLARE_TUNNEL_TOKEN
    if [ -n "$CLOUDFLARE_TUNNEL_TOKEN" ]; then
        CF_COMPOSE=("${COMPOSE_WITH_CF[@]}")
    else
        CF_COMPOSE=()
    fi
}
read_cloudflare_token

# Run as an OnionHeaven hub (config-file-only; only an exact "yes" counts,
# checked in the containers). Kept in step with app/MacOS/onionpress and
# onionpress.containers: compose hands it to tor and onionheaven.
ONIONHEAVEN_ACCEPT_REGISTRATIONS=""
if [ -f "$DATA_DIR/config" ]; then
    ONIONHEAVEN_ACCEPT_REGISTRATIONS=$(config_value ONIONHEAVEN_ACCEPT_REGISTRATIONS)
fi
export ONIONHEAVEN_ACCEPT_REGISTRATIONS

# ─── Parse global flags ────────────────────────────────────────────
# --yes / -y skips interactive confirmations (for scripted/automated use).
# Honour ONIONPRESS_YES inherited from the environment so callers like
# scrub's phase_uninstall (which exports it) can suppress prompts.
ONIONPRESS_YES=${ONIONPRESS_YES:-false}
_filtered_args=()
for _arg in "$@"; do
    case "$_arg" in
        --yes|-y) ONIONPRESS_YES=true ;;
        *) _filtered_args+=("$_arg") ;;
    esac
done
set -- "${_filtered_args[@]}"

# ─── Helper functions ───────────────────────────────────────────────

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Host part of the WordPress URLs we print. On every interface that's the
# LAN address; on loopback a LAN URL would not open, so it's localhost.
wp_access_host() {
    case "$ONIONPRESS_BIND_HOST" in
        0.0.0.0) hostname -I 2>/dev/null | awk '{print $1}' | grep . || echo localhost ;;
        127.*) echo localhost ;;
        *) echo "$ONIONPRESS_BIND_HOST" ;;
    esac
}

# Where WordPress answers now: the configured host once a start has seen it
# installed, else this machine only (the port is on 127.0.0.1 until then,
# issue #464; a LAN URL before setup pointed nowhere, issue #507).
wp_access_url() {
    if [ -f "$DATA_DIR/$WP_INSTALLED_MARKER" ]; then
        echo "http://$(wp_access_host):${ONIONPRESS_WP_PORT}"
    else
        echo "http://localhost:${ONIONPRESS_WP_PORT}"
    fi
}

# The address line of a start: the address the tor container serves
# (`onionpress address`), or what to do for one.
onion_address_line() {
    local addr
    addr=$(op_py --data-dir "$DATA_DIR" address 2>/dev/null) || addr=""
    echo "Onion address: ${addr:-none yet (set up the site: onionpress setup)}"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if WordPress core is installed (setup wizard completed)
wp_is_installed() {
    wp_cli core is-installed >/dev/null 2>&1
}

# ─── WordPress's installer is nobody's but the owner's (issue #464) ───
#
# Until WordPress is installed, wp-admin/install.php takes the first
# visitor's choice of admin account. The .deb starts the units at once and
# a headless install may wait days for `onionpress setup`, so until then:
#
# - WordPress's published port binds 127.0.0.1, whatever ONIONPRESS_BIND_HOST
#   says. Whether WordPress is installed is only known once the container
#   answers, so the start binds by the last start's verdict (the
#   .wordpress-installed marker, written when `wp core is-installed` said
#   yes, removed when it said no) and moves the port once the verdict is
#   in (bind_wordpress_port_for_install_state: a recreate of the one
#   container, once per install, right after setup).
# - The daemon (onionpress.daemon, the onionpress-daemon.service user
#   unit) registers the address with the OnionHeaven hub only once it has
#   seen WordPress installed (Daemon.hub_registration_allowed; until #407 a
#   runtime mask of the heartbeat client's unit, held here).
# - The image denies install.php and setup-config.php to every source but
#   the owner's (loopback and the network's gateway), so Tor visitors never
#   see them (onionpress-install-page.conf in the WordPress image).
# A setup that finds WordPress installed adopts it only when OnionPress
# installed it (setup_logic's .wordpress-installed-by-onionpress marker).
WP_INSTALLED_MARKER=".wordpress-installed"
WP_INSTALLED_BY_ONIONPRESS_MARKER=".wordpress-installed-by-onionpress"

# The bind host for this start's `compose up`: the configured one once a
# start has seen WordPress installed, else 127.0.0.1.
wordpress_bind_host_for_start() {
    if [ -f "$DATA_DIR/$WP_INSTALLED_MARKER" ]; then
        echo "$ONIONPRESS_BIND_HOST"
    else
        echo 127.0.0.1
    fi
}

# The host part of onionpress-wordpress's published port as Docker maps
# it now ('' when the container is not up).
wordpress_port_bind_host() {
    docker port onionpress-wordpress 80/tcp 2>/dev/null | head -1 | cut -d: -f1 | tr -d '[:space:]'
}

# Record the verdict and move WordPress's published port to the bind host
# it calls for, when it is somewhere else. $1: true when WordPress is
# installed.
bind_wordpress_port_for_install_state() {
    local installed="$1" wanted current
    if [ "$installed" = true ]; then
        touch "$DATA_DIR/$WP_INSTALLED_MARKER"
        wanted="$ONIONPRESS_BIND_HOST"
    else
        rm -f "${DATA_DIR:?}/${WP_INSTALLED_MARKER:?}"
        wanted=127.0.0.1
    fi
    current=$(wordpress_port_bind_host)
    [ -n "$current" ] || return 0
    [ "$current" != "$wanted" ] || return 0
    if [ "$installed" = true ]; then
        log "WordPress is installed: moving its port $ONIONPRESS_WP_PORT from $current to $wanted (ONIONPRESS_BIND_HOST)"
    else
        log "WordPress is not installed: keeping its port $ONIONPRESS_WP_PORT on 127.0.0.1 (was $current) until setup runs"
    fi
    ONIONPRESS_BIND_HOST="$wanted" docker compose up -d wordpress >> "$LOG_FILE" 2>&1 \
        || log "WARNING: could not move WordPress's port to $wanted (see $LOG_FILE)"
}

# What every setup path ends with once WordPress is installed: the port
# where the config says (the daemon sees the install on its next pass and
# opens its hub gate itself).
after_wordpress_installed() {
    bind_wordpress_port_for_install_state true
}



# Backup passwords are handed over in ONIONPRESS_BACKUP_PASSWORD, never on a
# command line: other local users can read any process's argv (ps,
# /proc/<pid>/cmdline) but not its environment. Sets BACKUP_PASS from the
# first of: the variable, a line on stdin, a no-echo prompt. A password
# given as an argument ($1: the old positional form of backup, restore,
# scrub and `setup --from-backup`) is refused, exit 2 (issue #504: a leaked
# child kept one in ps until reboot). Unsets the variable so the commands
# this script runs don't inherit it; pass it on as
# ONIONPRESS_BACKUP_PASSWORD="$BACKUP_PASS" cmd.
# Identical in app/MacOS/onionpress and linux/onionpress (test-enforced).
read_backup_password() {
    BACKUP_PASS="${ONIONPRESS_BACKUP_PASSWORD:-}"
    unset ONIONPRESS_BACKUP_PASSWORD
    if [ -n "${1:-}" ]; then
        echo "ERROR: a password on the command line is visible to other users of this computer, so it is refused. Leave it out to be prompted, or set ONIONPRESS_BACKUP_PASSWORD." >&2
        exit 2
    fi
    if [ -z "$BACKUP_PASS" ]; then
        if [ -t 0 ]; then
            read -r -s -p "Backup password: " BACKUP_PASS || true
            echo "" >&2
        else
            IFS= read -r BACKUP_PASS || true
        fi
    fi
}

# `onionpress setup` (setup_logic.setup_from_terminal, #442.11) with this
# launcher's arguments, the passwords moved off the command line into the
# environment the CLI reads (and drops) them from: `--pass`,
# `--ia-password` and `--from-backup`'s password. Its status says what is
# left for the launcher: 0 done, 2 already installed, 10 restart the stack
# (a backup's setup), anything else failed.
run_setup() {
    local args=() setup_pass="" ia_pass="" backup_pass=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --pass) setup_pass="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
            --ia-password) ia_pass="${2:-}"; shift; [ $# -eq 0 ] || shift ;;
            --from-backup)
                # `--from-backup <zip>`: the password as backup and restore
                # take it (ONIONPRESS_BACKUP_PASSWORD, stdin, a prompt). The
                # old `--from-backup <password> <zip>` is refused by
                # read_backup_password (never taken for a zip path).
                # The setup is then the restore (issue #509), so a hub's
                # recovery key goes along as the restore case passes it.
                if [ $# -ge 3 ] && [ "${3#-}" = "$3" ]; then
                    read_backup_password "${2:-}"
                    args+=(--from-backup "$3")
                    shift 3
                else
                    read_backup_password ""
                    args+=(--from-backup "${2:-}")
                    shift; [ $# -eq 0 ] || shift
                fi
                backup_pass="$BACKUP_PASS" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    ONIONPRESS_SETUP_PASSWORD="$setup_pass" ONIONPRESS_IA_PASSWORD="$ia_pass" \
        ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" ONIONPRESS_BACKUP_PASSWORD="$backup_pass" \
        op_py --data-dir "$DATA_DIR" setup --launcher "$INSTALL_DIR/onionpress" "${args[@]}"
}

