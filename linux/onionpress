#!/bin/bash

# OnionPress launcher script for Linux / Raspberry Pi
# This script manages the WordPress + Tor onion service containers
# See: https://github.com/brewsterkahle/onionpress

set -e

# Determine install and data directories
INSTALL_DIR="${ONIONPRESS_INSTALL_DIR:-/opt/onionpress}"
DOCKER_DIR="$INSTALL_DIR/docker"
PLUGINS_DIR="$INSTALL_DIR/plugins"
THEMES_DIR="$INSTALL_DIR/themes"
SCRIPTS_DIR="$INSTALL_DIR/scripts"
DATA_DIR="$HOME/.onionpress"
DOCUMENTS_DIR="$HOME/OnionPress"

# Shared Python package (also used by the tray app and, eventually, the Mac
# menubar app). Lives at $INSTALL_DIR/lib/onionpress/ — install scripts
# copy src/onionpress/ there. Setting PYTHONPATH lets us run `python3 -m
# onionpress.cli` without a system-wide pip install.
ONIONPRESS_PYTHONPATH="${ONIONPRESS_PYTHONPATH:-$INSTALL_DIR/lib}"
op_py() {
    # Run a subcommand of the shared Python CLI.
    PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -m onionpress.cli "$@"
}

# Per-user lock file to prevent double-starting
PIDFILE="$DATA_DIR/onionpress.pid"

# Ensure data dir exists
mkdir -p "$DATA_DIR"

# One-time host-side migration: ~/Documents/onionpress (Linux default)
# or ~/Documents/OnionPress (cross-platform) → ~/OnionPress. Walks the
# source tree recursively so empty subdirs in the destination (from a
# previous launcher pass) don't block the mv. Issue #239.
#
# REMOVE-AFTER 2026-08-01: by then every active install will have
# migrated. Delete this block and _op_migrate_tree.
_op_migrate_tree() {
    local src="$1" dst="$2"
    [ -d "$src" ] || return 0
    mkdir -p "$dst"
    shopt -s dotglob nullglob 2>/dev/null || true
    local entry base target
    for entry in "$src"/*; do
        [ -e "$entry" ] || continue
        base=$(basename "$entry")
        target="$dst/$base"
        if [ -d "$entry" ] && [ -d "$target" ]; then
            _op_migrate_tree "$entry" "$target"
            rmdir "$entry" 2>/dev/null || true
        else
            mv -n "$entry" "$target" 2>/dev/null || true
        fi
    done
}

if ! grep -qE '^PATH_MIGRATION_2026_05=done$' "$DATA_DIR/config" 2>/dev/null; then
    _migration_residual=0
    _migration_did_work=0
    for OLD in "$HOME/Documents/onionpress" "$HOME/Documents/OnionPress"; do
        [ -d "$OLD" ] || continue
        _migration_did_work=1
        rm -f "$OLD/MOVED.txt" 2>/dev/null || true
        _op_migrate_tree "$OLD" "$DOCUMENTS_DIR"
        rmdir "$OLD" 2>/dev/null || true
        if [ -d "$OLD" ]; then
            _migration_residual=1
            echo "OnionPress content moved to $DOCUMENTS_DIR" \
                > "$OLD/MOVED.txt" 2>/dev/null || true
        fi
    done
    if [ "$_migration_did_work" = "0" ]; then
        mkdir -p "$DOCUMENTS_DIR"
    fi
    if [ "$_migration_residual" = "0" ]; then
        printf 'PATH_MIGRATION_2026_05=done\n' >> "$DATA_DIR/config" 2>/dev/null || true
    fi
fi

# Ensure subtree exists for compose bind-mounts.
mkdir -p "$DOCUMENTS_DIR/backups"
mkdir -p "$DOCUMENTS_DIR/Creations/My Creations"
mkdir -p "$DOCUMENTS_DIR/Social Archives"
touch "$DOCUMENTS_DIR/Social Archives/.onionpress-activated"

# Log file with rotation (keep 3 x 5MB files)
LOG_FILE="$DATA_DIR/onionpress.log"
LOG_MAX_SIZE=$((5 * 1024 * 1024))  # 5 MB
LOG_KEEP=3

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$size" -ge "$LOG_MAX_SIZE" ]; then
        # Rotate: .log.3 → delete, .log.2 → .log.3, .log.1 → .log.2, .log → .log.1
        local i=$LOG_KEEP
        while [ $i -gt 1 ]; do
            local prev=$((i - 1))
            [ -f "${LOG_FILE}.$prev" ] && mv -f "${LOG_FILE}.$prev" "${LOG_FILE}.$i"
            i=$((i - 1))
        done
        mv -f "$LOG_FILE" "${LOG_FILE}.1"
        : > "$LOG_FILE"
    fi
}
rotate_log

# Read version
ONIONPRESS_VERSION="unknown"
if [ -f "$INSTALL_DIR/VERSION" ]; then
    ONIONPRESS_VERSION=$(cat "$INSTALL_DIR/VERSION")
fi
export ONIONPRESS_VERSION

# Timezone detection (Linux)
export TZ="$(cat /etc/timezone 2>/dev/null || echo UTC)"
export PYTHONDONTWRITEBYTECODE=1

# Rootless Docker: point CLI and compose at the user's rootless daemon socket
_rootless_sock="/run/user/$(id -u)/docker.sock"
if [ -S "$_rootless_sock" ]; then
    export DOCKER_HOST="unix://$_rootless_sock"
    export DOCKER_SOCK="$_rootless_sock"
fi

# Port-offset detection. Mirrors app/MacOS/onionpress's detect_port_offset
# (Mac multi-user). Probes all three host-exposed ports — WP 8080, SOCKS
# 9050, proxy 9077 — and bumps the offset by 10000 if any is in use. The
# common Linux collision is a system tor on 9050 (apt-installed by
# torbrowser-launcher); offset 10000 publishes OnionPress SOCKS on 19050
# instead. The container internally still listens on 9050, so the onion
# service is unaffected. Uses real socket bind (not lsof) so it sees
# ports owned by other users / system services.
detect_port_offset() {
    local offset=0
    while true; do
        local wp=$((8080 + offset))
        local socks=$((9050 + offset))
        local proxy=$((9077 + offset))
        if [ $proxy -gt 65535 ]; then
            offset=0
            break
        fi
        if python3 -c '
import socket, sys
for p in sys.argv[1:]:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("127.0.0.1", int(p)))
    except OSError:
        sys.exit(1)
    finally:
        s.close()
' "$wp" "$socks" "$proxy" 2>/dev/null; then
            break
        fi
        offset=$((offset + 10000))
    done
    echo "$offset"
}

if [ -z "$ONIONPRESS_PORT_OFFSET" ]; then
    # If the service is already running, read its offset from status.json
    # rather than re-detecting via socket bind. The bind test returns 0
    # when nothing currently holds port 8080 (e.g. between restarts or
    # when another user's containers hold it but the bind test runs as a
    # different uid), causing standalone commands like `onionpress setup`
    # to target the wrong port.
    _status_json="$DATA_DIR/status.json"
    if [ -f "$_status_json" ] && command -v python3 >/dev/null 2>&1; then
        _running_wp_port=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    p = int(d.get('wp_port', 0))
    if p > 0:
        print(p - 8080)
except Exception:
    pass
" "$_status_json" 2>/dev/null)
        if [ -n "$_running_wp_port" ] && [ "$_running_wp_port" -ge 0 ] 2>/dev/null; then
            ONIONPRESS_PORT_OFFSET="$_running_wp_port"
        fi
    fi
fi

if [ -z "$ONIONPRESS_PORT_OFFSET" ]; then
    # Sticky-offset recovery (mirrors src/menubar.py:258). If we just
    # quit/restarted, our previous offset's ports are likely in
    # TIME_WAIT for ~30-60s. Naive detection sees them as "taken" and
    # bumps to the next offset, giving the user a different port number
    # for the rest of the session even after the old socket frees.
    # Avoid this by reading a sentinel written on stop and waiting up
    # to 15s for the prior offset's ports to come back. Stale sentinels
    # (>60s) are ignored — likely from a crash where we never got to
    # write a fresh one.
    _prev_sentinel="$DATA_DIR/.previous-port-offset"
    if [ -f "$_prev_sentinel" ]; then
        _age=$(( $(date +%s) - $(stat -c %Y "$_prev_sentinel" 2>/dev/null || echo 0) ))
        if [ "$_age" -lt 60 ]; then
            _prev=$(cat "$_prev_sentinel" 2>/dev/null | tr -dc '0-9')
            if [ -n "$_prev" ]; then
                _desired=$((8080 + _prev))
                for _i in $(seq 1 30); do  # up to 15s, 0.5s each
                    if python3 -c '
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
    s.close()
except OSError:
    s.close(); sys.exit(1)
' "$_desired" 2>/dev/null; then
                        break
                    fi
                    sleep 0.5
                done
            fi
        fi
        rm -f "$_prev_sentinel"
    fi
    ONIONPRESS_PORT_OFFSET=$(detect_port_offset)
fi
export ONIONPRESS_PORT_OFFSET
export ONIONPRESS_WP_PORT=$((8080 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_SOCKS_PORT=$((9050 + ONIONPRESS_PORT_OFFSET))
export ONIONPRESS_PROXY_PORT=$((9077 + ONIONPRESS_PORT_OFFSET))

# Bind host. Linux is typically headless (Pi accessed from a phone or
# laptop on the LAN), so we bind to all interfaces by default. Desktop
# users who want localhost-only can set ONIONPRESS_BIND_HOST=127.0.0.1
# in ~/.onionpress/config before launch. Mac (Colima) doesn't run this
# launcher and gets the safer 127.0.0.1 default from the compose file.
: "${ONIONPRESS_BIND_HOST:=0.0.0.0}"
export ONIONPRESS_BIND_HOST

# Every OnionPress node is an OnionHeaven server (accepts registrations).
# The API server runs inside the tor container (always on, ~15MB overhead).
# The heartbeat monitor + takeover Arti container starts lazily on first
# registration. Takeover workers spawn on demand when a registered site
# goes offline. ONIONHEAVEN_HUB=1 enables 10 intro points (auto-detected).
# Tor implementation (C Tor is the default, matching Mac)
export TOR_IMPL="${TOR_IMPL:-tor}"

# OnionHome analytics directory (bind-mounted into tor container)
export ONIONPRESS_SHARED_DIR="$DATA_DIR/shared"
mkdir -p "$ONIONPRESS_SHARED_DIR/analytics"

export ONIONHEAVEN="1"
export ONIONHEAVEN_HUB="${ONIONHEAVEN_HUB:-0}"
export ONIONHEAVEN_MAX_SERVICES="${ONIONHEAVEN_MAX_SERVICES:-50}"
export ONIONHEAVEN_PROPAGATION_DELAY="${ONIONHEAVEN_PROPAGATION_DELAY:-180}"
export ONIONHEAVEN_HUB_THRESHOLD="${ONIONHEAVEN_HUB_THRESHOLD:-5}"

# Read config
CLOUDFLARE_TUNNEL_TOKEN=""
export CLOUDFLARE_TUNNEL_TOKEN

# Create default config if it doesn't exist
if [ ! -f "$DATA_DIR/config" ]; then
    cat > "$DATA_DIR/config" <<EOF
ADDRESS_PREFIX=op2
TOR_IMPL=tor
INSTALL_IA_PLUGIN=yes
UPDATE_ON_LAUNCH=no
START_ON_BOOT=yes
REGISTER_WITH_ONIONHEAVEN=yes
ONIONHEAVEN_ADDRESS=oheavenfhbohpdjijmxo3xgvvuo6eleyhhorbompoycle6x5eajlp7qd.onion
EOF
fi

# Read settings from config (override defaults)
if [ -f "$DATA_DIR/config" ]; then
    _val=$(grep "^TOR_IMPL=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export TOR_IMPL="$_val"
    _val=$(grep "^ONIONHEAVEN_MAX_SERVICES=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_MAX_SERVICES="$_val"
    _val=$(grep "^ONIONHEAVEN_PROPAGATION_DELAY=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_PROPAGATION_DELAY="$_val"
    _val=$(grep "^ONIONHEAVEN_HUB_THRESHOLD=" "$DATA_DIR/config" 2>/dev/null | cut -d= -f2)
    [ -n "$_val" ] && export ONIONHEAVEN_HUB_THRESHOLD="$_val"
fi

# ─── Parse global flags ────────────────────────────────────────────
# --yes / -y skips interactive confirmations (for scripted/automated use).
# Honour ONIONPRESS_YES inherited from the environment so callers like
# scrub's phase_uninstall (which exports it) can suppress prompts.
ONIONPRESS_YES=${ONIONPRESS_YES:-false}
_filtered_args=()
for _arg in "$@"; do
    case "$_arg" in
        --yes|-y) ONIONPRESS_YES=true ;;
        *) _filtered_args+=("$_arg") ;;
    esac
done
set -- "${_filtered_args[@]}"

# ─── Helper functions ───────────────────────────────────────────────

confirm_or_skip() {
    # Usage: confirm_or_skip "prompt text"
    # Returns 0 (proceed) if --yes or user confirms, 1 if declined
    if [ "$ONIONPRESS_YES" = "true" ]; then
        return 0
    fi
    echo "$1"
    read -r
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if WordPress core is installed (setup wizard completed)
wp_is_installed() {
    docker exec onionpress-wordpress wp core is-installed --allow-root >/dev/null 2>&1
}

# Verify a WP admin password without making a backup. Used by scrub/
# uninstall to pre-validate the password BEFORE any destructive work —
# otherwise create_backup verifies mid-script and the user can end up
# in a half-uninstalled state on a bad password.
#
# Stdin: the password.  Returns 0 if valid, non-zero otherwise.
verify_wp_admin_password() {
    op_py verify-admin-password
}

# Prompt for + validate a WP admin password. Sets PROMPTED_WP_PASS on
# success. Retries up to 3 times; returns 1 if user gives up.
prompt_and_validate_wp_password() {
    local prompt="${1:-WordPress admin password: }"
    local attempt
    PROMPTED_WP_PASS=""
    for attempt in 1 2 3; do
        local pw
        read -r -s -p "$prompt" pw
        echo ""
        if [ -z "$pw" ]; then
            echo "  (empty — aborting)"
            return 1
        fi
        if printf '%s' "$pw" | verify_wp_admin_password; then
            PROMPTED_WP_PASS="$pw"
            return 0
        fi
        echo "  Password does not match any WordPress admin account."
        if [ "$attempt" -lt 3 ]; then
            echo "  ($((3 - attempt)) more attempt$([ $attempt -lt 2 ] && echo s) remaining)"
        fi
    done
    echo "  Too many bad attempts — aborting."
    return 1
}

# ─── Secrets management ─────────────────────────────────────────────

setup_db_passwords() {
    local secrets_file="$DATA_DIR/secrets"

    if [ ! -f "$secrets_file" ]; then
        log "Generating random database passwords..."

        local wordpress_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)
        local root_pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32)

        touch "$secrets_file"
        chmod 600 "$secrets_file"

        cat > "$secrets_file" <<EOF
# Database passwords - generated on $(date)
# DO NOT SHARE THESE PASSWORDS
WORDPRESS_DB_PASSWORD='$wordpress_pass'
MYSQL_PASSWORD='$wordpress_pass'
MYSQL_ROOT_PASSWORD='$root_pass'
EOF

        log "Database passwords generated and saved to $secrets_file"
    fi

    if [ -f "$secrets_file" ]; then
        source "$secrets_file"
        export WORDPRESS_DB_PASSWORD
        export MYSQL_PASSWORD
        export MYSQL_ROOT_PASSWORD
    else
        log "ERROR: Secrets file not found at $secrets_file"
        exit 1
    fi
}

# ─── Key import ──────────────────────────────────────────────────────

import_key() {
    local key_b32="$1"

    mkdir -p "$DATA_DIR"

    if [ -z "$key_b32" ] || [ "$key_b32" = "--help" ] || [ "$key_b32" = "-h" ]; then
        cat <<HELPEOF
Usage: onionpress import-key <base32-secret-key>

Import a pre-generated ed25519 key for your onion service.

The base32 key should encode the 64-byte expanded ed25519 secret key.
OnionPress will derive the .onion address automatically.

HOW TO GET THE KEY FROM mkp224o OUTPUT:

  OnionPress stores vanity keys in ~/.onionpress/shared/vanity-keys/.
  Each address has its own directory containing hs_ed25519_secret_key.
  Encode that file to base32:

    python3 -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())"

EXAMPLE:

  KEY=\$(python3 -c "import base64; print(base64.b32encode(open('\$HOME/.onionpress/shared/vanity-keys/<address>.onion/hs_ed25519_secret_key','rb').read()).decode())")
  onionpress import-key "\$KEY"

WHAT THIS COMMAND DOES:

  1. Decodes the base32 key and validates it is exactly 64 bytes
  2. Derives the .onion address from the public key portion
  3. Writes key files to ~/.onionpress/shared/vanity-keys/<address>/
     - ks_hs_id.ed25519_expanded_private  (OpenSSH PEM format for Arti)
     - hostname                           (the .onion address)
  4. On next start, OnionPress will use this key

NOTE: If an onion address already exists, you will be prompted to
confirm the replacement. OnionPress will handle stopping and
removing the old keys automatically.

HELPEOF
        return 0
    fi

    # Decode base32 key and derive .onion address (no files written yet)
    local address
    address=$(python3 "$SCRIPTS_DIR/key_manager.py" decode-key "$key_b32" 2>&1)

    if [ $? -ne 0 ]; then
        echo "$address" >&2
        return 1
    fi

    # Check if this is the same key already installed
    local current_addr
    current_addr=$(find "$DATA_DIR/shared/vanity-keys" -name hostname -exec cat {} \; 2>/dev/null | head -1)
    if [ "$current_addr" = "$address" ]; then
        echo "Key already installed for: $address"
        echo "Nothing to do."
        return 0
    fi

    # Check if arti-state volume already exists
    if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -q '^onionpress-arti-state$'; then
        echo "An onion address key already exists."
        echo ""
        if [ -n "$current_addr" ]; then
            echo "Current address: $current_addr"
            echo ""
        fi
        echo "Importing a new key will REPLACE your current onion address."
        echo "Your old address will stop working permanently."
        echo ""
        printf "Continue? [y/N] "
        read -r confirm
        if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
            echo "Cancelled."
            return 1
        fi

        echo "Stopping OnionPress..."
        stop_containers 2>/dev/null
        echo "Removing old arti-state volume..."
        docker volume rm onionpress-arti-state >> "$LOG_FILE" 2>&1 || true
        if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -q '^onionpress-arti-state$'; then
            echo "Volume still in use -- force-removing containers..."
            docker rm -f $(docker ps -aq --filter volume=onionpress-arti-state) >> "$LOG_FILE" 2>&1 || true
            docker volume rm onionpress-arti-state >> "$LOG_FILE" 2>&1 || true
            if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -q '^onionpress-arti-state$'; then
                echo "ERROR: Could not remove old arti-state volume." >&2
                return 1
            fi
        fi
        docker volume rm onionpress-tor-keys >> "$LOG_FILE" 2>&1 || true
        rm -rf "$DATA_DIR/shared/vanity-keys/"
        echo "Old keys removed."
    elif [ -d "$DATA_DIR/shared/vanity-keys" ]; then
        rm -rf "$DATA_DIR/shared/vanity-keys/"
    fi

    touch "$DATA_DIR/.import-key-pending"

    # Write all key files (Arti PEM + C Tor + hostname)
    if ! python3 "$SCRIPTS_DIR/key_manager.py" import-key "$key_b32" "$DATA_DIR/shared/vanity-keys" 2>>"$LOG_FILE"; then
        echo "ERROR: Failed to write key files" >&2
        return 1
    fi

    # Update ADDRESS_PREFIX in config to match imported address
    local current_prefix=""
    if [ -f "$DATA_DIR/config" ]; then
        current_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
    fi
    local prefix_len=${#current_prefix}
    if [ "$prefix_len" -lt 2 ]; then
        prefix_len=3
    fi
    local addr_prefix=$(echo "$address" | cut -c1-$prefix_len)
    if [ -f "$DATA_DIR/config" ] && grep -q "^ADDRESS_PREFIX=" "$DATA_DIR/config"; then
        sed -i "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$addr_prefix/" "$DATA_DIR/config"
    else
        echo "ADDRESS_PREFIX=$addr_prefix" >> "$DATA_DIR/config"
    fi
    log "Updated ADDRESS_PREFIX to '$addr_prefix' to match imported key"

    log "Imported key for address: $address"
    echo "Imported key for: $address"
    echo "Key files written to: $DATA_DIR/shared/vanity-keys/$address"
    echo ""
    echo "Run 'sudo systemctl restart onionpress' to use this address."
    return 0
}

# Non-interactive key import (used by handle-action for settings page imports)
import_key_noninteractive() {
    local key_b32="$1"
    if [ -z "$key_b32" ]; then
        log "ERROR: No key provided for import"
        return 1
    fi

    mkdir -p "$DATA_DIR"

    # Decode key, derive address, and write all key files in one call
    local address
    address=$(python3 "$SCRIPTS_DIR/key_manager.py" import-key "$key_b32" "$DATA_DIR/shared/vanity-keys" 2>&1)

    if [ $? -ne 0 ]; then
        log "ERROR: $address"
        return 1
    fi

    touch "$DATA_DIR/.import-key-pending"

    # Update ADDRESS_PREFIX in config
    local current_prefix=""
    if [ -f "$DATA_DIR/config" ]; then
        current_prefix=$(grep "^ADDRESS_PREFIX=" "$DATA_DIR/config" | cut -d= -f2)
    fi
    local prefix_len=${#current_prefix}
    if [ "$prefix_len" -lt 2 ]; then
        prefix_len=3
    fi
    local addr_prefix=$(echo "$address" | cut -c1-$prefix_len)
    if [ -f "$DATA_DIR/config" ] && grep -q "^ADDRESS_PREFIX=" "$DATA_DIR/config"; then
        sed -i "s/^ADDRESS_PREFIX=.*/ADDRESS_PREFIX=$addr_prefix/" "$DATA_DIR/config"
    else
        echo "ADDRESS_PREFIX=$addr_prefix" >> "$DATA_DIR/config"
    fi
    log "Updated ADDRESS_PREFIX to '$addr_prefix' to match imported key"

    log "Non-interactive import: key for $address"
    return 0
}

# ─── Plugin installation ─────────────────────────────────────────────

install_ia_plugin() {
    local install_plugin="yes"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^INSTALL_IA_PLUGIN=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            install_plugin="$config_value"
        fi
    fi

    if [ "$install_plugin" != "yes" ]; then
        log "Internet Archive plugin installation disabled in config"
        return 0
    fi

    if [ ! -d "$SCRIPTS_DIR" ] || [ ! -f "$SCRIPTS_DIR/install_plugin.sh" ]; then
        log "Plugin installation scripts not available, skipping"
        return 0
    fi

    log "Checking Internet Archive Wayback Machine Link Fixer plugin..."

    cd "$DOCKER_DIR"

    if docker compose exec -T wordpress test -f /var/www/html/wp-content/plugins/internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php 2>/dev/null; then
        log "Internet Archive plugin already installed, checking activation status..."
        if "$SCRIPTS_DIR/activate_plugin.sh" "onionpress-wordpress" \
            "internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php" >>"$LOG_FILE" 2>&1; then
            log "Internet Archive Wayback Machine Link Fixer plugin is active"
        else
            log "Plugin will auto-activate after WordPress setup"
        fi
        return 0
    fi

    log "Installing Internet Archive Wayback Machine Link Fixer plugin..."

    local temp_dir=$(mktemp -d)

    if "$SCRIPTS_DIR/install_plugin.sh" "internet-archive-wayback-machine-link-fixer" "$temp_dir" >>"$LOG_FILE" 2>&1; then
        if docker cp "$temp_dir/internet-archive-wayback-machine-link-fixer" onionpress-wordpress:/var/www/html/wp-content/plugins/ 2>>"$LOG_FILE" && \
            cd "$DOCKER_DIR" && \
            docker compose exec -T wordpress chown -R www-data:www-data /var/www/html/wp-content/plugins/internet-archive-wayback-machine-link-fixer 2>>"$LOG_FILE"; then
            log "Internet Archive Wayback Machine Link Fixer plugin installed"

            if "$SCRIPTS_DIR/activate_plugin.sh" "onionpress-wordpress" \
                "internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php" >>"$LOG_FILE" 2>&1; then
                log "Plugin automatically activated"
            else
                log "Plugin will auto-activate after WordPress setup"
            fi
        else
            log "Failed to copy plugin to container"
        fi
    else
        log "Failed to download and verify plugin - check log for details"
    fi

    rm -rf "$temp_dir"
    return 0
}

# WP-Statistics plugin removed — it phoned home to connect.wp-statistics.com
# despite telemetry settings being disabled.  OnionPress's built-in hit counter
# (onionpress-hit-counter plugin) provides the same functionality without
# any clearnet leaks.  On existing installs the plugin is deactivated on the
# next launch via src/onionpress/multisite.py:deactivate_wp_statistics
# (called from start_containers as `op_py deactivate-wp-statistics`).

# ─── Image updates ────────────────────────────────────────────────────

update_images() {
    local update_enabled="no"
    if [ -f "$DATA_DIR/config" ]; then
        local config_value=$(grep "^UPDATE_ON_LAUNCH=" "$DATA_DIR/config" | cut -d= -f2)
        if [ ! -z "$config_value" ]; then
            update_enabled="$config_value"
        fi
    fi

    if [ "$update_enabled" != "yes" ]; then
        return 0
    fi

    log "Checking for Docker image updates..."

    cd "$DOCKER_DIR"

    # GHCR images pinned to digest — must match docker-compose.yml. Refresh
    # with build/refresh-image-digests.sh at each release. mariadb stays
    # on :latest to receive upstream security patches automatically.
    local images=(
        "ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:ecab8ad6c9a196b308441f1eac787504d8c43fb6ad7638363edb14a41e784e2b"
        "ghcr.io/brewsterkahle/onionpress-wordpress:latest@sha256:5056497e355667c6f440baf75721e189c7845921218468f566d34e20c39bc776"
        "mariadb:latest"
    )
    local pulled=0

    for image in "${images[@]}"; do
        log "Pulling $image..."
        if docker pull "$image" >> "$LOG_FILE" 2>&1; then
            log "$image up to date"
            pulled=1
        else
            log "WARNING: Failed to pull $image (continuing with cached version)"
        fi
    done

    if [ "$pulled" = "1" ]; then
        # Issue #230: reclaim disk from old <none> image tags created by
        # the pull above. Dangling-only (no -a) so in-use and freshly
        # tagged images are untouched.
        local prune_out
        prune_out=$(docker image prune -f 2>&1 | tail -1)
        if [ -n "$prune_out" ]; then
            log "$prune_out"
        fi
    fi

    return 0
}

