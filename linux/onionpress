                    local rp_local="/tmp/onionpress-restore-$$.zip"
                    docker cp "onionpress-wordpress:$rp_file" "$rp_local" 2>>"$LOG_FILE"
                    docker exec onionpress-wordpress sh -c "rm -f $rp_file" 2>/dev/null
                    if [ -z "$rp_password" ] || [ ! -f "$rp_local" ]; then
                        rm -f "$rp_local"
                        echo '{"success":false,"error":"Missing password or backup file","restored_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            docker exec -i onionpress-wordpress sh -c 'cat > /var/lib/onionpress/restore-result.json' 2>/dev/null
                        log "Restore failed: missing password or file"
                    else
                        local rp_addr
                        if rp_addr=$(restore_backup "$rp_password" "$rp_local" 2>>"$LOG_FILE"); then
                            rm -f "$rp_local"
                            # Restart to pick up restored keys
                            stop_containers 2>/dev/null || true
                            start_containers
                            wait_for_services
                            write_status
                            echo '{"success":true,"address":"'"$rp_addr"'","restored_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                docker exec -i onionpress-wordpress sh -c 'cat > /var/lib/onionpress/restore-result.json' 2>/dev/null
                            log "Restore complete: $rp_addr"
                        else
                            rm -f "$rp_local"
                            echo '{"success":false,"error":"Restore failed — wrong password or corrupt backup","restored_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                                docker exec -i onionpress-wordpress sh -c 'cat > /var/lib/onionpress/restore-result.json' 2>/dev/null
                            log "Restore failed"
                        fi
                    fi
                    ;;
                refresh-status)
                    setup_db_passwords
                    write_status
                    ;;
                update)
                    log "Update requested from settings page..."
                    # Run the update command and capture result
                    if "$0" update >> "$LOG_FILE" 2>&1; then
                        local updated_ver
                        updated_ver=$(cat "$INSTALL_DIR/VERSION" 2>/dev/null || echo "unknown")
                        echo '{"success":true,"version":"'"$updated_ver"'","updated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            docker exec -i onionpress-wordpress sh -c 'cat > /var/lib/onionpress/update-result.json' 2>/dev/null
                        log "Update complete: $updated_ver"
                    else
                        echo '{"success":false,"error":"Update failed — check logs","updated_at":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' | \
                            docker exec -i onionpress-wordpress sh -c 'cat > /var/lib/onionpress/update-result.json' 2>/dev/null
                        log "Update failed"
                    fi
                    ;;
                *)
                    log "Unknown action: $action"
                    ;;
            esac
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config, secrets.
            # After reset + start + setup, restore from backup to get data back.
            if [ "$ONIONPRESS_YES" != "true" ]; then
                echo ""
                echo "  This will ERASE everything: WordPress, database, Tor state,"
                echo "  onion address keys, config, and secrets."
                echo ""
                echo "  To preserve your data, run 'onionpress backup' first."
                echo ""
                echo "  Press Enter to continue or Ctrl+C to cancel..."
                read -r
            fi

            log "Resetting OnionPress (full wipe)..."

            # Stop everything
            setup_db_passwords 2>/dev/null || true
            if systemctl is-active onionpress-heartbeat.service >/dev/null 2>&1; then
                log "Stopping heartbeat client..."
                sudo systemctl stop onionpress-heartbeat 2>>"$LOG_FILE" || true
            fi
            stop_containers 2>/dev/null || true

            # Remove all Docker volumes
            cd "$DOCKER_DIR"
            log "Removing Docker volumes..."
            for vol in $(docker volume ls -q --filter "name=onionpress-" 2>/dev/null); do
                docker volume rm "$vol" >> "$LOG_FILE" 2>&1 && log "Removed volume: $vol" || log "WARNING: Failed to remove volume: $vol"
            done

            # Wipe data directory (keep directory structure)
            rm -f "$DATA_DIR/secrets" "$DATA_DIR/onionpress.log" "$DATA_DIR/.last_status_state"
            rm -f "$DATA_DIR/config" "$DATA_DIR/config.bak"
            rm -f "$DATA_DIR/onionheaven-registration.json"
            rm -f "$DATA_DIR/onion_address" "$DATA_DIR/healthcheck-address"
            rm -rf "$DATA_DIR/shared/vanity-keys/"
            log "Removed keys, config, secrets, and logs"

            echo ""
            echo "  Reset complete. Everything wiped. Starting fresh containers..."
            echo ""

            # Start fresh containers
            setup_db_passwords
            start_containers
            wait_for_services
            write_status

            # Clean OnionHeaven state in the shared persistent volume
            if docker ps --format '{{.Names}}' | grep -q '^onionheaven$'; then
                log "Resetting OnionHeaven..."
                docker exec onionheaven curl -s -X POST http://127.0.0.1:8083/reset-onionheaven >> "$LOG_FILE" 2>&1 || true
            fi

            log "OnionPress reset and restarted"
            echo "  Containers running. Run 'onionpress setup' to initialize WordPress."
            ;;

        validate-oh-address)
            _validate_oh_address "$2"
            ;;

        scrub)
            # Scrub: full lifecycle test — backup, uninstall, install, restore, verify.
            # Proves backup/restore integrity, clean install, and that uninstall
            # truly cleans up. Use after changes to install.sh, onionpress CLI,
            # or Docker setup.
            #
            # Usage: onionpress scrub [<wp-admin-password>] [--clean]
            #   --clean: delete backup zip after successful scrub (default: keep it)
            echo ""
            echo "OnionPress Scrub"
            echo "================"
            echo "This will: backup → uninstall → install → restore → verify"
            echo ""

            # Rootless-Docker user services need this set when invoked via sudo/ssh
            local _xdg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
            local _uctl="systemctl --user"

            local scrub_clean=false
            local scrub_pass=""
            for arg in "$@"; do
                case "$arg" in
                    --clean) scrub_clean=true ;;
                    scrub) ;;
                    *) [ -z "$scrub_pass" ] && scrub_pass="$arg" ;;
                esac
            done

            confirm_or_skip "Continue? [y/N] " || { echo "Cancelled."; exit 0; }

            # ── Step 1: Backup ──────────────────────────────────────────
            echo ""
            echo "── Step 1/5: Backup ──"
            setup_db_passwords
            if [ -z "$scrub_pass" ]; then
                read -r -s -p "WordPress admin password (for backup): " scrub_pass
                echo ""
            fi
            if [ -z "$scrub_pass" ]; then
                echo "ERROR: Password is required for backup."
                exit 1
            fi

            # Capture pre-scrub onion address so we can verify it survives the cycle
            local pre_scrub_addr
            pre_scrub_addr=$(get_onion_address 2>/dev/null || echo "")
            if [ -n "$pre_scrub_addr" ] && [ "$pre_scrub_addr" != "Generating..." ]; then
                echo "  Pre-scrub onion: $pre_scrub_addr"
            else
                pre_scrub_addr=""
                echo "  WARNING: No pre-scrub onion address captured (won't be able to verify match)"
            fi

            local scrub_backup="/tmp/onionpress-scrub-$(date +%Y%m%d-%H%M%S).zip"
            create_backup "$scrub_pass" "$scrub_backup"
            if [ ! -s "$scrub_backup" ]; then
                echo "ERROR: Backup file missing or empty — aborting."
                exit 1
            fi
            echo "  Backup saved to: $scrub_backup ($(du -h "$scrub_backup" | cut -f1))"

            # Remember the repo dir for re-install
            local scrub_repo_dir=""
            for d in /home/*/tmp/onionpress /home/*/onionpress /opt/onionpress-src; do
                if [ -d "$d/.git" ]; then
                    scrub_repo_dir="$d"
                    break
                fi
            done
            if [ -z "$scrub_repo_dir" ]; then
                echo "ERROR: Cannot find OnionPress git repo — needed to re-install."
                exit 1
            fi

            # ── Step 2: Uninstall ───────────────────────────────────────
            echo ""
            echo "── Step 2/5: Uninstall ──"

            # Stop user-level services (rootless install)
            XDG_RUNTIME_DIR="$_xdg" $_uctl stop onionpress-heartbeat 2>/dev/null || true
            XDG_RUNTIME_DIR="$_xdg" $_uctl stop onionpress-watcher.timer 2>/dev/null || true
            XDG_RUNTIME_DIR="$_xdg" $_uctl stop onionpress 2>/dev/null || true

            # Also stop legacy system-level services (pre-rootless installs)
            sudo systemctl stop onionpress-heartbeat 2>/dev/null || true
            sudo systemctl stop onionpress-watcher.timer 2>/dev/null || true
            sudo systemctl stop onionpress 2>/dev/null || true

            # Remove containers and volumes
            setup_db_passwords 2>/dev/null || true
            (cd "$DOCKER_DIR" 2>/dev/null && docker compose down -v 2>/dev/null) || true

            # Disable user-level services and remove unit files
            XDG_RUNTIME_DIR="$_xdg" $_uctl disable onionpress 2>/dev/null || true
            XDG_RUNTIME_DIR="$_xdg" $_uctl disable onionpress-heartbeat 2>/dev/null || true
            XDG_RUNTIME_DIR="$_xdg" $_uctl disable onionpress-watcher.timer 2>/dev/null || true
            rm -f "$HOME/.config/systemd/user/onionpress.service"
            rm -f "$HOME/.config/systemd/user/onionpress-heartbeat.service"
            rm -f "$HOME/.config/systemd/user/onionpress-watcher.service"
            rm -f "$HOME/.config/systemd/user/onionpress-watcher.timer"
            XDG_RUNTIME_DIR="$_xdg" $_uctl daemon-reload 2>/dev/null || true

            # Disable and remove legacy system-level service files
            sudo systemctl disable onionpress 2>/dev/null || true
            sudo systemctl disable onionpress-heartbeat 2>/dev/null || true
            sudo systemctl disable onionpress-watcher.timer 2>/dev/null || true
            sudo rm -f /etc/systemd/system/onionpress.service
            sudo rm -f /etc/systemd/system/onionpress-heartbeat.service
            sudo rm -f /etc/systemd/system/onionpress-watcher.service
            sudo rm -f /etc/systemd/system/onionpress-watcher.timer
            sudo systemctl daemon-reload

            # Remove install dir and data
            sudo rm -rf /opt/onionpress
            sudo rm -f /usr/local/bin/onionpress
            rm -rf "$DATA_DIR"
            echo "  Uninstall complete."

            # ── Step 3: Install ─────────────────────────────────────────
            echo ""
            echo "── Step 3/5: Install ──"
            cd "$scrub_repo_dir"
            sudo bash linux/install.sh
            echo "  Install complete."

            # ── Step 4: Restore ─────────────────────────────────────────
            echo ""
            echo "── Step 4/5: Restore ──"
            # Re-source the script since install may have changed it
            setup_db_passwords
            start_containers
            wait_for_services
            restore_backup "$scrub_pass" "$scrub_backup"
            echo "  Restore complete. Restarting..."
            touch "$DATA_DIR/.import-key-pending"
            stop_containers
            start_containers
            wait_for_services
            write_status
            echo "  Restore and restart complete."

            # ── Step 5: Verify ──────────────────────────────────────────
            echo ""
            echo "── Step 5/5: Verify ──"
            local scrub_ok=true

            # Check containers are running
            local expected_containers="onionpress-tor onionpress-wordpress onionpress-db onionheaven"
            for ctr in $expected_containers; do
                if docker ps --format '{{.Names}}' | grep -q "^${ctr}$"; then
                    echo "  ✓ $ctr running"
                else
                    echo "  ✗ $ctr NOT running"
                    scrub_ok=false
                fi
            done

            # Check onion address is present AND matches pre-scrub (vanity key preserved)
            local scrub_addr
            scrub_addr=$(get_onion_address 2>/dev/null || echo "")
            if [ -z "$scrub_addr" ] || [ "$scrub_addr" = "Generating..." ]; then
                echo "  ✗ No onion address found"
                scrub_ok=false
            elif [ -n "$pre_scrub_addr" ] && [ "$scrub_addr" != "$pre_scrub_addr" ]; then
                echo "  ✗ Onion address changed: $pre_scrub_addr → $scrub_addr (vanity key NOT restored)"
                scrub_ok=false
            else
                echo "  ✓ Onion address: $scrub_addr (matches pre-scrub)"
            fi

            # Check WordPress responds
            local wp_status
            wp_status=$(docker exec onionpress-wordpress curl -s -o /dev/null -w '%{http_code}' http://localhost:80/ 2>/dev/null || echo "000")
            if [ "$wp_status" = "200" ] || [ "$wp_status" = "301" ] || [ "$wp_status" = "302" ]; then
                echo "  ✓ WordPress responding (HTTP $wp_status)"
            else
                echo "  ✗ WordPress not responding (HTTP $wp_status)"
                scrub_ok=false
            fi

            # Check systemd user service is enabled (matches install.sh's user-level model)
            if XDG_RUNTIME_DIR="$_xdg" $_uctl is-enabled onionpress >/dev/null 2>&1; then
                echo "  ✓ onionpress.service enabled (user)"
            else
                echo "  ✗ onionpress.service not enabled (user)"
                scrub_ok=false
            fi

            echo ""
            if [ "$scrub_ok" = "true" ]; then
                echo "Scrub PASSED — backup/uninstall/install/restore all working."
                if [ "$scrub_clean" = "true" ]; then
                    rm -f "$scrub_backup"
                    echo "  Cleaned up: $scrub_backup"
                else
                    echo "  Backup retained at: $scrub_backup"
                    echo "  (pass --clean to delete on success)"
                fi
            else
                echo "Scrub FAILED — see errors above."
                echo "  Backup retained for recovery: $scrub_backup"
            fi
            ;;

        uninstall)
            echo ""
            echo "OnionPress Uninstaller"
            echo "======================"
            echo ""
            echo "CRITICAL WARNING"
            echo ""
            echo "Uninstalling will PERMANENTLY DELETE:"
            echo "  - Your onion address and private key"
            echo "  - All WordPress content and data"
            echo "  - Database and configuration"
            echo "  - Systemd services"
            echo "  - /opt/onionpress installation"
            echo ""
            echo "Your site CANNOT BE RECOVERED unless you have a backup."
            echo ""

            if [ "$ONIONPRESS_YES" != "true" ]; then
                # Offer backup first (like Mac version)
                read -r -p "Create a backup before uninstalling? [Y/n] " backup_choice
                if [ "$backup_choice" != "n" ] && [ "$backup_choice" != "N" ]; then
                    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q onionpress-wordpress; then
                        read -r -s -p "WordPress admin password (for backup): " bp_pass
                        echo ""
                        bp_path="/tmp/OnionPress-backup-$(date +%Y-%m-%d-%H-%M).zip"
                        if create_backup "$bp_pass" "$bp_path"; then
                            echo "Backup saved to: $bp_path"
                            echo ""
                            echo "IMPORTANT: Copy this file somewhere safe before continuing!"
                            echo "  e.g.: scp $(whoami)@$(hostname -I 2>/dev/null | awk '{print $1}'):$bp_path ."
                            echo ""
                        else
                            echo "Backup failed. Fix the issue or press Ctrl-C to abort."
                            echo ""
                        fi
                    else
                        echo "Containers are not running — cannot create backup."
                        echo "Start OnionPress first, or skip backup."
                        echo ""
                        read -r -p "Continue without backup? [y/N] " skip_backup
                        if [ "$skip_backup" != "y" ] && [ "$skip_backup" != "Y" ]; then
                            echo "Cancelled."
                            exit 0
                        fi
                    fi
                fi

                # Final confirmation — require typing DELETE
                read -r -p "Type DELETE to confirm uninstall: " confirm
                if [ "$confirm" != "DELETE" ]; then
                    echo "Uninstall cancelled."
                    exit 0
                fi
            fi

            echo ""

            # Unregister from OnionHeaven before stopping (needs running containers)
            if docker ps --format '{{.Names}}' 2>/dev/null | grep -q onionpress-tor; then
                echo "Unregistering from OnionHeaven..."
                # Send offline signal via the tor container's API server
                docker exec onionpress-tor curl -s -X POST http://127.0.0.1:9077/unregister 2>/dev/null || true
            fi

            echo "Stopping services..."
            sudo systemctl stop onionpress-heartbeat 2>/dev/null || true
            sudo systemctl stop onionpress-watcher.timer 2>/dev/null || true
            sudo systemctl stop onionpress 2>/dev/null || true

            echo "Removing containers and volumes..."
            setup_db_passwords 2>/dev/null || true
            cd "$DOCKER_DIR" 2>/dev/null && docker compose down -v 2>/dev/null || true

            echo "Disabling and removing systemd services..."
            sudo systemctl disable onionpress 2>/dev/null || true
            sudo systemctl disable onionpress-heartbeat 2>/dev/null || true
            sudo systemctl disable onionpress-watcher.timer 2>/dev/null || true
            sudo rm -f /etc/systemd/system/onionpress.service
            sudo rm -f /etc/systemd/system/onionpress-heartbeat.service
            sudo rm -f /etc/systemd/system/onionpress-watcher.service
            sudo rm -f /etc/systemd/system/onionpress-watcher.timer
            sudo systemctl daemon-reload

            echo "Removing /opt/onionpress..."
            sudo rm -rf /opt/onionpress

            echo "Removing /usr/local/bin/onionpress symlink..."
            sudo rm -f /usr/local/bin/onionpress

            echo "Removing data directory ($DATA_DIR)..."
            rm -rf "$DATA_DIR"

            echo ""
            echo "OnionPress has been uninstalled."
            if [ -n "${bp_path:-}" ] && [ -f "${bp_path:-}" ]; then
                echo ""
                echo "Your backup is at: $bp_path"
                echo "Use it to restore: onionpress restore <password> $bp_path"
            fi
            ;;

        reset-onionheaven)
            # Clean stress test entries and refresh takeover workers with current code.
            # Preserves real entries and their keys.
            log "Resetting OnionHeaven (clean stress tests + refresh workers)..."

            if ! docker ps --format '{{.Names}}' | grep -q '^onionheaven$'; then
                echo "ERROR: onionheaven container is not running"
                exit 1
            fi

            result=$(docker exec onionheaven curl -s -X POST http://127.0.0.1:8083/reset-onionheaven 2>&1)
            echo "$result" | python3 -m json.tool 2>/dev/null || echo "$result"
            log "OnionHeaven reset complete"
            ;;

        *)
            echo "Usage: $0 {start|stop|restart|status|address|setup|reset|reset-onionheaven|import-key|backup|restore|update|logs|scrub|write-status|apply-config|handle-action|validate-oh-address|uninstall}"
            exit 1
            ;;
    esac
}

main "$@"
