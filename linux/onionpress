# ─── `onionpress update`: a released package, checked ─────────────────

# `onionpress update` is onionpress.cli's on both platforms (cli.cmd_update
# -> updater.py: the release lookup, the version compare, the --version /
# --pre / --force rules, and the check of onionpress.deb against the
# release's SHA256SUMS). This launcher keeps the Linux install leaves the
# Python calls: update_install_deb (apt-get, then update_finish) and the
# developer's --from-checkout below. Until 2.6.1 a bash client of its own
# lived here (update_find_release, update_fetch_release, ...).

# `update-install-deb <path> [--force]`: install the package `onionpress
# update` downloaded and checked (its sha256 is the release's SHA256SUMS
# line, it is the onionpress package of the tag's version), then
# update_finish. apt-get, not dpkg -i, so new dependencies come along;
# never removing a package to make room. The package's postinst restarts
# the user's onionpress.service and heartbeat where they run and returns
# once the site is up on the new files (issue #357); update_finish then
# pulls the images and restarts once more, as every update path ends. Two
# restarts, one after the other: the second is what restarts a site the
# user runs without the unit.
update_install_deb() {
    local deb="$1" force="${2:-}"
    local -a apt_opts
    if [ -z "$deb" ] || [ ! -f "$deb" ]; then
        log "ERROR: update-install-deb: no package at '${deb:-}'"
        echo "  ERROR: update-install-deb: no package at '${deb:-}'. Nothing was installed." >&2
        return 1
    fi
    apt_opts=(-y --no-remove)
    if [ "$force" = "--force" ]; then
        apt_opts+=(--reinstall --allow-downgrades)
    fi
    log "Installing $deb with apt-get..."
    if ! sudo apt-get install "${apt_opts[@]}" "$deb" >> "$LOG_FILE" 2>&1; then
        log "ERROR: update: apt-get could not install $deb"
        echo "  ERROR: installing the package failed. Check $LOG_FILE for details." >&2
        return 1
    fi
    update_finish
}

# ─── `onionpress update --from-checkout`: a developer's git checkout ──

# The git checkout `onionpress update --from-checkout` installs from,
# brought up to date: the invoking user's own ($HOME/tmp/onionpress,
# $HOME/onionpress), else root's /opt/onionpress-src (cloned from GitHub
# when there is none). Never another account's home: update used to take
# the first checkout in any /home/*/, so any user on the machine could
# leave one there for it to install as root. The checkout must pass
# update_checkout_trusted, have no local changes, and only move forward
# (git pull --ff-only; it used to reset --hard to whatever origin/main
# said). Sets UPDATE_REPO_DIR, or UPDATE_ERROR and returns 1.
update_source_checkout() {
    local d uid state git_as=""
    uid=$(id -u)
    UPDATE_REPO_DIR=""
    UPDATE_ERROR=""
    for d in "$HOME/tmp/onionpress" "$HOME/onionpress"; do
        if [ -d "$d/.git" ] && [ ! -L "$d" ]; then
            UPDATE_REPO_DIR="$d"
            break
        fi
    done
    if [ -z "$UPDATE_REPO_DIR" ]; then
        # root's checkout, and root's git for it (git refuses a repository
        # another user owns).
        UPDATE_REPO_DIR="/opt/onionpress-src"
        git_as="sudo"
        if [ ! -e "$UPDATE_REPO_DIR" ] && [ ! -L "$UPDATE_REPO_DIR" ]; then
            log "No checkout found -- cloning to $UPDATE_REPO_DIR..."
            echo "  Cloning OnionPress repo..."
            if ! sudo git clone https://github.com/brewsterkahle/onionpress.git "$UPDATE_REPO_DIR" >> "$LOG_FILE" 2>&1; then
                UPDATE_ERROR="git clone failed. Check $LOG_FILE for details."
                return 1
            fi
        elif [ -L "$UPDATE_REPO_DIR" ] || [ ! -d "$UPDATE_REPO_DIR/.git" ]; then
            UPDATE_ERROR="$UPDATE_REPO_DIR is not a git checkout; not updating from it."
            return 1
        fi
    fi
    update_checkout_trusted "$UPDATE_REPO_DIR" "$uid" || return 1
    if ! state=$($git_as git -C "$UPDATE_REPO_DIR" status --porcelain 2>>"$LOG_FILE"); then
        UPDATE_ERROR="could not read the state of $UPDATE_REPO_DIR (see $LOG_FILE); nothing was installed."
        return 1
    fi
    if [ -n "$state" ]; then
        UPDATE_ERROR="$UPDATE_REPO_DIR has local changes; commit or remove them, or update it yourself. Nothing was installed."
        return 1
    fi
    log "Pulling latest into $UPDATE_REPO_DIR..."
    if ! $git_as git -C "$UPDATE_REPO_DIR" pull --ff-only >> "$LOG_FILE" 2>&1; then
        UPDATE_ERROR="$UPDATE_REPO_DIR cannot move forward to what it pulls from (git pull --ff-only failed); bring it up to date yourself. Nothing was installed."
        return 1
    fi
    # What the pull brought must pass the same checks.
    update_checkout_trusted "$UPDATE_REPO_DIR" "$uid" || return 1
    return 0
}

# A checkout update may install from (as root): every file and folder in
# it, and every folder above it, belongs to the invoking user (uid $2) or
# root, and none is writable by everyone (a folder above may be, with the
# sticky bit, like /tmp). Returns 1 with UPDATE_ERROR set.
update_checkout_trusted() {
    local real d bad uid="$2"
    if ! real=$(cd -P "$1" 2>/dev/null && pwd -P); then
        UPDATE_ERROR="cannot read $1; not updating from it."
        return 1
    fi
    d="$real"
    while :; do
        bad=$(find "$d" -maxdepth 0 \( \( ! -uid 0 ! -uid "$uid" \) -o \( -perm -0002 ! -perm -1000 \) \) -print 2>/dev/null) || bad="$d"
        if [ -n "$bad" ]; then
            UPDATE_ERROR="$d belongs to another user or is writable by everyone; not updating from $real."
            return 1
        fi
        [ "$d" = "/" ] && break
        d=$(dirname "$d")
    done
    if ! bad=$(find "$real" \( ! -uid 0 ! -uid "$uid" \) -print -quit 2>>"$LOG_FILE"); then
        UPDATE_ERROR="cannot read all of $real; not updating from it."
        return 1
    fi
    if [ -n "$bad" ]; then
        UPDATE_ERROR="$bad belongs to another user; not updating from $real."
        return 1
    fi
    if ! bad=$(find "$real" ! -type l -perm -0002 -print -quit 2>>"$LOG_FILE"); then
        UPDATE_ERROR="cannot read all of $real; not updating from it."
        return 1
    fi
    if [ -n "$bad" ]; then
        UPDATE_ERROR="$bad is writable by everyone; not updating from $real."
        return 1
    fi
    return 0
}

# `onionpress update --from-checkout`: install the checkout's file set (its
# own linux/install-tree.sh, the list the .deb and install.sh use), staged
# beside $INSTALL_DIR and renamed into place (a failure leaves the
# installed files as they were), then update_finish.
update_from_checkout() {
    log "Checking for OnionPress updates..."
    echo "  Checking for updates..."

    # The checkout to install from, brought forward (see
    # update_source_checkout: never another user's).
    if ! update_source_checkout; then
        log "ERROR: update: $UPDATE_ERROR"
        echo "  ERROR: $UPDATE_ERROR"
        return 1
    fi
    local repo_dir="$UPDATE_REPO_DIR"

    if [ ! -f "$repo_dir/linux/install-tree.sh" ]; then
        log "ERROR: update: $repo_dir has no linux/install-tree.sh"
        echo "  ERROR: $repo_dir is too old to update from (no linux/install-tree.sh)."
        return 1
    fi
    log "Installing updated files from $repo_dir..."
    echo "  Installing updated files..."
    if ! sudo bash "$repo_dir/linux/install-tree.sh" install "$repo_dir" "$INSTALL_DIR" >> "$LOG_FILE" 2>&1; then
        log "ERROR: update: installing from $repo_dir failed; $INSTALL_DIR is unchanged"
        echo "  ERROR: installing the update failed; nothing was changed. Check $LOG_FILE for details."
        return 1
    fi
    update_finish
}

# After an update installed new files (a release's package or a checkout):
# the new plugins into the running WordPress, the images pulled, and
# OnionPress restarted, the daemon too (its code was replaced).
update_finish() {
    local new_version plugin
    new_version=$(cat "$INSTALL_DIR/VERSION" 2>/dev/null || echo "unknown")

    # Deploy updated plugins to running container
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q onionpress-wordpress; then
        for plugin in "$INSTALL_DIR/plugins/"*.php; do
            wp_put "/var/www/html/wp-content/mu-plugins/$(basename "$plugin")" 644 \
                < "$plugin" 2>>"$LOG_FILE"
        done
        log "Updated plugins deployed to WordPress container"
    fi

    # Pull the release's images: every pin is a digest, so `--policy
    # missing` fetches exactly what the new release moved (as the start
    # does) and never clobbers a local build.
    cd "$INSTALL_DIR/docker"
    setup_db_passwords
    if using_local_images; then
        log "Skipping image pull: running locally built images"
        echo "  Skipping image pull (running locally built images)"
    else
        log "Pulling the release's Docker images..."
        echo "  Pulling the release's Docker images..."
        docker compose "${CF_COMPOSE[@]}" pull --policy missing >> "$LOG_FILE" 2>&1 || log "WARNING: docker compose pull failed"
    fi

    # Restart: the hub hears /offline while the site goes down; the daemon
    # is stopped without a second /offline (it comes right back on the
    # new code) and started again with the stack.
    log "Restarting OnionPress..."
    echo "  Restarting OnionPress..."
    daemon_offline
    op_py --data-dir "$DATA_DIR" daemon stop --no-offline >> "$LOG_FILE" 2>&1 || true
    stop_containers || log "WARNING: update: the stop failed; starting the containers anyway"
    start_containers
    wait_for_services
    start_daemon

    log "Update complete: $new_version"
    echo "  Update complete! Now running OnionPress $new_version."
}


main() {
    launcher_environment
    case "${1:-start}" in
        start)
            # PID lock
            if [ -f "$PIDFILE" ]; then
                old_pid=$(cat "$PIDFILE" 2>/dev/null)
                if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                    echo "OnionPress is already running (PID $old_pid)." >&2
                    exit 1
                fi
                rm -f "$PIDFILE"
            fi
            echo $$ > "$PIDFILE"
            trap 'rm -f "$PIDFILE"' EXIT INT TERM HUP

            # Check Docker is available
            if ! command_exists docker || ! docker info >/dev/null 2>&1; then
                log "ERROR: Docker is not available. Install Docker first."
                exit 1
            fi
            # Everything below needs Docker Engine and Compose at least as
            # new as onionpress.docker_versions says (`docker compose pull
            # --policy missing` on every start, 2.22+): refuse an older
            # one, or a machine whose docker-compose is the retired v1
            # with no `docker compose`, with what was found and how to
            # upgrade, instead of failing at the first compose call.
            if ! _docker_check=$(op_py check-docker 2>&1); then
                while IFS= read -r _line; do
                    log "ERROR: $_line"
                done <<< "$_docker_check"
                exit 1
            fi
            log "$_docker_check"

            setup_db_passwords
            start_containers
            wait_for_services
            # The daemon (status, probe, heartbeat, the page's requests,
            # log capture): the user unit, where there is one.
            start_daemon

            address_line=$(onion_address_line)
            log "OnionPress is running!"
            log "$address_line"
            log "Local access: $(wp_access_url)"

            echo ""
            echo "OnionPress is running!"
            echo "  $address_line"
            echo "  Local access:  $(wp_access_url)"
            echo "  Status page:   $(wp_access_url)/onionpress-status"
            echo "  Logs:          $LOG_FILE"
            # Done: onionpress.service is a oneshot that stays active
            # (RemainAfterExit); the daemon unit carries on (issue #407:
            # until then this process stayed in a 30 s status loop).
            ;;

        stop)
            setup_db_passwords
            # The hub hears /offline before the containers go down (the
            # daemon's, while the tor container is still up).
            daemon_offline
            stop_containers
            ;;

        restart)
            setup_db_passwords
            daemon_offline
            stop_containers || log "WARNING: restart: the stop failed; starting the containers anyway"
            start_containers
            wait_for_services
            # The daemon sees the stack come back and registers again; a
            # terminal's restart with no daemon running starts one.
            start_daemon
            ;;

        status)
            op_py --data-dir "$DATA_DIR" status
            ;;

        address)
            # The address, its shareable URL (--url) or that URL on the
            # clipboard (--copy): onionpress.app_commands (issue #382).
            op_py --data-dir "$DATA_DIR" address "${@:2}"
            ;;

        version|check-reachability|check-docker|open|onionname)
            # The app's remaining functions as subcommands (issue #382):
            # the version, the Settings page's reachability test through
            # the onionheaven Tor client, whether Docker and Compose are
            # new enough (what `start` refuses on), the tray's Open Local
            # Site / Open in Tor Browser / Settings (logged in), and the
            # onionname (show | set NAME).
            op_py --data-dir "$DATA_DIR" "$1" "${@:2}"
            ;;

        dashboard)
            # Open wp-admin in the default browser, auto-logged-in as the first
            # admin user, through the onionpress-auto-login mu-plugin: a
            # one-shot token, 120 s TTL, deleted on use. The token is never
            # on a command line (ps shows every user's): open-login hands it
            # to WordPress on stdin and gives the browser a 0600 page that
            # redirects to the login URL (onionpress.auto_login).
            if ! command -v xdg-open >/dev/null 2>&1; then
                echo "xdg-open not found — open http://localhost:${ONIONPRESS_WP_PORT:-8080}/wp-admin manually."
                exit 1
            fi
            op_py open-login "http://localhost:${ONIONPRESS_WP_PORT:-8080}/wp-admin/" >/dev/null
            ;;

        setup)
            # Usage: onionpress setup [--user USER] [--pass PASS] [--title TITLE]
            #        onionpress setup --from-backup <backup.zip>   (password: ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt)
            # The install the setup window makes (run_setup); a backup's
            # setup is the restore (issue #509: the backup's site, never a
            # fresh one under temporary credentials), then a restart so
            # the start provisions the restored site.
            setup_db_passwords
            cd "$DOCKER_DIR"
            shift  # remove "setup" from args
            local setup_rc=0
            run_setup "$@" || setup_rc=$?
            case "$setup_rc" in
                0)
                    # The site is set up: the tunnel, if there is a token.
                    start_cloudflare_tunnel true
                    ;;
                2) exit 0 ;;
                10)
                    stop_containers || log "WARNING: setup: the stop failed; starting the containers anyway"
                    start_containers
                    wait_for_services
                    ;;
                *) exit 1 ;;
            esac
            echo ""
            echo "  Setup complete! Your site is now running."
            echo "  Admin panel: http://$(wp_access_host):${ONIONPRESS_WP_PORT}/wp-admin"
            echo "  Status page: http://$(wp_access_host):${ONIONPRESS_WP_PORT}/onionpress-status"
            ;;

        provision)
            # Provision an already-installed WordPress with user-chosen
            # site title, username, and password.  Used in headless / SSH
            # installs after the auto-install bootstrap (systemd path where
            # the container auto-installs WP with a random admin password).
            # Unlike `setup`, this works when WP is already installed.
            #
            # Usage: onionpress provision [--adopt-existing]
            #   → interactive terminal prompts
            # An installed WordPress is adopted only when OnionPress
            # installed it (the .wordpress-installed-by-onionpress marker),
            # else refused: whoever reached wp-admin/install.php first
            # chose its admin (issue #464). --adopt-existing keeps it anyway.
            PYTHONPATH="$ONIONPRESS_PYTHONPATH" python3 -I -B -c "
import sys
sys.path[:0] = sys.argv.pop(1).split(':')
from onionpress.setup_logic import provision_interactive
sys.exit(0 if provision_interactive(adopt_existing='--adopt-existing' in sys.argv[1:]) else 1)
" "$ONIONPRESS_PYTHONPATH" "${@:2}"
            ;;

        provision-post-install)
            # Run the post-`wp core install` provisioning steps —
            # multisite conversion, sunrise.php + mu-plugins + .htaccess,
            # OnionPress theme + bundled plugins, and permission fixes.
            # Called by setup_logic.install_fresh_wordpress after a fresh
            # wp core install completes; also safe to re-run by hand.
            # Idempotent — every step skips or no-ops when its work is
            # already done. Stays a bash subcommand for now; planned to
            # be ported to src/onionpress/multisite.py as a follow-up.
            #
            # Delegated to src/onionpress/multisite.py:provision_post_install.
            # The previous bash implementation lived here AND in
            # app/MacOS/onionpress as parallel copies; the Python module
            # is shared so the two platforms can't drift. Step ordering
            # (ensure_multisite BEFORE install_multisite_domain_map) is
            # enforced inside the module — see its docstring for why.
            op_py provision-post-install \
                --themes-dir "$THEMES_DIR" \
                --plugins-dir "$PLUGINS_DIR"
            # Every setup ends here (setup_logic.install_fresh_wordpress
            # runs this subcommand): WordPress's port goes where the config
            # says (issue #464; the daemon's hub gate opens on its own).
            # The tunnel too, when there is a token (start_cloudflare_tunnel).
            if wp_is_installed; then
                after_wordpress_installed
                start_cloudflare_tunnel true
            fi
            ;;

        setup-bundled-plugins)
            # Configure and activate Cache Enabler and the Link Fixer
            # (setup_bundled_plugins). setup_logic.install_fresh_wordpress
            # starts this in the background once setup has made the user's
            # site, so a new install has them without waiting for a restart.
            setup_bundled_plugins
            ;;

        import-key)
            # The stop inside runs compose: with the DB passwords, or it
            # warns about every missing one (issue #507).
            setup_db_passwords
            import_key "${@:2}"
            ;;

        # ── Vanity + admin-password — thin wrappers around the Python CLI
        # (src/onionpress/launcher_ops.py). Code lives there so the Mac
        # menubar can reuse it; bash just hands off.
        generate-vanity)
            # Generate a vanity onion address via mkp224o inside the tor
            # container. On success, prints the new address on stdout and
            # writes the key bundle to ~/.onionpress/shared/vanity-keys/.
            # The next container start picks the key up automatically.
            op_py generate-vanity
            ;;

        admin-password)
            # Read the recovery admin password (only used if the user has
            # lost the credentials they set up via the onboarding wizard).
            op_py admin-password
            ;;

        get)
            # Fetch a URL over Tor and print the body — for checking whether
            # a .onion is reachable. cmd_get in src/onionpress/cli.py runs
            # curl inside the tor container. "${@:2}" forwards the URL and
            # flags (-i, --max-time) verbatim.
            op_py get "${@:2}"
            ;;

        logs)
            # Bare: the container logs. --app, --launcher or --web (-n N,
            # -f): the end of that OnionPress log (issue #382).
            if [ $# -gt 1 ]; then
                op_py --data-dir "$DATA_DIR" logs "${@:2}"
            else
                cd "$DOCKER_DIR"
                docker compose "${CF_COMPOSE[@]}" logs -f
            fi
            ;;

        backup)
            # backup [-o|--output <path>] [--check] [--json] [--user <login>].
            # The shared CLI (cli.cmd_backup → backup.create_backup, the
            # Mac's) reads the password (must match a WordPress administrator)
            # from ONIONPRESS_BACKUP_PASSWORD, stdin or a no-echo prompt and
            # refuses the old `backup <password> [output_path]` (issue #504);
            # --check verifies the password and names the file, making no
            # backup (the tray asks that first). Issue #406.
            shift  # drop "backup"
            op_py --data-dir "$DATA_DIR" backup "$@"
            ;;

        restore)
            # restore <backup_file.zip> [--check] [--json] [--confirmed WHAT]:
            # onionpress.cli's argparse (#529). The password comes from
            # ONIONPRESS_BACKUP_PASSWORD, stdin or a prompt (cli.read_backup_password;
            # the old `restore <password> <backup_file.zip>` is refused there,
            # issue #504); --check answers what the backup is, or {"ask":
            # "password"} without one; a hub's recovery key goes along in the
            # environment. The exit status is the CLI's, the caller's only
            # sign of a refused or failed restore (the tray and the menubar
            # check it); the CLI's own lines say what happened.
            setup_db_passwords
            ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" op_py --data-dir "$DATA_DIR" restore "${@:2}"
            ;;

        hub-recovery-key)
            # An OnionHeaven hub's backup recovery key: create, show, check,
            # restore (src/onionpress/cli.py, hub_backup.py). The hub's
            # registry and registrants' keys in its backups are sealed to
            # it. The private half is printed once by create and otherwise
            # read from ONIONPRESS_HUB_RECOVERY_KEY, stdin or a prompt,
            # never from argv. The public half goes to
            # $DATA_DIR/hub-backup-recovery.pub, which no container mounts.
            ONIONPRESS_HUB_RECOVERY_KEY="$_HUB_RECOVERY_KEY" \
                op_py --data-dir "$DATA_DIR" hub-recovery-key "${@:2}"
            ;;

        update)
            # One updater on both platforms (onionpress.cli update ->
            # updater.py): the release lookup and the check of its
            # onionpress.deb against SHA256SUMS; the install comes back to
            # this launcher's leaves (update-install-deb, or
            # update-from-checkout with --from-checkout).
            # ONIONPRESS_YES=true (the global -y filter above) still means --yes.
            update_args=("${@:2}")
            [ "$ONIONPRESS_YES" != "true" ] || update_args+=(--yes)
            op_py --data-dir "$DATA_DIR" update --launcher "$INSTALL_DIR/onionpress" "${update_args[@]}"
            ;;

        update-install-deb)
            # Internal, run by `onionpress update` with a checked package:
            # sudo apt-get installs it, then update_finish restarts the site.
            update_install_deb "${@:2}"
            ;;

        update-from-checkout)
            # Internal, run by `onionpress update --from-checkout`: a
            # developer's git checkout, through linux/install-tree.sh.
            update_from_checkout
            ;;

        apply-config)
            # The Settings page's config-updates.json, through the allowlist
            # (config.SETTINGS_PAGE_KEYS) and config.apply_side_effects
            # (START_ON_BOOT's units): onionpress.handle_action.apply_config,
            # as on the Mac. handle-action applies it on every run too.
            op_py --data-dir "$DATA_DIR" apply-config
            ;;

        onionheaven)
            # Opt in to / out of OnionHeaven (enable | disable | status
            # [--json]); delegated to onionpress.cli, see onionheaven_cmd.
            onionheaven_cmd "${@:2}"
            ;;

        config)
            # Read and change settings: config get KEY | set KEY VALUE |
            # unset KEY | list [--json]. One implementation for both
            # platforms (src/onionpress/config.py, issue #365); the tray
            # writes through it too.
            op_py --data-dir "$DATA_DIR" config "${@:2}"
            ;;

        handle-action)
            # The WordPress Settings page's requests, handled once for both
            # platforms (onionpress.handle_action, issue #366): the daemon
            # runs this on its status loop. Its actions run through this
            # launcher: start, restart, stop, apply-config,
            # settings-page-backup, settings-page-restore (the bash bodies
            # below), update --check --json (onionpress.cli). The daemon's
            # unit cgroup ends with the daemon (an update restarts it):
            # whatever must outlive this run goes through a transient unit
            # (start.run_detached_cli's systemd-run), which
            # ONIONPRESS_IN_WATCHER tells (inherited by the launcher runs
            # under the handler).
            ONIONPRESS_IN_WATCHER=true op_py --data-dir "$DATA_DIR" handle-action --launcher "$INSTALL_DIR/onionpress" "${@:2}"
            ;;

        settings-page-backup)
            # The Settings page's backup (handle-action create-backup), the
            # shared CLI's (cli.cmd_settings_page_backup, the Mac's; issue
            # #406): handed to WordPress, and the password came from there
            # (ONIONPRESS_BACKUP_PASSWORD), so never a hub's registry or
            # registrants' keys, the Cloudflare tunnel token or any other
            # config WordPress is not shown, nor the site's own onion
            # service key; refused on an OnionHeaven hub or OnionHome, or a
            # node that could not be checked (exit 3, the reason in the
            # answer). Usage: settings-page-backup <output.zip> [--json]
            setup_db_passwords
            op_py --data-dir "$DATA_DIR" settings-page-backup "${@:2}"
            ;;

        settings-page-restore)
            # The Settings page's restore (handle-action restore-backup), the
            # shared CLI's (cli.cmd_settings_page_restore, the Mac's; issue
            # #406): backup.restore_from_backup in place with
            # through_wordpress=True, never the install-from-backup
            # `restore`. The file and its password (ONIONPRESS_BACKUP_PASSWORD)
            # came through WordPress: a backup holding an OnionHeaven hub's
            # keys or OnionHome's name registry is refused, the hub data is
            # never written, and on Linux a backup of another address is
            # refused (no one at this host to ask; the Mac asks). Exit 3
            # with the reason in the answer; the handler restarts OnionPress
            # after a success.
            setup_db_passwords
            op_py --data-dir "$DATA_DIR" settings-page-restore "${@:2}"
            ;;

        reset)
            # Wipe everything: WordPress, database, Tor state, keys, config,
            # secrets (onionpress.cli reset, issue #366: it asks first, with
            # --check --json / --confirmed for a UI and --yes for scripts,
            # and asks the OnionHeaven hubs that may hold the key to delete
            # it while the key can still sign), then on Linux (#529) this
            # launcher's start and the hub state's reset, as this case did
            # in bash. ONIONPRESS_YES=true (the global -y) still means --yes.
            setup_db_passwords 2>/dev/null || true
            reset_args=("${@:2}")
            [ "${ONIONPRESS_YES:-}" != "true" ] || reset_args+=(--yes)
            op_py --data-dir "$DATA_DIR" reset "${reset_args[@]}"
            ;;

        validate-oh-address)
            # The Settings dialog's hub check (onionheaven.validate_hub_address,
            # issue #529): JSON on stdout, exit 1 for a malformed or own address.
            op_py --data-dir "$DATA_DIR" validate-oh-address "${2:-}"
            ;;

        upload-analytics)
            # Upload the diagnostic logs to OnionHome now (Share Now from
            # the command line): one implementation for both platforms,
            # onionpress.analytics_sharing.request_upload (issue #351). It
            # refuses while sharing is off or the daemon is not running,
            # else leaves the marker the daemon takes in its next cycle.
            op_py --data-dir "$DATA_DIR" upload-analytics
            ;;

        scrub)
            # Full lifecycle test — backup, uninstall, install, restore,
            # verify. Ported from ~300 lines of bash to src/onionpress/
            # scrub.py for the phase orchestration + structured verify
            # checks. Heavy phases (the backup, the restore, the
            # install.sh run) still go through bash subcommands; the
            # Python module is the orchestration glue, sudo keep-alive,
            # and verify checks.
            #
            # Args forwarded verbatim — "${@:2}" skips this case label
            # itself. Supports: `onionpress scrub [--clean]` (the password
            # from the environment, stdin or a prompt; one on argv is refused).
            op_py --data-dir "$DATA_DIR" scrub "${@:2}"
            ;;

        uninstall)
            # Remove OnionPress (onionpress.uninstall's Linux branch, #529):
            # asks first (--check --json and --confirmed for the tray, or at
            # this terminal: the hub that may hold the key, then DELETE),
            # offers a backup, takes the key back off the OnionHeaven hubs,
            # stops the units and the tray, removes the containers and
            # volumes, /opt/onionpress and the symlinks (sudo), the desktop
            # entries and ~/.onionpress. ONIONPRESS_YES=true (-y; scrub's
            # uninstall) answers every question and skips the backup offer.
            [ "${ONIONPRESS_YES:-}" != "true" ] || export ONIONPRESS_CONFIRMED="hub-holds-key uninstall"
            op_py --data-dir "$DATA_DIR" uninstall "${@:2}"
            ;;

        reset-onionheaven)
            # Clean stress test entries and refresh takeover workers with current code.
            # Preserves real entries and their keys.
            log "Resetting OnionHeaven (clean stress tests + refresh workers)..."

            if ! docker ps --format '{{.Names}}' | grep -q '^onionheaven$'; then
                echo "ERROR: onionheaven container is not running"
                exit 1
            fi

            result=$(reset_onionheaven_in_container) \
                || { echo "ERROR: OnionHeaven reset failed — see $LOG_FILE"; exit 1; }
            echo "$result" | python3 -I -m json.tool 2>/dev/null || echo "$result"
            log "OnionHeaven reset complete"
            ;;

        help|-h|--help)
            # One text for both platforms (cli.launcher_help, #529).
            op_py --data-dir "$DATA_DIR" launcher-help
            exit 0
            ;;

        *)
            # Every other verb is onionpress.cli's: a subcommand with no
            # case of its own reaches it here (check-for-update,
            # ensure-archive-s3-keys, ...), and one the CLI does not have
            # either gets the CLI's usage and exit status.
            op_py --data-dir "$DATA_DIR" "$@"
            ;;
    esac
}

main "$@"
