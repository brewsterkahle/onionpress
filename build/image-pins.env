# OnionPress container image pins — THE canonical source of truth.
#
# Generated by build/refresh-image-digests.sh. Do not hand-edit: the script
# writes this file first, then propagates the literals into every consumer
# so a bare `docker compose up` with no environment still works.
#
# Consumers (all kept in sync by that script, all enforced by
# tests/test_image_pins.py):
#   app/Resources/docker/docker-compose.yml   tor, wordpress, onionheaven
#   app/MacOS/onionpress                      update_images(), takeover worker
#   linux/onionpress                          update_images()
#   src/onionpress/containers.py              ONIONHEAVEN_IMAGE
#   src/onionpress/launcher_ops.py            DEFAULT_TOR_IMAGE
#
# Every consumer reads these names as an override with the pin as default,
# so exporting either variable points the whole stack at a different image —
# that is how build/build-images.sh hands you a locally built stack.
#
# Why digests and not tags: `:latest` is mutable. A digest is the only thing
# that makes "the v2.4.110 tor image" mean one specific set of bytes on both
# amd64 and arm64. These MUST be multi-arch index digests (what
# `docker buildx imagetools inspect <tag>` reports), never a single-platform
# manifest digest, or the pin resolves on one architecture and 404s on the
# other.
#
# mariadb:latest and willfarrell/autoheal:latest are deliberately NOT pinned
# here — see docs/BUILDING.md, "Why some images stay floating".

ONIONPRESS_TOR_IMAGE=ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:46a9da851f5a39ba9efcb9c139956d7339c81fe85f8fa32376983046e4728f43
ONIONPRESS_WORDPRESS_IMAGE=ghcr.io/brewsterkahle/onionpress-wordpress:latest@sha256:b6724d1ac4f6c93595ae231a7d222ea7de29f697287fbde79cf779cb5c060290
