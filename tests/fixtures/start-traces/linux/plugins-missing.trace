log Starting OnionPress containers...
fn wait_for_docker 180
docker volume ls --format {{.Name}}
docker volume ls --format {{.Name}}
log Pulling pre-built images (missing only)...
docker compose pull --policy missing
log WordPress network egress block in place: ok (test)
docker ps -a --format {{.Names}}
docker network inspect --format {{json .Options}} onionpress-network
docker compose up -d wordpress db onionheaven autoheal [BIND=127.0.0.1]
log WordPress, DB, and Tor client containers starting
docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp core is-installed
log WordPress is installed -- starting Tor
docker port onionpress-wordpress 80/tcp
log WordPress is installed: moving its port 8080 from 127.0.0.1 to 0.0.0.0 (ONIONPRESS_BIND_HOST)
docker compose up -d wordpress [BIND=0.0.0.0]
bin systemctl --user is-enabled onionpress-heartbeat.service
docker compose up -d tor onionheaven [BIND=0.0.0.0]
docker port onionpress-tor 9050/tcp
docker container inspect onionpress-cloudflared
fn start_onionheaven_activation_watcher
docker exec -u www-data onionpress-wordpress sed -n s/^[[:space:]*]*Version:[[:space:]]*//p /var/www/html/wp-content/plugins/internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php
log Installing Internet Archive Wayback Machine Link Fixer 1.4.2...
docker exec onionpress-wordpress true
docker exec onionpress-wordpress mktemp -d /tmp/onionpress-plugin-XXXXXX
docker exec onionpress-wordpress curl -sSL -f --max-time 300 --speed-limit 1024 --speed-time 30 --socks5-hostname onionheaven:9050 -o /tmp/onionpress-plugin-abcdef/plugin.zip https://downloads.wordpress.org/plugin/internet-archive-wayback-machine-link-fixer.1.4.2.zip
docker cp onionpress-wordpress:/tmp/onionpress-plugin-abcdef/plugin.zip $TEMPDIR/internet-archive-wayback-machine-link-fixer.zip
docker exec onionpress-wordpress rm -rf /tmp/onionpress-plugin-abcdef
log Failed to download and verify Internet Archive Wayback Machine Link Fixer - check log for details
docker exec -u www-data onionpress-wordpress sed -n s/^[[:space:]*]*Version:[[:space:]]*//p /var/www/html/wp-content/plugins/cache-enabler/cache-enabler.php
log Installing Cache Enabler 1.8.17...
docker exec onionpress-wordpress true
docker exec onionpress-wordpress mktemp -d /tmp/onionpress-plugin-XXXXXX
docker exec onionpress-wordpress curl -sSL -f --max-time 300 --speed-limit 1024 --speed-time 30 --socks5-hostname onionheaven:9050 -o /tmp/onionpress-plugin-abcdef/plugin.zip https://downloads.wordpress.org/plugin/cache-enabler.1.8.17.zip
docker cp onionpress-wordpress:/tmp/onionpress-plugin-abcdef/plugin.zip $TEMPDIR/cache-enabler.zip
docker exec onionpress-wordpress rm -rf /tmp/onionpress-plugin-abcdef
log Failed to download and verify Cache Enabler - check log for details
py deactivate-wp-statistics
py provision-post-install --themes-dir $TMP/opt/themes --plugins-dir $TMP/opt/plugins
docker exec -u www-data -e WP_CLI_CACHE_DIR=/tmp/wp-cli-cache onionpress-wordpress wp core is-installed
docker exec -u www-data onionpress-wordpress test -f /var/www/html/wp-content/plugins/cache-enabler/cache-enabler.php
docker exec -u www-data onionpress-wordpress test -f /var/www/html/wp-content/plugins/internet-archive-wayback-machine-link-fixer/internet-archive-wayback-machine-link-fixer.php
docker exec onionpress-wordpress test -f /var/www/html/wp-content/uploads/.onionpress-regenerate-derivatives
rc=0
markers=.wordpress-installed
volumes=onionpress-onion-keys onionpress-tor-state
