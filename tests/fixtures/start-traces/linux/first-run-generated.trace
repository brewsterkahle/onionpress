log Starting OnionPress containers...
fn wait_for_docker 180
docker volume ls --format {{.Name}}
docker volume ls --format {{.Name}}
docker volume ls --format {{.Name}}
log First run detected
log First run with ADDRESS_PREFIX=op2 -- checking tor image for mkp224o...
py generate-vanity
log Vanity address generated; will be installed below
log Using pre-imported key: op2bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.onion
fn ensure_key_formats $TMP/home/.onionpress/shared/vanity-keys/op2bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.onion
log Key formats synchronized
docker image inspect --format {{.Id}} ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:PIN
docker volume create onionpress-onion-keys
docker run --rm --network none --cap-drop ALL --cap-add DAC_OVERRIDE --security-opt no-new-privileges:true -v onionpress-onion-keys:/dest --mount type=bind,source=$TMP/home/.onionpress/shared/vanity-keys/op2bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.onion,target=/src,readonly --entrypoint sh ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:PIN -c mkdir -p /dest/wordpress && cp /src/ks_hs_id.ed25519_expanded_private /dest/wordpress/ && chown -R 0:0 /dest && chmod 700 /dest /dest/wordpress && chmod 600 /dest/wordpress/*
log Address key installed to the onionpress-onion-keys volume
docker volume create onionpress-tor-state
docker run --rm --network none --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --security-opt no-new-privileges:true -v onionpress-tor-state:/dest --mount type=bind,source=$TMP/home/.onionpress/shared/vanity-keys/op2bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.onion,target=/src,readonly --entrypoint sh ghcr.io/brewsterkahle/onionpress-tor:latest@sha256:PIN -c 
                    set -e
                    mkdir -p /dest/hidden_service/wordpress/authorized_clients
                    cp /src/hs_ed25519_secret_key /dest/hidden_service/wordpress/
                    cp /src/hs_ed25519_public_key /dest/hidden_service/wordpress/ 2>/dev/null || true
                    cp /src/hostname /dest/hidden_service/wordpress/
                    chown -R debian-tor:debian-tor /dest/hidden_service
                    chmod 700 /dest/hidden_service /dest/hidden_service/wordpress
                    chmod 600 /dest/hidden_service/wordpress/hs_ed25519_secret_key
                    chmod 644 /dest/hidden_service/wordpress/hostname
                
log Address key installed to tor-state volume (C Tor)
log Onion address: op2bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.onion
