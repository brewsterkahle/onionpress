{
  "manifest_version": 3,
  "name": "OnionPress",
  "version": "1.2.0",
  "description": "Browse .onion sites in any browser. Requires OnionPress to be running.",
  "key": "",
  "permissions": [
    "proxy",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.onion/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
